import os;
import hashlib;
import from typing { LiteralString, cast }
import from fnmatch { fnmatch }

import from jaclang.prune.campaign { Campaign }


enum FileRole {
    SOURCE = 1,
    IMPL_ANNEX = 2,
    TEST = 3,
    FIXTURE = 4,
    GENERATED = 5,
    VENDORED = 6,
    DOCS = 7,
}


glob ROLE_LABELS: dict[FileRole, str] = {
         FileRole.SOURCE: "source",
         FileRole.IMPL_ANNEX: "impl-annex",
         FileRole.TEST: "test",
         FileRole.FIXTURE: "fixture",
         FileRole.GENERATED: "generated",
         FileRole.VENDORED: "vendored",
         FileRole.DOCS: "docs",

     };


def role_label(role: FileRole) -> str {
    return ROLE_LABELS.get(role, "source");
}


glob GENERATED_MARKERS = [
         "# this file is generated",
         "# auto-generated",
         "# autogenerated",
         "# generated by",
         "# do not edit",

     ];


obj ManifestEntry {
    has path: str,
        role: FileRole,
        content_hash: str,
        module_name: str;

    def is_live -> bool {
        return self.role == FileRole.SOURCE or self.role == FileRole.IMPL_ANNEX;
    }
}


obj Manifest {
    has project_root: str,
        entries: list[ManifestEntry] = [];

    def by_role(role: FileRole) -> list[ManifestEntry] {
        return [
            e
            for e in self.entries
            if e.role == role
        ];
    }

    def live_entries -> list[ManifestEntry] {
        return [
            e
            for e in self.entries
            if e.is_live()
        ];
    }

    def role_counts -> dict[str, int] {
        counts: dict[str, int] = {};
        for e in self.entries {
            k = role_label(e.role);
            counts[k] = counts.get(k, 0) + 1;
        }
        return counts;
    }
}


def _content_hash(path: str) -> str {
    try {
        with open(path, "rb") as f {
            return hashlib.sha256(f.read()).hexdigest();
        }
    } except Exception {
        return "";
    }
}


def _has_generated_marker(path: str) -> bool {
    try {
        with open(path, "r", encoding="utf-8", errors="ignore") as f {
            head = f.read(512).lower();
        }
    } except Exception {
        return False;
    }
    return bool(any(m in head for m in GENERATED_MARKERS));
}


def _module_name(path: str, project_root: str) -> str {
    try {
        rel = os.path.relpath(path, project_root);
    } except Exception {
        rel = path;
    }
    rel = rel.replace(os.sep, "/");
    for suffix in [".impl.jac", ".test.jac", ".jac"] {
        if rel.endswith(suffix) {
            rel = rel[:-len(suffix)];
            break;
        }
    }
    parts = [
        p
        for p in rel.split("/")
        if p and p != ".."
    ];
    return ".".join(parts);
}


def classify(path: str, generated_globs: list[str]) -> FileRole {
    norm = path.replace(os.sep, "/");
    base = os.path.basename(norm);
    parts = norm.split("/");

    if "/vendor/" in norm or "vendor" in parts {
        return FileRole.VENDORED;
    }
    if "fixtures" in parts or "fixture" in parts {
        return FileRole.FIXTURE;
    }
    if base.endswith(".impl.jac") {
        return FileRole.IMPL_ANNEX;
    }
    if (base.endswith(".test.jac") or base.startswith("test_") or "tests" in parts) {
        return FileRole.TEST;
    }
    if any(fnmatch(base, cast(LiteralString, g)) for g in generated_globs)
    or _has_generated_marker(path) {
        return FileRole.GENERATED;
    }
    if "docs" in parts {
        return FileRole.DOCS;
    }
    return FileRole.SOURCE;
}


def _iter_jac_paths(roots: list[str]) -> list[str] {
    found: list[str] = [];
    seen: set[str] = set();
    for scope_root in roots {
        if os.path.isfile(scope_root) {
            if scope_root.endswith(".jac") and scope_root not in seen {
                seen.add(scope_root);
                found.append(scope_root);
            }
            continue;
        }
        for (dirpath, dirnames, filenames) in os.walk(scope_root) {
            dirnames[:] = [
                d
                for d in dirnames
                if not d.startswith(".") and d != "__pycache__"
            ];
            for name in filenames {
                if name.endswith(".jac") {
                    full = os.path.join(dirpath, name);
                    if full not in seen {
                        seen.add(full);
                        found.append(full);
                    }
                }
            }
        }
    }
    return sorted(found);
}


def _excluded(path: str, project_root: str, patterns: list[str]) -> bool {
    if not patterns {
        return False;
    }
    norm = path.replace(os.sep, "/");
    try {
        rel = os.path.relpath(path, project_root).replace(os.sep, "/");
    } except Exception {
        rel = norm;
    }
    return bool(
        any(
            fnmatch(norm, cast(LiteralString, p))
            or fnmatch(rel, cast(LiteralString, p)) for p in patterns
        )
    );
}


def build_manifest(campaign: Campaign) -> Manifest {
    manifest = Manifest(project_root=campaign.project_root);
    explicit_files = {
        os.path.abspath(path)
        for path in campaign.scope_paths()
        if os.path.isfile(path)
    };
    for path in _iter_jac_paths(campaign.scope_paths()) {
        if _excluded(path, campaign.project_root, campaign.exclude) {
            continue;
        }
        if campaign.include_globs
        and not _excluded(path, campaign.project_root, campaign.include_globs) {
            continue;
        }
        role = classify(path, campaign.generated_globs);

        if role == FileRole.FIXTURE and os.path.abspath(path) in explicit_files {
            role = FileRole.SOURCE;
        }
        manifest.entries.append(
            ManifestEntry(
                path=os.path.abspath(path),
                role=role,
                content_hash=_content_hash(path),
                module_name=_module_name(path, campaign.project_root)
            )
        );
    }
    return manifest;
}


obj ScopeCoverage {
    has in_scope_live: int,
        project_live: int;

    def is_partial -> bool {
        return self.project_live > self.in_scope_live;
    }

    def outside_count -> int {
        return max(0, self.project_live - self.in_scope_live);
    }
}


"""Count the project's live (source + impl-annex) `.jac` files without hashing
or compiling, so a scoped run can tell whether consumers live outside its scope.
A subtree scoped without its consumers makes cross-module detectors
(visibility-tightening) read as mass-dead; this is the coverage signal that
lets the report say so."""
def scope_coverage(campaign: Campaign, manifest: Manifest) -> ScopeCoverage {
    in_scope = len(manifest.live_entries());
    if not campaign.paths {
        # No explicit paths -> scope already spans the whole project root.
        return ScopeCoverage(in_scope_live=in_scope, project_live=in_scope);
    }
    project_live = 0;
    for path in _iter_jac_paths([campaign.project_root]) {
        if _excluded(path, campaign.project_root, campaign.exclude) {
            continue;
        }
        if campaign.include_globs
        and not _excluded(path, campaign.project_root, campaign.include_globs) {
            continue;
        }
        role = classify(path, campaign.generated_globs);
        if role == FileRole.SOURCE or role == FileRole.IMPL_ANNEX {
            project_live += 1;
        }
    }
    return ScopeCoverage(
        in_scope_live=in_scope, project_live=max(in_scope, project_live)
    );
}
