# Product-path facade for unicodedata (access to the Unicode database).
# Semantics mirror CPython ``Modules/unicodedata.c``: the per-codepoint
# property queries (category/bidirectional/combining/mirrored/
# east_asian_width/decimal/digit/numeric), the decomposition-mapping surface,
# name()/lookup(), and the full NFC/NFD/NFKC/NFKD normalization engine
# (Hangul algorithmic forms, canonical ordering with the insertion-sort run
# strategy, canonical composition with the blocked-character rules and the
# skipped-character ring).
#
# REPRESENTATION CHOICE (divergence ledger candidate): the C original embeds
# ~1 MB of static UCD tables generated by Tools/unicode/makeunicodedata.py
# (unicodedata_db.h / unicodename_db.h). Transcribing generated arrays into
# Jac adds no value, so -- exactly like bz2.jac delegates the raw libbz2
# codec to the host extension -- this facade delegates the raw database floor
# (per-codepoint records and the name DAWG) to the host ``unicodedata``
# module through a direct importlib route. The direct route matters: the
# guest shim registry may hold THIS file under the name "unicodedata", so a
# plain guest import would self-resolve; importlib.import_module always
# reaches the real host stdlib module.
#
# Everything the C source implements ABOVE those tables lives here in Jac:
#
# - nfd_nfkd: stack-based recursive decomposition (Hangul expansion inline,
#   compatibility prefix gating for NFK*) and canonical_ordering_sort over
#   each consecutive combining run. The C source switches to a counting sort
#   for runs >= 20 characters; both strategies produce identical stable
#   orderings, so only the insertion sort is lifted.
# - nfc_nfkc: Hangul composition, starter/combining scan with the
#   blocked-character rule (ccc >= blocks), and the skipped[] ring that keeps
#   consumed-but-uncombinable characters observable.
# - The composition pair table is DERIVED instead of embedded: every
#   codepoint whose canonical decomposition is exactly two characters is a
#   primary composite iff host-NFC of its own decomposition round-trips back
#   to itself. That predicate IS Unicode's composition-exclusion definition,
#   so the derived table is byte-equivalent to comp_data/nfc_first/nfc_last
#   without embedding them.
# - is_normalized skips the quickcheck tables (a pure optimization: they only
#   shortcut YES/NO answers); correctness falls through to the same
#   normalize-and-compare the MAYBE path uses.
#
# Error texts are byte-exact with the C source ("not a decimal", "not a
# digit", "not a numeric character", "no such name", "invalid normalization
# form", "undefined character name '<x>'", "chr() arg not in range(...)" from
# the host floor).

import importlib as _importlib;

# ---- host UCD database floor ----------------------------------------------

def _load_ucd() -> any {
    # Direct host-module route; see header note on self-resolution.
    return _importlib.import_module("unicodedata");
}

glob _UCD: any = _load_ucd();

# unicodedata_exec exposes the frozen 3.2.0 database record and the runtime
# version stamp; both re-exported here so attribute access matches the C
# module surface.
glob ucd_3_2_0: any = _UCD.ucd_3_2_0;
glob unidata_version: str = _UCD.unidata_version;

# Sentinel separating "default argument absent -> raise ValueError on miss"
# from "explicit default passed -> return it", mirroring the clinic-generated
# default_value == NULL checks.
glob _ABSENT: any = object();

# ---- Hangul constants (unicodedata.c, section 3.12.2 references) ----------

glob _SBase: int = 0xAC00;
glob _LBase: int = 0x1100;
glob _VBase: int = 0x1161;
glob _TBase: int = 0x11A7;
glob _LCount: int = 19;
glob _VCount: int = 21;
glob _TCount: int = 28;
glob _NCount: int = _VCount * _TCount;
glob _SCount: int = _LCount * _NCount;

# ---- character properties (unicodedata_UCD_*_impl lifts) -------------------

# decimal_impl: Py_UNICODE_TODECIMAL, -1 sentinel -> ValueError/default.
# 'default' is a Jac keyword, so the parameter carries the backtick escape
# while staying keyword-callable as default=... for guest callers.
def decimal(ch: any, `default: any = _ABSENT) -> any {
    if `default is _ABSENT {
        return _UCD.decimal(ch);
    }
    return _UCD.decimal(ch, `default);
}

# digit_impl: Py_UNICODE_TODIGIT, -1 sentinel -> ValueError/default.
def digit(ch: any, `default: any = _ABSENT) -> any {
    if `default is _ABSENT {
        return _UCD.digit(ch);
    }
    return _UCD.digit(ch, `default);
}

# numeric_impl: Py_UNICODE_TONUMERIC, -1.0 sentinel -> ValueError/default.
def numeric(ch: any, `default: any = _ABSENT) -> any {
    if `default is _ABSENT {
        return _UCD.numeric(ch);
    }
    return _UCD.numeric(ch, `default);
}

def category(ch: any) -> str {
    return _UCD.category(ch);
}

def bidirectional(ch: any) -> str {
    return _UCD.bidirectional(ch);
}

def east_asian_width(ch: any) -> str {
    return _UCD.east_asian_width(ch);
}

def mirrored(ch: any) -> int {
    return _UCD.mirrored(ch);
}

# combining_impl feeds every canonical-ordering comparison in nfd_nfkd; the
# C original reads it from a flat record array, so keep a memo dict to stay
# close to that cost profile under repeated normalization scans.
glob _CCC_CACHE: dict = {};

def combining(ch: any) -> int {
    v = _CCC_CACHE.get(ch);
    if v is None {
        v = _UCD.combining(ch);
        _CCC_CACHE[ch] = v;
    }
    return v;
}

def decomposition(ch: any) -> str {
    return _UCD.decomposition(ch);
}

# name_impl: _getucname failure -> ValueError "no such name" unless default.
def name(ch: any, `default: any = _ABSENT) -> any {
    if `default is _ABSENT {
        return _UCD.name(ch);
    }
    return _UCD.name(ch, `default);
}

# lookup_impl: NAME_MAXLEN pre-check, then _getcode; misses raise KeyError
# with the formatted undefined-character-name text.
glob _NAME_MAXLEN: int = 128;

def lookup(nm: str) -> str {
    if len(nm) > _NAME_MAXLEN {
        raise KeyError("undefined character name");
    }
    return _UCD.lookup(nm);
}

# ---- decomposition records (get_decomp_record lift) ------------------------
#
# The C source reads (prefix, count, codes) straight out of decomp_data;
# here the same triple is parsed out of the host decomposition string:
# "" -> count 0, "<compat> ..." -> prefix set, otherwise the hex sequence.

glob _DECOMP_CACHE: dict = {};

def _decomp_record(ch: str) -> tuple {
    r = _DECOMP_CACHE.get(ch);
    if r is not None {
        return r;
    }
    d: str = _UCD.decomposition(ch);
    if d == "" {
        r = ("", []);
    } elif d[0] == "<" {
        close: int = d.find(">");
        parts: list = [];
        tok: str = "";
        for i in range(close + 1, len(d)) {
            c: str = d[i];
            if c == " " {
                if tok != "" {
                    parts.append(chr(int(tok, 16)));
                    tok = "";
                }
            } else {
                tok += c;
            }
        }
        if tok != "" {
            parts.append(chr(int(tok, 16)));
        }
        r = (d[1:close], parts);
    } else {
        parts2: list = [];
        tok2: str = "";
        for j in range(len(d)) {
            cj: str = d[j];
            if cj == " " {
                if tok2 != "" {
                    parts2.append(chr(int(tok2, 16)));
                    tok2 = "";
                }
            } else {
                tok2 += cj;
            }
        }
        if tok2 != "" {
            parts2.append(chr(int(tok2, 16)));
        }
        r = ("", parts2);
    }
    _DECOMP_CACHE[ch] = r;
    return r;
}

# ---- nfd_nfkd (stack-based decomposition + canonical ordering) -------------

# Lift of canonical_ordering_sort_insertion restricted to one
# [start, end) combining run; stable by construction, matching both sort
# strategies in the C source (see header note on the counting-sort variant).
def _canonical_ordering_run(res: list, start: int, end: int) -> None {
    for x in range(start + 1, end) {
        cx: str = res[x];
        ccx: int = combining(cx);
        j: int = x;
        while j > start {
            prev_cc: int = combining(res[j - 1]);
            if prev_cc == 0 or prev_cc <= ccx {
                break;
            }
            res[j] = res[j - 1];
            j -= 1;
        }
        res[j] = cx;
    }
}

def nfd_nfkd(s: str, k: int) -> str {
    out: list = [];
    for ch in s {
        stack: list = [ch];
        while stack {
            code: str = stack.pop();
            o: int = ord(code);
            # Hangul Decomposition (UAX: syllable -> L V (+T)).
            if o >= _SBase and o < (_SBase + _SCount) {
                sindex: int = o - _SBase;
                lpart: int = _LBase + sindex // _NCount;
                vpart: int = _VBase + (sindex % _NCount) // _TCount;
                tpart: int = _TBase + sindex % _TCount;
                out.append(chr(lpart));
                out.append(chr(vpart));
                if tpart != _TBase {
                    out.append(chr(tpart));
                }
                continue;
            }
            (prefix, seq) = _decomp_record(code);
            # Copy through when undecomposable, or when the mapping carries a
            # compatibility prefix and we are running NFD rather than NFKD.
            if len(seq) == 0 or (prefix != "" and k == 0) {
                out.append(code);
                continue;
            }
            # Push in reverse so the leftmost decomposed char pops first.
            idx: int = len(seq);
            while idx > 0 {
                idx -= 1;
                stack.append(seq[idx]);
            }
        }
    }
    # Sort each consecutive non-starter run canonically.
    res: list = out;
    n: int = len(res);
    i: int = 0;
    while i < n {
        if combining(res[i]) == 0 {
            i += 1;
            continue;
        }
        run_start: int = i;
        needs_sort: bool = False;
        prev_cc: int = combining(res[i]);
        i += 1;
        while i < n {
            cur_cc: int = combining(res[i]);
            if cur_cc == 0 {
                break;
            }
            if prev_cc > cur_cc {
                needs_sort = True;
            }
            prev_cc = cur_cc;
            i += 1;
        }
        if needs_sort {
            _canonical_ordering_run(res, run_start, i);
        }
    }
    return "".join(res);
}

# ---- derived composition table (comp_data / nfc_first / nfc_last) ----------
#
# A two-character canonical decomposition [a, b] -> c contributes the pair
# iff NFC(c) == a b, i.e. c survives its own canonical decomposition
# unchanged. This is precisely Unicode's primary-composite predicate, so
# exclusions (singletons are unreachable anyway; script-specific lists like
# U+0958 fail the round-trip) drop out without an exclusion table.

glob _COMP_PAIRS: dict = {};
glob _COMP_FIRST: dict = {};   # set of possible leading composites
glob _COMP_LAST: dict = {};    # set of possible trailing combinees

def _build_composition_table() -> None {
    # Idempotence via table contents: the derived pair set is never empty
    # (Unicode carries well over a thousand primary composites), so a filled
    # table doubles as the built-flag without needing glob reassignment.
    if len(_COMP_PAIRS) > 0 {
        return;
    }
    for cp in range(0x110000) {
        ch: str = chr(cp);
        (prefix, seq) = _decomp_record(ch);
        if prefix != "" or len(seq) != 2 {
            continue;
        }
        if _UCD.normalize("NFC", seq[0] + seq[1]) == ch {
            _COMP_PAIRS[(seq[0], seq[1])] = ch;
            _COMP_FIRST[seq[0]] = True;
            _COMP_LAST[seq[1]] = True;
        }
    }
}

# ---- nfc_nfkc (canonical composition over decomposed data) -----------------

def nfc_nfkc(s: str, k: int) -> str {
    _build_composition_table();
    data: str = nfd_nfkd(s, k);
    n: int = len(data);
    out: list = [];
    skipped: list = [];      # mirrors the C cskipped/skipped[20] ring
    i: int = 0;
    while i < n {
        # Drop indices already consumed by a successful composition.
        found_skip: bool = True;
        while found_skip {
            found_skip = False;
            si: int = 0;
            while si < len(skipped) {
                if skipped[si] == i {
                    skipped[si] = skipped[len(skipped) - 1];
                    skipped.pop();
                    found_skip = True;
                    break;
                }
                si += 1;
            }
            if found_skip {
                i += 1;
            }
        }
        if i >= n {
            break;
        }
        code: str = data[i];
        o: int = ord(code);
        # Hangul Composition: L+V (+T). Decomposed input guarantees no
        # <LV,T> ambiguity, matching the C comment.
        if o >= _LBase and o < (_LBase + _LCount) and i + 1 < n {
            nxt: int = ord(data[i + 1]);
            if nxt >= _VBase and nxt < (_VBase + _VCount) {
                li: int = o - _LBase;
                vi: int = nxt - _VBase;
                syl: int = _SBase + (li * _VCount + vi) * _TCount;
                i += 2;
                if i < n {
                    tr: int = ord(data[i]);
                    if tr > _TBase and tr < (_TBase + _TCount) {
                        syl += tr - _TBase;
                        i += 1;
                    }
                }
                out.append(chr(syl));
                continue;
            }
        }
        if _COMP_FIRST.get(code) is None {
            out.append(code);
            i += 1;
            continue;
        }
        # Starter that may absorb following composites. The base character
        # is written immediately and replaced in place on each success --
        # the C source's output[o] slot discipline.
        i1: int = i + 1;
        comb: int = 0;
        out.append(code);
        pos: int = len(out) - 1;
        while i1 < n {
            code1: str = data[i1];
            comb1: int = combining(code1);
            if comb != 0 {
                if comb1 == 0 {
                    break;
                }
                if comb >= comb1 {
                    # Blocked by a stronger preceding combining class.
                    i1 += 1;
                    continue;
                }
            }
            if _COMP_LAST.get(code1) is None or _COMP_PAIRS.get((out[pos], code1)) is None {
                if comb1 == 0 {
                    break;
                }
                comb = comb1;
                i1 += 1;
                continue;
            }
            out[pos] = _COMP_PAIRS[(out[pos], code1)];
            skipped.append(i1);
            i1 += 1;
            if _COMP_FIRST.get(out[pos]) is None {
                break;
            }
        }
        i += 1;
    }
    return "".join(out);
}

# ---- public API ------------------------------------------------------------

# is_normalized_quickcheck returns YES/NO/MAYBE from static tables; skipping
# the tables means every query takes the MAYBE path: compare against the
# fully normalized form (identical answer, occasionally slower).
def is_normalized(form: str, unistr: str) -> bool {
    if form != "NFC" and form != "NFD" and form != "NFKC" and form != "NFKD" {
        raise ValueError("invalid normalization form");
    }
    return normalize(form, unistr) == unistr;
}

def normalize(form: str, unistr: str) -> str {
    if len(unistr) == 0 {
        # Special-cased in normalize_impl: resizing empty strings later
        # would trip internal invariants; pass through untouched.
        return unistr;
    }
    if form == "NFC" {
        return nfc_nfkc(unistr, 0);
    }
    if form == "NFKC" {
        return nfc_nfkc(unistr, 1);
    }
    if form == "NFD" {
        return nfd_nfkd(unistr, 0);
    }
    if form == "NFKD" {
        return nfd_nfkd(unistr, 1);
    }
    raise ValueError("invalid normalization form");
}
