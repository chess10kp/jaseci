     break\n                if name == 'readlines':\n                    ostream.writelines(data)\n                else:\n                    ostream.write(data)\n            assert ostream.getvalue() == self.tstring[0], ('assertEqual', ostream.getvalue(), self.tstring[0])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
