taldecoder\n    text = '\u30d5\u30eb\u30fc\u30c4'\n    try:\n        text.encode(self.encoding)\n    except UnicodeEncodeError:\n        text = 'Python is cool'\n    encode_w_null = (text + '\\x00').encode(self.encoding)\n    encode_plus_null = text.encode(self.encoding) + '\\x00'.encode(self.encoding)\n    assert encode_w_null.endswith(b'\\x00'), ('assertTrue', encode_w_null.endswith(b'\\x00'))\n    assert encode_w_null == encode_plus_null, ('assertEqual', encode_w_null, encode_plus_null)\n    encode_w_null_2 = (text + '\\x00' + text + '\\x00').encode(self.encoding)\n    encode_plus_null_2 = encode_plus_null + encode_plus_null\n    assert encode_w_null_2.count(b'\\x00') == 2, ('assertEqual', encode_w_null_2.count(b'\\x00'), 2)\n    assert encode_w_null_2 == encode_plus_null_2, ('assertEqual', encode_w_null_2, encode_plus_null_2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

