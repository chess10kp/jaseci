er\n    for source, scheme, expected in self.codectests:\n        if isinstance(source, bytes):\n            func = self.decode\n        else:\n            func = self.encode\n        if expected:\n            result = func(source, scheme)[0]\n            if func is self.decode:\n                assert type(result) is str, ('assertTrue', type(result) is str)\n                assert result == expected, ('assertEqual', result, expected)\n            else:\n                assert type(result) is bytes, ('assertTrue', type(result) is bytes)\n                assert result == expected, ('assertEqual', result, expected)\n        else:\n            try:\n                func(*(source, scheme))\n            except UnicodeError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "Test_ISO2022_JP2.test_callback_returns_bytes" {
    (ok, detail) = p2_libtest_run_snippet("COMMON_CODEC_TESTS = ((b'ab\\xffcd', 'replace', 'ab\ufffdcd'), (b'ab\\x1bdef', 'replace', 'ab\\x1bdef'), (b'ab\\x1b$def', 'replace', 'ab\ufffd'))\nimport codecs\n\ndef _t():\n\n    def setUp():\n        if self.codec is None:\n            self.codec = codecs.lookup(self.encoding)\n        self.encode = self.codec.encode\n        self.decode = self.codec.decode\n        self.reader = self.codec.streamreader\n        self.writer = self.codec.streamwriter\n        self.incrementalencoder = self.codec.incrementalencoder\n        self.incrementaldecoder = self.codec.incrementaldecoder\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.codec = None\n    _SelfNS.codec = None\n    self.codectests = COMMON_CODEC_TESTS + ((b'ab\\x1bNdef', 'replace', 'abdef'),)\n    _SelfNS.codectests = COMMON_CODEC_TESTS + ((b'ab\\x1bNdef', 'replace', 'abdef'),)\n    self.encoding = 'iso2022_jp_2'\n    _SelfNS.encoding = 'iso2022_jp_2'\n    self.has_iso10646 = 0\n    _SelfNS.has_iso10646 = 0\n    self.roundtriptest = 1\n    _SelfNS.roundtriptest = 1\n    self.tstring = (b'Python \\x1b$B$N3+H/$O!\"\\x1b(B1990 \\x1b$BG/$4$m$+$i3+;O$5$l$F$$$^$9!#\\x1b(B\\n\\x1b$B3+H/<T$N\\x1b(B Guido van Rossum \\x1b$B$O650iMQ$N%W%m%0%i%_%s%08@8l!V\\x1b(BABC\\x1b$B!W$N3+H/$K;22C$7$F$$$^$7$?$,!\"\\x1b(BABC \\x1b$B$O<BMQ>e$NL\\\\E*$K$O$\"$^$jE,$7$F$$$^$;$s$G$7$?!#\\x1b(B\\n\\x1b$B$3$N$?$a!\"\\x1b(BGuido \\x1b$B$O$h$j<BMQE*$J%W%m%0%i%_%s%08@8l$N3+H/$r3+;O$7!\"1Q9q\\x1b(B BBS \\x1b$BJ|Aw$N%3%a%G%#HVAH!V%b%s%F%#\\x1b(B \\x1b$B%Q%$%=%s!W$N%U%!%s$G$\"$k\\x1b(B Guido \\x1b$B$O$3$N8@8l$r!V\\x1b(BPython\\x1b$B!W$HL>$E$1$^$7$?!#\\x1b(B\\n\\x1b$B$3$N$h$&$JGX7J$+$i@8$^$l$?\\x1b(B Python \\x1b$B$N8@8l@_7W$O!\"!V%7%s%W%k!W$G!V=,F@$,MF0W!W$H$$$&L\\\\I8$K=EE@$,CV$+$l$F$$$^$9!#\\x1b(B\\n\\x1b$BB?$/$N%9%/%j%W%H7O8@8l$G$O%f!<%6$NL\\\\@h$NMxJX@-$rM%@h$7$F?\\'!9$J5!G=$r8@8lMWAG$H$7$F<h$jF~$l$k>l9g$,B?$$$N$G$9$,!\"\\x1b(BPython \\x1b$B$G$O$=$&$$$C$?>.:Y9)$,DI2C$5$l$k$3$H$O$\"