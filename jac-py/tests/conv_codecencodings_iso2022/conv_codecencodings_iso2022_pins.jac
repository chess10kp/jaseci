er = self.codec.incrementaldecoder\n    UTF8Writer = codecs.getwriter('utf-8')\n    for sizehint in [None, -1] + list(range(1, 33)) + [64, 128, 256, 512, 1024]:\n        istream = BytesIO(self.tstring[0])\n        ostream = UTF8Writer(BytesIO())\n        decoder = self.incrementaldecoder()\n        while 1:\n            data = istream.read(sizehint)\n            if not data:\n                break\n            else:\n                u = decoder.decode(data)\n                ostream.write(u)\n        assert ostream.getvalue() == self.tstring[1], ('assertEqual', ostream.getvalue(), self.tstring[1])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
