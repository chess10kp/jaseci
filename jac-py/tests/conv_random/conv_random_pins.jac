    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\n\nclass MyIndex:\n\n    def __init__(self, value):\n        self.value = value\n\n    def __index__(self):\n        return self.value\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.gen = random.SystemRandom()\n    _SelfNS.gen = random.SystemRandom()\n    randint = self.gen.randint\n    assert randint(2, 5) in (2, 3, 4, 5), ('assertIn', randint(2, 5), (2, 3, 4, 5))\n    assert randint(2, 2) == 2, ('assertEqual', randint(2, 2), 2)\n    assert randint(MyIndex(2), MyIndex(5)) in (2, 3, 4, 5), ('assertIn', randint(MyIndex(2), MyIndex(5)), (2, 3, 4, 5))\n    assert randint(MyIndex(2), MyIndex(2)) == 2, ('assertEqual', randint(MyIndex(2), MyIndex(2)), 2)\n    try:\n        randint(*(5, 2))\n    except ValueError:\n        pass\n    try:\n        randint()\n    except TypeError:\n        pass\n    try:\n        randint(*(2,))\n    except TypeError:\n        pass\n    try:\n        randint(*(2, 5, 1))\n    except TypeError:\n        pass\n    try:\n        randint(*(2.0, 5))\n    except TypeError:\n        pass\n    try:\n        randint(*(2, 5.0))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
