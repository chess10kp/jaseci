test "SystemRandom_TestBasicOps.test_getrandbits" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.gen = random.SystemRandom()\n    _SelfNS.gen = random.SystemRandom()\n    getrandbits = self.gen.getrandbits\n    for k in range(1, 1000):\n        assert 0 <= getrandbits(k) < 2 ** k, ('assertTrue', 0 <= getrandbits(k) < 2 ** k)\n    assert getrandbits(0) == 0, ('assertEqual', getrandbits(0), 0)\n    for span in [1, 2, 3, 4, 31, 32, 32, 52, 53, 54, 119, 127, 128, 129]:\n        all_bits = 2 ** span - 1\n        cum = 0\n        cpl_cum = 0\n        for i in range(100):\n            v = getrandbits(span)\n            cum |= v\n            cpl_cum |= all_bits ^ v\n        assert cum == all_bits, ('assertEqual', cum, all_bits)\n        assert cpl_cum == all_bits, ('assertEqual', cpl_cum, all_bits)\n    try:\n        getrandbits()\n    except TypeError:\n        pass\n    try:\n        getrandbits(*(1, 2))\n    except TypeError:\n        pass\n    try:\n        getrandbits(*(-1,))\n    except ValueError:\n        pass\n    try:\n        getrandbits(*(1 << 1000,))\n    except OverflowError:\n        pass\n    try:\n        getrandbits(*(-1 << 1000,))\n    except ValueError:\n        pass\n    try:\n        getrandbits(*(10.1,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MersenneTwister_TestBasicOps.test_getrandbits" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.gen = random.Random()\n    _SelfNS.gen = random.Random()\n    getrandbits = self.gen.getrandbits\n    for k in range(1, 1000):\n        assert 0 <= getrandbits(k) < 2 ** k, ('assertTrue', 0 <= getrandbits(k) < 2 ** k)\n    assert getrandbits(0) == 0, ('assertEqual', getrandbits(0), 0)\n    for span in [1, 2, 3, 4, 31, 32, 32, 52, 53, 54, 119, 127, 128, 129]:\n        all_bits = 2 ** span - 1\n        cum = 0\n        cpl_cum = 0\n        for i in range(100):\n            v = getrandbits(span)\n            cum |= v\n            cpl_cum |= all_bits ^ v\n        assert cum == all_bits, ('assertEqual', cum, all_bits)\n        assert cpl_cum == all_bits, ('assertEqual', cpl_cum, all_bits)\n    try:\n        getrandbits()\n    except TypeError:\n        pass\n    try:\n        getrandbits(*(1, 2))\n    except TypeError:\n        pass\n    try:\n        getrandbits(*(-1,))\n    except ValueError:\n        pass\n    try:\n        getrandbits(*(1 << 1000,))\n    except OverflowError:\n        pass\n    try:\n        getrandbits(*(-1 << 1000,))\n    except ValueError:\n        pass\n    try:\n        getrandbits(*(10.1,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

