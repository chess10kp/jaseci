test "TestDistributions.test_binomialvariate" {
    (ok, detail) = p2_libtest_run_snippet("import random\nfrom collections import abc, Counter\n\ndef _t():\n    B = random.binomialvariate\n    try:\n        B(n=-1)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        B(n=1, p=-0.5)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        B(n=1, p=1.5)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert B(0, 0.5) == 0, ('assertEqual', B(0, 0.5), 0)\n    assert B(10, 0.0) == 0, ('assertEqual', B(10, 0.0), 0)\n    assert B(10, 1.0) == 10, ('assertEqual', B(10, 1.0), 10)\n    assert B(1, 0.3) in {0, 1}, ('assertTrue', B(1, 0.3) in {0, 1})\n    assert B(1, 0.9) in {0, 1}, ('assertTrue', B(1, 0.9) in {0, 1})\n    assert B(1, 0.0) in {0}, ('assertTrue', B(1, 0.0) in {0})\n    assert B(1, 1.0) in {1}, ('assertTrue', B(1, 1.0) in {1})\n    assert B(5, 1e-18) == 0, ('assertEqual', B(5, 1e-18), 0)\n    assert B(5, 0.25) in set(range(6)), ('assertTrue', B(5, 0.25) in set(range(6)))\n    assert B(5, 0.75) in set(range(6)), ('assertTrue', B(5, 0.75) in set(range(6)))\n    assert B(100, 0.25) in set(range(101)), ('assertTrue', B(100, 0.25) in set(range(101)))\n    assert B(100, 0.75) in set(range(101)), ('assertTrue', B(100, 0.75) in set(range(101)))\n    c = Counter((B(4, 0.25) for i in range(100000)))\n    assert 29641 <= c[0] <= 33641, ('assertTrue', 29641 <= c[0] <= 33641)\n    assert 40188 <= c[1] <= 44188, ('assertTrue', 40188 <= c[1] <= 44188)\n    assert 19094 <= c[2] <= 23094, ('assertTrue', 19094 <= c[2] <= 23094)\n    assert 2688 <= c[3] <= 6688, ('assertTrue', 2688 <= c[3] <= 6688)\n    assert set(c) == {0, 1, 2, 3, 4}, ('assertEqual', set(c), {0, 1, 2, 3, 4})\n    c = Counter((B(100, 0.25) for i in range(100000)))\n    assert 34214 <= c[20] + c[21] + c[22] + c[23] + c[24] <= 38214, ('assertTrue', 34214 <= c[20] + c[21] + c[22] + c[23] + c[24] <= 38214)\n    assert set(c) <= set(range(101)), ('assertTrue', set(c) <= set(range(101)))\n    assert c.total() == 100000, ('assertEqual', c.total(), 100000)\n    assert 19000000 <= B(100000000, 0.2) <= 21000000, ('assertTrue', 19000000 <= B(100000000, 0.2) <= 21000000)\n    assert 89000000 <= B(100000000, 0.9) <= 91000000, ('assertTrue', 89000000 <= B(100000000, 0.9) <= 91000000)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
