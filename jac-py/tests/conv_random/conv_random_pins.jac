    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MersenneTwister_TestBasicOps.test_pickling" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\nimport pickle\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.gen = random.Random()\n    _SelfNS.gen = random.Random()\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        state = pickle.dumps(self.gen, proto)\n        origseq = [self.gen.random() for i in range(10)]\n        newgen = pickle.loads(state)\n        restoredseq = [newgen.random() for i in range(10)]\n        assert origseq == restoredseq, ('assertEqual', origseq, restoredseq)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

