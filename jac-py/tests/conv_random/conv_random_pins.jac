test "MersenneTwister_TestBasicOps.test_shuffle" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.gen = random.Random()\n    _SelfNS.gen = random.Random()\n    shuffle = self.gen.shuffle\n    lst = []\n    shuffle(lst)\n    assert lst == [], ('assertEqual', lst, [])\n    lst = [37]\n    shuffle(lst)\n    assert lst == [37], ('assertEqual', lst, [37])\n    seqs = [list(range(n)) for n in range(10)]\n    shuffled_seqs = [list(range(n)) for n in range(10)]\n    for shuffled_seq in shuffled_seqs:\n        shuffle(shuffled_seq)\n    for seq, shuffled_seq in zip(seqs, shuffled_seqs):\n        assert len(seq) == len(shuffled_seq), ('assertEqual', len(seq), len(shuffled_seq))\n        assert set(seq) == set(shuffled_seq), ('assertEqual', set(seq), set(shuffled_seq))\n    lst = list(range(1000))\n    shuffled_lst = list(range(1000))\n    shuffle(shuffled_lst)\n    assert lst != shuffled_lst, ('assertTrue', lst != shuffled_lst)\n    shuffle(lst)\n    assert lst != shuffled_lst, ('assertTrue', lst != shuffled_lst)\n    try:\n        shuffle(*((1, 2, 3),))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MersenneTwister_TestBasicOps.test_sample" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.gen = random.Random()\n    _SelfNS.gen = random.Random()\n    N = 100\n    population = range(N)\n    for k in range(N + 1):\n        s = self.gen.sample(population, k)\n        assert len(s) == k, ('assertEqual', len(s), k)\n        uniq = set(s)\n        assert len(uniq) == k, ('assertEqual', len(uniq), k)\n        assert uniq <= set(population), ('assertTrue', uniq <= set(population))\n    assert self.gen.sample([], 0) == [], ('assertEqual', self.gen.sample([], 0), [])\n    try:\n        self.gen.sample(*(population, N + 1))\n    except ValueError:\n        pass\n    try:\n        self.gen.sample(*([], -1))\n    except ValueError:\n        pass\n    try:\n        self.gen.sample(*(population, 1.0))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
