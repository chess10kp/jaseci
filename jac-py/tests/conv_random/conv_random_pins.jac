test "MersenneTwister_TestBasicOps.test_randbelow_without_getrandbits" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport unittest\nimport unittest.mock\nimport random\nimport warnings\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.gen = random.Random()\n    _SelfNS.gen = random.Random()\n    maxsize = 1 << random.BPF\n    with warnings.catch_warnings():\n        warnings.simplefilter('ignore', UserWarning)\n        self.gen._randbelow_without_getrandbits(maxsize + 1, maxsize=maxsize)\n    self.gen._randbelow_without_getrandbits(5640, maxsize=maxsize)\n    n = 42\n    epsilon = 0.01\n    limit = (maxsize - maxsize % n) / maxsize\n    with unittest.mock.patch.object(random.Random, 'random') as random_mock:\n        random_mock.side_effect = [limit + epsilon, limit - epsilon]\n        self.gen._randbelow_without_getrandbits(n, maxsize=maxsize)\n        assert random_mock.call_count == 2, ('assertEqual', random_mock.call_count, 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

