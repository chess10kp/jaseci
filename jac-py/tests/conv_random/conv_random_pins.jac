test "TestDistributions.test_von_mises_range" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\n\ndef _t():\n    g = random.Random()\n    N = 100\n    for mu in (0.0, 0.1, 3.1, 6.2):\n        for kappa in (0.0, 2.3, 500.0):\n            for _ in range(N):\n                sample = g.vonmisesvariate(mu, kappa)\n                assert 0 <= sample <= random.TWOPI, ('assertTrue', 0 <= sample <= random.TWOPI, 'vonmisesvariate({}, {}) produced a result {} out of range [0, 2*pi]'.format(mu, kappa, sample))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
