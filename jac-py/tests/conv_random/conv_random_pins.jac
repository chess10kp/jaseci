    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.gen = random.Random()\n    _SelfNS.gen = random.Random()\n    for seed in (1, 12, 123, 1234, 12345, 123456, 654321):\n        self.gen.seed(seed)\n        x1 = self.gen.random()\n        y1 = self.gen.gauss(0, 1)\n        self.gen.seed(seed)\n        x2 = self.gen.random()\n        y2 = self.gen.gauss(0, 1)\n        assert x1 == x2, ('assertEqual', x1, x2)\n        assert y1 == y2, ('assertEqual', y1, y2)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
