test "TestDistributions.test_zeroinputs" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\n\ndef _t():\n    g = random.Random()\n    x = [g.random() for i in range(50)] + [0.0] * 5\n    g.random = x[:].pop\n    g.uniform(1, 10)\n    g.random = x[:].pop\n    g.paretovariate(1.0)\n    g.random = x[:].pop\n    g.expovariate(1.0)\n    g.random = x[:].pop\n    g.expovariate()\n    g.random = x[:].pop\n    g.weibullvariate(1.0, 1.0)\n    g.random = x[:].pop\n    g.vonmisesvariate(1.0, 1.0)\n    g.random = x[:].pop\n    g.normalvariate(0.0, 1.0)\n    g.random = x[:].pop\n    g.gauss(0.0, 1.0)\n    g.random = x[:].pop\n    g.lognormvariate(0.0, 1.0)\n    g.random = x[:].pop\n    g.vonmisesvariate(0.0, 1.0)\n    g.random = x[:].pop\n    g.gammavariate(0.01, 1.0)\n    g.random = x[:].pop\n    g.gammavariate(1.0, 1.0)\n    g.random = x[:].pop\n    g.gammavariate(200.0, 1.0)\n    g.random = x[:].pop\n    g.betavariate(3.0, 3.0)\n    g.random = x[:].pop\n    g.triangular(0.0, 1.0, 1.0 / 3.0)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDistributions.test_avg_std" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\nfrom math import log, exp, pi, fsum, sin, factorial\n\ndef gamma(z, sqrt2pi=(2.0 * pi) ** 0.5):\n    if z < 0.5:\n        return pi / sin(pi * z) / gamma(1.0 - z)\n    az = z + (7.0 - 0.5)\n    return az ** (z - 0.5) / exp(az) * sqrt2pi * fsum([0.9999999999995183, 676.5203681218835 / z, -1259.139216722289 / (z + 1.0), 771.3234287757674 / (z + 2.0), -176.6150291498386 / (z + 3.0), 12.50734324009056 / (z + 4.0), -0.1385710331296526 / (z + 5.0), 9.934937113930748e-06 / (z + 6.0), 1.659470187408462e-07 / (z + 7.0)])\n\ndef _t():\n    g = random.Random()\n    N = 5000\n    x = [i / float(N) for i in range(1, N)]\n    for variate, args, mu, sigmasqrd in [(g.uniform, (1.0, 10.0), (10.0 + 1.0) / 2, (10.0 - 1.0) ** 2 / 12), (g.triangular, (0.0, 1.0, 1.0 / 3.0), 4.0 / 9.0, 7.0 / 9.0 / 18.0), (g.expovariate, (1.5,), 1 / 1.5, 1 / 1.5 ** 2), (g.vonmisesvariate, (1.23, 0), pi, pi ** 2 / 3), (g.paretovariate, (5.0,), 5.0 / (5.0 - 1), 5.0 / ((5.0 - 1) ** 2 * (5.0 - 2))), (g.weibullvariate, (1.0, 3.0), gamma(1 + 1 / 3.0), gamma(1 + 2 / 3.0) - gamma(1 + 1 / 3.0) ** 2)]:\n        g.random = x[:].pop\n        y = []\n        for i in range(len(x)):\n            try:\n                y.append(variate(*args))\n            except IndexError:\n                pass\n        s1 = s2 = 0\n        for e in y:\n            s1 += e\n            s2 += (e - mu) ** 2\n        N = len(y)\n        assert round(s1 / N - mu, 2) == 0, ('assertAlmostEqual', s1 / N, mu, '%s%r' % (variate.__name__, args))\n        assert round(s2 / (N - 1) - sigmasqrd, 2) == 0, ('assertAlmostEqual', s2 / (N - 1), sigmasqrd, '%s%r' % (variate.__name__, args))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

