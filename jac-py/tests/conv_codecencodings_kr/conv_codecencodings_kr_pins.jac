pe(result) is bytes, ('assertTrue', type(result) is bytes)\n                assert result == expected, ('assertEqual', result, expected)\n        else:\n            try:\n                func(*(source, scheme))\n            except UnicodeError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
