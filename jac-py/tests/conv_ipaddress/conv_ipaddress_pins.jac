address.ip_network('10.1.1.6/31'), ipaddress.ip_network('10.1.1.8/29'), ipaddress.ip_network('10.1.1.16/28'), ipaddress.ip_network('10.1.1.32/27'), ipaddress.ip_network('10.1.1.64/26'), ipaddress.ip_network('10.1.1.128/25')], ('assertEqual', sorted(list(addr1.address_exclude(addr6))), [ipaddress.ip_network('10.1.1.0/30'), ipaddress.ip_network('10.1.1.4/32'), ipaddress.ip_network('10.1.1.6/31'), ipaddress.ip_network('10.1.1.8/29'), ipaddress.ip_network('10.1.1.16/28'), ipaddress.ip_network('10.1.1.32/27'), ipaddress.ip_network('10.1.1.64/26'), ipaddress.ip_network('10.1.1.128/25')])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testHash" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert hash(ipaddress.ip_interface('10.1.1.0/24')) == hash(ipaddress.ip_interface('10.1.1.0/24')), ('assertEqual', hash(ipaddress.ip_interface('10.1.1.0/24')), hash(ipaddress.ip_interface('10.1.1.0/24')))\n    assert hash(ipaddress.ip_network('10.1.1.0/24')) == hash(ipaddress.ip_network('10.1.1.0/24')), ('assertEqual', hash(ipaddress.ip_network('10.1.1.0/24')), hash(ipaddress.ip_network('10.1.1.0/24')))\n    assert hash(ipaddress.ip_address('10.1.1.0')) == hash(ipaddress.ip_address('10.1.1.0')), ('assertEqual', hash(ipaddress.ip_address('10.1.1.0')), hash(ipaddress.ip_address('10.1.1.0')))\n    assert hash(ipaddress.ip_address('1.2.3.4')) == hash(ipaddress.ip_address(int(ipaddress.ip_address('1.2.3.4')._ip))), ('assertEqual', hash(ipaddress.ip_address('1.2.3.4')), hash(ipaddress.ip_address(int(ipaddress.ip_address('1.2.3.4')._ip))))\n    ip1 = ipaddress.ip_address('10.1.1.0')\n    ip2 = ipaddress.ip_address('1::')\n    dummy = {}\n    dummy[self.ipv4_address] = None\n    dummy[self.ipv6_address] = None\n    dummy[ip1] = None\n    dummy[ip2] = None\n    assert self.ipv4_address in dummy, ('assertIn', self.ipv4_address, dummy)\n    assert ip2 in dummy, ('assertIn', ip2, dummy)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

