test "IpaddrUnitTest.testFancySubnetting" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert sorted(self.ipv4_network.subnets(prefixlen_diff=3)) == sorted(self.ipv4_network.subnets(new_prefix=27)), ('assertEqual', sorted(self.ipv4_network.subnets(prefixlen_diff=3)), sorted(self.ipv4_network.subnets(new_prefix=27)))\n    try:\n        list(*(self.ipv4_network.subnets(new_prefix=23),))\n    except ValueError:\n        pass\n    try:\n        list(*(self.ipv4_network.subnets(prefixlen_diff=3, new_prefix=27),))\n    except ValueError:\n        pass\n    assert sorted(self.ipv6_network.subnets(prefixlen_diff=4)) == sorted(self.ipv6_network.subnets(new_prefix=68)), ('assertEqual', sorted(self.ipv6_network.subnets(prefixlen_diff=4)), sorted(self.ipv6_network.subnets(new_prefix=68)))\n    try:\n        list(*(self.ipv6_network.subnets(new_prefix=63),))\n    except ValueError:\n        pass\n    try:\n        list(*(self.ipv6_network.subnets(prefixlen_diff=4, new_prefix=68),))\n    except ValueError:\n        pass\n    assert sorted(self.ipv6_scoped_network.subnets(prefixlen_diff=4)) == sorted(self.ipv6_scoped_network.subnets(new_prefix=68)), ('assertEqual', sorted(self.ipv6_scoped_network.subnets(prefixlen_diff=4)), sorted(self.ipv6_scoped_network.subnets(new_prefix=68)))\n    try:\n        list(*(self.ipv6_scoped_network.subnets(new_prefix=63),))\n    except ValueError:\n        pass\n    try:\n        list(*(self.ipv6_scoped_network.subnets(prefixlen_diff=4, new_prefix=68),))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testGetSubnets" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert list(self.ipv4_network.subnets())[0].prefixlen == 25, ('assertEqual', list(self.ipv4_network.subnets())[0].prefixlen, 25)\n    assert str(list(self.ipv4_network.subnets())[0].network_address) == '1.2.3.0', ('assertEqual', str(list(self.ipv4_network.subnets())[0].network_address), '1.2.3.0')\n    assert str(list(self.ipv4_network.subnets())[1].network_address) == '1.2.3.128', ('assertEqual', str(list(self.ipv4_network.subnets())[1].network_address), '1.2.3.128')\n    assert list(self.ipv6_network.subnets())[0].prefixlen == 65, ('assertEqual', list(self.ipv6_network.subnets())[0].prefixlen, 65)\n    assert list(self.ipv6_scoped_network.subnets())[0].prefixlen == 65, ('assertEqual', list(self.ipv6_scoped_network.subnets())[0].prefixlen, 65)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

