);
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testInterfaceComparison" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert ipaddress.ip_interface('1.1.1.1/24') == ipaddress.ip_interface('1.1.1.1/24'), ('assertTrue', ipaddress.ip_interface('1.1.1.1/24') == ipaddress.ip_interface('1.1.1.1/24'))\n    assert ipaddress.ip_interface('1.1.1.1/16') < ipaddress.ip_interface('1.1.1.1/24'), ('assertTrue', ipaddress.ip_interface('1.1.1.1/16') < ipaddress.ip_interface('1.1.1.1/24'))\n    assert ipaddress.ip_interface('1.1.1.1/24') < ipaddress.ip_interface('1.1.1.2/24'), ('assertTrue', ipaddress.ip_interface('1.1.1.1/24') < ipaddress.ip_interface('1.1.1.2/24'))\n    assert ipaddress.ip_interface('1.1.1.2/16') < ipaddress.ip_interface('1.1.1.1/24'), ('assertTrue', ipaddress.ip_interface('1.1.1.2/16') < ipaddress.ip_interface('1.1.1.1/24'))\n    assert ipaddress.ip_interface('1.1.1.1/24') > ipaddress.ip_interface('1.1.1.1/16'), ('assertTrue', ipaddress.ip_interface('1.1.1.1/24') > ipaddress.ip_interface('1.1.1.1/16'))\n    assert ipaddress.ip_interface('1.1.1.2/24') > ipaddress.ip_interface('1.1.1.1/24'), ('assertTrue', ipaddress.ip_interface('1.1.1.2/24') > ipaddress.ip_interface('1.1.1.1/24'))\n    assert ipaddress.ip_interface('1.1.1.1/24') > ipaddress.ip_interface('1.1.1.2/16'), ('assertTrue', ipaddress.ip_interface('1.1.1.1/24') > ipaddress.ip_interface('1.1.1.2/16'))\n    assert ipaddress.ip_interface('::1/64') == ipaddress.ip_interface('::1/64'), ('assertTrue', ipaddress.ip_interface('::1/64') == ipaddress.ip_interface('::1/64'))\n    assert ipaddress.ip_interface('::1/64') < ipaddress.ip_interface('::1/80'), ('assertTrue', ipaddress.ip_interface('::1/64') < ipaddress.ip_interface('::1/80'))\n    assert ipaddress.ip_interface('::1/64') < ipaddress.ip_interface('::2/64'), ('assertTrue', ipaddress.ip_interface('::1/64') < ipaddress.ip_interface('::2/64'))\n    assert ipaddress.ip_interface('::2/48') < ipaddress.ip_interface('::1/64'), ('assertTrue', ipaddress.ip_interface('::2/48') < ipaddress.ip_interface('::1/64'))\n    assert ipaddress.ip_interface('::1/80') > ipaddress.ip_interface('::1/64'), ('assertTrue', ipaddress.ip_interface('::1/80') > ipaddress.ip_interface('::1/64'))\n    assert ipaddress.ip_interface('::2/64') > ipaddress.ip_interface('::1/64'), ('assertTrue', ipaddress.ip_interface('::2/64') > ipaddress.ip_interface('::1/64'))\n    assert ipaddress.ip_interface('::1/64') > ipaddress.ip_interface('::2/48'), ('assertTrue', ipaddress.ip_interface('::1/64') > ipaddress.ip_interface('::2/48'))\n    assert ipaddress.ip_interface('::1%scope/64') == ipaddress.ip_interface('::1%scope/64'), ('assertTrue', ipaddress.ip_interface('::1%scope/64') == ipaddress.ip_interface('::1%scope/64'))\n    assert ipaddress.ip_interface('::1%scope/64') < ipaddress.ip_interface('::1%scope/80'), ('assertTrue', ipaddress.ip_interface('::1%scope/64') < ipaddress.ip_interface('::1%scope/80'))\n    assert ipaddress.ip_interface('::1%scope/64') < ipaddress.ip_interface('::2%scope/64'), ('assertTrue', ipaddress.ip_interface('::1%scope/64') < ipaddress.ip_interface('::2%scope/64'))\n    assert ipaddress.ip_interface('::2%scope/48') < ipaddress.ip_interface('::1%scope/64'), ('assertTrue', ipaddress.ip_interface('::2%scope/48') < ipaddress.ip_interface('::1%scope/64'))\n    assert ipaddress.ip_interface('::1%scope/80') > ipaddress.ip_interface('::1%scope/64'), ('assertTrue', ipaddress.ip_interface('::1%scope/80') > ipaddress.ip_interface('::1%scope/64'))\n    assert ipaddress.ip_interface('::2%scope/64') > ipaddress.ip_interface('::1%scope/64'), ('assertTrue', ipaddress.ip_interface('::2%scope/64') > ipaddress.ip_interface('::1%scope/64'))\n    assert ipaddress.ip_interface('::1%scope/64') > ipaddress.ip_interface('::2%scope/48'), ('assertTrue', ipaddress.ip_interface('::1%scope/64') > ipaddress.ip_interface('::2%scope/48'))\n    assert not ipaddress.ip_interface('::1%scope/64') == ipaddress.ip_interface('::1/64'), ('assertFalse', ipaddress.ip_interface('::1%scope/64') == ipaddress.ip_interface('::1/64'))\n    assert ipaddress.ip_interface('::1%scope/64') < ipaddress.ip_interface('::1/80'), ('assertTrue', ipaddress.ip_interface('::1%scope/64') < ipaddress.ip_interface('::1/80'))\n    assert ipaddress.ip_interface('::1%scope/64') < ipaddress.ip_interface('::2/64'), ('assertTrue', ipaddress.ip_interface('::1%scope/64') < ipaddress.ip_interface('::2/64'))\n    assert ipaddress.ip_interface('::2%scope/48') < ipaddress.ip_interface('::1/64'), ('assertTrue', ipaddress.ip_interface('::2%scope/48') < ipaddress.ip_interface('::1/64'))\n    assert ipaddress.ip_interface('::1%scope/80') > ipaddress.ip_interface('::1/64'), ('assertTrue', ipaddress.ip_interface('::1%scope/80') > ipaddress.ip_interface('::1/64'))\n    assert ipaddress.ip_interface('::2%scope/64') > ipaddress.ip_interface('::1/64'), ('assertTrue', ipaddress.ip_interface('::2%scope/64') > ipaddress.ip_interface('::1/64'))\n    assert ipaddress.ip_interface('::1%scope/64') > ipaddress.ip_interface('::2/48'), ('assertTrue', ipaddress.ip_interface('::1%scope/64') > ipaddress.ip_interface('::2/48'))\n    assert not ipaddress.ip_interface('::1/64') == ipaddress.ip_interface('::1%scope/64'), ('assertFalse', ipaddress.ip_interface('::1/64') == ipaddress.ip_interface('::1%scope/64'))\n    assert ipaddress.ip_interface('::1/64') < ipaddress.ip_interface('::1%scope/80'), ('assertTrue', ipaddress.ip_interface('::1/64') < ipaddress.ip_interface('::1%scope/80'))\n    assert ipaddress.ip_interface('::1/64') < ipaddress.ip_interface('::2%scope/64'), ('assertTrue', ipaddress.ip_interface('::1/64') < ipaddress.ip_interface('::2%scope/64'))\n    assert ipaddress.ip_interface('::2/48') < ipaddress.ip_interface('::1%scope/64'), ('assertTrue', ipaddress.ip_interface('::2/48') < ipaddress.ip_interface('::1%scope/64'))\n    assert ipaddress.ip_interface('::1/80') > ipaddress.ip_interface('::1%scope/64'), ('assertTrue', ipaddress.ip_interface('::1/80') > ipaddress.ip_interface('::1%scope/64'))\n    assert ipaddress.ip_interface('::2/64') > ipaddress.ip_interface('::1%scope/64'), ('assertTrue', ipaddress.ip_interface('::2/64') > ipaddress.ip_interface('::1%scope/64'))\n    assert ipaddress.ip_interface('::1/64') > ipaddress.ip_interface('::2%scope/48'), ('assertTrue', ipaddress.ip_interface('::1/64') > ipaddress.ip_interface('::2%scope/48'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testNetworkComparison" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    ip1 = ipaddress.IPv4Network('1.1.1.0/24')\n    ip2 = ipaddress.IPv4Network('1.1.1.0/32')\n    ip3 = ipaddress.IPv4Network('1.1.2.0/24')\n    assert ip1 < ip3, ('assertTrue', ip1 < ip3)\n    assert ip3 > ip2, ('assertTrue', ip3 > ip2)\n    assert ip1.compare_networks(ip1) == 0, ('assertEqual', ip1.compare_networks(ip1), 0)\n    assert ip1.compare_networks(ip2) == -1, ('assertEqual', ip1.compare_networks(ip2), -1)\n    assert ip2.compare_networks(ip1) == 1, ('assertEqual', ip2.compare_networks(ip1), 1)\n    assert ip1.compare_networks(ip3) == -1, ('assertEqual', ip1.compare_networks(ip3), -1)\n    assert ip3.compare_networks(ip1) == 1, ('assertEqual', ip3.compare_networks(ip1), 1)\n    assert ip1._get_networks_key() < ip3._get_networks_key(), ('assertTrue', ip1._get_networks_key() < ip3._get_networks_key())\n    ip1 = ipaddress.IPv6Network('2001:2000::/96')\n    ip2 = ipaddress.IPv6Network('2001:2001::/96')\n    ip3 = ipaddress.IPv6Network('2001:ffff:2000::/96')\n    assert ip1 < ip3, ('assertTrue', ip1 < ip3)\n    assert ip3 > ip2, ('assertTrue', ip3 > ip2)\n    assert ip1.compare_networks(ip3) == -1, ('assertEqual', ip1.compare_networks(ip3), -1)\n    assert ip1._get_networks_key() < ip3._get_networks_key(), ('assertTrue', ip1._get_networks_key() < ip3._get_networks_key())\n    try:\n        self.ipv4_network.compare_networks(*(self.ipv6_network,))\n    except TypeError:\n        pass\n    ipv6 = ipaddress.IPv6Interface('::/0')\n    ipv4 = ipaddress.IPv4Interface('0.0.0.0/0')\n    try:\n        ipv4.__lt__(*(ipv6,))\n    except TypeError:\n        pass\n    try:\n        ipv4.__gt__(*(ipv6,))\n    except TypeError:\n        pass\n    try:\n        ipv6.__lt__(*(ipv4,))\n    except TypeError:\n        pass\n    try:\n        ipv6.__gt__(*(ipv4,))\n    except TypeError:\n        pass\n    ip1 = ipaddress.ip_network('10.1.2.128/25')\n    assert not ip1 < ip1, ('assertFalse', ip1 < ip1)\n    assert not ip1 > ip1, ('assertFalse', ip1 > ip1)\n    ip2 = ipaddress.ip_network('10.1.3.0/24')\n    assert ip1 < ip2, ('assertTrue', ip1 < ip2)\n    assert not ip2 < ip1, ('assertFalse', ip2 < ip1)\n    assert not ip1 > ip2, ('assertFalse', ip1 > ip2)\n    assert ip2 > ip1, ('assertTrue', ip2 > ip1)\n    ip3 = ipaddress.ip_network('10.1.3.0/25')\n    assert ip2 < ip3, ('assertTrue', ip2 < ip3)\n    assert not ip3 < ip2, ('assertFalse', ip3 < ip2)\n    assert not ip2 > ip3, ('assertFalse', ip2 > ip3)\n    assert ip3 > ip2, ('assertTrue', ip3 > ip2)\n    ip1 = ipaddress.ip_network('10.10.10.0/31')\n    ip2 = ipaddress.ip_network('10.10.10.0')\n    ip3 = ipaddress.ip_network('10.10.10.2/31')\n    ip4 = ipaddress.ip_network('10.10.10.2')\n    sorted = [ip1, ip2, ip3, ip4]\n    unsorted = [ip2, ip4, ip1, ip3]\n    unsorted.sort()\n    assert sorted == unsorted, ('assertEqual', sorted, unsorted)\n    unsorted = [ip4, ip1, ip3, ip2]\n    unsorted.sort()\n    assert sorted == unsorted, ('assertEqual', sorted, unsorted)\n    assert ip1.__lt__(ipaddress.ip_address('10.10.10.0')) is NotImplemented, ('assertIs', ip1.__lt__(ipaddress.ip_address('10.10.10.0')), NotImplemented)\n    assert ip2.__lt__(ipaddress.ip_address('10.10.10.0')) is NotImplemented, ('assertIs', ip2.__lt__(ipaddress.ip_address('10.10.10.0')), NotImplemented)\n    assert ipaddress.ip_network('1.1.1.1') <= ipaddress.ip_network('1.1.1.1'), ('assertTrue', ipaddress.ip_network('1.1.1.1') <= ipaddress.ip_network('1.1.1.1'))\n    assert ipaddress.ip_network('1.1.1.1') <= ipaddress.ip_network('1.1.1.2'), ('assertTrue', ipaddress.ip_network('1.1.1.1') <= ipaddress.ip_network('1.1.1.2'))\n    assert not ipaddress.ip_network('1.1.1.2') <= ipaddress.ip_network('1.1.1.1'), ('assertFalse', ipaddress.ip_network('1.1.1.2') <= ipaddress.ip_network('1.1.1.1'))\n    assert ipaddress.ip_network('::1') <= ipaddress.ip_network('::1'), ('assertTrue', ipaddress.ip_network('::1') <= ipaddress.ip_network('::1'))\n    assert ipaddress.ip_network('::1') <= ipaddress.ip_network('::2'), ('assertTrue', ipaddress.ip_network('::1') <= ipaddress.ip_network('::2'))\n    assert not ipaddress.ip_network('::2') <= ipaddress.ip_network('::1'), ('assertFalse', ipaddress.ip_network('::2') <= ipaddress.ip_network('::1'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testStrictNetworks" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    try:\n        ipaddress.ip_network(*('192.168.1.1/24',))\n    except ValueError:\n        pass\n    try:\n        ipaddress.ip_network(*('::1/120',))\n    except ValueError:\n        pass\n    try:\n        ipaddress.ip_network(*('::1%scope/120',))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testOverlaps" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    other = ipaddress.IPv4Network('1.2.3.0/30')\n    other2 = ipaddress.IPv4Network('1.2.2.0/24')\n    other3 = ipaddress.IPv4Network('1.2.2.64/26')\n    assert self.ipv4_network.overlaps(other), ('assertTrue', self.ipv4_network.overlaps(other))\n    assert not self.ipv4_network.overlaps(other2), ('assertFalse', self.ipv4_network.overlaps(other2))\n    assert other2.overlaps(other3), ('assertTrue', other2.overlaps(other3))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testEmbeddedIpv4" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    ipv4_string = '192.168.0.1'\n    ipv4 = ipaddress.IPv4Interface(ipv4_string)\n    v4compat_ipv6 = ipaddress.IPv6Interface('::%s' % ipv4_string)\n    assert int(v4compat_ipv6.ip) == int(ipv4.ip), ('assertEqual', int(v4compat_ipv6.ip), int(ipv4.ip))\n    v4mapped_ipv6 = ipaddress.IPv6Interface('::ffff:%s' % ipv4_string)\n    assert v4mapped_ipv6.ip != ipv4.ip, ('assertNotEqual', v4mapped_ipv6.ip, ipv4.ip)\n    try:\n        ipaddress.IPv6Interface(*('2001:1.1.1.1:1.1.1.1',))\n    except ipaddress.AddressValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testIPv6AddressTooLarge" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert ipaddress.ip_address('::FFFF:192.0.2.1') == ipaddress.ip_address('::FFFF:c000:201'), ('assertEqual', ipaddress.ip_address('::FFFF:192.0.2.1'), ipaddress.ip_address('::FFFF:c000:201'))\n    assert ipaddress.ip_address('FFFF::192.0.2.1') == ipaddress.ip_address('FFFF::c000:201'), ('assertEqual', ipaddress.ip_address('FFFF::192.0.2.1'), ipaddress.ip_address('FFFF::c000:201'))\n    assert ipaddress.ip_address('0000:0000:0000:0000:0000:FFFF:192.168.255.255') == ipaddress.ip_address('::ffff:c0a8:ffff'), ('assertEqual', ipaddress.ip_address('0000:0000:0000:0000:0000:FFFF:192.168.255.255'), ipaddress.ip_address('::ffff:c0a8:ffff'))\n    assert ipaddress.ip_address('FFFF:0000:0000:0000:0000:0000:192.168.255.255') == ipaddress.ip_address('ffff::c0a8:ffff'), ('assertEqual', ipaddress.ip_address('FFFF:0000:0000:0000:0000:0000:192.168.255.255'), ipaddress.ip_address('ffff::c0a8:ffff'))\n    assert ipaddress.ip_address('::FFFF:192.0.2.1%scope') == ipaddress.ip_address('::FFFF:c000:201%scope'), ('assertEqual', ipaddress.ip_address('::FFFF:192.0.2.1%scope'), ipaddress.ip_address('::FFFF:c000:201%scope'))\n    assert ipaddress.ip_address('FFFF::192.0.2.1%scope') == ipaddress.ip_address('FFFF::c000:201%scope'), ('assertEqual', ipaddress.ip_address('FFFF::192.0.2.1%scope'), ipaddress.ip_address('FFFF::c000:201%scope'))\n    assert ipaddress.ip_address('::FFFF:192.0.2.1%scope') != ipaddress.ip_address('::FFFF:c000:201'), ('assertNotEqual', ipaddress.ip_address('::FFFF:192.0.2.1%scope'), ipaddress.ip_address('::FFFF:c000:201'))\n    assert ipaddress.ip_address('FFFF::192.0.2.1%scope') != ipaddress.ip_address('FFFF::c000:201'), ('assertNotEqual', ipaddress.ip_address('FFFF::192.0.2.1%scope'), ipaddress.ip_address('FFFF::c000:201'))\n    assert ipaddress.ip_address('::FFFF:192.0.2.1') != ipaddress.ip_address('::FFFF:c000:201%scope'), ('assertNotEqual', ipaddress.ip_address('::FFFF:192.0.2.1'), ipaddress.ip_address('::FFFF:c000:201%scope'))\n    assert ipaddress.ip_address('FFFF::192.0.2.1') != ipaddress.ip_address('FFFF::c000:201%scope'), ('assertNotEqual', ipaddress.ip_address('FFFF::192.0.2.1'), ipaddress.ip_address('FFFF::c000:201%scope'))\n    assert ipaddress.ip_address('0000:0000:0000:0000:0000:FFFF:192.168.255.255%scope') == ipaddress.ip_address('::ffff:c0a8:ffff%scope'), ('assertEqual', ipaddress.ip_address('0000:0000:0000:0000:0000:FFFF:192.168.255.255%scope'), ipaddress.ip_address('::ffff:c0a8:ffff%scope'))\n    assert ipaddress.ip_address('FFFF:0000:0000:0000:0000:0000:192.168.255.255%scope') == ipaddress.ip_address('ffff::c0a8:ffff%scope'), ('assertEqual', ipaddress.ip_address('FFFF:0000:0000:0000:0000:0000:192.168.255.255%scope'), ipaddress.ip_address('ffff::c0a8:ffff%scope'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testIPVersion" {
