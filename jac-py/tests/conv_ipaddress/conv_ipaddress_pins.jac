ssert compressed == str(ipaddress.IPv6Interface(uncompressed)), ('assertEqual', compressed, str(ipaddress.IPv6Interface(uncompressed)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
