prefixlen, 63)\n    assert str(self.ipv6_scoped_network.supernet().network_address) == '2001:658:22a:cafe::', ('assertEqual', str(self.ipv6_scoped_network.supernet().network_address), '2001:658:22a:cafe::')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
