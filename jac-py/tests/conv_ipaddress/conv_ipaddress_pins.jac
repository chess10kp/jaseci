test "IpaddrUnitTest.testNetworkElementCaching" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert 'broadcast_address' not in self.ipv4_network.__dict__, ('assertNotIn', 'broadcast_address', self.ipv4_network.__dict__)\n    assert 'hostmask' not in self.ipv4_network.__dict__, ('assertNotIn', 'hostmask', self.ipv4_network.__dict__)\n    assert self.ipv4_network.broadcast_address == ipaddress.IPv4Address('1.2.3.255'), ('assertEqual', self.ipv4_network.broadcast_address, ipaddress.IPv4Address('1.2.3.255'))\n    assert self.ipv4_network.hostmask == ipaddress.IPv4Address('0.0.0.255'), ('assertEqual', self.ipv4_network.hostmask, ipaddress.IPv4Address('0.0.0.255'))\n    assert 'broadcast_address' in self.ipv4_network.__dict__, ('assertIn', 'broadcast_address', self.ipv4_network.__dict__)\n    assert 'hostmask' in self.ipv4_network.__dict__, ('assertIn', 'hostmask', self.ipv4_network.__dict__)\n    assert 'broadcast_address' not in self.ipv6_network.__dict__, ('assertNotIn', 'broadcast_address', self.ipv6_network.__dict__)\n    assert 'hostmask' not in self.ipv6_network.__dict__, ('assertNotIn', 'hostmask', self.ipv6_network.__dict__)\n    assert self.ipv6_network.network_address == ipaddress.IPv6Address('2001:658:22a:cafe::'), ('assertEqual', self.ipv6_network.network_address, ipaddress.IPv6Address('2001:658:22a:cafe::'))\n    assert self.ipv6_interface.network.network_address == ipaddress.IPv6Address('2001:658:22a:cafe::'), ('assertEqual', self.ipv6_interface.network.network_address, ipaddress.IPv6Address('2001:658:22a:cafe::'))\n    assert self.ipv6_network.broadcast_address == ipaddress.IPv6Address('2001:658:22a:cafe:ffff:ffff:ffff:ffff'), ('assertEqual', self.ipv6_network.broadcast_address, ipaddress.IPv6Address('2001:658:22a:cafe:ffff:ffff:ffff:ffff'))\n    assert self.ipv6_network.hostmask == ipaddress.IPv6Address('::ffff:ffff:ffff:ffff'), ('assertEqual', self.ipv6_network.hostmask, ipaddress.IPv6Address('::ffff:ffff:ffff:ffff'))\n    assert self.ipv6_interface.network.broadcast_address == ipaddress.IPv6Address('2001:658:22a:cafe:ffff:ffff:ffff:ffff'), ('assertEqual', self.ipv6_interface.network.broadcast_address, ipaddress.IPv6Address('2001:658:22a:cafe:ffff:ffff:ffff:ffff'))\n    assert self.ipv6_interface.network.hostmask == ipaddress.IPv6Address('::ffff:ffff:ffff:ffff'), ('assertEqual', self.ipv6_interface.network.hostmask, ipaddress.IPv6Address('::ffff:ffff:ffff:ffff'))\n    assert 'broadcast_address' in self.ipv6_network.__dict__, ('assertIn', 'broadcast_address', self.ipv6_network.__dict__)\n    assert 'hostmask' in self.ipv6_network.__dict__, ('assertIn', 'hostmask', self.ipv6_network.__dict__)\n    assert 'broadcast_address' in self.ipv6_interface.network.__dict__, ('assertIn', 'broadcast_address', self.ipv6_interface.network.__dict__)\n    assert 'hostmask' in self.ipv6_interface.network.__dict__, ('assertIn', 'hostmask', self.ipv6_interface.network.__dict__)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

