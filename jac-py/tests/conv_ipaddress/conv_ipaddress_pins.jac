test "IpaddrUnitTest.testEqual" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert self.ipv4_interface == ipaddress.IPv4Interface('1.2.3.4/24'), ('assertTrue', self.ipv4_interface == ipaddress.IPv4Interface('1.2.3.4/24'))\n    assert not self.ipv4_interface == ipaddress.IPv4Interface('1.2.3.4/23'), ('assertFalse', self.ipv4_interface == ipaddress.IPv4Interface('1.2.3.4/23'))\n    assert not self.ipv4_interface == ipaddress.IPv6Interface('::1.2.3.4/24'), ('assertFalse', self.ipv4_interface == ipaddress.IPv6Interface('::1.2.3.4/24'))\n    assert not self.ipv4_interface == ipaddress.IPv6Interface('::1.2.3.4%scope/24'), ('assertFalse', self.ipv4_interface == ipaddress.IPv6Interface('::1.2.3.4%scope/24'))\n    assert not self.ipv4_interface == '', ('assertFalse', self.ipv4_interface == '')\n    assert not self.ipv4_interface == [], ('assertFalse', self.ipv4_interface == [])\n    assert not self.ipv4_interface == 2, ('assertFalse', self.ipv4_interface == 2)\n    assert self.ipv6_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1/64'), ('assertTrue', self.ipv6_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1/64'))\n    assert not self.ipv6_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1/63'), ('assertFalse', self.ipv6_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1/63'))\n    assert not self.ipv6_interface == ipaddress.IPv4Interface('1.2.3.4/23'), ('assertFalse', self.ipv6_interface == ipaddress.IPv4Interface('1.2.3.4/23'))\n    assert not self.ipv6_interface == '', ('assertFalse', self.ipv6_interface == '')\n    assert not self.ipv6_interface == [], ('assertFalse', self.ipv6_interface == [])\n    assert not self.ipv6_interface == 2, ('assertFalse', self.ipv6_interface == 2)\n    assert self.ipv6_scoped_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1%scope/64'), ('assertTrue', self.ipv6_scoped_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1%scope/64'))\n    assert self.ipv6_with_ipv4_part == ipaddress.IPv6Interface('0000:0000:0000:0000:0000:0000:0102:0304'), ('assertTrue', self.ipv6_with_ipv4_part == ipaddress.IPv6Interface('0000:0000:0000:0000:0000:0000:0102:0304'))\n    assert not self.ipv6_scoped_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1%scope/63'), ('assertFalse', self.ipv6_scoped_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1%scope/63'))\n    assert not self.ipv6_scoped_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1/64'), ('assertFalse', self.ipv6_scoped_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1/64'))\n    assert not self.ipv6_scoped_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1/63'), ('assertFalse', self.ipv6_scoped_interface == ipaddress.IPv6Interface('2001:658:22a:cafe:200::1/63'))\n    assert not self.ipv6_scoped_interface == ipaddress.IPv4Interface('1.2.3.4/23'), ('assertFalse', self.ipv6_scoped_interface == ipaddress.IPv4Interface('1.2.3.4/23'))\n    assert not self.ipv6_scoped_interface == '', ('assertFalse', self.ipv6_scoped_interface == '')\n    assert not self.ipv6_scoped_interface == [], ('assertFalse', self.ipv6_scoped_interface == [])\n    assert not self.ipv6_scoped_interface == 2, ('assertFalse', self.ipv6_scoped_interface == 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
