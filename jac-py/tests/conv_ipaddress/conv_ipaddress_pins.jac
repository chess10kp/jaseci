test "IpaddrUnitTest.testPacked" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert self.ipv4_address.packed == b'\\x01\\x02\\x03\\x04', ('assertEqual', self.ipv4_address.packed, b'\\x01\\x02\\x03\\x04')\n    assert ipaddress.IPv4Interface('255.254.253.252').packed == b'\\xff\\xfe\\xfd\\xfc', ('assertEqual', ipaddress.IPv4Interface('255.254.253.252').packed, b'\\xff\\xfe\\xfd\\xfc')\n    assert self.ipv6_address.packed == b' \\x01\\x06X\\x02*\\xca\\xfe\\x02\\x00\\x00\\x00\\x00\\x00\\x00\\x01', ('assertEqual', self.ipv6_address.packed, b' \\x01\\x06X\\x02*\\xca\\xfe\\x02\\x00\\x00\\x00\\x00\\x00\\x00\\x01')\n    assert ipaddress.IPv6Interface('ffff:2:3:4:ffff::').packed == b'\\xff\\xff\\x00\\x02\\x00\\x03\\x00\\x04\\xff\\xff' + b'\\x00' * 6, ('assertEqual', ipaddress.IPv6Interface('ffff:2:3:4:ffff::').packed, b'\\xff\\xff\\x00\\x02\\x00\\x03\\x00\\x04\\xff\\xff' + b'\\x00' * 6)\n    assert ipaddress.IPv6Interface('::1:0:0:0:0').packed == b'\\x00' * 6 + b'\\x00\\x01' + b'\\x00' * 8, ('assertEqual', ipaddress.IPv6Interface('::1:0:0:0:0').packed, b'\\x00' * 6 + b'\\x00\\x01' + b'\\x00' * 8)\n    assert self.ipv6_scoped_address.packed == b' \\x01\\x06X\\x02*\\xca\\xfe\\x02\\x00\\x00\\x00\\x00\\x00\\x00\\x01', ('assertEqual', self.ipv6_scoped_address.packed, b' \\x01\\x06X\\x02*\\xca\\xfe\\x02\\x00\\x00\\x00\\x00\\x00\\x00\\x01')\n    assert ipaddress.IPv6Interface('ffff:2:3:4:ffff::%scope').packed == b'\\xff\\xff\\x00\\x02\\x00\\x03\\x00\\x04\\xff\\xff' + b'\\x00' * 6, ('assertEqual', ipaddress.IPv6Interface('ffff:2:3:4:ffff::%scope').packed, b'\\xff\\xff\\x00\\x02\\x00\\x03\\x00\\x04\\xff\\xff' + b'\\x00' * 6)\n    assert ipaddress.IPv6Interface('::1:0:0:0:0%scope').packed == b'\\x00' * 6 + b'\\x00\\x01' + b'\\x00' * 8, ('assertEqual', ipaddress.IPv6Interface('::1:0:0:0:0%scope').packed, b'\\x00' * 6 + b'\\x00\\x01' + b'\\x00' * 8)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testIpType" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    ipv4net = ipaddress.ip_network('1.2.3.4')\n    ipv4addr = ipaddress.ip_address('1.2.3.4')\n    ipv6net = ipaddress.ip_network('::1.2.3.4')\n    ipv6addr = ipaddress.ip_address('::1.2.3.4')\n    assert ipaddress.IPv4Network == type(ipv4net), ('assertEqual', ipaddress.IPv4Network, type(ipv4net))\n    assert ipaddress.IPv4Address == type(ipv4addr), ('assertEqual', ipaddress.IPv4Address, type(ipv4addr))\n    assert ipaddress.IPv6Network == type(ipv6net), ('assertEqual', ipaddress.IPv6Network, type(ipv6net))\n    assert ipaddress.IPv6Address == type(ipv6addr), ('assertEqual', ipaddress.IPv6Address, type(ipv6addr))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testReservedIpv4" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert True == ipaddress.ip_interface('224.1.1.1/31').is_multicast, ('assertEqual', True, ipaddress.ip_interface('224.1.1.1/31').is_multicast)\n    assert False == ipaddress.ip_network('240.0.0.0').is_multicast, ('assertEqual', False, ipaddress.ip_network('240.0.0.0').is_multicast)\n    assert True == ipaddress.ip_network('240.0.0.0').is_reserved, ('assertEqual', True, ipaddress.ip_network('240.0.0.0').is_reserved)\n    assert True == ipaddress.ip_interface('192.168.1.1/17').is_private, ('assertEqual', True, ipaddress.ip_interface('192.168.1.1/17').is_private)\n    assert False == ipaddress.ip_network('192.169.0.0').is_private, ('assertEqual', False, ipaddress.ip_network('192.169.0.0').is_private)\n    assert True == ipaddress.ip_network('10.255.255.255').is_private, ('assertEqual', True, ipaddress.ip_network('10.255.255.255').is_private)\n    assert False == ipaddress.ip_network('11.0.0.0').is_private, ('assertEqual', False, ipaddress.ip_network('11.0.0.0').is_private)\n    assert False == ipaddress.ip_network('11.0.0.0').is_reserved, ('assertEqual', False, ipaddress.ip_network('11.0.0.0').is_reserved)\n    assert True == ipaddress.ip_network('172.31.255.255').is_private, ('assertEqual', True, ipaddress.ip_network('172.31.255.255').is_private)\n    assert False == ipaddress.ip_network('172.32.0.0').is_private, ('assertEqual', False, ipaddress.ip_network('172.32.0.0').is_private)\n    assert True == ipaddress.ip_network('169.254.1.0/24').is_link_local, ('assertEqual', True, ipaddress.ip_network('169.254.1.0/24').is_link_local)\n    assert True == ipaddress.ip_interface('169.254.100.200/24').is_link_local, ('assertEqual', True, ipaddress.ip_interface('169.254.100.200/24').is_link_local)\n    assert False == ipaddress.ip_interface('169.255.100.200/24').is_link_local, ('assertEqual', False, ipaddress.ip_interface('169.255.100.200/24').is_link_local)\n    assert True == ipaddress.ip_network('127.100.200.254/32').is_loopback, ('assertEqual', True, ipaddress.ip_network('127.100.200.254/32').is_loopback)\n    assert True == ipaddress.ip_network('127.42.0.0/16').is_loopback, ('assertEqual', True, ipaddress.ip_network('127.42.0.0/16').is_loopback)\n    assert False == ipaddress.ip_network('128.0.0.0').is_loopback, ('assertEqual', False, ipaddress.ip_network('128.0.0.0').is_loopback)\n    assert False == ipaddress.ip_network('100.64.0.0/10').is_private, ('assertEqual', False, ipaddress.ip_network('100.64.0.0/10').is_private)\n    assert False == ipaddress.ip_network('100.64.0.0/10').is_global, ('assertEqual', False, ipaddress.ip_network('100.64.0.0/10').is_global)\n    assert True == ipaddress.ip_network('192.0.2.128/25').is_private, ('assertEqual', True, ipaddress.ip_network('192.0.2.128/25').is_private)\n    assert True == ipaddress.ip_network('192.0.3.0/24').is_global, ('assertEqual', True, ipaddress.ip_network('192.0.3.0/24').is_global)\n    assert True == ipaddress.ip_address('0.0.0.0').is_unspecified, ('assertEqual', True, ipaddress.ip_address('0.0.0.0').is_unspecified)\n    assert True == ipaddress.ip_address('224.1.1.1').is_multicast, ('assertEqual', True, ipaddress.ip_address('224.1.1.1').is_multicast)\n    assert False == ipaddress.ip_address('240.0.0.0').is_multicast, ('assertEqual', False, ipaddress.ip_address('240.0.0.0').is_multicast)\n    assert True == ipaddress.ip_address('240.0.0.1').is_reserved, ('assertEqual', True, ipaddress.ip_address('240.0.0.1').is_reserved)\n    assert False == ipaddress.ip_address('239.255.255.255').is_reserved, ('assertEqual', False, ipaddress.ip_address('239.255.255.255').is_reserved)\n    assert True == ipaddress.ip_address('192.168.1.1').is_private, ('assertEqual', True, ipaddress.ip_address('192.168.1.1').is_private)\n    assert False == ipaddress.ip_address('192.169.0.0').is_private, ('assertEqual', False, ipaddress.ip_address('192.169.0.0').is_private)\n    assert True == ipaddress.ip_address('10.255.255.255').is_private, ('assertEqual', True, ipaddress.ip_address('10.255.255.255').is_private)\n    assert False == ipaddress.ip_address('11.0.0.0').is_private, ('assertEqual', False, ipaddress.ip_address('11.0.0.0').is_private)\n    assert True == ipaddress.ip_address('172.31.255.255').is_private, ('assertEqual', True, ipaddress.ip_address('172.31.255.255').is_private)\n    assert False == ipaddress.ip_address('172.32.0.0').is_private, ('assertEqual', False, ipaddress.ip_address('172.32.0.0').is_private)\n    assert not ipaddress.ip_address('192.0.0.0').is_global, ('assertFalse', ipaddress.ip_address('192.0.0.0').is_global)\n    assert ipaddress.ip_address('192.0.0.9').is_global, ('assertTrue', ipaddress.ip_address('192.0.0.9').is_global)\n    assert ipaddress.ip_address('192.0.0.10').is_global, ('assertTrue', ipaddress.ip_address('192.0.0.10').is_global)\n    assert not ipaddress.ip_address('192.0.0.255').is_global, ('assertFalse', ipaddress.ip_address('192.0.0.255').is_global)\n    assert True == ipaddress.ip_address('169.254.100.200').is_link_local, ('assertEqual', True, ipaddress.ip_address('169.254.100.200').is_link_local)\n    assert False == ipaddress.ip_address('169.255.100.200').is_link_local, ('assertEqual', False, ipaddress.ip_address('169.255.100.200').is_link_local)\n    assert ipaddress.ip_address('192.0.7.1').is_global, ('assertTrue', ipaddress.ip_address('192.0.7.1').is_global)\n    assert not ipaddress.ip_address('203.0.113.1').is_global, ('assertFalse', ipaddress.ip_address('203.0.113.1').is_global)\n    assert True == ipaddress.ip_address('127.100.200.254').is_loopback, ('assertEqual', True, ipaddress.ip_address('127.100.200.254').is_loopback)\n    assert True == ipaddress.ip_address('127.42.0.0').is_loopback, ('assertEqual', True, ipaddress.ip_address('127.42.0.0').is_loopback)\n    assert False == ipaddress.ip_address('128.0.0.0').is_loopback, ('assertEqual', False, ipaddress.ip_address('128.0.0.0').is_loopback)\n    assert True == ipaddress.ip_network('0.0.0.0').is_unspecified, ('assertEqual', True, ipaddress.ip_network('0.0.0.0').is_unspecified)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testPrivateNetworks" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert False == ipaddress.ip_network('0.0.0.0/0').is_private, ('assertEqual', False, ipaddress.ip_network('0.0.0.0/0').is_private)\n    assert False == ipaddress.ip_network('1.0.0.0/8').is_private, ('assertEqual', False, ipaddress.ip_network('1.0.0.0/8').is_private)\n    assert True == ipaddress.ip_network('0.0.0.0/8').is_private, ('assertEqual', True, ipaddress.ip_network('0.0.0.0/8').is_private)\n    assert True == ipaddress.ip_network('10.0.0.0/8').is_private, ('assertEqual', True, ipaddress.ip_network('10.0.0.0/8').is_private)\n    assert True == ipaddress.ip_network('127.0.0.0/8').is_private, ('assertEqual', True, ipaddress.ip_network('127.0.0.0/8').is_private)\n    assert True == ipaddress.ip_network('169.254.0.0/16').is_private, ('assertEqual', True, ipaddress.ip_network('169.254.0.0/16').is_private)\n    assert True == ipaddress.ip_network('172.16.0.0/12').is_private, ('assertEqual', True, ipaddress.ip_network('172.16.0.0/12').is_private)\n    assert True == ipaddress.ip_network('192.0.0.0/29').is_private, ('assertEqual', True, ipaddress.ip_network('192.0.0.0/29').is_private)\n    assert False == ipaddress.ip_network('192.0.0.9/32').is_private, ('assertEqual', False, ipaddress.ip_network('192.0.0.9/32').is_private)\n    assert True == ipaddress.ip_network('192.0.0.170/31').is_private, ('assertEqual', True, ipaddress.ip_network('192.0.0.170/31').is_private)\n    assert True == ipaddress.ip_network('192.0.2.0/24').is_private, ('assertEqual', True, ipaddress.ip_network('192.0.2.0/24').is_private)\n    assert True == ipaddress.ip_network('192.168.0.0/16').is_private, ('assertEqual', True, ipaddress.ip_network('192.168.0.0/16').is_private)\n    assert True == ipaddress.ip_network('198.18.0.0/15').is_private, ('assertEqual', True, ipaddress.ip_network('198.18.0.0/15').is_private)\n    assert True == ipaddress.ip_network('198.51.100.0/24').is_private, ('assertEqual', True, ipaddress.ip_network('198.51.100.0/24').is_private)\n    assert True == ipaddress.ip_network('203.0.113.0/24').is_private, ('assertEqual', True, ipaddress.ip_network('203.0.113.0/24').is_private)\n    assert True == ipaddress.ip_network('240.0.0.0/4').is_private, ('assertEqual', True, ipaddress.ip_network('240.0.0.0/4').is_private)\n    assert True == ipaddress.ip_network('255.255.255.255/32').is_private, ('assertEqual', True, ipaddress.ip_network('255.255.255.255/32').is_private)\n    assert False == ipaddress.ip_network('::/0').is_private, ('assertEqual', False, ipaddress.ip_network('::/0').is_private)\n    assert False == ipaddress.ip_network('::ff/128').is_private, ('assertEqual', False, ipaddress.ip_network('::ff/128').is_private)\n    assert True == ipaddress.ip_network('::1/128').is_private, ('assertEqual', True, ipaddress.ip_network('::1/128').is_private)\n    assert True == ipaddress.ip_network('::/128').is_private, ('assertEqual', True, ipaddress.ip_network('::/128').is_private)\n    assert True == ipaddress.ip_network('::ffff:0:0/96').is_private, ('assertEqual', True, ipaddress.ip_network('::ffff:0:0/96').is_private)\n    assert True == ipaddress.ip_network('100::/64').is_private, ('assertEqual', True, ipaddress.ip_network('100::/64').is_private)\n    assert True == ipaddress.ip_network('2001:2::/48').is_private, ('assertEqual', True, ipaddress.ip_network('2001:2::/48').is_private)\n    assert False == ipaddress.ip_network('2001:3::/48').is_private, ('assertEqual', False, ipaddress.ip_network('2001:3::/48').is_private)\n    assert True == ipaddress.ip_network('2001:db8::/32').is_private, ('assertEqual', True, ipaddress.ip_network('2001:db8::/32').is_private)\n    assert True == ipaddress.ip_network('2001:10::/28').is_private, ('assertEqual', True, ipaddress.ip_network('2001:10::/28').is_private)\n    assert True == ipaddress.ip_network('fc00::/7').is_private, ('assertEqual', True, ipaddress.ip_network('fc00::/7').is_private)\n    assert True == ipaddress.ip_network('fe80::/10').is_private, ('assertEqual', True, ipaddress.ip_network('fe80::/10').is_private)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testReservedIpv6" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert True == ipaddress.ip_network('ffff::').is_multicast, ('assertEqual', True, ipaddress.ip_network('ffff::').is_multicast)\n    assert True == ipaddress.ip_network(2 ** 128 - 1).is_multicast, ('assertEqual', True, ipaddress.ip_network(2 ** 128 - 1).is_multicast)\n    assert True == ipaddress.ip_network('ff00::').is_multicast, ('assertEqual', True, ipaddress.ip_network('ff00::').is_multicast)\n    assert False == ipaddress.ip_network('fdff::').is_multicast, ('assertEqual', False, ipaddress.ip_network('fdff::').is_multicast)\n    assert True == ipaddress.ip_network('fecf::').is_site_local, ('assertEqual', True, ipaddress.ip_network('fecf::').is_site_local)\n    assert True == ipaddress.ip_network('feff:ffff:ffff:ffff::').is_site_local, ('assertEqual', True, ipaddress.ip_network('feff:ffff:ffff:ffff::').is_site_local)\n    assert False == ipaddress.ip_network('fbf:ffff::').is_site_local, ('assertEqual', False, ipaddress.ip_network('fbf:ffff::').is_site_local)\n    assert False == ipaddress.ip_network('ff00::').is_site_local, ('assertEqual', False, ipaddress.ip_network('ff00::').is_site_local)\n    assert True == ipaddress.ip_network('fc00::').is_private, ('assertEqual', True, ipaddress.ip_network('fc00::').is_private)\n    assert True == ipaddress.ip_network('fc00:ffff:ffff:ffff::').is_private, ('assertEqual', True, ipaddress.ip_network('fc00:ffff:ffff:ffff::').is_private)\n    assert False == ipaddress.ip_network('fbff:ffff::').is_private, ('assertEqual', False, ipaddress.ip_network('fbff:ffff::').is_private)\n    assert False == ipaddress.ip_network('fe00::').is_private, ('assertEqual', False, ipaddress.ip_network('fe00::').is_private)\n    assert True == ipaddress.ip_network('fea0::').is_link_local, ('assertEqual', True, ipaddress.ip_network('fea0::').is_link_local)\n    assert True == ipaddress.ip_network('febf:ffff::').is_link_local, ('assertEqual', True, ipaddress.ip_network('febf:ffff::').is_link_local)\n    assert False == ipaddress.ip_network('fe7f:ffff::').is_link_local, ('assertEqual', False, ipaddress.ip_network('fe7f:ffff::').is_link_local)\n    assert False == ipaddress.ip_network('fec0::').is_link_local, ('assertEqual', False, ipaddress.ip_network('fec0::').is_link_local)\n    assert True == ipaddress.ip_interface('0:0::0:01').is_loopback, ('assertEqual', True, ipaddress.ip_interface('0:0::0:01').is_loopback)\n    assert False == ipaddress.ip_interface('::1/127').is_loopback, ('assertEqual', False, ipaddress.ip_interface('::1/127').is_loopback)\n    assert False == ipaddress.ip_network('::').is_loopback, ('assertEqual', False, ipaddress.ip_network('::').is_loopback)\n    assert False == ipaddress.ip_network('::2').is_loopback, ('assertEqual', False, ipaddress.ip_network('::2').is_loopback)\n    assert True == ipaddress.ip_network('0::0').is_unspecified, ('assertEqual', True, ipaddress.ip_network('0::0').is_unspecified)\n    assert False == ipaddress.ip_network('::1').is_unspecified, ('assertEqual', False, ipaddress.ip_network('::1').is_unspecified)\n    assert False == ipaddress.ip_network('::/127').is_unspecified, ('assertEqual', False, ipaddress.ip_network('::/127').is_unspecified)\n    assert True == ipaddress.ip_network('2001::1/128').is_private, ('assertEqual', True, ipaddress.ip_network('2001::1/128').is_private)\n    assert True == ipaddress.ip_network('200::1/128').is_global, ('assertEqual', True, ipaddress.ip_network('200::1/128').is_global)\n    assert True == ipaddress.ip_address('ffff::').is_multicast, ('assertEqual', True, ipaddress.ip_address('ffff::').is_multicast)\n    assert True == ipaddress.ip_address(2 ** 128 - 1).is_multicast, ('assertEqual', True, ipaddress.ip_address(2 ** 128 - 1).is_multicast)\n    assert True == ipaddress.ip_address('ff00::').is_multicast, ('assertEqual', True, ipaddress.ip_address('ff00::').is_multicast)\n    assert False == ipaddress.ip_address('fdff::').is_multicast, ('assertEqual', False, ipaddress.ip_address('fdff::').is_multicast)\n    assert True == ipaddress.ip_address('fecf::').is_site_local, ('assertEqual', True, ipaddress.ip_address('fecf::').is_site_local)\n    assert True == ipaddress.ip_address('feff:ffff:ffff:ffff::').is_site_local, ('assertEqual', True, ipaddress.ip_address('feff:ffff:ffff:ffff::').is_site_local)\n    assert False == ipaddress.ip_address('fbf:ffff::').is_site_local, ('assertEqual', False, ipaddress.ip_address('fbf:ffff::').is_site_local)\n    assert False == ipaddress.ip_address('ff00::').is_site_local, ('assertEqual', False, ipaddress.ip_address('ff00::').is_site_local)\n    assert True == ipaddress.ip_address('fc00::').is_private, ('assertEqual', True, ipaddress.ip_address('fc00::').is_private)\n    assert True == ipaddress.ip_address('fc00:ffff:ffff:ffff::').is_private, ('assertEqual', True, ipaddress.ip_address('fc00:ffff:ffff:ffff::').is_private)\n    assert False == ipaddress.ip_address('fbff:ffff::').is_private, ('assertEqual', False, ipaddress.ip_address('fbff:ffff::').is_private)\n    assert False == ipaddress.ip_address('fe00::').is_private, ('assertEqual', False, ipaddress.ip_address('fe00::').is_private)\n    assert True == ipaddress.ip_address('fea0::').is_link_local, ('assertEqual', True, ipaddress.ip_address('fea0::').is_link_local)\n    assert True == ipaddress.ip_address('febf:ffff::').is_link_local, ('assertEqual', True, ipaddress.ip_address('febf:ffff::').is_link_local)\n    assert False == ipaddress.ip_address('fe7f:ffff::').is_link_local, ('assertEqual', False, ipaddress.ip_address('fe7f:ffff::').is_link_local)\n    assert False == ipaddress.ip_address('fec0::').is_link_local, ('assertEqual', False, ipaddress.ip_address('fec0::').is_link_local)\n    assert True == ipaddress.ip_address('0:0::0:01').is_loopback, ('assertEqual', True, ipaddress.ip_address('0:0::0:01').is_loopback)\n    assert True == ipaddress.ip_address('::1').is_loopback, ('assertEqual', True, ipaddress.ip_address('::1').is_loopback)\n    assert False == ipaddress.ip_address('::2').is_loopback, ('assertEqual', False, ipaddress.ip_address('::2').is_loopback)\n    assert True == ipaddress.ip_address('0::0').is_unspecified, ('assertEqual', True, ipaddress.ip_address('0::0').is_unspecified)\n    assert False == ipaddress.ip_address('::1').is_unspecified, ('assertEqual', False, ipaddress.ip_address('::1').is_unspecified)\n    assert not ipaddress.ip_address('64:ff9b:1::').is_global, ('assertFalse', ipaddress.ip_address('64:ff9b:1::').is_global)\n    assert not ipaddress.ip_address('2001::').is_global, ('assertFalse', ipaddress.ip_address('2001::').is_global)\n    assert ipaddress.ip_address('2001:1::1').is_global, ('assertTrue', ipaddress.ip_address('2001:1::1').is_global)\n    assert ipaddress.ip_address('2001:1::2').is_global, ('assertTrue', ipaddress.ip_address('2001:1::2').is_global)\n    assert not ipaddress.ip_address('2001:2::').is_global, ('assertFalse', ipaddress.ip_address('2001:2::').is_global)\n    assert ipaddress.ip_address('2001:3::').is_global, ('assertTrue', ipaddress.ip_address('2001:3::').is_global)\n    assert not ipaddress.ip_address('2001:4::').is_global, ('assertFalse', ipaddress.ip_address('2001:4::').is_global)\n    assert ipaddress.ip_address('2001:4:112::').is_global, ('assertTrue', ipaddress.ip_address('2001:4:112::').is_global)\n    assert not ipaddress.ip_address('2001:10::').is_global, ('assertFalse', ipaddress.ip_address('2001:10::').is_global)\n    assert ipaddress.ip_address('2001:20::').is_global, ('assertTrue', ipaddress.ip_address('2001:20::').is_global)\n    assert ipaddress.ip_address('2001:30::').is_global, ('assertTrue', ipaddress.ip_address('2001:30::').is_global)\n    assert not ipaddress.ip_address('2001:40::').is_global, ('assertFalse', ipaddress.ip_address('2001:40::').is_global)\n    assert not ipaddress.ip_address('2002::').is_global, ('assertFalse', ipaddress.ip_address('2002::').is_global)\n    assert not ipaddress.ip_address('3fff::').is_global, ('assertFalse', ipaddress.ip_address('3fff::').is_global)\n    assert True == ipaddress.ip_address('100::').is_reserved, ('assertEqual', True, ipaddress.ip_address('100::').is_reserved)\n    assert True == ipaddress.ip_network('4000::1/128').is_reserved, ('assertEqual', True, ipaddress.ip_network('4000::1/128').is_reserved)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
