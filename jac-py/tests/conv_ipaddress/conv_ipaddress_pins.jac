twork((ip, 24))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        ipaddress.IPv4Network((3221225985, 24))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        ipaddress.IPv4Network(('192.0.2.1', '255.255.255.0'))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        ipaddress.IPv4Network((ip, '255.255.255.0'))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        ipaddress.IPv4Network((3221225985, '255.255.255.0'))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    net = ipaddress.IPv4Network('192.0.2.0/24')\n    assert ipaddress.IPv4Network(('192.0.2.1', 24), strict=False) == net, ('assertEqual', ipaddress.IPv4Network(('192.0.2.1', 24), strict=False), net)\n    assert ipaddress.IPv4Network((ip, 24), strict=False) == net, ('assertEqual', ipaddress.IPv4Network((ip, 24), strict=False), net)\n    assert ipaddress.IPv4Network((3221225985, 24), strict=False) == net, ('assertEqual', ipaddress.IPv4Network((3221225985, 24), strict=False), net)\n    assert ipaddress.IPv4Network(('192.0.2.1', '255.255.255.0'), strict=False) == net, ('assertEqual', ipaddress.IPv4Network(('192.0.2.1', '255.255.255.0'), strict=False), net)\n    assert ipaddress.IPv4Network((ip, '255.255.255.0'), strict=False) == net, ('assertEqual', ipaddress.IPv4Network((ip, '255.255.255.0'), strict=False), net)\n    assert ipaddress.IPv4Network((3221225985, '255.255.255.0'), strict=False) == net, ('assertEqual', ipaddress.IPv4Network((3221225985, '255.255.255.0'), strict=False), net)\n    ip = ipaddress.IPv4Address('192.0.2.0')\n    net = ipaddress.IPv4Network('192.0.2.0/24')\n    assert ipaddress.IPv4Network(('192.0.2.0', '255.255.255.0')) == net, ('assertEqual', ipaddress.IPv4Network(('192.0.2.0', '255.255.255.0')), net)\n    assert ipaddress.IPv4Network((ip, '255.255.255.0')) == net, ('assertEqual', ipaddress.IPv4Network((ip, '255.255.255.0')), net)\n    assert ipaddress.IPv4Network((3221225984, '255.255.255.0')) == net, ('assertEqual', ipaddress.IPv4Network((3221225984, '255.255.255.0')), net)\n    assert ipaddress.IPv4Network(('192.0.2.0', 24)) == net, ('assertEqual', ipaddress.IPv4Network(('192.0.2.0', 24)), net)\n    assert ipaddress.IPv4Network((ip, 24)) == net, ('assertEqual', ipaddress.IPv4Network((ip, 24)), net)\n    assert ipaddress.IPv4Network((3221225984, 24)) == net, ('assertEqual', ipaddress.IPv4Network((3221225984, 24)), net)\n    assert ipaddress.IPv4Interface(('192.0.2.1', 24)) == ipaddress.IPv4Interface('192.0.2.1/24'), ('assertEqual', ipaddress.IPv4Interface(('192.0.2.1', 24)), ipaddress.IPv4Interface('192.0.2.1/24'))\n    assert ipaddress.IPv4Interface((3221225985, 24)) == ipaddress.IPv4Interface('192.0.2.1/24'), ('assertEqual', ipaddress.IPv4Interface((3221225985, 24)), ipaddress.IPv4Interface('192.0.2.1/24'))\n    try:\n        ipaddress.IPv4Network(('192.0.2.1', '255.255.255.255.0'))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        ipaddress.ip_network(('192.0.2.1', '255.255.255.255.0'))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
