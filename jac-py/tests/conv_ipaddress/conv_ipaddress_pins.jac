test "IpaddrUnitTest.testGetNum_Addresses" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert self.ipv4_network.num_addresses == 256, ('assertEqual', self.ipv4_network.num_addresses, 256)\n    assert list(self.ipv4_network.subnets())[0].num_addresses == 128, ('assertEqual', list(self.ipv4_network.subnets())[0].num_addresses, 128)\n    assert self.ipv4_network.supernet().num_addresses == 512, ('assertEqual', self.ipv4_network.supernet().num_addresses, 512)\n    assert self.ipv6_network.num_addresses == 18446744073709551616, ('assertEqual', self.ipv6_network.num_addresses, 18446744073709551616)\n    assert list(self.ipv6_network.subnets())[0].num_addresses == 9223372036854775808, ('assertEqual', list(self.ipv6_network.subnets())[0].num_addresses, 9223372036854775808)\n    assert self.ipv6_network.supernet().num_addresses == 36893488147419103232, ('assertEqual', self.ipv6_network.supernet().num_addresses, 36893488147419103232)\n    assert self.ipv6_scoped_network.num_addresses == 18446744073709551616, ('assertEqual', self.ipv6_scoped_network.num_addresses, 18446744073709551616)\n    assert list(self.ipv6_scoped_network.subnets())[0].num_addresses == 9223372036854775808, ('assertEqual', list(self.ipv6_scoped_network.subnets())[0].num_addresses, 9223372036854775808)\n    assert self.ipv6_scoped_network.supernet().num_addresses == 36893488147419103232, ('assertEqual', self.ipv6_scoped_network.supernet().num_addresses, 36893488147419103232)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testContains" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert ipaddress.IPv4Interface('1.2.3.128/25') in self.ipv4_network, ('assertIn', ipaddress.IPv4Interface('1.2.3.128/25'), self.ipv4_network)\n    assert ipaddress.IPv4Interface('1.2.4.1/24') not in self.ipv4_network, ('assertNotIn', ipaddress.IPv4Interface('1.2.4.1/24'), self.ipv4_network)\n    addr1 = ipaddress.IPv4Address('1.2.3.37')\n    assert addr1 in self.ipv4_network, ('assertIn', addr1, self.ipv4_network)\n    assert not ipaddress.IPv4Network('1.1.0.0/16').__contains__(ipaddress.IPv4Network('1.0.0.0/15')), ('assertFalse', ipaddress.IPv4Network('1.1.0.0/16').__contains__(ipaddress.IPv4Network('1.0.0.0/15')))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testNth" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert str(self.ipv4_network[5]) == '1.2.3.5', ('assertEqual', str(self.ipv4_network[5]), '1.2.3.5')\n    try:\n        self.ipv4_network.__getitem__(*(256,))\n    except IndexError:\n        pass\n    assert str(self.ipv6_network[5]) == '2001:658:22a:cafe::5', ('assertEqual', str(self.ipv6_network[5]), '2001:658:22a:cafe::5')\n    try:\n        self.ipv6_network.__getitem__(*(1 << 64,))\n    except IndexError:\n        pass\n    assert str(self.ipv6_scoped_network[5]) == '2001:658:22a:cafe::5', ('assertEqual', str(self.ipv6_scoped_network[5]), '2001:658:22a:cafe::5')\n    try:\n        self.ipv6_scoped_network.__getitem__(*(1 << 64,))\n    except IndexError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

