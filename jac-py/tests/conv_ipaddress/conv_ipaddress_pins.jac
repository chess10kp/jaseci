address), '2001:658:22a:cafe::%scope')\n    assert str(self.ipv6_scoped_network.hostmask) == '::ffff:ffff:ffff:ffff', ('assertEqual', str(self.ipv6_scoped_network.hostmask), '::ffff:ffff:ffff:ffff')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
