test "IpaddrUnitTest.testGetSupernet4" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    try:\n        self.ipv4_network.supernet(prefixlen_diff=2, new_prefix=1)\n    except ValueError:\n        pass\n    try:\n        self.ipv4_network.supernet(new_prefix=25)\n    except ValueError:\n        pass\n    assert self.ipv4_network.supernet(prefixlen_diff=2) == self.ipv4_network.supernet(new_prefix=22), ('assertEqual', self.ipv4_network.supernet(prefixlen_diff=2), self.ipv4_network.supernet(new_prefix=22))\n    try:\n        self.ipv6_network.supernet(prefixlen_diff=2, new_prefix=1)\n    except ValueError:\n        pass\n    try:\n        self.ipv6_network.supernet(new_prefix=65)\n    except ValueError:\n        pass\n    assert self.ipv6_network.supernet(prefixlen_diff=2) == self.ipv6_network.supernet(new_prefix=62), ('assertEqual', self.ipv6_network.supernet(prefixlen_diff=2), self.ipv6_network.supernet(new_prefix=62))\n    try:\n        self.ipv6_scoped_network.supernet(prefixlen_diff=2, new_prefix=1)\n    except ValueError:\n        pass\n    try:\n        self.ipv6_scoped_network.supernet(new_prefix=65)\n    except ValueError:\n        pass\n    assert self.ipv6_scoped_network.supernet(prefixlen_diff=2) == self.ipv6_scoped_network.supernet(new_prefix=62), ('assertEqual', self.ipv6_scoped_network.supernet(prefixlen_diff=2), self.ipv6_scoped_network.supernet(new_prefix=62))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testHosts" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\nfrom collections.abc import Iterator\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    hosts = self.ipv4_network.hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert ipaddress.IPv4Address('1.2.3.1') == next(hosts), ('assertEqual', ipaddress.IPv4Address('1.2.3.1'), next(hosts))\n    hosts = list(self.ipv4_network.hosts())\n    assert 254 == len(hosts), ('assertEqual', 254, len(hosts))\n    assert ipaddress.IPv4Address('1.2.3.1') == hosts[0], ('assertEqual', ipaddress.IPv4Address('1.2.3.1'), hosts[0])\n    assert ipaddress.IPv4Address('1.2.3.254') == hosts[-1], ('assertEqual', ipaddress.IPv4Address('1.2.3.254'), hosts[-1])\n    ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/120')\n    hosts = ipv6_network.hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert ipaddress.IPv6Address('2001:658:22a:cafe::1') == next(hosts), ('assertEqual', ipaddress.IPv6Address('2001:658:22a:cafe::1'), next(hosts))\n    hosts = list(ipv6_network.hosts())\n    assert 255 == len(hosts), ('assertEqual', 255, len(hosts))\n    assert ipaddress.IPv6Address('2001:658:22a:cafe::1') == hosts[0], ('assertEqual', ipaddress.IPv6Address('2001:658:22a:cafe::1'), hosts[0])\n    assert ipaddress.IPv6Address('2001:658:22a:cafe::ff') == hosts[-1], ('assertEqual', ipaddress.IPv6Address('2001:658:22a:cafe::ff'), hosts[-1])\n    ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/120')\n    hosts = ipv6_scoped_network.hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert ipaddress.IPv6Address('2001:658:22a:cafe::1') == next(hosts), ('assertEqual', ipaddress.IPv6Address('2001:658:22a:cafe::1'), next(hosts))\n    hosts = list(ipv6_scoped_network.hosts())\n    assert 255 == len(hosts), ('assertEqual', 255, len(hosts))\n    assert ipaddress.IPv6Address('2001:658:22a:cafe::1') == hosts[0], ('assertEqual', ipaddress.IPv6Address('2001:658:22a:cafe::1'), hosts[0])\n    assert ipaddress.IPv6Address('2001:658:22a:cafe::ff') == hosts[-1], ('assertEqual', ipaddress.IPv6Address('2001:658:22a:cafe::ff'), hosts[-1])\n    addrs = [ipaddress.IPv4Address('2.0.0.0'), ipaddress.IPv4Address('2.0.0.1')]\n    str_args = '2.0.0.0/31'\n    tpl_args = ('2.0.0.0', 31)\n    hosts = ipaddress.ip_network(str_args).hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert next(hosts) == addrs[0], ('assertEqual', next(hosts), addrs[0])\n    hosts = ipaddress.ip_network(tpl_args).hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert next(hosts) == addrs[0], ('assertEqual', next(hosts), addrs[0])\n    assert addrs == list(ipaddress.ip_network(str_args).hosts()), ('assertEqual', addrs, list(ipaddress.ip_network(str_args).hosts()))\n    assert addrs == list(ipaddress.ip_network(tpl_args).hosts()), ('assertEqual', addrs, list(ipaddress.ip_network(tpl_args).hosts()))\n    assert list(ipaddress.ip_network(str_args).hosts()) == list(ipaddress.ip_network(tpl_args).hosts()), ('assertEqual', list(ipaddress.ip_network(str_args).hosts()), list(ipaddress.ip_network(tpl_args).hosts()))\n    addrs = [ipaddress.IPv4Address('1.2.3.4')]\n    str_args = '1.2.3.4/32'\n    tpl_args = ('1.2.3.4', 32)\n    hosts = ipaddress.ip_network(str_args).hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert next(hosts) == addrs[0], ('assertEqual', next(hosts), addrs[0])\n    hosts = ipaddress.ip_network(tpl_args).hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert next(hosts) == addrs[0], ('assertEqual', next(hosts), addrs[0])\n    assert addrs == list(ipaddress.ip_network(str_args).hosts()), ('assertEqual', addrs, list(ipaddress.ip_network(str_args).hosts()))\n    assert addrs == list(ipaddress.ip_network(tpl_args).hosts()), ('assertEqual', addrs, list(ipaddress.ip_network(tpl_args).hosts()))\n    assert list(ipaddress.ip_network(str_args).hosts()) == list(ipaddress.ip_network(tpl_args).hosts()), ('assertEqual', list(ipaddress.ip_network(str_args).hosts()), list(ipaddress.ip_network(tpl_args).hosts()))\n    addrs = [ipaddress.IPv6Address('2001:658:22a:cafe::'), ipaddress.IPv6Address('2001:658:22a:cafe::1')]\n    str_args = '2001:658:22a:cafe::/127'\n    tpl_args = ('2001:658:22a:cafe::', 127)\n    hosts = ipaddress.ip_network(str_args).hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert next(hosts) == addrs[0], ('assertEqual', next(hosts), addrs[0])\n    hosts = ipaddress.ip_network(tpl_args).hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert next(hosts) == addrs[0], ('assertEqual', next(hosts), addrs[0])\n    assert addrs == list(ipaddress.ip_network(str_args).hosts()), ('assertEqual', addrs, list(ipaddress.ip_network(str_args).hosts()))\n    assert addrs == list(ipaddress.ip_network(tpl_args).hosts()), ('assertEqual', addrs, list(ipaddress.ip_network(tpl_args).hosts()))\n    assert list(ipaddress.ip_network(str_args).hosts()) == list(ipaddress.ip_network(tpl_args).hosts()), ('assertEqual', list(ipaddress.ip_network(str_args).hosts()), list(ipaddress.ip_network(tpl_args).hosts()))\n    addrs = [ipaddress.IPv6Address('2001:658:22a:cafe::1')]\n    str_args = '2001:658:22a:cafe::1/128'\n    tpl_args = ('2001:658:22a:cafe::1', 128)\n    hosts = ipaddress.ip_network(str_args).hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert next(hosts) == addrs[0], ('assertEqual', next(hosts), addrs[0])\n    hosts = ipaddress.ip_network(tpl_args).hosts()\n    assert isinstance(hosts, Iterator), ('assertIsInstance', hosts, Iterator)\n    assert next(hosts) == addrs[0], ('assertEqual', next(hosts), addrs[0])\n    assert addrs == list(ipaddress.ip_network(str_args).hosts()), ('assertEqual', addrs, list(ipaddress.ip_network(str_args).hosts()))\n    assert addrs == list(ipaddress.ip_network(tpl_args).hosts()), ('assertEqual', addrs, list(ipaddress.ip_network(tpl_args).hosts()))\n    assert list(ipaddress.ip_network(str_args).hosts()) == list(ipaddress.ip_network(tpl_args).hosts()), ('assertEqual', list(ipaddress.ip_network(str_args).hosts()), list(ipaddress.ip_network(tpl_args).hosts()))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
