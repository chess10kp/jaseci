test "IpaddrUnitTest.testIpFromInt" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert self.ipv4_interface._ip == ipaddress.IPv4Interface(16909060)._ip, ('assertEqual', self.ipv4_interface._ip, ipaddress.IPv4Interface(16909060)._ip)\n    ipv4 = ipaddress.ip_network('1.2.3.4')\n    ipv6 = ipaddress.ip_network('2001:658:22a:cafe:200:0:0:1')\n    ipv6_scoped = ipaddress.ip_network('2001:658:22a:cafe:200:0:0:1%scope')\n    assert ipv4 == ipaddress.ip_network(int(ipv4.network_address)), ('assertEqual', ipv4, ipaddress.ip_network(int(ipv4.network_address)))\n    assert ipv6 == ipaddress.ip_network(int(ipv6.network_address)), ('assertEqual', ipv6, ipaddress.ip_network(int(ipv6.network_address)))\n    assert ipv6_scoped != ipaddress.ip_network(int(ipv6_scoped.network_address)), ('assertNotEqual', ipv6_scoped, ipaddress.ip_network(int(ipv6_scoped.network_address)))\n    v6_int = 42540616829182469433547762482097946625\n    assert self.ipv6_interface._ip == ipaddress.IPv6Interface(v6_int)._ip, ('assertEqual', self.ipv6_interface._ip, ipaddress.IPv6Interface(v6_int)._ip)\n    assert self.ipv6_scoped_interface._ip == ipaddress.IPv6Interface(v6_int)._ip, ('assertEqual', self.ipv6_scoped_interface._ip, ipaddress.IPv6Interface(v6_int)._ip)\n    assert ipaddress.ip_network(self.ipv4_address._ip).version == 4, ('assertEqual', ipaddress.ip_network(self.ipv4_address._ip).version, 4)\n    assert ipaddress.ip_network(self.ipv6_address._ip).version == 6, ('assertEqual', ipaddress.ip_network(self.ipv6_address._ip).version, 6)\n    assert ipaddress.ip_network(self.ipv6_scoped_address._ip).version == 6, ('assertEqual', ipaddress.ip_network(self.ipv6_scoped_address._ip).version, 6)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

