test "IpaddrUnitTest.testIpv4Mapped" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    assert ipaddress.ip_address('::ffff:192.168.1.1').ipv4_mapped == ipaddress.ip_address('192.168.1.1'), ('assertEqual', ipaddress.ip_address('::ffff:192.168.1.1').ipv4_mapped, ipaddress.ip_address('192.168.1.1'))\n    assert ipaddress.ip_address('::c0a8:101').ipv4_mapped == None, ('assertEqual', ipaddress.ip_address('::c0a8:101').ipv4_mapped, None)\n    assert ipaddress.ip_address('::ffff:c0a8:101').ipv4_mapped == ipaddress.ip_address('192.168.1.1'), ('assertEqual', ipaddress.ip_address('::ffff:c0a8:101').ipv4_mapped, ipaddress.ip_address('192.168.1.1'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IpaddrUnitTest.testIpv4MappedProperties" {
    (ok, detail) = p2_libtest_run_snippet("import ipaddress\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.ipv4_address = ipaddress.IPv4Address('1.2.3.4')\n    self.ipv4_interface = ipaddress.IPv4Interface('1.2.3.4/24')\n    self.ipv4_network = ipaddress.IPv4Network('1.2.3.0/24')\n    self.ipv6_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1')\n    self.ipv6_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1/64')\n    self.ipv6_network = ipaddress.IPv6Network('2001:658:22a:cafe::/64')\n    self.ipv6_scoped_address = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope')\n    self.ipv6_scoped_interface = ipaddress.IPv6Interface('2001:658:22a:cafe:200:0:0:1%scope/64')\n    self.ipv6_scoped_network = ipaddress.IPv6Network('2001:658:22a:cafe::%scope/64')\n    self.ipv6_with_ipv4_part = ipaddress.IPv6Interface('::1.2.3.4')\n    for addr4 in ('178.62.3.251', '169.254.169.254', '127.0.0.1', '224.0.0.1', '192.168.0.1', '0.0.0.0', '100.64.0.1'):\n        ipv4 = ipaddress.IPv4Address(addr4)\n        ipv6 = ipaddress.IPv6Address(f'::ffff:{addr4}')\n        assert ipv4.is_global == ipv6.is_global, ('assertEqual', ipv4.is_global, ipv6.is_global)\n        assert ipv4.is_private == ipv6.is_private, ('assertEqual', ipv4.is_private, ipv6.is_private)\n        assert ipv4.is_reserved == ipv6.is_reserved, ('assertEqual', ipv4.is_reserved, ipv6.is_reserved)\n        assert ipv4.is_multicast == ipv6.is_multicast, ('assertEqual', ipv4.is_multicast, ipv6.is_multicast)\n        assert ipv4.is_unspecified == ipv6.is_unspecified, ('assertEqual', ipv4.is_unspecified, ipv6.is_unspecified)\n        assert ipv4.is_link_local == ipv6.is_link_local, ('assertEqual', ipv4.is_link_local, ipv6.is_link_local)\n        assert ipv4.is_loopback == ipv6.is_loopback, ('assertEqual', ipv4.is_loopback, ipv6.is_loopback)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

