1:0:operator:/root:\\n', b'games:x:12:100:games:/usr/games:\\n', b'gopher:x:13:30:gopher:/usr/lib/gopher-data:\\n', b'ftp:x:14:50:FTP User:/var/ftp:/bin/bash\\n', b'nobody:x:65534:65534:Nobody:/home:\\n', b'postfix:x:100:101:postfix:/var/spool/postfix:\\n', b'niemeyer:x:500:500::/home/niemeyer:/bin/bash\\n', b'postgres:x:101:102:PostgreSQL Server:/var/lib/pgsql:/bin/bash\\n', b'mysql:x:102:103:MySQL server:/var/lib/mysql:/bin/bash\\n', b'www:x:103:104::/var/www:/bin/false\\n']\n    _SelfNS.TEXT_LINES = [b'root:x:0:0:root:/root:/bin/bash\\n', b'bin:x:1:1:bin:/bin:\\n', b'daemon:x:2:2:daemon:/sbin:\\n', b'adm:x:3:4:adm:/var/adm:\\n', b'lp:x:4:7:lp:/var/spool/lpd:\\n', b'sync:x:5:0:sync:/sbin:/bin/sync\\n', b'shutdown:x:6:0:shutdown:/sbin:/sbin/shutdown\\n', b'halt:x:7:0:halt:/sbin:/sbin/halt\\n', b'mail:x:8:12:mail:/var/spool/mail:\\n', b'news:x:9:13:news:/var/spool/news:\\n', b'uucp:x:10:14:uucp:/var/spool/uucp:\\n', b'operator:x:11:0:operator:/root:\\n', b'games:x:12:100:games:/usr/games:\\n', b'gopher:x:13:30:gopher:/usr/lib/gopher-data:\\n', b'ftp:x:14:50:FTP User:/var/ftp:/bin/bash\\n', b'nobody:x:65534:65534:Nobody:/home:\\n', b'postfix:x:100:101:postfix:/var/spool/postfix:\\n', b'niemeyer:x:500:500::/home/niemeyer:/bin/bash\\n', b'postgres:x:101:102:PostgreSQL Server:/var/lib/pgsql:/bin/bash\\n', b'mysql:x:102:103:MySQL server:/var/lib/mysql:/bin/bash\\n', b'www:x:103:104::/var/www:/bin/false\\n']\n    self.bz2_block_magic = bytes.fromhex('314159265359')\n    _SelfNS.bz2_block_magic = bytes.fromhex('314159265359')\n    self.compressor = BZ2Compressor(1)\n    _SelfNS.compressor = BZ2Compressor(1)\n    self.test_size = 0\n    _SelfNS.test_size = 0\n    self.TEXT = b''.join(_SelfNS.TEXT_LINES)\n    _SelfNS.TEXT = b''.join(_SelfNS.TEXT_LINES)\n    fd, self.filename = tempfile.mkstemp()\n    os.close(fd)\n    with BZ2File(self.filename, 'wb') as f:\n        f.write(b'content')\n        assert f.name == self.filename, ('assertEqual', f.name, self.filename)\n        assert isinstance(f.fileno(), int), ('assertIsInstance', f.fileno(), int)\n        assert f.mode == 'wb', ('assertEqual', f.mode, 'wb')\n        assert f.readable() is False, ('assertIs', f.readable(), False)\n        assert f.writable() is True, ('assertIs', f.writable(), True)\n        assert f.seekable() is False, ('assertIs', f.seekable(), False)\n        assert f.closed is False, ('assertIs', f.closed, False)\n    assert f.closed is True, ('assertIs', f.closed, True)\n    try:\n        f.name\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        f.fileno()\n    except ValueError:\n        pass\n    assert f.mode == 'wb', ('assertEqual', f.mode, 'wb')\n    try:\n        f.readable()\n    except ValueError:\n        pass\n    try:\n        f.writable()\n    except ValueError:\n        pass\n    try:\n        f.seekable()\n    except ValueError:\n        pass\n    with BZ2File(self.filename, 'ab') as f:\n        f.write(b'appendix')\n        assert f.name == self.filename, ('assertEqual', f.name, self.filename)\n        assert isinstance(f.fileno(), int), ('assertIsInstance', f.fileno(), int)\n        assert f.mode == 'wb', ('assertEqual', f.mode, 'wb')\n        assert f.readable() is False, ('assertIs', f.readable(), False)\n        assert f.writable() is True, ('assertIs', f.writable(), True)\n        assert f.seekable() is False, ('assertIs', f.seekable(), False)\n        assert f.closed is False, ('assertIs', f.closed, False)\n    assert f.closed is True, ('assertIs', f.closed, True)\n    try:\n        f.name\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        f.fileno()\n    except ValueError:\n        pass\n    assert f.mode == 'wb', ('assertEqual', f.mode, 'wb')\n    try:\n        f.readable()\n    except ValueError:\n        pass\n    try:\n        f.writable()\n    except ValueError:\n        pass\n    try:\n        f.seekable()\n    except ValueError:\n        pass\n    with BZ2File(self.filename, 'rb') as f:\n        assert f.read() == b'contentappendix', ('assertEqual', f.read(), b'contentappendix')\n        assert f.name == self.filename, ('assertEqual', f.name, self.filename)\n        assert isinstance(f.fileno(), int), ('assertIsInstance', f.fileno(), int)\n        assert f.mode == 'rb', ('assertEqual', f.mode, 'rb')\n        assert f.readable() is True, ('assertIs', f.readable(), True)\n        assert f.writable() is False, ('assertIs', f.writable(), False)\n        assert f.seekable() is True, ('assertIs', f.seekable(), True)\n        assert f.closed is False, ('assertIs', f.closed, False)\n    assert f.closed is True, ('assertIs', f.closed, True)\n    try:\n        f.name\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        f.fileno()\n    except ValueError:\n        pass\n    assert f.mode == 'rb', ('assertEqual', f.mode, 'rb')\n    try:\n        f.readable()\n    except ValueError:\n        pass\n    try:\n        f.writable()\n    except ValueError:\n        pass\n    try:\n        f.seekable()\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

