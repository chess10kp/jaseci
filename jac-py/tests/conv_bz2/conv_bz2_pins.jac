test "BZ2CompressorTest.testCompress" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport tempfile\nimport shutil\nimport subprocess\nfrom test.support import import_helper\nbz2 = import_helper.import_module('bz2')\nfrom bz2 import BZ2File, BZ2Compressor, BZ2Decompressor\nhas_cmdline_bunzip2 = None\n\ndef ext_decompress(data):\n    global has_cmdline_bunzip2\n    if has_cmdline_bunzip2 is None:\n        has_cmdline_bunzip2 = bool(shutil.which('bunzip2'))\n    if has_cmdline_bunzip2:\n        return subprocess.check_output(['bunzip2'], input=data)\n    else:\n        return bz2.decompress(data)\n\ndef _t():\n\n    def setUp():\n        fd, self.filename = tempfile.mkstemp()\n        os.close(fd)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.BAD_DATA = b'this is not a valid bzip2 file'\n    _SelfNS.BAD_DATA = b'this is not a valid bzip2 file'\n    self.BIG_DATA = b''\n    _SelfNS.BIG_DATA = b''\n    self.BIG_TEXT = b''\n    _SelfNS.BIG_TEXT = b''\n    self.DATA = b'BZh91AY&SY.\\xc8N\\x18\\x00\\x01>_\\x80\\x00\\x10@\\x02\\xff\\xf0\\x01\\x07n\\x00?\\xe7\\xff\\xe00\\x01\\x99\\xaa\\x00\\xc0\\x03F\\x86\\x8c#&\\x83F\\x9a\\x03\\x06\\xa6\\xd0\\xa6\\x93M\\x0fQ\\xa7\\xa8\\x06\\x804hh\\x12$\\x11\\xa4i4\\xf14S\\xd2<Q\\xb5\\x0fH\\xd3\\xd4\\xdd\\xd5\\x87\\xbb\\xf8\\x94\\r\\x8f\\xafI\\x12\\xe1\\xc9\\xf8/E\\x00pu\\x89\\x12]\\xc9\\xbbDL\\nQ\\x0e\\t1\\x12\\xdf\\xa0\\xc0\\x97\\xac2O9\\x89\\x13\\x94\\x0e\\x1c7\\x0ed\\x95I\\x0c\\xaaJ\\xa4\\x18L\\x10\\x05#\\x9c\\xaf\\xba\\xbc/\\x97\\x8a#C\\xc8\\xe1\\x8cW\\xf9\\xe2\\xd0\\xd6M\\xa7\\x8bXa<e\\x84t\\xcbL\\xb3\\xa7\\xd9\\xcd\\xd1\\xcb\\x84.\\xaf\\xb3\\xab\\xab\\xad`n}\\xa0lh\\tE,\\x8eZ\\x15\\x17VH>\\x88\\xe5\\xcd9gd6\\x0b\\n\\xe9\\x9b\\xd5\\x8a\\x99\\xf7\\x08.K\\x8ev\\xfb\\xf7xw\\xbb\\xdf\\xa1\\x92\\xf1\\xdd|/\";\\xa2\\xba\\x9f\\xd5\\xb1#A\\xb6\\xf6\\xb3o\\xc9\\xc5y\\\\\\xebO\\xe7\\x85\\x9a\\xbc\\xb6f8\\x952\\xd5\\xd7\"%\\x89>V,\\xf7\\xa6z\\xe2\\x9f\\xa3\\xdf\\x11\\x11\"\\xd6E)I\\xa9\\x13^\\xca\\xf3r\\xd0\\x03U\\x922\\xf26\\xec\\xb6\\xed\\x8b\\xc3U\\x