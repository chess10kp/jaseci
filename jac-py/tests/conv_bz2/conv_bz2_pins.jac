test "BZ2FileTest.testOpenPathLikeFilename" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport tempfile\nfrom test.support.os_helper import unlink, FakePath\nfrom bz2 import BZ2File, BZ2Compressor, BZ2Decompressor\n\ndef _t():\n\n    def setUp():\n        fd, self.filename = tempfile.mkstemp()\n        os.close(fd)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.BAD_DATA = b'this is not a valid bzip2 file'\n    _SelfNS.BAD_DATA = b'this is not a valid bzip2 file'\n    self.BIG_DATA = b''\n    _SelfNS.BIG_DATA = b''\n    self.BIG_TEXT = b''\n    _SelfNS.BIG_TEXT = b''\n    self.DATA = b'BZh91AY&SY.\\xc8N\\x18\\x00\\x01>_\\x80\\x00\\x10@\\x02\\xff\\xf0\\x01\\x07n\\x00?\\xe7\\xff\\xe00\\x01\\x99\\xaa\\x00\\xc0\\x03F\\x86\\x8c#&\\x83F\\x9a\\x03\\x06\\xa6\\xd0\\xa6\\x93M\\x0fQ\\xa7\\xa8\\x06\\x804hh\\x12$\\x11\\xa4i4\\xf14S\\xd2<Q\\xb5\\x0fH\\xd3\\xd4\\xdd\\xd5\\x87\\xbb\\xf8\\x94\\r\\x8f\\xafI\\x12\\xe1\\xc9\\xf8/E\\x00pu\\x89\\x12]\\xc9\\xbbDL\\nQ\\x0e\\t1\\x12\\xdf\\xa0\\xc0\\x97\\xac2O9\\x89\\x13\\x94\\x0e\\x1c7\\x0ed\\x95I\\x0c\\xaaJ\\xa4\\x18L\\x10\\x05#\\x9c\\xaf\\xba\\xbc/\\x97\\x8a#C\\xc8\\xe1\\x8cW\\xf9\\xe2\\xd0\\xd6M\\xa7\\x8bXa<e\\x84t\\xcbL\\xb3\\xa7\\xd9\\xcd\\xd1\\xcb\\x84.\\xaf\\xb3\\xab\\xab\\xad`n}\\xa0lh\\tE,\\x8eZ\\x15\\x17VH>\\x88\\xe5\\xcd9gd6\\x0b\\n\\xe9\\x9b\\xd5\\x8a\\x99\\xf7\\x08.K\\x8ev\\xfb\\xf7xw\\xbb\\xdf\\xa1\\x92\\xf1\\xdd|/\";\\xa2\\xba\\x9f\\xd5\\xb1#A\\xb6\\xf6\\xb3o\\xc9\\xc5y\\\\\\xebO\\xe7\\x85\\x9a\\xbc\\xb6f8\\x952\\xd5\\xd7\"%\\x89>V,\\xf7\\xa6z\\xe2\\x9f\\xa3\\xdf\\x11\\x11\"\\xd6E)I\\xa9\\x13^\\xca\\xf3r\\xd0\\x03U\\x922\\xf26\\xec\\xb6\\xed\\x8b\\xc3U\\x13\\x9d\\xc5\\x170\\xa4\\xfa^\\x92\\xacDF\\x8a\\x97\\xd6\\x19\\xfe\\xdd\\xb8\\xbd\\x1a\\x9a\\x19\\xa3\\x80ankR\\x8b\\xe5\\xd83]\\xa9\\xc6\\x08\\x82f\\xf6\\xb9\"6l$\\xb8j@\\xc0\\x8a\\xb0l1..\\xbak\\x83ls\\x15\\xbc\\xf4\\xc1\\x13\\xbe\\xf8E\\xb8\\x9d\\r\\xa8\\x9dk\\x84\\xd3n\\xfa\\xacQ\\x07\\xb1%y\\xaav\\xb4\\x08\\xe0z\\x1b\\x16\\xf5\\x04\\xe9\\xcc\\xb9\\x08z\\x1en7.G\\xfc]\\xc9\\x14\\xe1B@\\xbb!8`'\n    _SelfNS.DATA = b'BZh91AY&SY.\\xc8N\\x18\\x00\\x01>_\\x80\\x00\\x10@\\x02\\xff\\xf0\\x01\\x07n\\x00?\\xe7\\xff\\xe00\\x01\\x99\\xaa\\x00\\xc0\\x03F\\x86\\x8c#&\\x83F\\x9a\\x03\\x06\\xa6\\xd0\\xa6\\x93M\\x0fQ\\xa7\\xa8\\x06\\x804hh\\x12$\\x11\\xa4i4\\xf14S\\xd2<Q\\xb5\\x0fH\\xd3\\xd4\\xdd\\xd5\\x87\\xbb\\xf8\\x94\\r\\x8f\\xafI\\x12\\xe1\\xc9\\xf8/E\\x00pu\\x89\\x12]\\xc9\\xbbDL\\nQ\\x0e\\t1\\x12\\xdf\\xa0\\xc0\\x97\\xac2O9\\x89\\x13\\x94\\x0e\\x1c7\\x0ed\\x95I\\x0c\\xaaJ\\xa4\\x18L\\x10\\x05#\\x9c\\xaf\\xba\\xbc/\\x97\\x8a#C\\xc8\\xe1\\x8cW\\xf9\\xe2\\xd0\\xd6M\\xa7\\x8bXa<e\\x84t\\xcbL\\xb3\\xa7\\xd9\\xcd\\xd1\\xcb\\x84.\\xaf\\xb3\\xab\\xab\\xad`n}\\xa0lh\\tE,\\x8eZ\\x15\\x17VH>\\x88\\xe5\\xcd9gd6\\x0b\\n\\xe9\\x9b\\xd5\\x8a\\x99\\xf7\\x08.K\\x8ev\\xfb\\xf7xw\\xbb\\xdf\\xa1\\x92\\xf1\\xdd|/\";\\xa2\\xba\\x9f\\xd5\\xb1#A\\xb6\\xf6\\xb3o\\xc9\\xc5y\\\\\\xebO\\xe7\\x85\\x9a\\xbc\\xb6f8\\x952\\xd5\\xd7\"%\\x89>V,\\xf7\\xa6z\\xe2\\x9f\\xa3\\xdf\\x11\\x11\"\\xd6E)I\\xa9\\x13^\\xca\\xf3r\\xd0\\x03U\\x922\\xf26\\xec\\xb6\\xed\\x8b\\xc3U\\x13\\x9d\\xc5\\x170\\xa4\\xfa^\\x92\\xacDF\\x8a\\x97\\xd6\\x19\\xfe\\xdd\\xb8\\xbd\\x1a\\x9a\\x19\\xa3\\x80ankR\\x8b\\xe5\\xd83]\\xa9\\xc6\\x08\\x82f\\xf6\\xb9\"6l$\\xb8j@\\xc0\\x8a\\xb0l1..\\xbak\\x83ls\\x15\\xbc\\xf4\\xc1\\x13\\xbe\\xf8E\\xb8\\x9d\\r\\xa8\\x9dk\\x84\\xd3n\\xfa\\xacQ\\x07\\xb1%y\\xaav\\xb4\\x08\\xe0z\\x1b\\x16\\xf5\\x04\\xe9\\xcc\\xb9\\x08z\\x1en7.G\\xfc]\\xc9\\x14\\xe1B@\\xbb!8`'\n    self.EMPTY_DATA = b'BZh9\\x17rE8P\\x90\\x00\\x00\\x00\\x00'\n    _SelfNS.EMPTY_DATA = b'BZh9\\x17rE8P\\x90\\x00\\x00\\x00\\x00'\n    self.TEXT_LINES = [b'root:x:0:0:root:/root:/bin/bash\\n', b'bin:x:1:1:bin:/bin:\\n', b'daemon:x:2:2:daemon:/sbin:\\n', b'adm:x:3:4:adm:/var/adm:\\n', b'lp:x:4:7:lp:/var/spool/lpd:\\n', b'sync:x:5:0:sync:/sbin:/bin/sync\\n', b'shutdown:x:6:0:shutdown:/sbin:/sbin/shutdown\\n', b'halt:x:7:0:halt:/sbin:/sbin/halt\\n', b'mail:x:8:12:mail:/var/spool/mail:\\n', b'news:x:9:13:news:/var/spool/news:\\n', b'uucp:x:10:14:uucp:/var/spool/uucp:\\n', b'operator:x:11:0:operator:/root:\\n', b'games:x:12:100:games:/usr/games:\\n', b'gopher:x:13:30:gopher:/usr/lib/gopher-data:\\n', b'ftp:x:14:50:FTP User:/var/ftp:/bin/bash\\n', b'nobody:x:65534:65534:Nobody:/home:\\n', b'postfix:x:100:101:postfix:/var/spool/postfix:\\n', b'niemeyer:x:500:500::/home/niemeyer:/bin/bash\\n', b'postgres:x:101:102:PostgreSQL Server:/var/lib/pgsql:/bin/bash\\n', b'mysql:x:102:103:MySQL server:/var/lib/mysql:/bin/bash\\n', b'www:x:103:104::/var/www:/bin/false\\n']\n    _SelfNS.TEXT_LINES = [b'root:x:0:0:root:/root:/bin/bash\\n', b'bin:x:1:1:bin:/bin:\\n', b'daemon:x:2:2:daemon:/sbin:\\n', b'adm:x:3:4:adm:/var/adm:\\n', b'lp:x:4:7:lp:/var/spool/lpd:\\n', b'sync:x:5:0:sync:/sbin:/bin/sync\\n', b'shutdown:x:6:0:shutdown:/sbin:/sbin/shutdown\\n', b'halt:x:7:0:halt:/sbin:/sbin/halt\\n', b'mail:x:8:12:mail:/var/spool/mail:\\n', b'news:x:9:13:news:/var/spool/news:\\n', b'uucp:x:10:14:uucp:/var/spool/uucp:\\n', b'operator:x:11:0:operator:/root:\\n', b'games:x:12:100:games:/usr/games:\\n', b'gopher:x:13:30:gopher:/usr/lib/gopher-data:\\n', b'ftp:x:14:50:FTP User:/var/ftp:/bin/bash\\n', b'nobody:x:65534:65534:Nobody:/home:\\n', b'postfix:x:100:101:postfix:/var/spool/postfix:\\n', b'niemeyer:x:500:500::/home/niemeyer:/bin/bash\\n', b'postgres:x:101:102:PostgreSQL Server:/var/lib/pgsql:/bin/bash\\n', b'mysql:x:102:103:MySQL server:/var/lib/mysql:/bin/bash\\n', b'www:x:103:104::/var/www:/bin/false\\n']\n    self.bz2_block_magic = bytes.fromhex('314159265359')\n    _SelfNS.bz2_block_magic = bytes.fromhex('314159265359')\n    self.compressor = BZ2Compressor(1)\n    _SelfNS.compressor = BZ2Compressor(1)\n    self.test_size = 0\n    _SelfNS.test_size = 0\n    self.TEXT = b''.join(_SelfNS.TEXT_LINES)\n    _SelfNS.TEXT = b''.join(_SelfNS.TEXT_LINES)\n    fd, self.filename = tempfile.mkstemp()\n    os.close(fd)\n    filename = FakePath(self.filename)\n    with BZ2File(filename, 'wb') as f:\n        f.write(self.DATA)\n        assert f.name == self.filename, ('assertEqual', f.name, self.filename)\n    with BZ2File(filename, 'rb') as f:\n        assert f.read() == self.DATA, ('assertEqual', f.read(), self.DATA)\n        assert f.name == self.filename, ('assertEqual', f.name, self.filename)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "BZ2FileTest.testDecompressLimited" {
    (ok, detail) = p2_libtest_run_snippet("from io import BytesIO, DEFAULT_BUFFER_SIZE\nimport os\nimport tempfile\nfrom test.support import import_helper\nfrom compression._common import _streams\nbz2 = import_helper.import_module('bz2')\nfrom bz2 import BZ2File, BZ2Compressor, BZ2Decompressor\n\ndef _t():\n\n    def setUp():\n        fd, self.filename = tempfile.mkstemp()\n        os.close(fd)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.BAD_DATA = b'this is not a valid bzip2 file'\n    _SelfNS.BAD_DATA = b'this is not a valid bzip2 file'\n    self.BIG_DATA = b''\n    _SelfNS.BIG_DATA = b''\n    self.BIG_TEXT = b''\n    _SelfNS.BIG_TEXT = b''\n    self.DATA = b'BZh91AY&SY.\\xc8N\\x18\\x00\\x01>_\\x80\\x00\\x10@\\x02\\xff\\xf0\\x01\\x07n\\x00?\\xe7\\xff\\xe00\\x01\\x99\\xaa\\x00\\xc0\\x03F\\x86\\x8c#&\\x83F\\x9a\\x03\\x06\\xa6\\xd0\\xa6\\x93M\\x0fQ\\xa7\\xa8\\x06\\x804hh\\x12$\\x11\\xa4i4\\xf14S\\xd2<Q\\xb5\\x0fH\\xd3\\xd4\\xdd\\xd5\\x87\\xbb\\xf8\\x94\\r\\x8f\\xafI\\x12\\xe1\\xc9\\xf8/E\\x00pu\\x89\\x12]\\xc9\\xbbDL\\nQ\\x0e\\t1\\x12\\xdf\\xa0\\xc0\\x97\\xac2O9\\x89\\x13\\x94\\x0e\\x1c7\\x0ed\\x95I\\x0c\\xaaJ\\xa4\\x18L\\x10\\x05#\\x9c\\xaf\\xba\\xbc/\\x97\\x8a#C\\xc8\\xe1\\x8cW\\xf9\\xe2\\xd0\\xd6M\\xa7\\x8bXa<e\\x84t\\xcbL\\xb3\\xa7\\xd9\\xcd\\xd1\\xcb\\x84.\\xaf\\xb3\\xab\\xab\\xad`n}\\xa0lh\\tE,\\x8eZ\\x15\\x17VH>\\x88\\xe5\\xcd9gd6\\x0b\\n\\xe9\\x9b\\xd5\\x8a\\x99\\xf7\\x08.K\\x8ev\\xfb\\xf7xw\\xbb\\xdf\\xa1\\x92\\xf1\\xdd|/\";\\xa2\\xba\\x9f\\xd5\\xb1#A\\xb6\\xf6\\xb3o\\xc9\\xc5y\\\\\\xebO\\xe7\\x85\\x9a\\xbc\\xb6f8\\x952\\xd5\\xd7\"%\\x89>V,\\xf7\\xa6z\\xe2\\x9f\\xa3\\xdf\\x11\\x11\"\\xd6E)I\\xa9\\x13^\\xca\\xf3r\\xd0\\x03U\\x922\\xf26\\xec\\xb6\\xed\\x8b\\xc3U\\x13\\x9d\\xc5\\x170\\xa4\\xfa^\\x92\\xacDF\\x8a\\x97\\xd6\\x19\\xfe\\xdd\\xb8\\xbd\\x1a\\x9a\\x19\\xa3\\x80ankR\\x8b\\xe5\\xd83]\\xa9\\xc6\\x08\\x82f\\xf6\\xb9\"6l$\\xb8j@\\xc0\\x8a\\xb0l1..\\xbak\\x83ls\\x15\\xbc\\xf4\\xc1\\x13\\xbe\\xf8E\\xb8\\x9d\\r\\xa8\\x9dk\\x84\\xd3n\\xfa\\xacQ\\x07\\xb1%y\\xaav\\xb4\\x08\\xe0z\\x1b\\x16\\xf5\\x04\\xe9\\xcc\\xb9\\x08z\\x1en7.G\\xfc]\\xc9\\x14\\xe1B@\\xbb!8`'\n    _SelfNS.DATA = b'BZh91AY&SY.\\xc8N\\x18\\x00\\x01>_\\x80\\x00\\x10@\\x02\\xff\\xf0\\x01\\x07n\\x00?\\xe7\\xff\\xe00\\x01\\x99\\xaa\\x00\\xc0\\x03F\\x86\\x8c#&\\x83F\\x9a\\x03\\x06\\xa6\\xd0\\xa6\\x93M\\x0fQ\\xa7\\xa8\\x06\\x804hh\\x12$\\x11\\xa4i4\\xf14S\\xd2<Q\\xb5\\x0fH\\xd3\\xd4\\xdd\\xd5\\x87\\xbb\\xf8\\x94\\r\\x8f\\xafI\\x12\\xe1\\xc9\\xf8/E\\x00pu\\x89\\x12]\\xc9\\xbbDL\\nQ\\x0e\\t1\\x12\\xdf\\xa0\\xc0\\x97\\xac2O9\\x89\\x13\\x94\\x0e\\x1c7\\x0ed\\x95I\\x0c\\xaaJ\\xa4\\x18L\\x10\\x05#\\x9c\\xaf\\xba\\xbc/\\x97\\x8a#C\\xc8\\xe1\\x8cW\\xf9\\xe2\\xd0\\xd6M\\xa7\\x8bXa<e\\x84t\\xcbL\\xb3\\xa7\\xd9\\xcd\\xd1\\xcb\\x84.\\xaf\\xb3\\xab\\xab\\xad`n}\\xa0lh\\tE,\\x8eZ\\x15\\x17VH>\\x88\\xe5\\xcd9gd6\\x0b\\n\\xe9\\x9b\\xd5\\x8a\\x99\\xf7\\x08.K\\x8ev\\xfb\\xf7xw\\xbb\\xdf\\xa1\\x92\\xf1\\xdd|/\";\\xa2\\xba\\x9f\\xd5\\xb1#A\\xb6\\xf6\\xb3o\\xc9\\xc5y\\\\\\xebO\\xe7\\x85\\x9a\\xbc\\xb6f8\\x952\\xd5\\xd7\"%\\x89>V,\\xf7\\xa6z\\xe2\\x9f\\xa3\\xdf\\x11\\x11\"\\xd6E)I\\xa9\\x13^\\xca\\xf3r\\xd0\\x03U\\x922\\xf26\\xec\\xb6\\xed\\x8b\\xc3U\\x13\\x9d\\xc5\\x170\\xa4\\xfa^\\x92\\xacDF\\x8a\\x97\\xd6\\x19\\xfe\\xdd\\xb8\\xbd\\x1a\\x9a\\x19\\xa3\\x80ankR\\x8b\\xe5\\xd83]\\xa9\\xc6\\x08\\x82f\\xf6\\xb9\"6l$\\xb8j@\\xc0\\x8a\\xb0l1..\\xbak\\x83ls\\x15\\xbc\\xf4\\xc1\\x13\\xbe\\xf8E\\xb8\\x9d\\r\\xa8\\x9dk\\x84\\xd3n\\xfa\\xacQ\\x07\\xb1%y\\xaav\\xb4\\x08\\xe0z\\x1b\\x16\\xf5\\x04\\xe9\\xcc\\xb9\\x08z\\x1en7.G\\xfc]\\xc9\\x14\\xe1B@\\xbb!8`'\n    self.EMPTY_DATA = b'BZh9\\x17rE8P\\x90\\x00\\x00\\x00\\x00'\n    _SelfNS.EMPTY_DATA = b'BZh9\\x17rE8P\\x90\\x00\\x00\\x00\\x00'\n    self.TEXT_LINES = [b'root:x:0:0:root:/root:/bin/bash\\n', b'bin:x:1:1:bin:/bin:\\n', b'daemon:x:2:2:daemon:/sbin:\\n', b'adm:x:3:4:adm:/var/adm:\\n', b'lp:x:4:7:lp:/var/spool/lpd:\\n', b'sync:x:5:0:sync:/sbin:/bin/sync\\n', b'shutdown:x:6:0:shutdown:/sbin:/sbin/shutdown\\n', b'halt:x:7:0:halt:/sbin:/sbin/halt\\n', b'mail:x:8:12:mail:/var/spool/mail:\\n', b'news:x:9:13:news:/var/spool/news:\\n', b'uucp:x:10:14:uucp:/var/spool/uucp:\\n', b'operator:x:11:0:operator:/root:\\n', b'games:x:12:100:games:/usr/games:\\n', b'gopher:x:13:30:gopher:/usr/lib/gopher-data:\\n', b'ftp:x:14:50:FTP User:/var/ftp:/bin/bash\\n', b'nobody:x:65534:65534:Nobody:/home:\\n', b'postfix:x:100:101:postfix:/var/spool/postfix:\\n', b'niemeyer:x:500:500::/home/niemeyer:/bin/bash\\n', b'postgres:x:101:102:PostgreSQL Server:/var/lib/pgsql:/bin/bash\\n', b'mysql:x:102:103:MySQL server:/var/lib/mysql:/bin/bash\\n', b'www:x:103:104::/var/www:/bin/false\\n']\n    _SelfNS.TEXT_LINES = [b'root:x:0:0:root:/root:/bin/bash\\n', b'bin:x:1:1:bin:/bin:\\n', b'daemon:x:2:2:daemon:/sbin:\\n', b'adm:x:3:4:adm:/var/adm:\\n', b'lp:x:4:7:lp:/var/spool/lpd:\\n', b'sync:x:5:0:sync:/sbin:/bin/sync\\n', b'shutdown:x:6:0:shutdown:/sbin:/sbin/shutdown\\n', b'halt:x:7:0:halt:/sbin:/sbin/halt\\n', b'mail:x:8:12:mail:/var/spool/mail:\\n', b'news:x:9:13:news:/var/spool/news:\\n', b'uucp:x:10:14:uucp:/var/spool/uucp:\\n', b'operator:x:11:0:operator:/root:\\n', b'games:x:12:100:games:/usr/games:\\n', b'gopher:x:13:30:gopher:/usr/lib/gopher-data:\\n', b'ftp:x:14:50:FTP User:/var/ftp:/bin/bash\\n', b'nobody:x:65534:65534:Nobody:/home:\\n', b'postfix:x:100:101:postfix:/var/spool/postfix:\\n', b'niemeyer:x:500:500::/home/niemeyer:/bin/bash\\n', b'postgres:x:101:102:PostgreSQL Server:/var/lib/pgsql:/bin/bash\\n', b'mysql:x:102:103:MySQL server:/var/lib/mysql:/bin/bash\\n', b'www:x:103:104::/var/www:/bin/false\\n']\n    self.bz2_block_magic = bytes.fromhex('314159265359')\n    _SelfNS.bz2_block_magic = bytes.fromhex('314159265359')\n    self.compressor = BZ2Compressor(1)\n    _SelfNS.compressor = BZ2Compressor(1)\n    self.test_size = 0\n    _SelfNS.test_size = 0\n    self.TEXT = b''.join(_SelfNS.TEXT_LINES)\n    _SelfNS.TEXT = b''.join(_SelfNS.TEXT_LINES)\n    fd, self.filename = tempfile.mkstemp()\n    os.close(fd)\n    'Decompressed data buffering should be limited'\n    bomb = bz2.compress(b'\\x00' * int(2000000.0), compresslevel=9)\n    assert len(bomb) < _streams.BUFFER_SIZE, ('assertLess', len(bomb), _streams.BUFFER_SIZE)\n    decomp = BZ2File(BytesIO(bomb))\n    assert decomp.read(1) == b'\\x00', ('assertEqual', decomp.read(1), b'\\x00')\n    max_decomp = 1 + DEFAULT_BUFFER_SIZE\n    assert decomp._buffer.raw.tell() <= max_decomp, ('assertLessEqual', decomp._buffer.raw.tell(), max_decomp)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "BZ2FileTest.testReadBytesIO" {
