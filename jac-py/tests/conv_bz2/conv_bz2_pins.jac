d)\n    createTempFile(streams=5)\n    with BZ2File(self.filename) as bz2f:\n        assert list(iter(bz2f)) == self.TEXT_LINES * 5, ('assertEqual', list(iter(bz2f)), self.TEXT_LINES * 5)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
