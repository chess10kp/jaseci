test "TestBasicOps.test_tee_reenter" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class I:\n        first = True\n\n        def __iter__(self):\n            return self\n\n        def __next__(self):\n            first = self.first\n            self.first = False\n            if first:\n                return next(b)\n    a, b = tee(I())\n    try:\n        next(a)\n    except RuntimeError as _exc:\n        assert _re.search('tee', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_StopIteration" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\nclass StopNow:\n    \"\"\"Class emulating an empty iterable.\"\"\"\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    try:\n        next(*(zip(),))\n    except StopIteration:\n        pass\n    for f in (chain, cycle, zip, groupby):\n        try:\n            next(*(f([]),))\n        except StopIteration:\n            pass\n        try:\n            next(*(f(StopNow()),))\n        except StopIteration:\n            pass\n    try:\n        next(*(islice([], None),))\n    except StopIteration:\n        pass\n    try:\n        next(*(islice(StopNow(), None),))\n    except StopIteration:\n        pass\n    p, q = tee([])\n    try:\n        next(*(p,))\n    except StopIteration:\n        pass\n    try:\n        next(*(q,))\n    except StopIteration:\n        pass\n    p, q = tee(StopNow())\n    try:\n        next(*(p,))\n    except StopIteration:\n        pass\n    try:\n        next(*(q,))\n    except StopIteration:\n        pass\n    try:\n        next(*(repeat(None, 0),))\n    except StopIteration:\n        pass\n    for f in (filter, filterfalse, map, takewhile, dropwhile, starmap):\n        try:\n            next(*(f(lambda x: x, []),))\n        except StopIteration:\n            pass\n        try:\n            next(*(f(lambda x: x, StopNow()),))\n        except StopIteration:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

