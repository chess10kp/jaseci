test "TestVariousIteratorArgs.test_zip" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef lzip(*args):\n    return list(zip(*args))\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef tupleize(*args):\n    return args\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in ('123', '', range(1000), ('do', 1.2), range(2000, 2200, 5)):\n        for g in (G, I, Ig, S, L, R):\n            assert list(zip(g(s))) == lzip(g(s)), ('assertEqual', list(zip(g(s))), lzip(g(s)))\n            assert list(zip(g(s), g(s))) == lzip(g(s), g(s)), ('assertEqual', list(zip(g(s), g(s))), lzip(g(s), g(s)))\n        try:\n            zip(*(X(s),))\n        except TypeError:\n            pass\n        try:\n            zip(*(N(s),))\n        except TypeError:\n            pass\n        try:\n            list(*(zip(E(s)),))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_ziplongest" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in ('123', '', range(1000), ('do', 1.2), range(2000, 2200, 5)):\n        for g in (G, I, Ig, S, L, R):\n            assert list(zip_longest(g(s))) == list(zip(g(s))), ('assertEqual', list(zip_longest(g(s))), list(zip(g(s))))\n            assert list(zip_longest(g(s), g(s))) == list(zip(g(s), g(s))), ('assertEqual', list(zip_longest(g(s), g(s))), list(zip(g(s), g(s))))\n        try:\n            zip_longest(*(X(s),))\n        except TypeError:\n            pass\n        try:\n            zip_longest(*(N(s),))\n        except TypeError:\n            pass\n        try:\n            list(*(zip_longest(E(s)),))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_map" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in (range(10), range(0), range(100), (7, 11), range(20, 50, 5)):\n        for g in (G, I, Ig, S, L, R):\n            assert list(map(onearg, g(s))) == [onearg(x) for x in g(s)], ('assertEqual', list(map(onearg, g(s))), [onearg(x) for x in g(s)])\n            assert list(map(operator.pow, g(s), g(s))) == [x ** x for x in g(s)], ('assertEqual', list(map(operator.pow, g(s), g(s))), [x ** x for x in g(s)])\n        try:\n            map(*(onearg, X(s)))\n        except TypeError:\n            pass\n        try:\n            map(*(onearg, N(s)))\n        except TypeError:\n            pass\n        try:\n            list(*(map(onearg, E(s)),))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_islice" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in ('12345', '', range(1000), ('do', 1.2), range(2000, 2200, 5)):\n        for g in (G, I, Ig, S, L, R):\n            assert list(islice(g(s), 1, None, 2)) == list(g(s))[1::2], ('assertEqual', list(islice(g(s), 1, None, 2)), list(g(s))[1::2])\n        try:\n            islice(*(X(s), 10))\n        except TypeError:\n            pass\n        try:\n            islice(*(N(s), 10))\n        except TypeError:\n            pass\n        try:\n            list(*(islice(E(s), 10),))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_pairwise" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in ('123', '', range(1000), ('do', 1.2), range(2000, 2200, 5)):\n        for g in (G, I, Ig, S, L, R):\n            seq = list(g(s))\n            expected = list(zip(seq, seq[1:]))\n            actual = list(pairwise(g(s)))\n            assert actual == expected, ('assertEqual', actual, expected)\n        try:\n            pairwise(*(X(s),))\n        except TypeError:\n            pass\n        try:\n            pairwise(*(N(s),))\n        except TypeError:\n            pass\n        try:\n            list(*(pairwise(E(s)),))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_starmap" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef lzip(*args):\n    return list(zip(*args))\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef tupleize(*args):\n    return args\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in (range(10), range(0), range(100), (7, 11), range(20, 50, 5)):\n        for g in (G, I, Ig, S, L, R):\n            ss = lzip(s, s)\n            assert list(starmap(operator.pow, g(ss))) == [x ** x for x in g(s)], ('assertEqual', list(starmap(operator.pow, g(ss))), [x ** x for x in g(s)])\n        try:\n            starmap(*(operator.pow, X(ss)))\n        except TypeError:\n            pass\n        try:\n            starmap(*(operator.pow, N(ss)))\n        except TypeError:\n            pass\n        try:\n            list(*(starmap(operator.pow, E(ss)),))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_takewhile" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in (range(10), range(0), range(1000), (7, 11), range(2000, 2200, 5)):\n        for g in (G, I, Ig, S, L, R):\n            tgt = []\n            for elem in g(s):\n                if not isEven(elem):\n                    break\n                tgt.append(elem)\n            assert list(takewhile(isEven, g(s))) == tgt, ('assertEqual', list(takewhile(isEven, g(s))), tgt)\n        try:\n            takewhile(*(isEven, X(s)))\n        except TypeError:\n            pass\n        try:\n            takewhile(*(isEven, N(s)))\n        except TypeError:\n            pass\n        try:\n            list(*(takewhile(isEven, E(s)),))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_dropwhile" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in (range(10), range(0), range(1000), (7, 11), range(2000, 2200, 5)):\n        for g in (G, I, Ig, S, L, R):\n            tgt = []\n            for elem in g(s):\n                if not tgt and isOdd(elem):\n                    continue\n                tgt.append(elem)\n            assert list(dropwhile(isOdd, g(s))) == tgt, ('assertEqual', list(dropwhile(isOdd, g(s))), tgt)\n        try:\n            dropwhile(*(isOdd, X(s)))\n        except TypeError:\n            pass\n        try:\n            dropwhile(*(isOdd, N(s)))\n        except TypeError:\n            pass\n        try:\n            list(*(dropwhile(isOdd, E(s)),))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_tee" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for s in ('123', '', range(1000), ('do', 1.2), range(2000, 2200, 5)):\n        for g in (G, I, Ig, S, L, R):\n            it1, it2 = tee(g(s))\n            assert list(it1) == list(g(s)), ('assertEqual', list(it1), list(g(s)))\n            assert list(it2) == list(g(s)), ('assertEqual', list(it2), list(g(s)))\n        try:\n            tee(*(X(s),))\n        except TypeError:\n            pass\n        try:\n            tee(*(N(s),))\n        except TypeError:\n            pass\n        try:\n            list(*(tee(E(s))[0],))\n        except ZeroDivisionError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "LengthTransparency.test_repeat" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\n\ndef _t():\n    assert operator.length_hint(repeat(None, 50)) == 50, ('assertEqual', operator.length_hint(repeat(None, 50)), 50)\n    assert operator.length_hint(repeat(None, 0)) == 0, ('assertEqual', operator.length_hint(repeat(None, 0)), 0)\n    assert operator.length_hint(repeat(None), 12) == 12, ('assertEqual', operator.length_hint(repeat(None), 12), 12)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "LengthTransparency.test_repeat_with_negative_times" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\n\ndef _t():\n    assert operator.length_hint(repeat(None, -1)) == 0, ('assertEqual', operator.length_hint(repeat(None, -1)), 0)\n    assert operator.length_hint(repeat(None, -2)) == 0, ('assertEqual', operator.length_hint(repeat(None, -2)), 0)\n    assert operator.length_hint(repeat(None, times=-1)) == 0, ('assertEqual', operator.length_hint(repeat(None, times=-1)), 0)\n    assert operator.length_hint(repeat(None, times=-2)) == 0, ('assertEqual', operator.length_hint(repeat(None, times=-2)), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "RegressionTests.test_sf_793826" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    def mutatingtuple(tuple1, f, tuple2):\n\n        def g(value, first=[1]):\n            if first:\n                del first[:]\n                f(next(z))\n            return value\n        items = list(tuple2)\n        items[1:1] = list(tuple1)\n        gen = map(g, items)\n        z = zip(*[gen] * len(tuple1))\n        next(z)\n\n    def f(t):\n        global T\n        T = t\n        first[:] = list(T)\n    first = []\n    mutatingtuple((1, 2, 3), f, (4, 5, 6))\n    second = list(T)\n    assert first == second, ('assertEqual', first, second)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "RegressionTests.test_sf_950057" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\n\ndef _t():\n\n    def gen1():\n        hist.append(0)\n        yield 1\n        hist.append(1)\n        raise AssertionError\n        hist.append(2)\n\n    def gen2(x):\n        hist.append(3)\n        yield 2\n        hist.append(4)\n    hist = []\n    try:\n        list(*(chain(gen1(), gen2(False)),))\n    except AssertionError:\n        pass\n    assert hist == [0, 1], ('assertEqual', hist, [0, 1])\n    hist = []\n    try:\n        list(*(chain(gen1(), gen2(True)),))\n    except AssertionError:\n        pass\n    assert hist == [0, 1], ('assertEqual', hist, [0, 1])\n    hist = []\n    try:\n        list(*(cycle(gen1()),))\n    except AssertionError:\n        pass\n    assert hist == [0, 1], ('assertEqual', hist, [0, 1])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "RegressionTests.test_issue30347_1" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n\n    def f(n):\n        if n == 5:\n            list(b)\n        return n != 6\n    for k, b in groupby(range(10), f):\n        list(b)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

