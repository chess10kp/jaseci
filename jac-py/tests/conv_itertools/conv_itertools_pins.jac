test "TestBasicOps.test_map" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef lzip(*args):\n    return list(zip(*args))\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef tupleize(*args):\n    return args\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    assert list(map(operator.pow, range(3), range(1, 7))) == [0 ** 1, 1 ** 2, 2 ** 3], ('assertEqual', list(map(operator.pow, range(3), range(1, 7))), [0 ** 1, 1 ** 2, 2 ** 3])\n    assert list(map(tupleize, 'abc', range(5))) == [('a', 0), ('b', 1), ('c', 2)], ('assertEqual', list(map(tupleize, 'abc', range(5))), [('a', 0), ('b', 1), ('c', 2)])\n    assert list(map(tupleize, 'abc', count())) == [('a', 0), ('b', 1), ('c', 2)], ('assertEqual', list(map(tupleize, 'abc', count())), [('a', 0), ('b', 1), ('c', 2)])\n    assert take(2, map(tupleize, 'abc', count())) == [('a', 0), ('b', 1)], ('assertEqual', take(2, map(tupleize, 'abc', count())), [('a', 0), ('b', 1)])\n    assert list(map(operator.pow, [])) == [], ('assertEqual', list(map(operator.pow, [])), [])\n    try:\n        map()\n    except TypeError:\n        pass\n    try:\n        list(*(map(None, range(3), range(3)),))\n    except TypeError:\n        pass\n    try:\n        map(*(operator.neg,))\n    except TypeError:\n        pass\n    try:\n        next(*(map(10, range(5)),))\n    except TypeError:\n        pass\n    try:\n        next(*(map(errfunc, [4], [5]),))\n    except ValueError:\n        pass\n    try:\n        next(*(map(onearg, [4], [5]),))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_starmap" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    assert list(starmap(operator.pow, zip(range(3), range(1, 7)))) == [0 ** 1, 1 ** 2, 2 ** 3], ('assertEqual', list(starmap(operator.pow, zip(range(3), range(1, 7)))), [0 ** 1, 1 ** 2, 2 ** 3])\n    assert take(3, starmap(operator.pow, zip(count(), count(1)))) == [0 ** 1, 1 ** 2, 2 ** 3], ('assertEqual', take(3, starmap(operator.pow, zip(count(), count(1)))), [0 ** 1, 1 ** 2, 2 ** 3])\n    assert list(starmap(operator.pow, [])) == [], ('assertEqual', list(starmap(operator.pow, [])), [])\n    assert list(starmap(operator.pow, [iter([4, 5])])) == [4 ** 5], ('assertEqual', list(starmap(operator.pow, [iter([4, 5])])), [4 ** 5])\n    try:\n        list(*(starmap(operator.pow, [None]),))\n    except TypeError:\n        pass\n    try:\n        starmap()\n    except TypeError:\n        pass\n    try:\n        starmap(*(operator.pow, [(4, 5)], 'extra'))\n    except TypeError:\n        pass\n    try:\n        next(*(starmap(10, [(4, 5)]),))\n    except TypeError:\n        pass\n    try:\n        next(*(starmap(errfunc, [(4, 5)]),))\n    except ValueError:\n        pass\n    try:\n        next(*(starmap(onearg, [(4, 5)]),))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_takewhile" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    data = [1, 3, 5, 20, 2, 4, 6, 8]\n    assert list(takewhile(underten, data)) == [1, 3, 5], ('assertEqual', list(takewhile(underten, data)), [1, 3, 5])\n    assert list(takewhile(underten, [])) == [], ('assertEqual', list(takewhile(underten, [])), [])\n    try:\n        takewhile()\n    except TypeError:\n        pass\n    try:\n        takewhile(*(operator.pow,))\n    except TypeError:\n        pass\n    try:\n        takewhile(*(operator.pow, [(4, 5)], 'extra'))\n    except TypeError:\n        pass\n    try:\n        next(*(takewhile(10, [(4, 5)]),))\n    except TypeError:\n        pass\n    try:\n        next(*(takewhile(errfunc, [(4, 5)]),))\n    except ValueError:\n        pass\n    t = takewhile(bool, [1, 1, 1, 0, 0, 0])\n    assert list(t) == [1, 1, 1], ('assertEqual', list(t), [1, 1, 1])\n    try:\n        next(*(t,))\n    except StopIteration:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
