test "TestBasicOps.test_accumulate" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nfrom decimal import Decimal\nfrom fractions import Fraction\nimport operator\nimport pickle\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef _t():\n    assert list(accumulate(range(10))) == [0, 1, 3, 6, 10, 15, 21, 28, 36, 45], ('assertEqual', list(accumulate(range(10))), [0, 1, 3, 6, 10, 15, 21, 28, 36, 45])\n    assert list(accumulate(iterable=range(10))) == [0, 1, 3, 6, 10, 15, 21, 28, 36, 45], ('assertEqual', list(accumulate(iterable=range(10))), [0, 1, 3, 6, 10, 15, 21, 28, 36, 45])\n    for typ in (int, complex, Decimal, Fraction):\n        assert list(accumulate(map(typ, range(10)))) == list(map(typ, [0, 1, 3, 6, 10, 15, 21, 28, 36, 45])), ('assertEqual', list(accumulate(map(typ, range(10)))), list(map(typ, [0, 1, 3, 6, 10, 15, 21, 28, 36, 45])))\n    assert list(accumulate('abc')) == ['a', 'ab', 'abc'], ('assertEqual', list(accumulate('abc')), ['a', 'ab', 'abc'])\n    assert list(accumulate([])) == [], ('assertEqual', list(accumulate([])), [])\n    assert list(accumulate([7])) == [7], ('assertEqual', list(accumulate([7])), [7])\n    try:\n        accumulate(*(range(10), 5, 6))\n    except TypeError:\n        pass\n    try:\n        accumulate()\n    except TypeError:\n        pass\n    try:\n        accumulate(x=range(10))\n    except TypeError:\n        pass\n    try:\n        list(*(accumulate([1, []]),))\n    except TypeError:\n        pass\n    s = [2, 8, 9, 5, 7, 0, 3, 4, 1, 6]\n    assert list(accumulate(s, min)) == [2, 2, 2, 2, 2, 0, 0, 0, 0, 0], ('assertEqual', list(accumulate(s, min)), [2, 2, 2, 2, 2, 0, 0, 0, 0, 0])\n    assert list(accumulate(s, max)) == [2, 8, 9, 9, 9, 9, 9, 9, 9, 9], ('assertEqual', list(accumulate(s, max)), [2, 8, 9, 9, 9, 9, 9, 9, 9, 9])\n    assert list(accumulate(s, operator.mul)) == [2, 16, 144, 720, 5040, 0, 0, 0, 0, 0], ('assertEqual', list(accumulate(s, operator.mul)), [2, 16, 144, 720, 5040, 0, 0, 0, 0, 0])\n    try:\n        list(accumulate(s, chr))\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert list(accumulate([10, 5, 1], initial=None)) == [10, 15, 16], ('assertEqual', list(accumulate([10, 5, 1], initial=None)), [10, 15, 16])\n    assert list(accumulate([10, 5, 1], initial=100)) == [100, 110, 115, 116], ('assertEqual', list(accumulate([10, 5, 1], initial=100)), [100, 110, 115, 116])\n    assert list(accumulate([], initial=100)) == [100], ('assertEqual', list(accumulate([], initial=100)), [100])\n    try:\n        list(accumulate([10, 20], 100))\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
