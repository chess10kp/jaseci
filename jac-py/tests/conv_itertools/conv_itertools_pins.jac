erable([''])) == [], ('assertEqual', list(chain.from_iterable([''])), [])\n    assert take(4, chain.from_iterable(['abc', 'def'])) == list('abcd'), ('assertEqual', take(4, chain.from_iterable(['abc', 'def'])), list('abcd'))\n    try:\n        list(*(chain.from_iterable([2, 3]),))\n    except TypeError:\n        pass\n    assert list(islice(chain.from_iterable(repeat(range(5))), 2)) == [0, 1], ('assertEqual', list(islice(chain.from_iterable(repeat(range(5))), 2)), [0, 1])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
