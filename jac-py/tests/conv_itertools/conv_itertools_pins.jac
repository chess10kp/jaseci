test "TestBasicOps.test_combinations" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef testR(r):\n    return r[0]\n\ndef testR2(r):\n    return r[2]\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    try:\n        combinations(*('abc',))\n    except TypeError:\n        pass\n    try:\n        combinations(*('abc', 2, 1))\n    except TypeError:\n        pass\n    try:\n        combinations(*(None,))\n    except TypeError:\n        pass\n    try:\n        combinations(*('abc', -2))\n    except ValueError:\n        pass\n\n    def combinations1(iterable, r):\n        \"\"\"Pure python version shown in the docs\"\"\"\n        pool = tuple(iterable)\n        n = len(pool)\n        if r > n:\n            return\n        indices = list(range(r))\n        yield tuple((pool[i] for i in indices))\n        while 1:\n            for i in reversed(range(r)):\n                if indices[i] != i + n - r:\n                    break\n            else:\n                return\n            indices[i] += 1\n            for j in range(i + 1, r):\n                indices[j] = indices[j - 1] + 1\n            yield tuple((pool[i] for i in indices))\n\n    def combinations2(iterable, r):\n        \"\"\"Pure python version shown in the docs\"\"\"\n        pool = tuple(iterable)\n        n = len(pool)\n        for indices in permutations(range(n), r):\n            if sorted(indices) == list(indices):\n                yield tuple((pool[i] for i in indices))\n\n    def combinations3(iterable, r):\n        \"\"\"Pure python version from cwr()\"\"\"\n        pool = tuple(iterable)\n        n = len(pool)\n        for indices in combinations_with_replacement(range(n), r):\n            if len(set(indices)) == r:\n                yield tuple((pool[i] for i in indices))\n    for n in range(7):\n        values = [5 * x - 12 for x in range(n)]\n        for r in range(n + 2):\n            result = list(combinations(values, r))\n            assert len(result) == (0 if r > n else fact(n) / fact(r) / fact(n - r)), ('assertEqual', len(result), (0 if r > n else fact(n) / fact(r) / fact(n - r)))\n            assert len(result) == len(set(result)), ('assertEqual', len(result), len(set(result)))\n            assert result == sorted(result), ('assertEqual', result, sorted(result))\n            for c in result:\n                assert len(c) == r, ('assertEqual', len(c), r)\n                assert len(set(c)) == r, ('assertEqual', len(set(c)), r)\n                assert list(c) == sorted(c), ('assertEqual', list(c), sorted(c))\n                assert all((e in values for e in c)), ('assertTrue', all((e in values for e in c)))\n                assert list(c) == [e for e in values if e in c], ('assertEqual', list(c), [e for e in values if e in c])\n            assert result == list(combinations1(values, r)), ('assertEqual', result, list(combinations1(values, r)))\n            assert result == list(combinations2(values, r)), ('assertEqual', result, list(combinations2(values, r)))\n            assert result == list(combinations3(values, r)), ('assertEqual', result, list(combinations3(values, r)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_combinations_with_replacement" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef testR(r):\n    return r[0]\n\ndef testR2(r):\n    return r[2]\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    cwr = combinations_with_replacement\n    try:\n        cwr(*('abc',))\n    except TypeError:\n        pass\n    try:\n        cwr(*('abc', 2, 1))\n    except TypeError:\n        pass\n    try:\n        cwr(*(None,))\n    except TypeError:\n        pass\n    try:\n        cwr(*('abc', -2))\n    except ValueError:\n        pass\n\n    def cwr1(iterable, r):\n        \"\"\"Pure python version shown in the docs\"\"\"\n        pool = tuple(iterable)\n        n = len(pool)\n        if not n and r:\n            return\n        indices = [0] * r\n        yield tuple((pool[i] for i in indices))\n        while 1:\n            for i in reversed(range(r)):\n                if indices[i] != n - 1:\n                    break\n            else:\n                return\n            indices[i:] = [indices[i] + 1] * (r - i)\n            yield tuple((pool[i] for i in indices))\n\n    def cwr2(iterable, r):\n        \"\"\"Pure python version shown in the docs\"\"\"\n        pool = tuple(iterable)\n        n = len(pool)\n        for indices in product(range(n), repeat=r):\n            if sorted(indices) == list(indices):\n                yield tuple((pool[i] for i in indices))\n\n    def numcombs(n, r):\n        if not n:\n            return 0 if r else 1\n        return fact(n + r - 1) / fact(r) / fact(n - 1)\n    for n in range(7):\n        values = [5 * x - 12 for x in range(n)]\n        for r in range(n + 2):\n            result = list(cwr(values, r))\n            assert len(result) == numcombs(n, r), ('assertEqual', len(result), numcombs(n, r))\n            assert len(result) == len(set(result)), ('assertEqual', len(result), len(set(result)))\n            assert result == sorted(result), ('assertEqual', result, sorted(result))\n            regular_combs = list(combinations(values, r))\n            if n == 0 or r <= 1:\n                assert result == regular_combs, ('assertEqual', result, regular_combs)\n            else:\n                assert set(result) >= set(regular_combs), ('assertTrue', set(result) >= set(regular_combs))\n            for c in result:\n                assert len(c) == r, ('assertEqual', len(c), r)\n                noruns = [k for k, v in groupby(c)]\n                assert len(noruns) == len(set(noruns)), ('assertEqual', len(noruns), len(set(noruns)))\n                assert list(c) == sorted(c), ('assertEqual', list(c), sorted(c))\n                assert all((e in values for e in c)), ('assertTrue', all((e in values for e in c)))\n                assert noruns == [e for e in values if e in c], ('assertEqual', noruns, [e for e in values if e in c])\n            assert result == list(cwr1(values, r)), ('assertEqual', result, list(cwr1(values, r)))\n            assert result == list(cwr2(values, r)), ('assertEqual', result, list(cwr2(values, r)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_permutations" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef testR(r):\n    return r[0]\n\ndef testR2(r):\n    return r[2]\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    try:\n        permutations()\n    except TypeError:\n        pass\n    try:\n        permutations(*('abc', 2, 1))\n    except TypeError:\n        pass\n    try:\n        permutations(*(None,))\n    except TypeError:\n        pass\n    try:\n        permutations(*('abc', -2))\n    except ValueError:\n        pass\n    assert list(permutations('abc', 32)) == [], ('assertEqual', list(permutations('abc', 32)), [])\n    try:\n        permutations(*('abc', 's'))\n    except TypeError:\n        pass\n    assert list(permutations(range(3), 2)) == [(0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)], ('assertEqual', list(permutations(range(3), 2)), [(0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)])\n\n    def permutations1(iterable, r=None):\n        \"\"\"Pure python version shown in the docs\"\"\"\n        pool = tuple(iterable)\n        n = len(pool)\n        r = n if r is None else r\n        if r > n:\n            return\n        indices = list(range(n))\n        cycles = list(range(n - r + 1, n + 1))[::-1]\n        yield tuple((pool[i] for i in indices[:r]))\n        while n:\n            for i in reversed(range(r)):\n                cycles[i] -= 1\n                if cycles[i] == 0:\n                    indices[i:] = indices[i + 1:] + indices[i:i + 1]\n                    cycles[i] = n - i\n                else:\n                    j = cycles[i]\n                    indices[i], indices[-j] = (indices[-j], indices[i])\n                    yield tuple((pool[i] for i in indices[:r]))\n                    break\n            else:\n                return\n\n    def permutations2(iterable, r=None):\n        \"\"\"Pure python version shown in the docs\"\"\"\n        pool = tuple(iterable)\n        n = len(pool)\n        r = n if r is None else r\n        for indices in product(range(n), repeat=r):\n            if len(set(indices)) == r:\n                yield tuple((pool[i] for i in indices))\n    for n in range(7):\n        values = [5 * x - 12 for x in range(n)]\n        for r in range(n + 2):\n            result = list(permutations(values, r))\n            assert len(result) == (0 if r > n else fact(n) / fact(n - r)), ('assertEqual', len(result), (0 if r > n else fact(n) / fact(n - r)))\n            assert len(result) == len(set(result)), ('assertEqual', len(result), len(set(result)))\n            assert result == sorted(result), ('assertEqual', result, sorted(result))\n            for p in result:\n                assert len(p) == r, ('assertEqual', len(p), r)\n                assert len(set(p)) == r, ('assertEqual', len(set(p)), r)\n                assert all((e in values for e in p)), ('assertTrue', all((e in values for e in p)))\n            assert result == list(permutations1(values, r)), ('assertEqual', result, list(permutations1(values, r)))\n            assert result == list(permutations2(values, r)), ('assertEqual', result, list(permutations2(values, r)))\n            if r == n:\n                assert result == list(permutations(values, None)), ('assertEqual', result, list(permutations(values, None)))\n                assert result == list(permutations(values)), ('assertEqual', result, list(permutations(values)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_combinatorics" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef testR(r):\n    return r[0]\n\ndef testR2(r):\n    return r[2]\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for n in range(6):\n        s = 'ABCDEFG'[:n]\n        for r in range(8):\n            prod = list(product(s, repeat=r))\n            cwr = list(combinations_with_replacement(s, r))\n            perm = list(permutations(s, r))\n            comb = list(combinations(s, r))\n            assert len(prod) == n ** r, ('assertEqual', len(prod), n ** r)\n            assert len(cwr) == (fact(n + r - 1) / fact(r) / fact(n - 1) if n else not r), ('assertEqual', len(cwr), (fact(n + r - 1) / fact(r) / fact(n - 1) if n else not r))\n            assert len(perm) == (0 if r > n else fact(n) / fact(n - r)), ('assertEqual', len(perm), (0 if r > n else fact(n) / fact(n - r)))\n            assert len(comb) == (0 if r > n else fact(n) / fact(r) / fact(n - r)), ('assertEqual', len(comb), (0 if r > n else fact(n) / fact(r) / fact(n - r)))\n            assert prod == sorted(set(prod)), ('assertEqual', prod, sorted(set(prod)))\n            assert cwr == sorted(set(cwr)), ('assertEqual', cwr, sorted(set(cwr)))\n            assert perm == sorted(set(perm)), ('assertEqual', perm, sorted(set(perm)))\n            assert comb == sorted(set(comb)), ('assertEqual', comb, sorted(set(comb)))\n            assert cwr == [t for t in prod if sorted(t) == list(t)], ('assertEqual', cwr, [t for t in prod if sorted(t) == list(t)])\n            assert perm == [t for t in prod if len(set(t)) == r], ('assertEqual', perm, [t for t in prod if len(set(t)) == r])\n            assert comb == [t for t in perm if sorted(t) == list(t)], ('assertEqual', comb, [t for t in perm if sorted(t) == list(t)])\n            assert comb == [t for t in cwr if len(set(t)) == r], ('assertEqual', comb, [t for t in cwr if len(set(t)) == r])\n            assert comb == list(filter(set(cwr).__contains__, perm)), ('assertEqual', comb, list(filter(set(cwr).__contains__, perm)))\n            assert comb == list(filter(set(perm).__contains__, cwr)), ('assertEqual', comb, list(filter(set(perm).__contains__, cwr)))\n            assert comb == sorted(set(cwr) & set(perm)), ('assertEqual', comb, sorted(set(cwr) & set(perm)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_compress" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    assert list(compress(data='ABCDEF', selectors=[1, 0, 1, 0, 1, 1])) == list('ACEF'), ('assertEqual', list(compress(data='ABCDEF', selectors=[1, 0, 1, 0, 1, 1])), list('ACEF'))\n    assert list(compress('ABCDEF', [1, 0, 1, 0, 1, 1])) == list('ACEF'), ('assertEqual', list(compress('ABCDEF', [1, 0, 1, 0, 1, 1])), list('ACEF'))\n    assert list(compress('ABCDEF', [0, 0, 0, 0, 0, 0])) == list(''), ('assertEqual', list(compress('ABCDEF', [0, 0, 0, 0, 0, 0])), list(''))\n    assert list(compress('ABCDEF', [1, 1, 1, 1, 1, 1])) == list('ABCDEF'), ('assertEqual', list(compress('ABCDEF', [1, 1, 1, 1, 1, 1])), list('ABCDEF'))\n    assert list(compress('ABCDEF', [1, 0, 1])) == list('AC'), ('assertEqual', list(compress('ABCDEF', [1, 0, 1])), list('AC'))\n    assert list(compress('ABC', [0, 1, 1, 1, 1, 1])) == list('BC'), ('assertEqual', list(compress('ABC', [0, 1, 1, 1, 1, 1])), list('BC'))\n    n = 10000\n    data = chain.from_iterable(repeat(range(6), n))\n    selectors = chain.from_iterable(repeat((0, 1)))\n    assert list(compress(data, selectors)) == [1, 3, 5] * n, ('assertEqual', list(compress(data, selectors)), [1, 3, 5] * n)\n    try:\n        compress(*(None, range(6)))\n    except TypeError:\n        pass\n    try:\n        compress(*(range(6), None))\n    except TypeError:\n        pass\n    try:\n        compress(*(range(6),))\n    except TypeError:\n        pass\n    try:\n        compress(*(range(6), None))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_cycle" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    assert take(10, cycle('abc')) == list('abcabcabca'), ('assertEqual', take(10, cycle('abc')), list('abcabcabca'))\n    assert list(cycle('')) == [], ('assertEqual', list(cycle('')), [])\n    try:\n        cycle()\n    except TypeError:\n        pass\n    try:\n        cycle(*(5,))\n    except TypeError:\n        pass\n    assert list(islice(cycle(gen3()), 10)) == [0, 1, 2, 0, 1, 2, 0, 1, 2, 0], ('assertEqual', list(islice(cycle(gen3()), 10)), [0, 1, 2, 0, 1, 2, 0, 1, 2, 0])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_groupby" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef testR(r):\n    return r[0]\n\ndef testR2(r):\n    return r[2]\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    assert [] == list(groupby([])), ('assertEqual', [], list(groupby([])))\n    assert [] == list(groupby([], key=id)), ('assertEqual', [], list(groupby([], key=id)))\n    try:\n        list(*(groupby('abc', []),))\n    except TypeError:\n        pass\n    try:\n        groupby(*(None,))\n    except TypeError:\n        pass\n    try:\n        groupby(*('abc', lambda x: x, 10))\n    except TypeError:\n        pass\n    s = [(0, 10, 20), (0, 11, 21), (0, 12, 21), (1, 13, 21), (1, 14, 22), (2, 15, 22), (3, 16, 23), (3, 17, 23)]\n    dup = []\n    for k, g in groupby(s, lambda r: r[0]):\n        for elem in g:\n            assert k == elem[0], ('assertEqual', k, elem[0])\n            dup.append(elem)\n    assert s == dup, ('assertEqual', s, dup)\n    dup = []\n    for k, g in groupby(s, testR):\n        for ik, ig in groupby(g, testR2):\n            for elem in ig:\n                assert k == elem[0], ('assertEqual', k, elem[0])\n                assert ik == elem[2], ('assertEqual', ik, elem[2])\n                dup.append(elem)\n    assert s == dup, ('assertEqual', s, dup)\n    keys = [k for k, g in groupby(s, testR)]\n    expectedkeys = set([r[0] for r in s])\n    assert set(keys) == expectedkeys, ('assertEqual', set(keys), expectedkeys)\n    assert len(keys) == len(expectedkeys), ('assertEqual', len(keys), len(expectedkeys))\n    s = list(zip('AABBBAAAA', range(9)))\n    it = groupby(s, testR)\n    _, g1 = next(it)\n    _, g2 = next(it)\n    _, g3 = next(it)\n    assert list(g1) == [], ('assertEqual', list(g1), [])\n    assert list(g2) == [], ('assertEqual', list(g2), [])\n    assert next(g3) == ('A', 5), ('assertEqual', next(g3), ('A', 5))\n    list(it)\n    assert list(g3) == [], ('assertEqual', list(g3), [])\n    s = 'abracadabra'\n    r = [k for k, g in groupby(sorted(s))]\n    assert r == ['a', 'b', 'c', 'd', 'r'], ('assertEqual', r, ['a', 'b', 'c', 'd', 'r'])\n    r = [k for k, g in groupby(sorted(s)) if list(islice(g, 1, 2))]\n    assert r == ['a', 'b', 'r'], ('assertEqual', r, ['a', 'b', 'r'])\n    r = [(len(list(g)), k) for k, g in groupby(sorted(s))]\n    assert r == [(5, 'a'), (2, 'b'), (1, 'c'), (1, 'd'), (2, 'r')], ('assertEqual', r, [(5, 'a'), (2, 'b'), (1, 'c'), (1, 'd'), (2, 'r')])\n    r = sorted([(len(list(g)), k) for k, g in groupby(sorted(s))], reverse=True)[:3]\n    assert r == [(5, 'a'), (2, 'r'), (2, 'b')], ('assertEqual', r, [(5, 'a'), (2, 'r'), (2, 'b')])\n\n    class ExpectedError(Exception):\n        pass\n\n    def delayed_raise(n=0):\n        for i in range(n):\n            yield 'yo'\n        raise ExpectedError\n\n    def gulp(iterable, keyp=None, func=list):\n        return [func(g) for k, g in groupby(iterable, keyp)]\n    try:\n        gulp(*(delayed_raise(0),))\n    except ExpectedError:\n        pass\n    try:\n        gulp(*(delayed_raise(1),))\n    except ExpectedError:\n        pass\n\n    class DummyCmp:\n\n        def __eq__(self, dst):\n            raise ExpectedError\n    s = [DummyCmp(), DummyCmp(), None]\n    try:\n        gulp(*(s,), func=id)\n    except ExpectedError:\n        pass\n    try:\n        gulp(*(s,))\n    except ExpectedError:\n        pass\n\n    def keyfunc(obj):\n        if keyfunc.skip > 0:\n            keyfunc.skip -= 1\n            return obj\n        else:\n            raise ExpectedError\n    keyfunc.skip = 0\n    try:\n        gulp(*([None], keyfunc))\n    except ExpectedError:\n        pass\n    keyfunc.skip = 1\n    try:\n        gulp(*([None, None], keyfunc))\n    except ExpectedError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_filter" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport copy\nimport pickle\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\npicklecopiers = [lambda s, proto=proto: pickle.loads(pickle.dumps(s, proto)) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n\n    def pickletest(protocol, it, stop=4, take=1, compare=None):\n        \"\"\"Test that an iterator is the same after pickling, also when part-consumed\"\"\"\n\n        def expand(it, i=0):\n            if i > 10:\n                raise RuntimeError('infinite recursion encountered')\n            if isinstance(it, str):\n                return it\n            try:\n                l = list(islice(it, stop))\n            except TypeError:\n                return it\n            return [expand(e, i + 1) for e in l]\n        dump = pickle.dumps(it, protocol)\n        i2 = pickle.loads(dump)\n        assert type(it) == type(i2), ('assertEqual', type(it), type(i2))\n        a, b = (expand(it), expand(i2))\n        assert a == b, ('assertEqual', a, b)\n        if compare:\n            c = expand(compare)\n            assert a == c, ('assertEqual', a, c)\n        i3 = pickle.loads(dump)\n        took = 0\n        try:\n            for i in range(take):\n                next(i3)\n                took += 1\n        except StopIteration:\n            pass\n        dump = pickle.dumps(i3, protocol)\n        i4 = pickle.loads(dump)\n        a, b = (expand(i3), expand(i4))\n        assert a == b, ('assertEqual', a, b)\n        if compare:\n            c = expand(compare[took:])\n            assert a == c, ('assertEqual', a, c)\n    assert list(filter(isEven, range(6))) == [0, 2, 4], ('assertEqual', list(filter(isEven, range(6))), [0, 2, 4])\n    assert list(filter(None, [0, 1, 0, 2, 0])) == [1, 2], ('assertEqual', list(filter(None, [0, 1, 0, 2, 0])), [1, 2])\n    assert list(filter(bool, [0, 1, 0, 2, 0])) == [1, 2], ('assertEqual', list(filter(bool, [0, 1, 0, 2, 0])), [1, 2])\n    assert take(4, filter(isEven, count())) == [0, 2, 4, 6], ('assertEqual', take(4, filter(isEven, count())), [0, 2, 4, 6])\n    try:\n        filter()\n    except TypeError:\n        pass\n    try:\n        filter(*(lambda x: x,))\n    except TypeError:\n        pass\n    try:\n        filter(*(lambda x: x, range(6), 7))\n    except TypeError:\n        pass\n    try:\n        filter(*(isEven, 3))\n    except TypeError:\n        pass\n    try:\n        next(*(filter(range(6), range(6)),))\n    except TypeError:\n        pass\n    ans = [0, 2, 4]\n    c = filter(isEven, range(6))\n    assert list(copy.copy(c)) == ans, ('assertEqual', list(copy.copy(c)), ans)\n    c = filter(isEven, range(6))\n    assert list(copy.deepcopy(c)) == ans, ('assertEqual', list(copy.deepcopy(c)), ans)\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        c = filter(isEven, range(6))\n        assert list(pickle.loads(pickle.dumps(c, proto))) == ans, ('assertEqual', list(pickle.loads(pickle.dumps(c, proto))), ans)\n        next(c)\n        assert list(pickle.loads(pickle.dumps(c, proto))) == ans[1:], ('assertEqual', list(pickle.loads(pickle.dumps(c, proto))), ans[1:])\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        c = filter(isEven, range(6))\n        pickletest(proto, c)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_filterfalse" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    assert list(filterfalse(isEven, range(6))) == [1, 3, 5], ('assertEqual', list(filterfalse(isEven, range(6))), [1, 3, 5])\n    assert list(filterfalse(None, [0, 1, 0, 2, 0])) == [0, 0, 0], ('assertEqual', list(filterfalse(None, [0, 1, 0, 2, 0])), [0, 0, 0])\n    assert list(filterfalse(bool, [0, 1, 0, 2, 0])) == [0, 0, 0], ('assertEqual', list(filterfalse(bool, [0, 1, 0, 2, 0])), [0, 0, 0])\n    assert take(4, filterfalse(isEven, count())) == [1, 3, 5, 7], ('assertEqual', take(4, filterfalse(isEven, count())), [1, 3, 5, 7])\n    try:\n        filterfalse()\n    except TypeError:\n        pass\n    try:\n        filterfalse(*(lambda x: x,))\n    except TypeError:\n        pass\n    try:\n        filterfalse(*(lambda x: x, range(6), 7))\n    except TypeError:\n        pass\n    try:\n        filterfalse(*(isEven, 3))\n    except TypeError:\n        pass\n    try:\n        next(*(filterfalse(range(6), range(6)),))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_zip" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef lzip(*args):\n    return list(zip(*args))\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef tupleize(*args):\n    return args\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    ans = [(x, y) for x, y in zip('abc', count())]\n    assert ans == [('a', 0), ('b', 1), ('c', 2)], ('assertEqual', ans, [('a', 0), ('b', 1), ('c', 2)])\n    assert list(zip('abc', range(6))) == lzip('abc', range(6)), ('assertEqual', list(zip('abc', range(6))), lzip('abc', range(6)))\n    assert list(zip('abcdef', range(3))) == lzip('abcdef', range(3)), ('assertEqual', list(zip('abcdef', range(3))), lzip('abcdef', range(3)))\n    assert take(3, zip('abcdef', count())) == lzip('abcdef', range(3)), ('assertEqual', take(3, zip('abcdef', count())), lzip('abcdef', range(3)))\n    assert list(zip('abcdef')) == lzip('abcdef'), ('assertEqual', list(zip('abcdef')), lzip('abcdef'))\n    assert list(zip()) == lzip(), ('assertEqual', list(zip()), lzip())\n    try:\n        zip(*(3,))\n    except TypeError:\n        pass\n    try:\n        zip(*(range(3), 3))\n    except TypeError:\n        pass\n    assert [tuple(list(pair)) for pair in zip('abc', 'def')] == lzip('abc', 'def'), ('assertEqual', [tuple(list(pair)) for pair in zip('abc', 'def')], lzip('abc', 'def'))\n    assert [pair for pair in zip('abc', 'def')] == lzip('abc', 'def'), ('assertEqual', [pair for pair in zip('abc', 'def')], lzip('abc', 'def'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_ziplongest" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef lzip(*args):\n    return list(zip(*args))\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef tupleize(*args):\n    return args\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for args in [['abc', range(6)], [range(6), 'abc'], [range(1000), range(2000, 2100), range(3000, 3050)], [range(1000), range(0), range(3000, 3050), range(1200), range(1500)], [range(1000), range(0), range(3000, 3050), range(1200), range(1500), range(0)]]:\n        target = [tuple([arg[i] if i < len(arg) else None for arg in args]) for i in range(max(map(len, args)))]\n        assert list(zip_longest(*args)) == target, ('assertEqual', list(zip_longest(*args)), target)\n        assert list(zip_longest(*args, **{})) == target, ('assertEqual', list(zip_longest(*args, **{})), target)\n        target = [tuple((e is None and 'X' or e for e in t)) for t in target]\n        assert list(zip_longest(*args, **dict(fillvalue='X'))) == target, ('assertEqual', list(zip_longest(*args, **dict(fillvalue='X'))), target)\n    assert take(3, zip_longest('abcdef', count())) == list(zip('abcdef', range(3))), ('assertEqual', take(3, zip_longest('abcdef', count())), list(zip('abcdef', range(3))))\n    assert list(zip_longest()) == list(zip()), ('assertEqual', list(zip_longest()), list(zip()))\n    assert list(zip_longest([])) == list(zip([])), ('assertEqual', list(zip_longest([])), list(zip([])))\n    assert list(zip_longest('abcdef')) == list(zip('abcdef')), ('assertEqual', list(zip_longest('abcdef')), list(zip('abcdef')))\n    assert list(zip_longest('abc', 'defg', **{})) == list(zip(list('abc') + [None], 'defg')), ('assertEqual', list(zip_longest('abc', 'defg', **{})), list(zip(list('abc') + [None], 'defg')))\n    try:\n        zip_longest(*(3,))\n    except TypeError:\n        pass\n    try:\n        zip_longest(*(range(3), 3))\n    except TypeError:\n        pass\n    for stmt in [\"zip_longest('abc', fv=1)\", \"zip_longest('abc', fillvalue=1, bogus_keyword=None)\"]:\n        try:\n            eval(stmt, globals(), locals())\n        except TypeError:\n            pass\n        else:\n            raise AssertionError('Did not raise Type in:  ' + stmt)\n    assert [tuple(list(pair)) for pair in zip_longest('abc', 'def')] == list(zip('abc', 'def')), ('assertEqual', [tuple(list(pair)) for pair in zip_longest('abc', 'def')], list(zip('abc', 'def')))\n    assert [pair for pair in zip_longest('abc', 'def')] == list(zip('abc', 'def')), ('assertEqual', [pair for pair in zip_longest('abc', 'def')], list(zip('abc', 'def')))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_zip_longest_bad_iterable" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\n\ndef _t():\n    exception = TypeError()\n\n    class BadIterable:\n\n        def __iter__(self):\n            raise exception\n\n    class _ExcBox:\n        pass\n    cm = _ExcBox()\n    try:\n        zip_longest(BadIterable())\n    except TypeError as _exc:\n        cm.exception = _exc\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert cm.exception is exception, ('assertIs', cm.exception, exception)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_pairwise" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\n\ndef _t():\n    assert list(pairwise('')) == [], ('assertEqual', list(pairwise('')), [])\n    assert list(pairwise('a')) == [], ('assertEqual', list(pairwise('a')), [])\n    assert list(pairwise('ab')) == [('a', 'b')], ('assertEqual', list(pairwise('ab')), [('a', 'b')])\n    assert list(pairwise('abcde')) == [('a', 'b'), ('b', 'c'), ('c', 'd'), ('d', 'e')], ('assertEqual', list(pairwise('abcde')), [('a', 'b'), ('b', 'c'), ('c', 'd'), ('d', 'e')])\n    assert list(pairwise(range(10000))) == list(zip(range(10000), range(1, 10000))), ('assertEqual', list(pairwise(range(10000))), list(zip(range(10000), range(1, 10000))))\n    try:\n        pairwise()\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        pairwise('abc', 10)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        pairwise(iterable='abc')\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        pairwise(None)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_product" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nimport random\nfrom functools import reduce\n\ndef lzip(*args):\n    return list(zip(*args))\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef tupleize(*args):\n    return args\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef testR(r):\n    return r[0]\n\ndef testR2(r):\n    return r[2]\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    for args, result in [([], [()]), (['ab'], [('a',), ('b',)]), ([range(2), range(3)], [(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2)]), ([range(0), range(2), range(3)], []), ([range(2), range(0), range(3)], []), ([range(2), range(3), range(0)], [])]:\n        assert list(product(*args)) == result, ('assertEqual', list(product(*args)), result)\n        for r in range(4):\n            assert list(product(*args * r)) == list(product(*args, **dict(repeat=r))), ('assertEqual', list(product(*args * r)), list(product(*args, **dict(repeat=r))))\n    assert len(list(product(*[range(7)] * 6))) == 7 ** 6, ('assertEqual', len(list(product(*[range(7)] * 6))), 7 ** 6)\n    try:\n        product(*(range(6), None))\n    except TypeError:\n        pass\n\n    def product1(*args, **kwds):\n        pools = list(map(tuple, args)) * kwds.get('repeat', 1)\n        n = len(pools)\n        if n == 0:\n            yield ()\n            return\n        if any((len(pool) == 0 for pool in pools)):\n            return\n        indices = [0] * n\n        yield tuple((pool[i] for pool, i in zip(pools, indices)))\n        while 1:\n            for i in reversed(range(n)):\n                if indices[i] == len(pools[i]) - 1:\n                    continue\n                indices[i] += 1\n                for j in range(i + 1, n):\n                    indices[j] = 0\n                yield tuple((pool[i] for pool, i in zip(pools, indices)))\n                break\n            else:\n                return\n\n    def product2(*iterables, repeat=1):\n        \"\"\"Pure python version used in docs\"\"\"\n        if repeat < 0:\n            raise ValueError('repeat argument cannot be negative')\n        pools = [tuple(pool) for pool in iterables] * repeat\n        result = [[]]\n        for pool in pools:\n            result = [x + [y] for x in result for y in pool]\n        for prod in result:\n            yield tuple(prod)\n    argtypes = ['', 'abc', '', range(0), range(4), dict(a=1, b=2, c=3), set('abcdefg'), range(11), tuple(range(13))]\n    for i in range(100):\n        args = [random.choice(argtypes) for j in range(random.randrange(5))]\n        expected_len = prod(map(len, args))\n        assert len(list(product(*args))) == expected_len, ('assertEqual', len(list(product(*args))), expected_len)\n        assert list(product(*args)) == list(product1(*args)), ('assertEqual', list(product(*args)), list(product1(*args)))\n        assert list(product(*args)) == list(product2(*args)), ('assertEqual', list(product(*args)), list(product2(*args)))\n        args = map(iter, args)\n        assert len(list(product(*args))) == expected_len, ('assertEqual', len(list(product(*args))), expected_len)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestBasicOps.test_repeat" {
    (ok, detail) = p2_libtest_run_snippet("from itertools import accumulate, batched, chain, combinations, combinations_with_replacement, compress, count, cycle, dropwhile, filterfalse, groupby, islice, pairwise, permutations, product, repeat, starmap, takewhile, tee, zip_longest\nimport operator\nfrom functools import reduce\n\ndef lzip(*args):\n    return list(zip(*args))\n\ndef onearg(x):\n    \"\"\"Test function of one argument\"\"\"\n    return 2 * x\n\ndef errfunc(*args):\n    \"\"\"Test function that raises an error\"\"\"\n    raise ValueError\n\ndef gen3():\n    \"\"\"Non-restartable source sequence\"\"\"\n    for i in (0, 1, 2):\n        yield i\n\ndef isEven(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 0\n\ndef isOdd(x):\n    \"\"\"Test predicate\"\"\"\n    return x % 2 == 1\n\ndef tupleize(*args):\n    return args\n\ndef irange(n):\n    for i in range(n):\n        yield i\n\ndef take(n, seq):\n    \"\"\"Convenience function for partially consuming a long of infinite iterable\"\"\"\n    return list(islice(seq, n))\n\ndef prod(iterable):\n    return reduce(operator.mul, iterable, 1)\n\ndef fact(n):\n    \"\"\"Factorial\"\"\"\n    return prod(range(1, n + 1))\n\ndef testR(r):\n    return r[0]\n\ndef testR2(r):\n    return r[2]\n\ndef underten(x):\n    return x < 10\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef _t():\n    assert list(repeat(object='a', times=3)) == ['a', 'a', 'a'], ('assertEqual', list(repeat(object='a', times=3)), ['a', 'a', 'a'])\n    assert lzip(range(3), repeat('a')) == [(0, 'a'), (1, 'a'), (2, 'a')], ('assertEqual', lzip(range(3), repeat('a')), [(0, 'a'), (1, 'a'), (2, 'a')])\n    assert list(repeat('a', 3)) == ['a', 'a', 'a'], ('assertEqual', list(repeat('a', 3)), ['a', 'a', 'a'])\n    assert take(3, repeat('a')) == ['a', 'a', 'a'], ('assertEqual', take(3, repeat('a')), ['a', 'a', 'a'])\n    assert list(repeat('a', 0)) == [], ('assertEqual', list(repeat('a', 0)), [])\n    assert list(repeat('a', -3)) == [], ('assertEqual', list(repeat('a', -3)), [])\n    try:\n        repeat()\n    except TypeError:\n        pass\n    try:\n        repeat(*(None, 3, 4))\n    except TypeError:\n        pass\n    try:\n        repeat(*(None, 'a'))\n    except TypeError:\n        pass\n    r = repeat(1 + 0j)\n    assert repr(r) == 'repeat((1+0j))', ('assertEqual', repr(r), 'repeat((1+0j))')\n    r = repeat(1 + 0j, 5)\n    assert repr(r) == 'repeat((1+0j), 5)', ('assertEqual', repr(r), 'repeat((1+0j), 5)')\n    list(r)\n    assert repr(r) == 'repeat((1+0j), 0)', ('assertEqual', repr(r), 'repeat((1+0j), 0)')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

