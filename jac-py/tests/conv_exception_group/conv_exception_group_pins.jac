    (ok, detail) = p2_libtest_run_snippet("import collections\n\ndef create_simple_eg():\n    excs = []\n    try:\n        try:\n            raise MemoryError('context and cause for ValueError(1)')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        try:\n            raise OSError('context for TypeError')\n        except OSError as e:\n            raise TypeError(int)\n    except TypeError as e:\n        excs.append(e)\n    try:\n        try:\n            raise ImportError('context for ValueError(2)')\n        except ImportError as e:\n            raise ValueError(2)\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('simple eg', excs)\n    except ExceptionGroup as e:\n        return e\n\ndef leaf_generator(exc, tbs=None):\n    if tbs is None:\n        tbs = []\n    tbs.append(exc.__traceback__)\n    if isinstance(exc, BaseExceptionGroup):\n        for e in exc.exceptions:\n            yield from leaf_generator(e, tbs)\n    else:\n        yield (exc, tbs)\n    tbs.pop()\n\ndef create_nested_eg():\n    excs = []\n    try:\n        try:\n            raise TypeError(bytes)\n        except TypeError as e:\n            raise ExceptionGroup('nested', [e])\n    except ExceptionGroup as e:\n        excs.append(e)\n    try:\n        try:\n            raise MemoryError('out of memory')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('root', excs)\n    except ExceptionGroup as eg:\n        return eg\n\ndef _t():\n\n    class MyEG(ExceptionGroup):\n        pass\n    excs = [ValueError(1), TypeError(2)]\n    eg = MyEG('test', excs)\n    assert repr(eg) == \"MyEG('test', [ValueError(1), TypeError(2)])\", ('assertEqual', repr(eg), \"MyEG('test', [ValueError(1), TypeError(2)])\")\n    excs.clear()\n    assert repr(eg) == \"MyEG('test', [ValueError(1), TypeError(2)])\", ('assertEqual', repr(eg), \"MyEG('test', [ValueError(1), TypeError(2)])\")\n    assert eg.args == ('test', []), ('assertEqual', eg.args, ('test', []))\n    excs = (ValueError(1), KeyboardInterrupt(2))\n    eg = BaseExceptionGroup('test', excs)\n    assert repr(eg) == \"BaseExceptionGroup('test', (ValueError(1), KeyboardInterrupt(2)))\", ('assertEqual', repr(eg), \"BaseExceptionGroup('test', (ValueError(1), KeyboardInterrupt(2)))\")\n    excs = collections.deque([ValueError(1), TypeError(2)])\n    eg = ExceptionGroup('test', excs)\n    assert repr(eg) == \"ExceptionGroup('test', deque([ValueError(1), TypeError(2)]))\", ('assertEqual', repr(eg), \"ExceptionGroup('test', deque([ValueError(1), TypeError(2)]))\")\n    excs.clear()\n    assert repr(eg) == \"ExceptionGroup('test', deque([ValueError(1), TypeError(2)]))\", ('assertEqual', repr(eg), \"ExceptionGroup('test', deque([ValueError(1), TypeError(2)]))\")\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StrAndReprTests.test_repr_raises" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport collections\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class MySeq(collections.abc.Sequence):\n\n        def __init__(self, raises):\n            self.raises = raises\n\n        def __len__(self):\n            return 1\n\n        def __getitem__(self, index):\n            if index == 0:\n                return ValueError(1)\n            raise IndexError\n\n        def __repr__(self):\n            if self.raises:\n                raise self.raises\n            return None\n    seq = MySeq(None)\n    try:\n        ExceptionGroup('test', seq)\n    except TypeError as _exc:\n        assert _re.search('__repr__ returned non-string \\\\(type NoneType\\\\)', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    seq = MySeq(ValueError)\n    try:\n        BaseExceptionGroup('test', seq)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

