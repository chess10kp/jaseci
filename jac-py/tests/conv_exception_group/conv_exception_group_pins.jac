}

test "NestedExceptionGroupBasicsTest.test_nested_group_chaining" {
    (ok, detail) = p2_libtest_run_snippet("def create_simple_eg():\n    excs = []\n    try:\n        try:\n            raise MemoryError('context and cause for ValueError(1)')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        try:\n            raise OSError('context for TypeError')\n        except OSError as e:\n            raise TypeError(int)\n    except TypeError as e:\n        excs.append(e)\n    try:\n        try:\n            raise ImportError('context for ValueError(2)')\n        except ImportError as e:\n            raise ValueError(2)\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('simple eg', excs)\n    except ExceptionGroup as e:\n        return e\n\ndef leaf_generator(exc, tbs=None):\n    if tbs is None:\n        tbs = []\n    tbs.append(exc.__traceback__)\n    if isinstance(exc, BaseExceptionGroup):\n        for e in exc.exceptions:\n            yield from leaf_generator(e, tbs)\n    else:\n        yield (exc, tbs)\n    tbs.pop()\n\ndef create_nested_eg():\n    excs = []\n    try:\n        try:\n            raise TypeError(bytes)\n        except TypeError as e:\n            raise ExceptionGroup('nested', [e])\n    except ExceptionGroup as e:\n        excs.append(e)\n    try:\n        try:\n            raise MemoryError('out of memory')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('root', excs)\n    except ExceptionGroup as eg:\n        return eg\n\ndef _t():\n    eg = create_nested_eg()\n    assert isinstance(eg.exceptions[1].__context__, MemoryError), ('assertIsInstance', eg.exceptions[1].__context__, MemoryError)\n    assert isinstance(eg.exceptions[1].__cause__, MemoryError), ('assertIsInstance', eg.exceptions[1].__cause__, MemoryError)\n    assert isinstance(eg.exceptions[0].__context__, TypeError), ('assertIsInstance', eg.exceptions[0].__context__, TypeError)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NestedExceptionGroupSplitTest.test_split_copies_notes" {
    (ok, detail) = p2_libtest_run_snippet("def create_simple_eg():\n    excs = []\n    try:\n        try:\n            raise MemoryError('context and cause for ValueError(1)')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        try:\n            raise OSError('context for TypeError')\n        except OSError as e:\n            raise TypeError(int)\n    except TypeError as e:\n        excs.append(e)\n    try:\n        try:\n            raise ImportError('context for ValueError(2)')\n        except ImportError as e:\n            raise ValueError(2)\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('simple eg', excs)\n    except ExceptionGroup as e:\n        return e\n\ndef leaf_generator(exc, tbs=None):\n    if tbs is None:\n        tbs = []\n    tbs.append(exc.__traceback__)\n    if isinstance(exc, BaseExceptionGroup):\n        for e in exc.exceptions:\n            yield from leaf_generator(e, tbs)\n    else:\n        yield (exc, tbs)\n    tbs.pop()\n\ndef create_nested_eg():\n    excs = []\n    try:\n        try:\n            raise TypeError(bytes)\n        except TypeError as e:\n            raise ExceptionGroup('nested', [e])\n    except ExceptionGroup as e:\n        excs.append(e)\n    try:\n        try:\n            raise MemoryError('out of memory')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('root', excs)\n    except ExceptionGroup as eg:\n        return eg\n\ndef _t():\n    eg = ExceptionGroup('eg', [ValueError(1), TypeError(2)])\n    eg.add_note('note1')\n    eg.add_note('note2')\n    orig_notes = list(eg.__notes__)\n    match, rest = eg.split(TypeError)\n    assert eg.__notes__ == orig_notes, ('assertEqual', eg.__notes__, orig_notes)\n    assert match.__notes__ == orig_notes, ('assertEqual', match.__notes__, orig_notes)\n    assert rest.__notes__ == orig_notes, ('assertEqual', rest.__notes__, orig_notes)\n    assert eg.__notes__ is not match.__notes__, ('assertIsNot', eg.__notes__, match.__notes__)\n    assert eg.__notes__ is not rest.__notes__, ('assertIsNot', eg.__notes__, rest.__notes__)\n    assert match.__notes__ is not rest.__notes__, ('assertIsNot', match.__notes__, rest.__notes__)\n    eg.add_note('eg')\n    match.add_note('match')\n    rest.add_note('rest')\n    assert eg.__notes__ == orig_notes + ['eg'], ('assertEqual', eg.__notes__, orig_notes + ['eg'])\n    assert match.__notes__ == orig_notes + ['match'], ('assertEqual', match.__notes__, orig_notes + ['match'])\n    assert rest.__notes__ == orig_notes + ['rest'], ('assertEqual', rest.__notes__, orig_notes + ['rest'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NestedExceptionGroupSplitTest.test_split_does_not_copy_non_sequence_notes" {
    (ok, detail) = p2_libtest_run_snippet("def create_simple_eg():\n    excs = []\n    try:\n        try:\n            raise MemoryError('context and cause for ValueError(1)')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        try:\n            raise OSError('context for TypeError')\n        except OSError as e:\n            raise TypeError(int)\n    except TypeError as e:\n        excs.append(e)\n    try:\n        try:\n            raise ImportError('context for ValueError(2)')\n        except ImportError as e:\n            raise ValueError(2)\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('simple eg', excs)\n    except ExceptionGroup as e:\n        return e\n\ndef leaf_generator(exc, tbs=None):\n    if tbs is None:\n        tbs = []\n    tbs.append(exc.__traceback__)\n    if isinstance(exc, BaseExceptionGroup):\n        for e in exc.exceptions:\n            yield from leaf_generator(e, tbs)\n    else:\n        yield (exc, tbs)\n    tbs.pop()\n\ndef create_nested_eg():\n    excs = []\n    try:\n        try:\n            raise TypeError(bytes)\n        except TypeError as e:\n            raise ExceptionGroup('nested', [e])\n    except ExceptionGroup as e:\n        excs.append(e)\n    try:\n        try:\n            raise MemoryError('out of memory')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('root', excs)\n    except ExceptionGroup as eg:\n        return eg\n\ndef _t():\n    eg = ExceptionGroup('eg', [ValueError(1), TypeError(2)])\n    eg.__notes__ = 123\n    match, rest = eg.split(TypeError)\n    assert not hasattr(match, '__notes__'), ('assertNotHasAttr', match, '__notes__')\n    assert not hasattr(rest, '__notes__'), ('assertNotHasAttr', rest, '__notes__')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NestedExceptionGroupSplitTest.test_drive_invalid_return_value" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef create_simple_eg():\n    excs = []\n    try:\n        try:\n            raise MemoryError('context and cause for ValueError(1)')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        try:\n            raise OSError('context for TypeError')\n        except OSError as e:\n            raise TypeError(int)\n    except TypeError as e:\n        excs.append(e)\n    try:\n        try:\n            raise ImportError('context for ValueError(2)')\n        except ImportError as e:\n            raise ValueError(2)\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('simple eg', excs)\n    except ExceptionGroup as e:\n        return e\n\ndef leaf_generator(exc, tbs=None):\n    if tbs is None:\n        tbs = []\n    tbs.append(exc.__traceback__)\n    if isinstance(exc, BaseExceptionGroup):\n        for e in exc.exceptions:\n            yield from leaf_generator(e, tbs)\n    else:\n        yield (exc, tbs)\n    tbs.pop()\n\ndef create_nested_eg():\n    excs = []\n    try:\n        try:\n            raise TypeError(bytes)\n        except TypeError as e:\n            raise ExceptionGroup('nested', [e])\n    except ExceptionGroup as e:\n        excs.append(e)\n    try:\n        try:\n            raise MemoryError('out of memory')\n        except MemoryError as e:\n            raise ValueError(1) from e\n    except ValueError as e:\n        excs.append(e)\n    try:\n        raise ExceptionGroup('root', excs)\n    except ExceptionGroup as eg:\n        return eg\n\ndef _t():\n\n    class MyEg(ExceptionGroup):\n\n        def derive(self, excs):\n            return 42\n    eg = MyEg('eg', [TypeError(1), ValueError(2)])\n    msg = 'derive must return an instance of BaseExceptionGroup'\n    try:\n        eg.split(TypeError)\n    except TypeError as _exc:\n        assert _re.search(msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        eg.subgroup(TypeError)\n    except TypeError as _exc:\n        assert _re.search(msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
