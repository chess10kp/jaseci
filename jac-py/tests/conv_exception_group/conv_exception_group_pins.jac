 ValueError(2)]\n    f = lambda e: True\n    for callable in [f, Predicate(f), Predicate(f).method]:\n        assert self.eg is self.eg.subgroup(callable), ('assertIs', self.eg, self.eg.subgroup(callable))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
