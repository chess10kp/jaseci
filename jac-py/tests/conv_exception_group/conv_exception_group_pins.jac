 eg = BaseExceptionGroup('nested', [eg, ValueError(1), eg, TypeError(2)])\n    assert str(eg) == 'nested (4 sub-exceptions)', ('assertEqual', str(eg), 'nested (4 sub-exceptions)')\n    assert repr(eg) == \"ExceptionGroup('nested', [ExceptionGroup('flat', [ValueError(1), TypeError(2)]), ValueError(1), ExceptionGroup('flat', [ValueError(1), TypeError(2)]), TypeError(2)])\", ('assertEqual', repr(eg), \"ExceptionGroup('nested', [ExceptionGroup('flat', [ValueError(1), TypeError(2)]), ValueError(1), ExceptionGroup('flat', [ValueError(1), TypeError(2)]), TypeError(2)])\")\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
