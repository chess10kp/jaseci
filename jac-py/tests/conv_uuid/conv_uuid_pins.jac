test "TestUUIDWithExtModule.test_uuid1_safe" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport unittest\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    try:\n        import _uuid\n    except ImportError:\n        has_uuid_generate_time_safe = False\n    else:\n        has_uuid_generate_time_safe = _uuid.has_uuid_generate_time_safe\n    if not has_uuid_generate_time_safe or not self.uuid._generate_time_safe:\n        raise unittest.SkipTest('requires uuid_generate_time_safe(3)')\n    u = self.uuid.uuid1()\n    assert u.is_safe != self.uuid.SafeUUID.unknown, ('assertNotEqual', u.is_safe, self.uuid.SafeUUID.unknown)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithoutExtModule.test_uuid1_time" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    with mock.patch.object(self.uuid, '_generate_time_safe', None), mock.patch.object(self.uuid, '_last_timestamp', None), mock.patch.object(self.uuid, 'getnode', return_value=93328246233727), mock.patch('time.time_ns', return_value=1545052026752910643), mock.patch('random.getrandbits', return_value=5317):\n        u = self.uuid.uuid1()\n        assert u == self.uuid.UUID('a7a55b92-01fc-11e9-94c5-54e1acf6da7f'), ('assertEqual', u, self.uuid.UUID('a7a55b92-01fc-11e9-94c5-54e1acf6da7f'))\n    with mock.patch.object(self.uuid, '_generate_time_safe', None), mock.patch.object(self.uuid, '_last_timestamp', None), mock.patch('time.time_ns', return_value=1545052026752910643):\n        u = self.uuid.uuid1(node=93328246233727, clock_seq=5317)\n        assert u == self.uuid.UUID('a7a55b92-01fc-11e9-94c5-54e1acf6da7f'), ('assertEqual', u, self.uuid.UUID('a7a55b92-01fc-11e9-94c5-54e1acf6da7f'))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

