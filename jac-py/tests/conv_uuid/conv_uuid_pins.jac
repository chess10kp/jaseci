}

test "TestUUIDWithExtModule.test_max_uuid" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    max_uuid = self.uuid.MAX\n    s = 'ffffffff-ffff-ffff-ffff-ffffffffffff'\n    i = (1 << 128) - 1\n    assert max_uuid == self.uuid.UUID(s), ('assertEqual', max_uuid, self.uuid.UUID(s))\n    assert max_uuid == self.uuid.UUID(int=i), ('assertEqual', max_uuid, self.uuid.UUID(int=i))\n    assert max_uuid.int == i, ('assertEqual', max_uuid.int, i)\n    assert str(max_uuid) == s, ('assertEqual', str(max_uuid), s)\n    assert max_uuid.variant == self.uuid.RESERVED_FUTURE, ('assertEqual', max_uuid.variant, self.uuid.RESERVED_FUTURE)\n    assert max_uuid.version is None, ('assertIsNone', max_uuid.version)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

