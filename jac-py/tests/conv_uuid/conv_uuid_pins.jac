test "TestUUIDWithExtModule.test_pickle_roundtrip" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport copy\nimport pickle\nimport sys\nfrom test import support\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n\n    def check(actual, expected):\n        assert actual == expected, ('assertEqual', actual, expected)\n        assert actual.is_safe == expected.is_safe, ('assertEqual', actual.is_safe, expected.is_safe)\n    with support.swap_item(sys.modules, 'uuid', self.uuid):\n        for is_safe in self.uuid.SafeUUID:\n            u = self.uuid.UUID('d82579ce6642a0de7ddf490a7aec7aa5', is_safe=is_safe)\n            check(copy.copy(u), u)\n            check(copy.deepcopy(u), u)\n            for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n                check(pickle.loads(pickle.dumps(u, proto)), u)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

