test "TestUUIDWithoutExtModule.test_uuid7_monotonicity" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport os\nimport random\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    us = [self.uuid.uuid7() for _ in range(10000)]\n    assert us == sorted(us), ('assertEqual', us, sorted(us))\n    with mock.patch.multiple(self.uuid, _last_timestamp_v7=0, _last_counter_v7=0):\n        timestamp_ns = 1672533296123456789\n        timestamp_ms, _ = divmod(timestamp_ns, 1000000)\n        counter_hi = random.getrandbits(11)\n        counter_lo = random.getrandbits(29)\n        counter = counter_hi << 30 | counter_lo\n        assert counter + 1 < 4398046511103, ('assertLess', counter + 1, 4398046511103)\n        tail = random.getrandbits(32)\n        random_bits = counter << 32 | tail\n        random_data = random_bits.to_bytes(10)\n        with mock.patch('time.time_ns', return_value=timestamp_ns), mock.patch('os.urandom', return_value=random_data) as urand:\n            u1 = self.uuid.uuid7()\n            urand.assert_called_once_with(10)\n            assert self.uuid._last_timestamp_v7 == timestamp_ms, ('assertEqual', self.uuid._last_timestamp_v7, timestamp_ms)\n            assert self.uuid._last_counter_v7 == counter, ('assertEqual', self.uuid._last_counter_v7, counter)\n            assert u1.time == timestamp_ms, ('assertEqual', u1.time, timestamp_ms)\n            assert u1.int >> 64 & 4095 == counter_hi, ('assertEqual', u1.int >> 64 & 4095, counter_hi)\n            assert u1.int >> 32 & 1073741823 == counter_lo, ('assertEqual', u1.int >> 32 & 1073741823, counter_lo)\n            assert u1.int & 4294967295 == tail, ('assertEqual', u1.int & 4294967295, tail)\n        next_timestamp_ns = 1672533296123457032\n        next_timestamp_ms, _ = divmod(timestamp_ns, 1000000)\n        assert timestamp_ms == next_timestamp_ms, ('assertEqual', timestamp_ms, next_timestamp_ms)\n        next_tail_bytes = os.urandom(4)\n        next_fail = int.from_bytes(next_tail_bytes)\n        with mock.patch('time.time_ns', return_value=next_timestamp_ns), mock.patch('os.urandom', return_value=next_tail_bytes) as urand:\n            u2 = self.uuid.uuid7()\n            urand.assert_called_once_with(4)\n            assert self.uuid._last_timestamp_v7 == timestamp_ms, ('assertEqual', self.uuid._last_timestamp_v7, timestamp_ms)\n            assert self.uuid._last_counter_v7 == counter + 1, ('assertEqual', self.uuid._last_counter_v7, counter + 1)\n            assert u2.time == timestamp_ms, ('assertEqual', u2.time, timestamp_ms)\n            assert u2.int >> 64 & 4095 == counter_hi, ('assertEqual', u2.int >> 64 & 4095, counter_hi)\n            assert u2.int >> 32 & 1073741823 == counter_lo + 1, ('assertEqual', u2.int >> 32 & 1073741823, counter_lo + 1)\n            assert u2.int & 4294967295 == next_fail, ('assertEqual', u2.int & 4294967295, next_fail)\n        assert u1 < u2, ('assertLess', u1, u2)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

