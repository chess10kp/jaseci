test "TestUUIDWithExtModule.test_uuid7_timestamp_backwards" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport os\nimport random\nfrom unittest import mock\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    timestamp_ns = 1672533296123456789\n    timestamp_ms, _ = divmod(timestamp_ns, 1000000)\n    fake_last_timestamp_v7 = timestamp_ms + 1\n    counter_hi = random.getrandbits(11)\n    counter_lo = random.getrandbits(29)\n    counter = counter_hi << 30 | counter_lo\n    assert counter + 1 < 4398046511103, ('assertLess', counter + 1, 4398046511103)\n    tail_bytes = os.urandom(4)\n    tail = int.from_bytes(tail_bytes)\n    with mock.patch.multiple(self.uuid, _last_timestamp_v7=fake_last_timestamp_v7, _last_counter_v7=counter), mock.patch('time.time_ns', return_value=timestamp_ns), mock.patch('os.urandom', return_value=tail_bytes) as urand:\n        u = self.uuid.uuid7()\n        urand.assert_called_once_with(4)\n        assert u.variant == self.uuid.RFC_4122, ('assertEqual', u.variant, self.uuid.RFC_4122)\n        assert u.version == 7, ('assertEqual', u.version, 7)\n        assert self.uuid._last_timestamp_v7 == fake_last_timestamp_v7 + 1, ('assertEqual', self.uuid._last_timestamp_v7, fake_last_timestamp_v7 + 1)\n        unix_ts_ms = fake_last_timestamp_v7 + 1 & 281474976710655\n        assert u.time == unix_ts_ms, ('assertEqual', u.time, unix_ts_ms)\n        assert u.int >> 80 & 281474976710655 == unix_ts_ms, ('assertEqual', u.int >> 80 & 281474976710655, unix_ts_ms)\n        assert self.uuid._last_counter_v7 == counter + 1, ('assertEqual', self.uuid._last_counter_v7, counter + 1)\n        assert u.int >> 64 & 4095 == counter_hi, ('assertEqual', u.int >> 64 & 4095, counter_hi)\n        assert u.int >> 32 & 1073741823 == counter_lo + 1, ('assertEqual', u.int >> 32 & 1073741823, counter_lo + 1)\n        assert u.int & 4294967295 == tail, ('assertEqual', u.int & 4294967295, tail)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

