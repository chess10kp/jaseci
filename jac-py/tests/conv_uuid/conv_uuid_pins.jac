test "TestUUIDWithoutExtModule.test_uuid6" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    u = self.uuid.uuid6()\n    assert u.variant == self.uuid.RFC_4122, ('assertEqual', u.variant, self.uuid.RFC_4122)\n    assert u.version == 6, ('assertEqual', u.version, 6)\n    fake_nanoseconds = 1545052026752910643\n    fake_node_value = 93328246233727\n    fake_clock_seq = 5317\n    with mock.patch.object(self.uuid, '_last_timestamp_v6', None), mock.patch.object(self.uuid, 'getnode', return_value=fake_node_value), mock.patch('time.time_ns', return_value=fake_nanoseconds), mock.patch('random.getrandbits', return_value=fake_clock_seq):\n        u = self.uuid.uuid6()\n        assert u.variant == self.uuid.RFC_4122, ('assertEqual', u.variant, self.uuid.RFC_4122)\n        assert u.version == 6, ('assertEqual', u.version, 6)\n        assert u.time == 137643448267529106, ('assertEqual', u.time, 137643448267529106)\n        assert u.fields[0] == 512761802, ('assertEqual', u.fields[0], 512761802)\n        assert u.fields[1] == 31317, ('assertEqual', u.fields[1], 31317)\n        assert u.fields[2] >> 12 & 15 == 6, ('assertEqual', u.fields[2] >> 12 & 15, 6)\n        assert u.fields[2] & 4095 == 2962, ('assertEqual', u.fields[2] & 4095, 2962)\n        assert u.fields[3] >> 6 & 15 == 2, ('assertEqual', u.fields[3] >> 6 & 15, 2)\n        assert u.fields[3] & 63 == fake_clock_seq >> 8, ('assertEqual', u.fields[3] & 63, fake_clock_seq >> 8)\n        assert u.fields[4] == fake_clock_seq & 255, ('assertEqual', u.fields[4], fake_clock_seq & 255)\n        assert u.fields[5] == fake_node_value, ('assertEqual', u.fields[5], fake_node_value)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

