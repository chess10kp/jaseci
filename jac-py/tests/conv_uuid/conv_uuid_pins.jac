test "TestUUIDWithoutExtModule.test_uuid6_uniqueness" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    uuids = {self.uuid.uuid6() for _ in range(1000)}\n    assert len(uuids) == 1000, ('assertEqual', len(uuids), 1000)\n    versions = {u.version for u in uuids}\n    assert versions == {6}, ('assertSetEqual', versions, {6})\n    timestamp = 138648505420000000\n    fake_nanoseconds = (timestamp - 122192928000000000) * 100\n    with mock.patch('time.time_ns', return_value=fake_nanoseconds):\n\n        def gen():\n            with mock.patch.object(self.uuid, '_last_timestamp_v6', None):\n                return self.uuid.uuid6(node=0, clock_seq=None)\n        N = 1024\n        uuids = {gen() for _ in range(N)}\n        assert {u.node for u in uuids} == {0}, ('assertSetEqual', {u.node for u in uuids}, {0})\n        assert {u.time for u in uuids} == {timestamp}, ('assertSetEqual', {u.time for u in uuids}, {timestamp})\n        assert len(uuids) < N, ('assertLess', len(uuids), N)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

