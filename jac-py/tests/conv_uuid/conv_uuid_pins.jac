287307832597519156748809049798316161701L\\nX\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\n(NtRub.', b'\\x80\\x02cuuid\\nUUID\\n)\\x81}(X\\x03\\x00\\x00\\x00int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00X\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\nN\\x85Rub.', b'\\x80\\x03cuuid\\nUUID\\n)\\x81}(X\\x03\\x00\\x00\\x00int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00X\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\nN\\x85Rub.', b'\\x80\\x04\\x95F\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x8c\\x04uuid\\x94\\x8c\\x04UUID\\x93)\\x81}(\\x8c\\x03int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00\\x8c\\x07is_safeh\\x00\\x8c\\x08SafeUUID\\x93N\\x85Rub.']\n    pickled_uuids_safe = [b'ccopy_reg\\n_reconstructor\\n(cuuid\\nUUID\\nc__builtin__\\nobject\\nNtR(dVint\\nL287307832597519156748809049798316161701L\\nsVis_safe\\ncuuid\\nSafeUUID\\n(I0\\ntRsb.', b'ccopy_reg\\n_reconstructor\\n(cuuid\\nUUID\\nc__builtin__\\nobject\\nNtR}(X\\x03\\x00\\x00\\x00intL287307832597519156748809049798316161701L\\nX\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\n(K\\x00tRub.', b'\\x80\\x02cuuid\\nUUID\\n)\\x81}(X\\x03\\x00\\x00\\x00int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00X\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\nK\\x00\\x85Rub.', b'\\x80\\x03cuuid\\nUUID\\n)\\x81}(X\\x03\\x00\\x00\\x00int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00X\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\nK\\x00\\x85Rub.', b'\\x80\\x04\\x95G\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x8c\\x04uuid\\x94\\x8c\\x04UUID\\x93)\\x81}(\\x8c\\x03int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00\\x8c\\x07is_safeh\\x00\\x8c\\x08SafeUUID\\x93K\\x00\\x85Rub.']\n    pickled_uuids_unsafe = [b'ccopy_reg\\n_reconstructor\\n(cuuid\\nUUID\\nc__builtin__\\nobject\\nNtR(dVint\\nL287307832597519156748809049798316161701L\\nsVis_safe\\ncuuid\\nSafeUUID\\n(I-1\\ntRsb.', b'ccopy_reg\\n_reconstructor\\n(cuuid\\nUUID\\nc__builtin__\\nobject\\nNtR}(X\\x03\\x00\\x00\\x00intL287307832597519156748809049798316161701L\\nX\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\n(J\\xff\\xff\\xff\\xfftRub.', b'\\x80\\x02cuuid\\nUUID\\n)\\x81}(X\\x03\\x00\\x00\\x00int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00X\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\nJ\\xff\\xff\\xff\\xff\\x85Rub.', b'\\x80\\x03cuuid\\nUUID\\n)\\x81}(X\\x03\\x00\\x00\\x00int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00X\\x07\\x00\\x00\\x00is_safecuuid\\nSafeUUID\\nJ\\xff\\xff\\xff\\xff\\x85Rub.', b'\\x80\\x04\\x95J\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x8c\\x04uuid\\x94\\x8c\\x04UUID\\x93)\\x81}(\\x8c\\x03int\\x8a\\x11\\xa5z\\xecz\\nI\\xdf}\\xde\\xa0Bf\\xcey%\\xd8\\x00\\x8c\\x07is_safeh\\x00\\x8c\\x08SafeUUID\\x93J\\xff\\xff\\xff\\xff\\x85Rub.']\n    u = self.uuid.UUID('d82579ce6642a0de7ddf490a7aec7aa5')\n    u_safe = self.uuid.UUID('d82579ce6642a0de7ddf490a7aec7aa5', is_safe=self.uuid.SafeUUID.safe)\n    u_unsafe = self.uuid.UUID('d82579ce6642a0de7ddf490a7aec7aa5', is_safe=self.uuid.SafeUUID.unsafe)\n    with support.swap_item(sys.modules, 'uuid', self.uuid):\n        for pickled in pickled_uuids:\n            check(pickle.loads(pickled), u)\n        for pickled in pickled_uuids_safe:\n            check(pickle.loads(pickled), u_safe)\n        for pickled in pickled_uuids_unsafe:\n            check(pickle.loads(pickled), u_unsafe)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithoutExtModule.test_uuid1_eui64" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    too_large_getter = lambda: 1 << 48\n    with mock.patch.multiple(self.uuid, _node=None, _GETTERS=[too_large_getter]):\n        node = self.uuid.getnode()\n    assert 0 < node < 1 << 48, ('assertTrue', 0 < node < 1 << 48)\n    try:\n        self.uuid.uuid1(node=node)\n    except ValueError:\n        raise AssertionError('uuid1 was given an invalid node ID')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

