60, 22136, 18, 52, 95073701484152), 24197857161011715162171839636988778104, 'urn:uuid:12345678-1234-5678-1234-567812345678', 466142576285865592, 4660, self.uuid.RESERVED_NCS, None), ('6ba7b810-9dad-11d1-80b4-00c04fd430c8', '{6ba7b810-9dad-11d1-80b4-00c04fd430c8}', '6ba7b8109dad11d180b400c04fd430c8', b'k\\xa7\\xb8\\x10\\x9d\\xad\\x11\\xd1\\x80\\xb4\\x00\\xc0O\\xd40\\xc8', b'\\x10\\xb8\\xa7k\\xad\\x9d\\xd1\\x11\\x80\\xb4\\x00\\xc0O\\xd40\\xc8', (1806153744, 40365, 4561, 128, 180, 825973027016), 143098242404177361603877621312831893704, 'urn:uuid:6ba7b810-9dad-11d1-80b4-00c04fd430c8', 131059232331511824, 180, self.uuid.RFC_4122, 1), ('6ba7b811-9dad-11d1-80b4-00c04fd430c8', '{6ba7b811-9dad-11d1-80b4-00c04fd430c8}', '6ba7b8119dad11d180b400c04fd430c8', b'k\\xa7\\xb8\\x11\\x9d\\xad\\x11\\xd1\\x80\\xb4\\x00\\xc0O\\xd40\\xc8', b'\\x11\\xb8\\xa7k\\xad\\x9d\\xd1\\x11\\x80\\xb4\\x00\\xc0O\\xd40\\xc8', (1806153745, 40365, 4561, 128, 180, 825973027016), 143098242483405524118141958906375844040, 'urn:uuid:6ba7b811-9dad-11d1-80b4-00c04fd430c8', 131059232331511825, 180, self.uuid.RFC_4122, 1), ('6ba7b812-9dad-11d1-80b4-00c04fd430c8', '{6ba7b812-9dad-11d1-80b4-00c04fd430c8}', '6ba7b8129dad11d180b400c04fd430c8', b'k\\xa7\\xb8\\x12\\x9d\\xad\\x11\\xd1\\x80\\xb4\\x00\\xc0O\\xd40\\xc8', b'\\x12\\xb8\\xa7k\\xad\\x9d\\xd1\\x11\\x80\\xb4\\x00\\xc0O\\xd40\\xc8', (1806153746, 40365, 4561, 128, 180, 825973027016), 143098242562633686632406296499919794376, 'urn:uuid:6ba7b812-9dad-11d1-80b4-00c04fd430c8', 131059232331511826, 180, self.uuid.RFC_4122, 1), ('6ba7b814-9dad-11d1-80b4-00c04fd430c8', '{6ba7b814-9dad-11d1-80b4-00c04fd430c8}', '6ba7b8149dad11d180b400c04fd430c8', b'k\\xa7\\xb8\\x14\\x9d\\xad\\x11\\xd1\\x80\\xb4\\x00\\xc0O\\xd40\\xc8', b'\\x14\\xb8\\xa7k\\xad\\x9d\\xd1\\x11\\x80\\xb4\\x00\\xc0O\\xd40\\xc8', (1806153748, 40365, 4561, 128, 180, 825973027016), 143098242721090011660934971687007695048, 'urn:uuid:6ba7b814-9dad-11d1-80b4-00c04fd430c8', 131059232331511828, 180, self.uuid.RFC_4122, 1), ('7d444840-9dc0-11d1-b245-5ffdce74fad2', '{7d444840-9dc0-11d1-b245-5ffdce74fad2}', '7d4448409dc011d1b2455ffdce74fad2', b'}DH@\\x9d\\xc0\\x11\\xd1\\xb2E_\\xfd\\xcet\\xfa\\xd2', b'@HD}\\xc0\\x9d\\xd1\\x11\\xb2E_\\xfd\\xcet\\xfa\\xd2', (2101626944, 40384, 4561, 178, 69, 105543695137490), 166508041112410060672666770310773930706, 'urn:uuid:7d444840-9dc0-11d1-b245-5ffdce74fad2', 131059314231363648, 12869, self.uuid.RFC_4122, 1), ('e902893a-9d22-3c7e-a7b8-d6e313b71d9f', '{e902893a-9d22-3c7e-a7b8-d6e313b71d9f}', 'e902893a9d223c7ea7b8d6e313b71d9f', b'\\xe9\\x02\\x89:\\x9d\"<~\\xa7\\xb8\\xd6\\xe3\\x13\\xb7\\x1d\\x9f', b':\\x89\\x02\\xe9\"\\x9d~<\\xa7\\xb8\\xd6\\xe3\\x13\\xb7\\x1d\\x9f', (3909257530, 40226, 15486, 167, 184, 236270776688031), 309723290945582129846206211755626405279, 'urn:uuid:e902893a-9d22-3c7e-a7b8-d6e313b71d9f', 900329748784384314, 10168, self.uuid.RFC_4122, 3), ('eb424026-6f54-4ef8-a4d0-bb658a1fc6cf', '{eb424026-6f54-4ef8-a4d0-bb658a1fc6cf}', 'eb4240266f544ef8a4d0bb658a1fc6cf', b'\\xebB@&oTN\\xf8\\xa4\\xd0\\xbbe\\x8a\\x1f\\xc6\\xcf', b'&@B\\xebTo\\xf8N\\xa4\\xd0\\xbbe\\x8a\\x1f\\xc6\\xcf', (3946987558, 28500, 20216, 164, 208, 206044783429327), 312712571721458096795100956955942831823, 'urn:uuid:eb424026-6f54-4ef8-a4d0-bb658a1fc6cf', 1078734521270157350, 9424, self.uuid.RFC_4122, 4), ('f81d4fae-7dec-11d0-a765-00a0c91e6bf6', '{f81d4fae-7dec-11d0-a765-00a0c91e6bf6}', 'f81d4fae7dec11d0a76500a0c91e6bf6', b'\\xf8\\x1dO\\xae}\\xec\\x11\\xd0\\xa7e\\x00\\xa0\\xc9\\x1ek\\xf6', b'\\xaeO\\x1d\\xf8\\xec}\\xd0\\x11\\xa7e\\x00\\xa0\\xc9\\x1ek\\xf6', (4162670510, 32236, 4560, 167, 101, 690568981494), 329800735698586629295641978511506172918, 'urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6', 130742845922168750, 10085, self.uuid.RFC_4122, 1), ('fffefdfc-fffe-fffe-fffe-fffefdfcfbfa', '{fffefdfc-fffe-fffe-fffe-fffefdfcfbfa}', 'fffefdfcfffefffefffefffefdfcfbfa', b'\\xff\\xfe\\xfd\\xfc\\xff\\xfe\\xff\\xfe\\xff\\xfe\\xff\\xfe\\xfd\\xfc\\xfb\\xfa', b'\\xfc\\xfd\\xfe\\xff\\xfe\\xff\\xfe\\xff\\xff\\xfe\\xff\\xfe\\xfd\\xfc\\xfb\\xfa', (4294901244, 65534, 65534, 255, 254, 281470647991290), 340277133821575024845345576078114880506, 'urn:uuid:fffefdfc-fffe-fffe-fffe-fffefdfcfbfa', 1152640025335102972, 16382, self.uuid.RESERVED_FUTURE, None), ('ffffffff-ffff-ffff-ffff-ffffffffffff', '{ffffffff-ffff-ffff-ffff-ffffffffffff}', 'ffffffffffffffffffffffffffffffff', b'\\xff' * 16, b'\\xff' * 16, (4294967295, 65535, 65535, 255, 255, 281474976710655), 340282366920938463463374607431768211455, 'urn:uuid:ffffffff-ffff-ffff-ffff-ffffffffffff', 1152921504606846975, 16383, self.uuid.RESERVED_FUTURE, None)]:\n        equivalents = []\n        for u in [self.uuid.UUID(string), self.uuid.UUID(curly), self.uuid.UUID(hex), self.uuid.UUID(bytes=bytes), self.uuid.UUID(bytes_le=bytes_le), self.uuid.UUID(fields=fields), self.uuid.UUID(int=integer), self.uuid.UUID(urn)]:\n            assert str(u) == string, ('assertEqual', str(u), string)\n            assert int(u) == integer, ('assertEqual', int(u), integer)\n            assert u.bytes == bytes, ('assertEqual', u.bytes, bytes)\n            assert u.bytes_le == bytes_le, ('assertEqual', u.bytes_le, bytes_le)\n            assert u.fields == fields, ('assertEqual', u.fields, fields)\n            assert u.time_low == fields[0], ('assertEqual', u.time_low, fields[0])\n            assert u.time_mid == fields[1], ('assertEqual', u.time_mid, fields[1])\n            assert u.time_hi_version == fields[2], ('assertEqual', u.time_hi_version, fields[2])\n            assert u.clock_seq_hi_variant == fields[3], ('assertEqual', u.clock_seq_hi_variant, fields[3])\n            assert u.clock_seq_low == fields[4], ('assertEqual', u.clock_seq_low, fields[4])\n            assert u.node == fields[5], ('assertEqual', u.node, fields[5])\n            assert u.hex == hex, ('assertEqual', u.hex, hex)\n            assert u.int == integer, ('assertEqual', u.int, integer)\n            assert u.urn == urn, ('assertEqual', u.urn, urn)\n            assert u.time == time, ('assertEqual', u.time, time)\n            assert u.clock_seq == clock_seq, ('assertEqual', u.clock_seq, clock_seq)\n            assert u.variant == variant, ('assertEqual', u.variant, variant)\n            assert u.version == version, ('assertEqual', u.version, version)\n            equivalents.append(u)\n        for u in equivalents:\n            for v in equivalents:\n                assert u == v, ('assertEqual', u, v)\n        assert type(u.bytes) == builtins.bytes, ('assertEqual', type(u.bytes), builtins.bytes)\n        assert type(u.bytes_le) == builtins.bytes, ('assertEqual', type(u.bytes_le), builtins.bytes)\n        ascending.append(u)\n    for i in range(len(ascending)):\n        for j in range(len(ascending)):\n            assert (i < j) == (ascending[i] < ascending[j]), ('assertEqual', (i < j), (ascending[i] < ascending[j]))\n            assert (i <= j) == (ascending[i] <= ascending[j]), ('assertEqual', (i <= j), (ascending[i] <= ascending[j]))\n            assert (i == j) == (ascending[i] == ascending[j]), ('assertEqual', (i == j), (ascending[i] == ascending[j]))\n            assert (i > j) == (ascending[i] > ascending[j]), ('assertEqual', (i > j), (ascending[i] > ascending[j]))\n            assert (i >= j) == (ascending[i] >= ascending[j]), ('assertEqual', (i >= j), (ascending[i] >= ascending[j]))\n            assert (i != j) == (ascending[i] != ascending[j]), ('assertEqual', (i != j), (ascending[i] != ascending[j]))\n    resorted = ascending[:]\n    resorted.reverse()\n    resorted.sort()\n    assert ascending == resorted, ('assertEqual', ascending, resorted)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithoutExtModule.test_exceptions" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    try:\n        (lambda: self.uuid.UUID(''))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('abc'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('1234567812345678123456781234567'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('123456781234567812345678123456789'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('123456781234567812345678z2345678'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes='abc'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes='\\x00' * 15))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes='\\x00' * 17))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes_le='abc'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes_le='\\x00' * 15))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes_le='\\x00' * 17))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(1,)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(1, 2, 3, 4, 5)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(1, 2, 3, 4, 5, 6, 7)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(-1, 0, 0, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(4294967296, 0, 0, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, -1, 0, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 65536, 0, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, -1, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 65536, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, -1, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 256, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 0, -1, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 0, 256, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 0, 0, -1)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 0, 0, 281474976710656)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('00' * 16, version=0))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('00' * 16, version=42))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(int=-1))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(int=1 << 128))()\n    except ValueError:\n        pass\n    h, b, f, i = ('00' * 16, b'\\x00' * 16, (0, 0, 0, 0, 0, 0), 0)\n    self.uuid.UUID(h)\n    self.uuid.UUID(hex=h)\n    self.uuid.UUID(bytes=b)\n    self.uuid.UUID(bytes_le=b)\n    self.uuid.UUID(fields=f)\n    self.uuid.UUID(int=i)\n    try:\n        (lambda: self.uuid.UUID())()\n    except TypeError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(h, b))()\n    except TypeError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(h, b, b))()\n    except TypeError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(h, b, b, f))()\n    except TypeError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(h, b, b, f, i))()\n    except TypeError:\n        pass\n    for hh in [[], [('hex', h)]]:\n        for bb in [[], [('bytes', b)]]:\n            for bble in [[], [('bytes_le', b)]]:\n                for ii in [[], [('int', i)]]:\n                    for ff in [[], [('fields', f)]]:\n                        args = dict(hh + bb + bble + ii + ff)\n                        if len(args) != 0:\n                            try:\n                                (lambda: self.uuid.UUID(h, **args))()\n                            except TypeError:\n                                pass\n                        if len(args) != 1:\n                            try:\n                                (lambda: self.uuid.UUID(**args))()\n                            except TypeError:\n                                pass\n    u = self.uuid.UUID(h)\n    try:\n        (lambda: setattr(u, 'hex', h))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'bytes', b))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'bytes_le', b))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'fields', f))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'int', i))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'time_low', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'time_mid', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'time_hi_version', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'time_hi_version', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'clock_seq_hi_variant', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'clock_seq_low', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'node', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: u < object())()\n    except TypeError:\n        pass\n    try:\n        (lambda: u > object())()\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithExtModule.test_exceptions" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    try:\n        (lambda: self.uuid.UUID(''))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('abc'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('1234567812345678123456781234567'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('123456781234567812345678123456789'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('123456781234567812345678z2345678'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes='abc'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes='\\x00' * 15))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes='\\x00' * 17))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes_le='abc'))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes_le='\\x00' * 15))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(bytes_le='\\x00' * 17))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(1,)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(1, 2, 3, 4, 5)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(1, 2, 3, 4, 5, 6, 7)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(-1, 0, 0, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(4294967296, 0, 0, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, -1, 0, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 65536, 0, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, -1, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 65536, 0, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, -1, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 256, 0, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 0, -1, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 0, 256, 0)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 0, 0, -1)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(fields=(0, 0, 0, 0, 0, 281474976710656)))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('00' * 16, version=0))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID('00' * 16, version=42))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(int=-1))()\n    except ValueError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(int=1 << 128))()\n    except ValueError:\n        pass\n    h, b, f, i = ('00' * 16, b'\\x00' * 16, (0, 0, 0, 0, 0, 0), 0)\n    self.uuid.UUID(h)\n    self.uuid.UUID(hex=h)\n    self.uuid.UUID(bytes=b)\n    self.uuid.UUID(bytes_le=b)\n    self.uuid.UUID(fields=f)\n    self.uuid.UUID(int=i)\n    try:\n        (lambda: self.uuid.UUID())()\n    except TypeError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(h, b))()\n    except TypeError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(h, b, b))()\n    except TypeError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(h, b, b, f))()\n    except TypeError:\n        pass\n    try:\n        (lambda: self.uuid.UUID(h, b, b, f, i))()\n    except TypeError:\n        pass\n    for hh in [[], [('hex', h)]]:\n        for bb in [[], [('bytes', b)]]:\n            for bble in [[], [('bytes_le', b)]]:\n                for ii in [[], [('int', i)]]:\n                    for ff in [[], [('fields', f)]]:\n                        args = dict(hh + bb + bble + ii + ff)\n                        if len(args) != 0:\n                            try:\n                                (lambda: self.uuid.UUID(h, **args))()\n                            except TypeError:\n                                pass\n                        if len(args) != 1:\n                            try:\n                                (lambda: self.uuid.UUID(**args))()\n                            except TypeError:\n                                pass\n    u = self.uuid.UUID(h)\n    try:\n        (lambda: setattr(u, 'hex', h))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'bytes', b))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'bytes_le', b))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'fields', f))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'int', i))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'time_low', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'time_mid', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'time_hi_version', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'time_hi_version', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'clock_seq_hi_variant', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'clock_seq_low', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: setattr(u, 'node', 0))()\n    except TypeError:\n        pass\n    try:\n        (lambda: u < object())()\n    except TypeError:\n        pass\n    try:\n        (lambda: u > object())()\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithoutExtModule.test_getnode" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    node1 = self.uuid.getnode()\n    assert 0 < node1 < 1 << 48, ('assertTrue', 0 < node1 < 1 << 48)\n    node2 = self.uuid.getnode()\n    assert node1 == node2, ('assertEqual', node1, node2)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

