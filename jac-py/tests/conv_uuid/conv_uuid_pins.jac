test "TestUUIDWithoutExtModule.test_uuid1_eui64" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    too_large_getter = lambda: 1 << 48\n    with mock.patch.multiple(self.uuid, _node=None, _GETTERS=[too_large_getter]):\n        node = self.uuid.getnode()\n    assert 0 < node < 1 << 48, ('assertTrue', 0 < node < 1 << 48)\n    try:\n        self.uuid.uuid1(node=node)\n    except ValueError:\n        raise AssertionError('uuid1 was given an invalid node ID')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithoutExtModule.test_uuid1" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    for u in [self.uuid.uuid1() for i in range(10)]:\n        assert u.variant == self.uuid.RFC_4122, ('assertEqual', u.variant, self.uuid.RFC_4122)\n        assert u.version == 1, ('assertEqual', u.version, 1)\n        assert u.is_safe in {self.uuid.SafeUUID.safe, self.uuid.SafeUUID.unsafe, self.uuid.SafeUUID.unknown}, ('assertIn', u.is_safe, {self.uuid.SafeUUID.safe, self.uuid.SafeUUID.unsafe, self.uuid.SafeUUID.unknown})\n    uuids = {}\n    for u in [self.uuid.uuid1() for i in range(1000)]:\n        uuids[u] = 1\n    assert len(uuids.keys()) == 1000, ('assertEqual', len(uuids.keys()), 1000)\n    u = self.uuid.uuid1(0)\n    assert u.node == 0, ('assertEqual', u.node, 0)\n    u = self.uuid.uuid1(20015998343868)\n    assert u.node == 20015998343868, ('assertEqual', u.node, 20015998343868)\n    u = self.uuid.uuid1(281474976710655)\n    assert u.node == 281474976710655, ('assertEqual', u.node, 281474976710655)\n    u = self.uuid.uuid1(20015998343868, 0)\n    assert u.node == 20015998343868, ('assertEqual', u.node, 20015998343868)\n    assert (u.clock_seq_hi_variant & 63) << 8 | u.clock_seq_low == 0, ('assertEqual', (u.clock_seq_hi_variant & 63) << 8 | u.clock_seq_low, 0)\n    u = self.uuid.uuid1(20015998343868, 4660)\n    assert u.node == 20015998343868, ('assertEqual', u.node, 20015998343868)\n    assert (u.clock_seq_hi_variant & 63) << 8 | u.clock_seq_low == 4660, ('assertEqual', (u.clock_seq_hi_variant & 63) << 8 | u.clock_seq_low, 4660)\n    u = self.uuid.uuid1(20015998343868, 16383)\n    assert u.node == 20015998343868, ('assertEqual', u.node, 20015998343868)\n    assert (u.clock_seq_hi_variant & 63) << 8 | u.clock_seq_low == 16383, ('assertEqual', (u.clock_seq_hi_variant & 63) << 8 | u.clock_seq_low, 16383)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

