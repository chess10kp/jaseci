test "TestUUIDWithoutExtModule.test_uuid6_clock_seq" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    get_clock_seq = lambda u: u.int >> 48 & 16383\n    u = self.uuid.uuid6()\n    assert get_clock_seq(u).bit_length() <= 14, ('assertLessEqual', get_clock_seq(u).bit_length(), 14)\n    big_clock_seq = 65535\n    res_clock_seq = 16383\n    u = self.uuid.uuid6(clock_seq=big_clock_seq)\n    assert get_clock_seq(u) == res_clock_seq, ('assertEqual', get_clock_seq(u), res_clock_seq)\n    for _ in range(10):\n        for b in [7, 14, 28]:\n            node = random.getrandbits(48)\n            clock_seq = 1 << b - 1 | random.getrandbits(b)\n            assert clock_seq.bit_length() == b, ('assertEqual', clock_seq.bit_length(), b)\n            u = self.uuid.uuid6(node=node, clock_seq=clock_seq)\n            assert get_clock_seq(u) == clock_seq & 16383, ('assertEqual', get_clock_seq(u), clock_seq & 16383)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithExtModule.test_uuid6_clock_seq" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    get_clock_seq = lambda u: u.int >> 48 & 16383\n    u = self.uuid.uuid6()\n    assert get_clock_seq(u).bit_length() <= 14, ('assertLessEqual', get_clock_seq(u).bit_length(), 14)\n    big_clock_seq = 65535\n    res_clock_seq = 16383\n    u = self.uuid.uuid6(clock_seq=big_clock_seq)\n    assert get_clock_seq(u) == res_clock_seq, ('assertEqual', get_clock_seq(u), res_clock_seq)\n    for _ in range(10):\n        for b in [7, 14, 28]:\n            node = random.getrandbits(48)\n            clock_seq = 1 << b - 1 | random.getrandbits(b)\n            assert clock_seq.bit_length() == b, ('assertEqual', clock_seq.bit_length(), b)\n            u = self.uuid.uuid6(node=node, clock_seq=clock_seq)\n            assert get_clock_seq(u) == clock_seq & 16383, ('assertEqual', get_clock_seq(u), clock_seq & 16383)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithoutExtModule.test_uuid6_test_vectors" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    timestamp = 138648505420000000\n    fake_nanoseconds = (timestamp - 122192928000000000) * 100\n    node = 175285648414790\n    clock_seq = 3 << 12 | 968\n    with mock.patch.object(self.uuid, '_last_timestamp_v6', None), mock.patch('time.time_ns', return_value=fake_nanoseconds):\n        u = self.uuid.uuid6(node=node, clock_seq=clock_seq)\n        assert str(u).upper() == '1EC9414C-232A-6B00-B3C8-9F6BDECED846', ('assertEqual', str(u).upper(), '1EC9414C-232A-6B00-B3C8-9F6BDECED846')\n        assert u.time == timestamp, ('assertEqual', u.time, timestamp)\n        assert u.int & 281474976710655 == node, ('assertEqual', u.int & 281474976710655, node)\n        assert u.int >> 48 & 16383 == clock_seq, ('assertEqual', u.int >> 48 & 16383, clock_seq)\n        assert u.int >> 62 & 3 == 2, ('assertEqual', u.int >> 62 & 3, 2)\n        assert u.int >> 64 & 4095 == 2816, ('assertEqual', u.int >> 64 & 4095, 2816)\n        assert u.int >> 76 & 15 == 6, ('assertEqual', u.int >> 76 & 15, 6)\n        assert u.int >> 80 & 65535 == 9002, ('assertEqual', u.int >> 80 & 65535, 9002)\n        assert u.int >> 96 & 4294967295 == 516505932, ('assertEqual', u.int >> 96 & 4294967295, 516505932)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

