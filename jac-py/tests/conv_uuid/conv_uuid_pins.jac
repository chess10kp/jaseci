g(command='netstat', args='-ian', heading=b'Address')\n    assert mac == 90520741023335, ('assertEqual', mac, 90520741023335)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestInternalsWithoutExtModule.test_find_mac_near_keyword" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport io\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef mock_get_command_stdout(data):\n\n    def get_command_stdout(command, args):\n        return io.BytesIO(data.encode())\n    return get_command_stdout\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self._uuid = py_uuid\n    _SelfNS._uuid = py_uuid\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    data = '\\nfake      Link encap:UNSPEC  hwaddr 00-00\\ncscotun0  Link encap:UNSPEC  HWaddr 00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00\\neth0      Link encap:Ethernet  HWaddr 12:34:56:78:90:ab\\n'\n    with mock.patch.multiple(self.uuid, _MAC_DELIM=b':', _MAC_OMITS_LEADING_ZEROES=False, _get_command_stdout=mock_get_command_stdout(data)):\n        mac = self.uuid._find_mac_near_keyword(command='ifconfig', args='', keywords=[b'hwaddr'], get_word_index=lambda x: x + 1)\n    assert mac == 20015998341291, ('assertEqual', mac, 20015998341291)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestInternalsWithoutExtModule.test_ip_getnode" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport unittest\nfrom test import support\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    def check_node(node, requires=None):\n        if requires and node is None:\n            raise unittest.SkipTest('requires ' + requires)\n        hex = '%012x' % node\n        if support.verbose >= 2:\n            print(hex, end=' ')\n        assert 0 < node < 1 << 48, ('assertTrue', 0 < node < 1 << 48)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self._uuid = py_uuid\n    _SelfNS._uuid = py_uuid\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    node = self.uuid._ip_getnode()\n    check_node(node, 'ip')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestInternalsWithoutExtModule.test_random_getnode" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport unittest\nfrom test import support\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    def check_node(node, requires=None):\n        if requires and node is None:\n            raise unittest.SkipTest('requires ' + requires)\n        hex = '%012x' % node\n        if support.verbose >= 2:\n            print(hex, end=' ')\n        assert 0 < node < 1 << 48, ('assertTrue', 0 < node < 1 << 48)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self._uuid = py_uuid\n    _SelfNS._uuid = py_uuid\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    node = self.uuid._random_getnode()\n    assert node & 1 << 40, ('assertTrue', node & 1 << 40)\n    check_node(node)\n    node2 = self.uuid._random_getnode()\n    assert node2 != node, ('assertNotEqual', node2, node)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestInternalsWithExtModule.test_parse_mac" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom unittest import mock\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    def check_parse_mac(aix):\n        if not aix:\n            patch = mock.patch.multiple(self.uuid, _MAC_DELIM=b':', _MAC_OMITS_LEADING_ZEROES=False)\n        else:\n            patch = mock.patch.multiple(self.uuid, _MAC_DELIM=b'.', _MAC_OMITS_LEADING_ZEROES=True)\n        with patch:\n            if not aix:\n                tests = ((b'52:54:00:9d:0e:67', 90520741023335), (b'12:34:56:78:90:ab', 20015998341291))\n            else:\n                tests = ((b'fe.ad.c.1.23.4', 280019184198404),)\n            for mac, expected in tests:\n                assert self.uuid._parse_mac(mac) == expected, ('assertEqual', self.uuid._parse_mac(mac), expected)\n            for mac in (b'', b'fe80::5054:ff:fe9', b'123:2:3:4:5:6:7:8', b'52:54:00:9d::67', b'52:54:00:9d:0e52:54:00:9d:0e:6x52-54-00-9d-0e-67'):\n                if aix:\n                    mac = mac.replace(b':', b'.')\n                assert self.uuid._parse_mac(mac) is None, ('assertIsNone', self.uuid._parse_mac(mac))\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self._uuid = py_uuid\n    _SelfNS._uuid = py_uuid\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    check_parse_mac(False)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

