test "TestUUIDWithoutExtModule.testIssue8621" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\n_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nimport os\nfrom test import support\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    fds = os.pipe()\n    pid = os.fork()\n    if pid == 0:\n        os.close(fds[0])\n        value = self.uuid.uuid4()\n        os.write(fds[1], value.hex.encode('latin-1'))\n        os._exit(0)\n    else:\n        os.close(fds[1])\n        _add_cleanup(os.close, *(fds[0],))\n        parent_value = self.uuid.uuid4().hex\n        support.wait_process(pid, exitcode=0)\n        child_value = os.read(fds[0], 100).decode('latin-1')\n        assert parent_value != child_value, ('assertNotEqual', parent_value, child_value)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\nfinally:\n    _run_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithoutExtModule.test_uuid_weakref" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport weakref\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    strong = self.uuid.uuid4()\n    weak = weakref.ref(strong)\n    assert strong is weak(), ('assertIs', strong, weak())\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithExtModule.test_cli_uuid4_outputted_with_no_args" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport contextlib\nimport io\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    stdout = io.StringIO()\n    with contextlib.redirect_stdout(stdout):\n        self.uuid.main()\n    output = stdout.getvalue().strip()\n    uuid_output = self.uuid.UUID(output)\n    assert output == str(uuid_output), ('assertEqual', output, str(uuid_output))\n    assert uuid_output.version == 4, ('assertEqual', uuid_output.version, 4)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithExtModule.test_nil_uuid" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    nil_uuid = self.uuid.NIL\n    s = '00000000-0000-0000-0000-000000000000'\n    i = 0\n    assert nil_uuid == self.uuid.UUID(s), ('assertEqual', nil_uuid, self.uuid.UUID(s))\n    assert nil_uuid == self.uuid.UUID(int=i), ('assertEqual', nil_uuid, self.uuid.UUID(int=i))\n    assert nil_uuid.int == i, ('assertEqual', nil_uuid.int, i)\n    assert str(nil_uuid) == s, ('assertEqual', str(nil_uuid), s)\n    assert nil_uuid.variant == self.uuid.RESERVED_NCS, ('assertEqual', nil_uuid.variant, self.uuid.RESERVED_NCS)\n    assert nil_uuid.version is None, ('assertIsNone', nil_uuid.version)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
