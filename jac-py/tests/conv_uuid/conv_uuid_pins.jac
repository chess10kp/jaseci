test "TestUUIDWithoutExtModule.test_uuid8" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\nfrom itertools import product\nfrom test.support import import_helper\npy_uuid = import_helper.import_fresh_module('uuid', blocked=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = py_uuid\n    _SelfNS.uuid = py_uuid\n    u = self.uuid.uuid8()\n    assert u.variant == self.uuid.RFC_4122, ('assertEqual', u.variant, self.uuid.RFC_4122)\n    assert u.version == 8, ('assertEqual', u.version, 8)\n    for _, hi, mid, lo in product(range(10), [None, 0, random.getrandbits(48)], [None, 0, random.getrandbits(12)], [None, 0, random.getrandbits(62)]):\n        u = self.uuid.uuid8(hi, mid, lo)\n        assert u.variant == self.uuid.RFC_4122, ('assertEqual', u.variant, self.uuid.RFC_4122)\n        assert u.version == 8, ('assertEqual', u.version, 8)\n        if hi is not None:\n            assert u.int >> 80 & 281474976710655 == hi, ('assertEqual', u.int >> 80 & 281474976710655, hi)\n        if mid is not None:\n            assert u.int >> 64 & 4095 == mid, ('assertEqual', u.int >> 64 & 4095, mid)\n        if lo is not None:\n            assert u.int & 4611686018427387903 == lo, ('assertEqual', u.int & 4611686018427387903, lo)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

