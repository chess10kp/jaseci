test "TestUUIDWithExtModule.test_uuid6_node" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    assert self.uuid.uuid6().node.bit_length() <= 48, ('assertLessEqual', self.uuid.uuid6().node.bit_length(), 48)\n    assert self.uuid.uuid6(0).node == 0, ('assertEqual', self.uuid.uuid6(0).node, 0)\n    max_node = 281474976710655\n    assert self.uuid.uuid6(max_node).node == max_node, ('assertEqual', self.uuid.uuid6(max_node).node, max_node)\n    big_node = 3960665672297421\n    res_node = 20015998348237\n    assert self.uuid.uuid6(big_node).node == res_node, ('assertEqual', self.uuid.uuid6(big_node).node, res_node)\n    for _ in range(10):\n        for b in [24, 48, 72]:\n            node = 1 << b - 1 | random.getrandbits(b)\n            assert node.bit_length() == b, ('assertEqual', node.bit_length(), b)\n            u = self.uuid.uuid6(node=node)\n            assert u.node == node & 281474976710655, ('assertEqual', u.node, node & 281474976710655)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUUIDWithExtModule.test_uuid6_clock_seq" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    get_clock_seq = lambda u: u.int >> 48 & 16383\n    u = self.uuid.uuid6()\n    assert get_clock_seq(u).bit_length() <= 14, ('assertLessEqual', get_clock_seq(u).bit_length(), 14)\n    big_clock_seq = 65535\n    res_clock_seq = 16383\n    u = self.uuid.uuid6(clock_seq=big_clock_seq)\n    assert get_clock_seq(u) == res_clock_seq, ('assertEqual', get_clock_seq(u), res_clock_seq)\n    for _ in range(10):\n        for b in [7, 14, 28]:\n            node = random.getrandbits(48)\n            clock_seq = 1 << b - 1 | random.getrandbits(b)\n            assert clock_seq.bit_length() == b, ('assertEqual', clock_seq.bit_length(), b)\n            u = self.uuid.uuid6(node=node, clock_seq=clock_seq)\n            assert get_clock_seq(u) == clock_seq & 16383, ('assertEqual', get_clock_seq(u), clock_seq & 16383)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
