test "TestUUIDWithExtModule.test_uuid7" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport random\nfrom unittest import mock\nfrom test.support import import_helper\nc_uuid = import_helper.import_fresh_module('uuid', fresh=['_uuid'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.uuid = c_uuid\n    _SelfNS.uuid = c_uuid\n    u = self.uuid.uuid7()\n    assert u.variant == self.uuid.RFC_4122, ('assertEqual', u.variant, self.uuid.RFC_4122)\n    assert u.version == 7, ('assertEqual', u.version, 7)\n    timestamp_ns = 1672533296123456789\n    timestamp_ms, _ = divmod(timestamp_ns, 1000000)\n    for _ in range(100):\n        counter_hi = random.getrandbits(11)\n        counter_lo = random.getrandbits(30)\n        counter = counter_hi << 30 | counter_lo\n        tail = random.getrandbits(32)\n        random_bits = counter << 32 | tail\n        random_bits = (1 << 7) - 1 << 73 | random_bits\n        random_data = random_bits.to_bytes(10)\n        with mock.patch.multiple(self.uuid, _last_timestamp_v7=None, _last_counter_v7=0), mock.patch('time.time_ns', return_value=timestamp_ns), mock.patch('os.urandom', return_value=random_data) as urand:\n            u = self.uuid.uuid7()\n            urand.assert_called_once_with(10)\n            assert u.variant == self.uuid.RFC_4122, ('assertEqual', u.variant, self.uuid.RFC_4122)\n            assert u.version == 7, ('assertEqual', u.version, 7)\n            assert self.uuid._last_timestamp_v7 == timestamp_ms, ('assertEqual', self.uuid._last_timestamp_v7, timestamp_ms)\n            assert self.uuid._last_counter_v7 == counter, ('assertEqual', self.uuid._last_counter_v7, counter)\n            unix_ts_ms = timestamp_ms & 281474976710655\n            assert u.time == unix_ts_ms, ('assertEqual', u.time, unix_ts_ms)\n            assert u.int >> 80 & 281474976710655 == unix_ts_ms, ('assertEqual', u.int >> 80 & 281474976710655, unix_ts_ms)\n            assert u.int >> 75 & 1 == 0, ('assertEqual', u.int >> 75 & 1, 0)\n            assert u.int >> 64 & 4095 == counter_hi, ('assertEqual', u.int >> 64 & 4095, counter_hi)\n            assert u.int >> 32 & 1073741823 == counter_lo, ('assertEqual', u.int >> 32 & 1073741823, counter_lo)\n            assert u.int & 4294967295 == tail, ('assertEqual', u.int & 4294967295, tail)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

