    (ok, detail) = p2_libtest_run_snippet("import zipfile, unittest\nfrom test.support import os_helper\nTESTFN = os_helper.TESTFN\n\ndef _t():\n    with zipfile.ZipFile(TESTFN, mode='w', allowZip64=True) as zipf:\n        zipf.debug = 100\n        numfiles = (1 << 16) * 3 // 2\n        for i in range(numfiles):\n            zipf.writestr('foo%08d' % i, '%d' % (i ** 3 % 57))\n        assert len(zipf.namelist()) == numfiles, ('assertEqual', len(zipf.namelist()), numfiles)\n    with zipfile.ZipFile(TESTFN, mode='r') as zipf2:\n        assert len(zipf2.namelist()) == numfiles, ('assertEqual', len(zipf2.namelist()), numfiles)\n        for i in range(numfiles):\n            content = zipf2.read('foo%08d' % i).decode('ascii')\n            assert content == '%d' % (i ** 3 % 57), ('assertEqual', content, '%d' % (i ** 3 % 57))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
