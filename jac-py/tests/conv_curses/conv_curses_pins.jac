test "TestAscii.test_ctypes" {
    (ok, detail) = p2_libtest_run_snippet("import string\nimport sys\nimport curses\nimport curses.ascii\nimport curses.textpad\n\ndef _t():\n\n    def check(func, expected):\n        assert func(i) == expected, ('assertEqual', func(i), expected)\n        assert func(c) == expected, ('assertEqual', func(c), expected)\n    for i in range(256):\n        c = chr(i)\n        b = bytes([i])\n        check(curses.ascii.isalnum, b.isalnum())\n        check(curses.ascii.isalpha, b.isalpha())\n        check(curses.ascii.isdigit, b.isdigit())\n        check(curses.ascii.islower, b.islower())\n        check(curses.ascii.isspace, b.isspace())\n        check(curses.ascii.isupper, b.isupper())\n        check(curses.ascii.isascii, i < 128)\n        check(curses.ascii.ismeta, i >= 128)\n        check(curses.ascii.isctrl, i < 32)\n        check(curses.ascii.iscntrl, i < 32 or i == 127)\n        check(curses.ascii.isblank, c in ' \\t')\n        check(curses.ascii.isgraph, 32 < i <= 126)\n        check(curses.ascii.isprint, 32 <= i <= 126)\n        check(curses.ascii.ispunct, c in string.punctuation)\n        check(curses.ascii.isxdigit, c in string.hexdigits)\n    for i in (-2, -1, 256, sys.maxunicode, sys.maxunicode + 1):\n        assert not curses.ascii.isalnum(i), ('assertFalse', curses.ascii.isalnum(i))\n        assert not curses.ascii.isalpha(i), ('assertFalse', curses.ascii.isalpha(i))\n        assert not curses.ascii.isdigit(i), ('assertFalse', curses.ascii.isdigit(i))\n        assert not curses.ascii.islower(i), ('assertFalse', curses.ascii.islower(i))\n        assert not curses.ascii.isspace(i), ('assertFalse', curses.ascii.isspace(i))\n        assert not curses.ascii.isupper(i), ('assertFalse', curses.ascii.isupper(i))\n        assert not curses.ascii.isascii(i), ('assertFalse', curses.ascii.isascii(i))\n        assert not curses.ascii.isctrl(i), ('assertFalse', curses.ascii.isctrl(i))\n        assert not curses.ascii.iscntrl(i), ('assertFalse', curses.ascii.iscntrl(i))\n        assert not curses.ascii.isblank(i), ('assertFalse', curses.ascii.isblank(i))\n        assert not curses.ascii.isgraph(i), ('assertFalse', curses.ascii.isgraph(i))\n        assert not curses.ascii.isprint(i), ('assertFalse', curses.ascii.isprint(i))\n        assert not curses.ascii.ispunct(i), ('assertFalse', curses.ascii.ispunct(i))\n        assert not curses.ascii.isxdigit(i), ('assertFalse', curses.ascii.isxdigit(i))\n    assert not curses.ascii.ismeta(-1), ('assertFalse', curses.ascii.ismeta(-1))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
