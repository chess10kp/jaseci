    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npwd = import_helper.import_module('pwd')\n\ndef _t():\n    entries = pwd.getpwall()\n    for e in entries:\n        assert len(e) == 7, ('assertEqual', len(e), 7)\n        assert e[0] == e.pw_name, ('assertEqual', e[0], e.pw_name)\n        assert isinstance(e.pw_name, str), ('assertIsInstance', e.pw_name, str)\n        assert e[1] == e.pw_passwd, ('assertEqual', e[1], e.pw_passwd)\n        assert isinstance(e.pw_passwd, str), ('assertIsInstance', e.pw_passwd, str)\n        assert e[2] == e.pw_uid, ('assertEqual', e[2], e.pw_uid)\n        assert isinstance(e.pw_uid, int), ('assertIsInstance', e.pw_uid, int)\n        assert e[3] == e.pw_gid, ('assertEqual', e[3], e.pw_gid)\n        assert isinstance(e.pw_gid, int), ('assertIsInstance', e.pw_gid, int)\n        assert e[4] == e.pw_gecos, ('assertEqual', e[4], e.pw_gecos)\n        assert type(e.pw_gecos) in (str, type(None)), ('assertIn', type(e.pw_gecos), (str, type(None)))\n        assert e[5] == e.pw_dir, ('assertEqual', e[5], e.pw_dir)\n        assert isinstance(e.pw_dir, str), ('assertIsInstance', e.pw_dir, str)\n        assert e[6] == e.pw_shell, ('assertEqual', e[6], e.pw_shell)\n        assert isinstance(e.pw_shell, str), ('assertIsInstance', e.pw_shell, str)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
