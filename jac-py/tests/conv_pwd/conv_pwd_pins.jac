\n            break\n    else:\n        raise AssertionError('Cannot find non-existent uid')\n    if sys.platform != 'cygwin':\n        try:\n            pwd.getpwuid(*(-1,))\n        except KeyError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
