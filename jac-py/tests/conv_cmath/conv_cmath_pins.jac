test "CMathTests.test_cmath_matches_math" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\nINF = float('inf')\nNAN = float('nan')\ncomplex_zeros = [complex(x, y) for x in [0.0, -0.0] for y in [0.0, -0.0]]\ncomplex_infinities = [complex(x, y) for x, y in [(INF, 0.0), (INF, 2.3), (INF, INF), (2.3, INF), (0.0, INF), (-0.0, INF), (-2.3, INF), (-INF, INF), (-INF, 2.3), (-INF, 0.0), (-INF, -0.0), (-INF, -2.3), (-INF, -INF), (-2.3, -INF), (-0.0, -INF), (0.0, -INF), (2.3, -INF), (INF, -INF), (INF, -2.3), (INF, -0.0)]]\ncomplex_nans = [complex(x, y) for x, y in [(NAN, -INF), (NAN, -2.3), (NAN, -0.0), (NAN, 0.0), (NAN, 2.3), (NAN, INF), (-INF, NAN), (-2.3, NAN), (-0.0, NAN), (0.0, NAN), (2.3, NAN), (INF, NAN)]]\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    def rAssertAlmostEqual(a, b, rel_err=2e-15, abs_err=5e-323, msg=None):\n        \"\"\"Fail if the two floating-point numbers are not almost equal.\n\n        Determine whether floating-point values a and b are equal to within\n        a (small) rounding error.  The default values for rel_err and\n        abs_err are chosen to be suitable for platforms where a float is\n        represented by an IEEE 754 double.  They allow an error of between\n        9 and 19 ulps.\n        \"\"\"\n        if math.isnan(a):\n            if math.isnan(b):\n                return\n            raise AssertionError(msg or '{!r} should be nan'.format(b))\n        if math.isinf(a):\n            if a == b:\n                return\n            raise AssertionError(msg or 'finite result where infinity expected: expected {!r}, got {!r}'.format(a, b))\n        if not a and (not b):\n            if math.copysign(1.0, a) != math.copysign(1.0, b):\n                raise AssertionError(msg or 'zero has wrong sign: expected {!r}, got {!r}'.format(a, b))\n        try:\n            absolute_error = abs(b - a)\n        except OverflowError:\n            pass\n        else:\n            if absolute_error <= max(abs_err, rel_err * abs(a)):\n                return\n        raise AssertionError(msg or '{!r} and {!r} are not sufficiently close'.format(a, b))\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    test_values = [0.01, 0.1, 0.2, 0.5, 0.9, 0.99]\n    unit_interval = test_values + [-x for x in test_values] + [0.0, 1.0, -1.0]\n    positive = test_values + [1.0] + [1.0 / x for x in test_values]\n    nonnegative = [0.0] + positive\n    real_line = [0.0] + positive + [-x for x in positive]\n    test_functions = {'acos': unit_interval, 'asin': unit_interval, 'atan': real_line, 'cos': real_line, 'cosh': real_line, 'exp': real_line, 'log': positive, 'log10': positive, 'sin': real_line, 'sinh': real_line, 'sqrt': nonnegative, 'tan': real_line, 'tanh': real_line}\n    for fn, values in test_functions.items():\n        float_fn = getattr(math, fn)\n        complex_fn = getattr(cmath, fn)\n        for v in values:\n            z = complex_fn(v)\n            rAssertAlmostEqual(float_fn(v), z.real)\n            assert 0.0 == z.imag, ('assertEqual', 0.0, z.imag)\n    for base in [0.5, 2.0, 10.0]:\n        for v in positive:\n            z = cmath.log(v, base)\n            rAssertAlmostEqual(math.log(v, base), z.real)\n            assert 0.0 == z.imag, ('assertEqual', 0.0, z.imag)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_specific_values" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\nfrom cmath import phase, polar, rect, pi\nimport platform\nimport sys\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    def rAssertAlmostEqual(a, b, rel_err=2e-15, abs_err=5e-323, msg=None):\n        \"\"\"Fail if the two floating-point numbers are not almost equal.\n\n        Determine whether floating-point values a and b are equal to within\n        a (small) rounding error.  The default values for rel_err and\n        abs_err are chosen to be suitable for platforms where a float is\n        represented by an IEEE 754 double.  They allow an error of between\n        9 and 19 ulps.\n        \"\"\"\n        if math.isnan(a):\n            if math.isnan(b):\n                return\n            raise AssertionError(msg or '{!r} should be nan'.format(b))\n        if math.isinf(a):\n            if a == b:\n                return\n            raise AssertionError(msg or 'finite result where infinity expected: expected {!r}, got {!r}'.format(a, b))\n        if not a and (not b):\n            if math.copysign(1.0, a) != math.copysign(1.0, b):\n                raise AssertionError(msg or 'zero has wrong sign: expected {!r}, got {!r}'.format(a, b))\n        try:\n            absolute_error = abs(b - a)\n        except OverflowError:\n            pass\n        else:\n            if absolute_error <= max(abs_err, rel_err * abs(a)):\n                return\n        raise AssertionError(msg or '{!r} and {!r} are not sufficiently close'.format(a, b))\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    SKIP_ON_TIGER = {'tan0064'}\n    osx_version = None\n    if sys.platform == 'darwin':\n        version_txt = platform.mac_ver()[0]\n        try:\n            osx_version = tuple(map(int, version_txt.split('.')))\n        except ValueError:\n            pass\n\n    def rect_complex(z):\n        \"\"\"Wrapped version of rect that accepts a complex number instead of\n            two float arguments.\"\"\"\n        return cmath.rect(z.real, z.imag)\n\n    def polar_complex(z):\n        \"\"\"Wrapped version of polar that returns a complex number instead of\n            two floats.\"\"\"\n        return complex(*polar(z))\n    for id, fn, ar, ai, er, ei, flags in parse_testfile(test_file):\n        arg = complex(ar, ai)\n        expected = complex(er, ei)\n        if osx_version is not None and osx_version < (10, 5):\n            if id in SKIP_ON_TIGER:\n                continue\n        if fn == 'rect':\n            function = rect_complex\n        elif fn == 'polar':\n            function = polar_complex\n        else:\n            function = getattr(cmath, fn)\n        if 'divide-by-zero' in flags or 'invalid' in flags:\n            try:\n                actual = function(arg)\n            except ValueError:\n                continue\n            else:\n                raise AssertionError('ValueError not raised in test {}: {}(complex({!r}, {!r}))'.format(id, fn, ar, ai))\n        if 'overflow' in flags:\n            try:\n                actual = function(arg)\n            except OverflowError:\n                continue\n            else:\n                raise AssertionError('OverflowError not raised in test {}: {}(complex({!r}, {!r}))'.format(id, fn, ar, ai))\n        actual = function(arg)\n        if 'ignore-real-sign' in flags:\n            actual = complex(abs(actual.real), actual.imag)\n            expected = complex(abs(expected.real), expected.imag)\n        if 'ignore-imag-sign' in flags:\n            actual = complex(actual.real, abs(actual.imag))\n            expected = complex(expected.real, abs(expected.imag))\n        if fn in ('log', 'log10'):\n            real_abs_err = 2e-15\n        else:\n            real_abs_err = 5e-323\n        error_message = '{}: {}(complex({!r}, {!r}))\\nExpected: complex({!r}, {!r})\\nReceived: complex({!r}, {!r})\\nReceived value insufficiently close to expected value.'.format(id, fn, ar, ai, expected.real, expected.imag, actual.real, actual.imag)\n        rAssertAlmostEqual(expected.real, actual.real, abs_err=real_abs_err, msg=error_message)\n        rAssertAlmostEqual(expected.imag, actual.imag, msg=error_message)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_polar" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\nfrom cmath import phase, polar, rect, pi\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    def rAssertAlmostEqual(a, b, rel_err=2e-15, abs_err=5e-323, msg=None):\n        \"\"\"Fail if the two floating-point numbers are not almost equal.\n\n        Determine whether floating-point values a and b are equal to within\n        a (small) rounding error.  The default values for rel_err and\n        abs_err are chosen to be suitable for platforms where a float is\n        represented by an IEEE 754 double.  They allow an error of between\n        9 and 19 ulps.\n        \"\"\"\n        if math.isnan(a):\n            if math.isnan(b):\n                return\n            raise AssertionError(msg or '{!r} should be nan'.format(b))\n        if math.isinf(a):\n            if a == b:\n                return\n            raise AssertionError(msg or 'finite result where infinity expected: expected {!r}, got {!r}'.format(a, b))\n        if not a and (not b):\n            if math.copysign(1.0, a) != math.copysign(1.0, b):\n                raise AssertionError(msg or 'zero has wrong sign: expected {!r}, got {!r}'.format(a, b))\n        try:\n            absolute_error = abs(b - a)\n        except OverflowError:\n            pass\n        else:\n            if absolute_error <= max(abs_err, rel_err * abs(a)):\n                return\n        raise AssertionError(msg or '{!r} and {!r} are not sufficiently close'.format(a, b))\n\n    def check_polar(func):\n\n        def check(arg, expected):\n            got = func(arg)\n            for e, g in zip(expected, got):\n                rAssertAlmostEqual(e, g)\n        check(0, (0.0, 0.0))\n        check(1, (1.0, 0.0))\n        check(-1, (1.0, pi))\n        check(1j, (1.0, pi / 2))\n        check(-3j, (3.0, -pi / 2))\n        inf = float('inf')\n        check(complex(inf, 0), (inf, 0.0))\n        check(complex(-inf, 0), (inf, pi))\n        check(complex(3, inf), (inf, pi / 2))\n        check(complex(5, -inf), (inf, -pi / 2))\n        check(complex(inf, inf), (inf, pi / 4))\n        check(complex(inf, -inf), (inf, -pi / 4))\n        check(complex(-inf, inf), (inf, 3 * pi / 4))\n        check(complex(-inf, -inf), (inf, -3 * pi / 4))\n        nan = float('nan')\n        check(complex(nan, 0), (nan, nan))\n        check(complex(0, nan), (nan, nan))\n        check(complex(nan, nan), (nan, nan))\n        check(complex(inf, nan), (inf, nan))\n        check(complex(-inf, nan), (inf, nan))\n        check(complex(nan, inf), (inf, nan))\n        check(complex(nan, -inf), (inf, nan))\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    check_polar(polar)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_polar_errno" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import requires_IEEE_754, cpython_only, import_helper\nfrom test.test_math import parse_testfile, test_file\nimport cmath, math\nfrom cmath import phase, polar, rect, pi\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    def rAssertAlmostEqual(a, b, rel_err=2e-15, abs_err=5e-323, msg=None):\n        \"\"\"Fail if the two floating-point numbers are not almost equal.\n\n        Determine whether floating-point values a and b are equal to within\n        a (small) rounding error.  The default values for rel_err and\n        abs_err are chosen to be suitable for platforms where a float is\n        represented by an IEEE 754 double.  They allow an error of between\n        9 and 19 ulps.\n        \"\"\"\n        if math.isnan(a):\n            if math.isnan(b):\n                return\n            raise AssertionError(msg or '{!r} should be nan'.format(b))\n        if math.isinf(a):\n            if a == b:\n                return\n            raise AssertionError(msg or 'finite result where infinity expected: expected {!r}, got {!r}'.format(a, b))\n        if not a and (not b):\n            if math.copysign(1.0, a) != math.copysign(1.0, b):\n                raise AssertionError(msg or 'zero has wrong sign: expected {!r}, got {!r}'.format(a, b))\n        try:\n            absolute_error = abs(b - a)\n        except OverflowError:\n            pass\n        else:\n            if absolute_error <= max(abs_err, rel_err * abs(a)):\n                return\n        raise AssertionError(msg or '{!r} and {!r} are not sufficiently close'.format(a, b))\n\n    def check_polar(func):\n\n        def check(arg, expected):\n            got = func(arg)\n            for e, g in zip(expected, got):\n                rAssertAlmostEqual(e, g)\n        check(0, (0.0, 0.0))\n        check(1, (1.0, 0.0))\n        check(-1, (1.0, pi))\n        check(1j, (1.0, pi / 2))\n        check(-3j, (3.0, -pi / 2))\n        inf = float('inf')\n        check(complex(inf, 0), (inf, 0.0))\n        check(complex(-inf, 0), (inf, pi))\n        check(complex(3, inf), (inf, pi / 2))\n        check(complex(5, -inf), (inf, -pi / 2))\n        check(complex(inf, inf), (inf, pi / 4))\n        check(complex(inf, -inf), (inf, -pi / 4))\n        check(complex(-inf, inf), (inf, 3 * pi / 4))\n        check(complex(-inf, -inf), (inf, -3 * pi / 4))\n        nan = float('nan')\n        check(complex(nan, 0), (nan, nan))\n        check(complex(0, nan), (nan, nan))\n        check(complex(nan, nan), (nan, nan))\n        check(complex(inf, nan), (inf, nan))\n        check(complex(-inf, nan), (inf, nan))\n        check(complex(nan, inf), (inf, nan))\n        check(complex(nan, -inf), (inf, nan))\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    _testcapi = import_helper.import_module('_testcapi')\n\n    def polar_with_errno_set(z):\n        _testcapi.set_errno(11)\n        try:\n            return polar(z)\n        finally:\n            _testcapi.set_errno(0)\n    check_polar(polar_with_errno_set)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_abs" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\nINF = float('inf')\nNAN = float('nan')\ncomplex_zeros = [complex(x, y) for x in [0.0, -0.0] for y in [0.0, -0.0]]\ncomplex_infinities = [complex(x, y) for x, y in [(INF, 0.0), (INF, 2.3), (INF, INF), (2.3, INF), (0.0, INF), (-0.0, INF), (-2.3, INF), (-INF, INF), (-INF, 2.3), (-INF, 0.0), (-INF, -0.0), (-INF, -2.3), (-INF, -INF), (-2.3, -INF), (-0.0, -INF), (0.0, -INF), (2.3, -INF), (INF, -INF), (INF, -2.3), (INF, -0.0)]]\ncomplex_nans = [complex(x, y) for x, y in [(NAN, -INF), (NAN, -2.3), (NAN, -0.0), (NAN, 0.0), (NAN, 2.3), (NAN, INF), (-INF, NAN), (-2.3, NAN), (-0.0, NAN), (0.0, NAN), (2.3, NAN), (INF, NAN)]]\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    for z in complex_zeros:\n        assert abs(z) == 0.0, ('assertEqual', abs(z), 0.0)\n    for z in complex_infinities:\n        assert abs(z) == INF, ('assertEqual', abs(z), INF)\n    assert abs(complex(NAN, -INF)) == INF, ('assertEqual', abs(complex(NAN, -INF)), INF)\n    assert math.isnan(abs(complex(NAN, -2.3))), ('assertTrue', math.isnan(abs(complex(NAN, -2.3))))\n    assert math.isnan(abs(complex(NAN, -0.0))), ('assertTrue', math.isnan(abs(complex(NAN, -0.0))))\n    assert math.isnan(abs(complex(NAN, 0.0))), ('assertTrue', math.isnan(abs(complex(NAN, 0.0))))\n    assert math.isnan(abs(complex(NAN, 2.3))), ('assertTrue', math.isnan(abs(complex(NAN, 2.3))))\n    assert abs(complex(NAN, INF)) == INF, ('assertEqual', abs(complex(NAN, INF)), INF)\n    assert abs(complex(-INF, NAN)) == INF, ('assertEqual', abs(complex(-INF, NAN)), INF)\n    assert math.isnan(abs(complex(-2.3, NAN))), ('assertTrue', math.isnan(abs(complex(-2.3, NAN))))\n    assert math.isnan(abs(complex(-0.0, NAN))), ('assertTrue', math.isnan(abs(complex(-0.0, NAN))))\n    assert math.isnan(abs(complex(0.0, NAN))), ('assertTrue', math.isnan(abs(complex(0.0, NAN))))\n    assert math.isnan(abs(complex(2.3, NAN))), ('assertTrue', math.isnan(abs(complex(2.3, NAN))))\n    assert abs(complex(INF, NAN)) == INF, ('assertEqual', abs(complex(INF, NAN)), INF)\n    assert math.isnan(abs(complex(NAN, NAN))), ('assertTrue', math.isnan(abs(complex(NAN, NAN))))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_abs_overflows" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    try:\n        abs(*(complex(1.4e+308, 1.4e+308),))\n    except OverflowError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_rect" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\nfrom cmath import phase, polar, rect, pi\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    def assertCEqual(a, b):\n        eps = 1e-07\n        if abs(a.real - b[0]) > eps or abs(a.imag - b[1]) > eps:\n            raise AssertionError((a, b))\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    assertCEqual(rect(0, 0), (0, 0))\n    assertCEqual(rect(1, 0), (1.0, 0))\n    assertCEqual(rect(1, -pi), (-1.0, 0))\n    assertCEqual(rect(1, pi / 2), (0, 1.0))\n    assertCEqual(rect(1, -pi / 2), (0, -1.0))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_isfinite" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\nINF = float('inf')\nNAN = float('nan')\ncomplex_zeros = [complex(x, y) for x in [0.0, -0.0] for y in [0.0, -0.0]]\ncomplex_infinities = [complex(x, y) for x, y in [(INF, 0.0), (INF, 2.3), (INF, INF), (2.3, INF), (0.0, INF), (-0.0, INF), (-2.3, INF), (-INF, INF), (-INF, 2.3), (-INF, 0.0), (-INF, -0.0), (-INF, -2.3), (-INF, -INF), (-2.3, -INF), (-0.0, -INF), (0.0, -INF), (2.3, -INF), (INF, -INF), (INF, -2.3), (INF, -0.0)]]\ncomplex_nans = [complex(x, y) for x, y in [(NAN, -INF), (NAN, -2.3), (NAN, -0.0), (NAN, 0.0), (NAN, 2.3), (NAN, INF), (-INF, NAN), (-2.3, NAN), (-0.0, NAN), (0.0, NAN), (2.3, NAN), (INF, NAN)]]\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    real_vals = [float('-inf'), -2.3, -0.0, 0.0, 2.3, float('inf'), float('nan')]\n    for x in real_vals:\n        for y in real_vals:\n            z = complex(x, y)\n            assert cmath.isfinite(z) == (math.isfinite(x) and math.isfinite(y)), ('assertEqual', cmath.isfinite(z), (math.isfinite(x) and math.isfinite(y)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_isnan" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\nINF = float('inf')\nNAN = float('nan')\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    assert not cmath.isnan(1), ('assertFalse', cmath.isnan(1))\n    assert not cmath.isnan(1j), ('assertFalse', cmath.isnan(1j))\n    assert not cmath.isnan(INF), ('assertFalse', cmath.isnan(INF))\n    assert cmath.isnan(NAN), ('assertTrue', cmath.isnan(NAN))\n    assert cmath.isnan(complex(NAN, 0)), ('assertTrue', cmath.isnan(complex(NAN, 0)))\n    assert cmath.isnan(complex(0, NAN)), ('assertTrue', cmath.isnan(complex(0, NAN)))\n    assert cmath.isnan(complex(NAN, NAN)), ('assertTrue', cmath.isnan(complex(NAN, NAN)))\n    assert cmath.isnan(complex(NAN, INF)), ('assertTrue', cmath.isnan(complex(NAN, INF)))\n    assert cmath.isnan(complex(INF, NAN)), ('assertTrue', cmath.isnan(complex(INF, NAN)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CMathTests.test_isinf" {
    (ok, detail) = p2_libtest_run_snippet("from test.test_math import parse_testfile, test_file\nimport cmath, math\nINF = float('inf')\nNAN = float('nan')\n\ndef _t():\n\n    def setUp():\n        self.test_values = open(test_file, encoding='utf-8')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    _SelfNS.test_functions = [getattr(cmath, fname) for fname in ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'exp', 'log', 'log10', 'sin', 'sinh', 'sqrt', 'tan', 'tanh']]\n    self.test_values = open(test_file, encoding='utf-8')\n    assert not cmath.isinf(1), ('assertFalse', cmath.isinf(1))\n    assert not cmath.isinf(1j), ('assertFalse', cmath.isinf(1j))\n    assert not cmath.isinf(NAN), ('assertFalse', cmath.isinf(NAN))\n    assert cmath.isinf(INF), ('assertTrue', cmath.isinf(INF))\n    assert cmath.isinf(complex(INF, 0)), ('assertTrue', cmath.isinf(complex(INF, 0)))\n    assert cmath.isinf(complex(0, INF)), ('assertTrue', cmath.isinf(complex(0, INF)))\n    assert cmath.isinf(complex(INF, INF)), ('assertTrue', cmath.isinf(complex(INF, INF)))\n    assert cmath.isinf(complex(NAN, INF)), ('assertTrue', cmath.isinf(complex(NAN, INF)))\n    assert cmath.isinf(complex(INF, NAN)), ('assertTrue', cmath.isinf(complex(INF, NAN)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
