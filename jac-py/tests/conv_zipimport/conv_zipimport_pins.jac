test "BadFileZipImportTestCase.testBadArgs" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport zipimport\nTESTMOD = 'ziptestmodule'\n\ndef _t():\n    try:\n        zipimport.zipimporter(*(None,))\n    except TypeError:\n        pass\n    try:\n        zipimport.zipimporter(*(TESTMOD,), kwd=None)\n    except TypeError:\n        pass\n    try:\n        zipimport.zipimporter(*(list(os.fsencode(TESTMOD)),))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

