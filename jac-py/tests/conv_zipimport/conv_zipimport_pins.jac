    (ok, detail) = p2_libtest_run_snippet("_cleanup_stack = []\n\ndef _drain_cleanups():\n    while _cleanup_stack:\n        _fn, _a, _k = _cleanup_stack.pop()\n        try:\n            _fn(*_a, **_k)\n        except BaseException as _ce:\n            print('ORACLE_EXC ' + type(_ce).__name__ + ' ' + repr(str(_ce)))\nimport sys\nimport os\nimport marshal\nimport importlib\nimport importlib.util\nimport struct\nimport unittest\nimport unittest.mock\nfrom test.support import import_helper\nfrom test.support import os_helper\nfrom zipfile import ZipFile, ZipInfo, ZIP_STORED, ZIP_DEFLATED\nimport zipimport\nimport linecache\n\ndef make_pyc(co, mtime, size):\n    data = marshal.dumps(co)\n    pyc = importlib.util.MAGIC_NUMBER + struct.pack('<iLL', 0, int(mtime) & 4294967295, size & 4294967295) + data\n    return pyc\nTEMP_ZIP = os.path.abspath('junk95142.zip')\n\nclass ImportHooksBaseTestCase(unittest.TestCase):\n\n    def setUp(self):\n        self.path = sys.path[:]\n        self.meta_path = sys.meta_path[:]\n        self.path_hooks = sys.path_hooks[:]\n        sys.path_importer_cache.clear()\n        self.modules_before = import_helper.modules_setup()\n\n    def tearDown(self):\n        sys.path[:] = self.path\n        sys.meta_path[:] = self.meta_path\n        sys.path_hooks[:] = self.path_hooks\n        sys.path_importer_cache.clear()\n        import_helper.modules_cleanup(*self.modules_before)\n\ndef _testGetData():\n    zi = zipimport.zipimporter(os.path.join(TEMP_ZIP, 'ignored'))\n    pathname = os.path.join('a', 'b', 'c', 'testdata.dat')\n    data = bytes(range(256))\n    assert zi.get_data(pathname) == data, ('assertEqual', zi.get_data(pathname), data)\n    assert zi.get_data(os.path.join(TEMP_ZIP, pathname)) == data, ('assertEqual', zi.get_data(os.path.join(TEMP_ZIP, pathname)), data)\n    assert zi.get_data(os.path.join('a', 'b', '')) == b'', ('assertEqual', zi.get_data(os.path.join('a', 'b', '')), b'')\n    assert zi.get_data(os.path.join(TEMP_ZIP, 'a', 'b', '')) == b'', ('assertEqual', zi.get_data(os.path.join(TEMP_ZIP, 'a', 'b', '')), b'')\n    try:\n        zi.get_data(*(os.path.join('a', 'b'),))\n    except OSError:\n        pass\n    try:\n        zi.get_data(*(os.path.join(TEMP_ZIP, 'a', 'b'),))\n    except OSError:\n        pass\n\nclass ImportHooksBaseTestCase(unittest.TestCase):\n\n    def setUp(self):\n        self.path = sys.path[:]\n        self.meta_path = sys.meta_path[:]\n        self.path_hooks = sys.path_hooks[:]\n        sys.path_importer_cache.clear()\n        self.modules_before = import_helper.modules_setup()\n\n    def tearDown(self):\n        sys.path[:] = self.path\n        sys.meta_path[:] = self.meta_path\n        sys.path_hooks[:] = self.path_hooks\n        sys.path_importer_cache.clear()\n        import_helper.modules_cleanup(*self.modules_before)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.compression = ZIP_STORED\n    linecache.clearcache()\n    zipimport._zip_directory_cache.clear()\n    ImportHooksBaseTestCase.setUp(self)\n    _cleanup_stack.append((os_helper.unlink, (TEMP_ZIP,), {}))\n    with ZipFile(TEMP_ZIP, 'w', compression=self.compression) as z:\n        data = bytes(range(256))\n        z.writestr('a/b/c/testdata.dat', data)\n    _testGetData()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _drain_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
