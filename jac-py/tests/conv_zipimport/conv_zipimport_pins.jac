test "BadFileZipImportTestCase.testNotZipFile" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import os_helper\nimport zipimport\nTESTMOD = 'ziptestmodule'\n\ndef assertZipFailure(filename):\n    try:\n        zipimport.zipimporter(*(filename,))\n    except zipimport.ZipImportError:\n        pass\n\ndef _t():\n    os_helper.unlink(TESTMOD)\n    fp = open(TESTMOD, 'w+')\n    fp.write('a' * 22)\n    fp.close()\n    assertZipFailure(TESTMOD)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
