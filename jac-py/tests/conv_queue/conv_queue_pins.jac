test "PyPriorityQueueTest.test_shutdown_immediate_all_methods_in_one_thread" {
    (ok, detail) = p2_libtest_run_snippet("import threading\nfrom test.support import import_helper\npy_queue = import_helper.import_fresh_module('queue', blocked=['_queue'])\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.PriorityQueue\n        self.cum = 0\n        self.cumlock = threading.Lock()\n\n    def _shutdown_all_methods_in_one_thread(immediate):\n        q = self.type2test(2)\n        q.put('L')\n        q.put_nowait('O')\n        q.shutdown(immediate)\n        try:\n            q.put('E')\n        except self.queue.ShutDown as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            q.put_nowait('W')\n        except self.queue.ShutDown as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        if immediate:\n            try:\n                q.get()\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                q.get_nowait()\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                q.task_done()\n            except ValueError as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            q.join()\n        else:\n            assert q.get() in 'LO', ('assertIn', q.get(), 'LO')\n            q.task_done()\n            assert q.get() in 'LO', ('assertIn', q.get(), 'LO')\n            q.task_done()\n            q.join()\n            try:\n                q.get()\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                q.get_nowait()\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                q.get(True, 1.0)\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = py_queue\n    _SelfNS.queue = py_queue\n    self.type2test = self.queue.PriorityQueue\n    self.cum = 0\n    self.cumlock = threading.Lock()\n    return _shutdown_all_methods_in_one_thread(True)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PyPriorityQueueTest.test_shutdown_pending_get" {
    (ok, detail) = p2_libtest_run_snippet("import threading\nfrom test.support import import_helper\npy_queue = import_helper.import_fresh_module('queue', blocked=['_queue'])\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.PriorityQueue\n        self.cum = 0\n        self.cumlock = threading.Lock()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = py_queue\n    _SelfNS.queue = py_queue\n    self.type2test = self.queue.PriorityQueue\n    self.cum = 0\n    self.cumlock = threading.Lock()\n\n    def get():\n        try:\n            results.append(q.get())\n        except Exception as e:\n            results.append(e)\n    q = self.type2test()\n    results = []\n    get_thread = threading.Thread(target=get)\n    get_thread.start()\n    q.shutdown(immediate=False)\n    get_thread.join(timeout=10.0)\n    assert not get_thread.is_alive(), ('assertFalse', get_thread.is_alive())\n    assert len(results) == 1, ('assertEqual', len(results), 1)\n    assert isinstance(results[0], self.queue.ShutDown), ('assertIsInstance', results[0], self.queue.ShutDown)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

