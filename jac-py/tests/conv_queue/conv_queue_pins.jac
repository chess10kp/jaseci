test "CSimpleQueueTest.test_reentrancy" {
    (ok, detail) = p2_libtest_run_snippet("import itertools\nfrom test.support import import_helper\nc_queue = import_helper.import_fresh_module('queue', fresh=['_queue'])\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.SimpleQueue\n        self.q = self.type2test()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = c_queue\n    _SelfNS.queue = c_queue\n    self.type2test = self.queue.SimpleQueue\n    self.q = self.type2test()\n    q = self.q\n    gen = itertools.count()\n    N = 10000\n    results = []\n\n    class Circular(object):\n\n        def __init__(self):\n            self.circular = self\n\n        def __del__(self):\n            q.put(next(gen))\n    while True:\n        o = Circular()\n        q.put(next(gen))\n        del o\n        results.append(q.get())\n        if results[-1] >= N:\n            break\n    assert results == list(range(N + 1)), ('assertEqual', results, list(range(N + 1)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CSimpleQueueTest.test_basic" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\nc_queue = import_helper.import_fresh_module('queue', fresh=['_queue'])\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.SimpleQueue\n        self.q = self.type2test()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = c_queue\n    _SelfNS.queue = c_queue\n    self.type2test = self.queue.SimpleQueue\n    self.q = self.type2test()\n    q = self.q\n    assert q.empty(), ('assertTrue', q.empty())\n    assert q.qsize() == 0, ('assertEqual', q.qsize(), 0)\n    q.put(1)\n    assert not q.empty(), ('assertFalse', q.empty())\n    assert q.qsize() == 1, ('assertEqual', q.qsize(), 1)\n    q.put(2)\n    q.put_nowait(3)\n    q.put(4)\n    assert not q.empty(), ('assertFalse', q.empty())\n    assert q.qsize() == 4, ('assertEqual', q.qsize(), 4)\n    assert q.get() == 1, ('assertEqual', q.get(), 1)\n    assert q.qsize() == 3, ('assertEqual', q.qsize(), 3)\n    assert q.get_nowait() == 2, ('assertEqual', q.get_nowait(), 2)\n    assert q.qsize() == 2, ('assertEqual', q.qsize(), 2)\n    assert q.get(block=False) == 3, ('assertEqual', q.get(block=False), 3)\n    assert not q.empty(), ('assertFalse', q.empty())\n    assert q.qsize() == 1, ('assertEqual', q.qsize(), 1)\n    assert q.get(timeout=0.1) == 4, ('assertEqual', q.get(timeout=0.1), 4)\n    assert q.empty(), ('assertTrue', q.empty())\n    assert q.qsize() == 0, ('assertEqual', q.qsize(), 0)\n    try:\n        q.get(block=False)\n    except self.queue.Empty as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        q.get(timeout=0.001)\n    except self.queue.Empty as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        q.get_nowait()\n    except self.queue.Empty as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert q.empty(), ('assertTrue', q.empty())\n    assert q.qsize() == 0, ('assertEqual', q.qsize(), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CSimpleQueueTest.test_negative_timeout_raises_exception" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\nc_queue = import_helper.import_fresh_module('queue', fresh=['_queue'])\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.SimpleQueue\n        self.q = self.type2test()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = c_queue\n    _SelfNS.queue = c_queue\n    self.type2test = self.queue.SimpleQueue\n    self.q = self.type2test()\n    q = self.q\n    q.put(1)\n    try:\n        q.get(timeout=-1)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CSimpleQueueTest.test_references" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\nfrom test.support import gc_collect, bigmemtest\nfrom test.support import import_helper\nc_queue = import_helper.import_fresh_module('queue', fresh=['_queue'])\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.SimpleQueue\n        self.q = self.type2test()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = c_queue\n    _SelfNS.queue = c_queue\n    self.type2test = self.queue.SimpleQueue\n    self.q = self.type2test()\n\n    class C:\n        pass\n    N = 20\n    q = self.q\n    for i in range(N):\n        q.put(C())\n    for i in range(N):\n        wr = weakref.ref(q.get())\n        gc_collect()\n        assert wr() is None, ('assertIsNone', wr())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
