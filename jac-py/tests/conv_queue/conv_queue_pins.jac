test "CPriorityQueueTest.test_shutdown_pending_get" {
    (ok, detail) = p2_libtest_run_snippet("import threading\nfrom test.support import import_helper\nc_queue = import_helper.import_fresh_module('queue', fresh=['_queue'])\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.PriorityQueue\n        self.cum = 0\n        self.cumlock = threading.Lock()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = c_queue\n    _SelfNS.queue = c_queue\n    self.type2test = self.queue.PriorityQueue\n    self.cum = 0\n    self.cumlock = threading.Lock()\n\n    def get():\n        try:\n            results.append(q.get())\n        except Exception as e:\n            results.append(e)\n    q = self.type2test()\n    results = []\n    get_thread = threading.Thread(target=get)\n    get_thread.start()\n    q.shutdown(immediate=False)\n    get_thread.join(timeout=10.0)\n    assert not get_thread.is_alive(), ('assertFalse', get_thread.is_alive())\n    assert len(results) == 1, ('assertEqual', len(results), 1)\n    assert isinstance(results[0], self.queue.ShutDown), ('assertIsInstance', results[0], self.queue.ShutDown)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PyFailingQueueTest.test_failing_queue" {
    (ok, detail) = p2_libtest_run_snippet("import threading\nimport time\nfrom test.support import import_helper\nfrom test.support import threading_helper\npy_queue = import_helper.import_fresh_module('queue', blocked=['_queue'])\nQUEUE_SIZE = 5\n\ndef qfull(q):\n    return q.maxsize > 0 and q.qsize() == q.maxsize\n\nclass _TriggerThread(threading.Thread):\n\n    def __init__(self, fn, args):\n        self.fn = fn\n        self.args = args\n        self.startedEvent = threading.Event()\n        threading.Thread.__init__(self)\n\n    def run(self):\n        time.sleep(0.1)\n        self.startedEvent.set()\n        self.fn(*self.args)\n\nclass FailingQueueException(Exception):\n    pass\n\nclass _TriggerThread(threading.Thread):\n\n    def __init__(self, fn, args):\n        self.fn = fn\n        self.args = args\n        self.startedEvent = threading.Event()\n        threading.Thread.__init__(self)\n\n    def run(self):\n        time.sleep(0.1)\n        self.startedEvent.set()\n        self.fn(*self.args)\n\nclass FailingQueueException(Exception):\n    pass\n\ndef _t():\n\n    def setUp():\n        Queue = self.queue.Queue\n\n        class FailingQueue(Queue):\n\n            def __init__(self, *args):\n                self.fail_next_put = False\n                self.fail_next_get = False\n                Queue.__init__(self, *args)\n\n            def _put(self, item):\n                if self.fail_next_put:\n                    self.fail_next_put = False\n                    raise FailingQueueException('You Lose')\n                return Queue._put(self, item)\n\n            def _get(self):\n                if self.fail_next_get:\n                    self.fail_next_get = False\n                    raise FailingQueueException('You Lose')\n                return Queue._get(self)\n        self.FailingQueue = FailingQueue\n\n    def do_blocking_test(block_func, block_args, trigger_func, trigger_args):\n        thread = _TriggerThread(trigger_func, trigger_args)\n        thread.start()\n        try:\n            self.result = block_func(*block_args)\n            if not thread.startedEvent.is_set():\n                raise AssertionError('blocking function %r appeared not to block' % block_func)\n            return self.result\n        finally:\n            threading_helper.join_thread(thread)\n\n    def do_exceptional_blocking_test(block_func, block_args, trigger_func, trigger_args, expected_exception_class):\n        thread = _TriggerThread(trigger_func, trigger_args)\n        thread.start()\n        try:\n            try:\n                block_func(*block_args)\n            except expected_exception_class:\n                raise\n            else:\n                raise AssertionError('expected exception of kind %r' % expected_exception_class)\n        finally:\n            threading_helper.join_thread(thread)\n            if not thread.startedEvent.is_set():\n                raise AssertionError('trigger thread ended but event never set')\n\n    def failing_queue_test(q):\n        if q.qsize():\n            raise RuntimeError('Call this function with an empty queue')\n        for i in range(QUEUE_SIZE - 1):\n            q.put(i)\n        q.fail_next_put = True\n        try:\n            q.put('oops', block=0)\n            raise AssertionError(\"The queue didn't fail when it should have\")\n        except FailingQueueException:\n            pass\n        q.fail_next_put = True\n        try:\n            q.put('oops', timeout=0.1)\n            raise AssertionError(\"The queue didn't fail when it should have\")\n        except FailingQueueException:\n            pass\n        q.put('last')\n        assert qfull(q), ('assertTrue', qfull(q))\n        q.fail_next_put = True\n        try:\n            do_blocking_test(q.put, ('full',), q.get, ())\n            raise AssertionError(\"The queue didn't fail when it should have\")\n        except FailingQueueException:\n            pass\n        q.put('last')\n        q.fail_next_put = True\n        try:\n            do_exceptional_blocking_test(q.put, ('full', True, 10), q.get, (), FailingQueueException)\n            raise AssertionError(\"The queue didn't fail when it should have\")\n        except FailingQueueException:\n            pass\n        q.put('last')\n        assert qfull(q), ('assertTrue', qfull(q))\n        q.get()\n        assert not qfull(q), ('assertTrue', not qfull(q))\n        q.put('last')\n        assert qfull(q), ('assertTrue', qfull(q))\n        do_blocking_test(q.put, ('full',), q.get, ())\n        for i in range(QUEUE_SIZE):\n            q.get()\n        assert not q.qsize(), ('assertTrue', not q.qsize())\n        q.put('first')\n        q.fail_next_get = True\n        try:\n            q.get()\n            raise AssertionError(\"The queue didn't fail when it should have\")\n        except FailingQueueException:\n            pass\n        assert q.qsize(), ('assertTrue', q.qsize())\n        q.fail_next_get = True\n        try:\n            q.get(timeout=0.1)\n            raise AssertionError(\"The queue didn't fail when it should have\")\n        except FailingQueueException:\n            pass\n        assert q.qsize(), ('assertTrue', q.qsize())\n        q.get()\n        assert not q.qsize(), ('assertTrue', not q.qsize())\n        q.fail_next_get = True\n        try:\n            do_exceptional_blocking_test(q.get, (), q.put, ('empty',), FailingQueueException)\n            raise AssertionError(\"The queue didn't fail when it should have\")\n        except FailingQueueException:\n            pass\n        assert q.qsize(), ('assertTrue', q.qsize())\n        q.get()\n        assert not q.qsize(), ('assertTrue', not q.qsize())\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = py_queue\n    _SelfNS.queue = py_queue\n    Queue = self.queue.Queue\n\n    class FailingQueue(Queue):\n\n        def __init__(self, *args):\n            self.fail_next_put = False\n            self.fail_next_get = False\n            Queue.__init__(self, *args)\n\n        def _put(self, item):\n            if self.fail_next_put:\n                self.fail_next_put = False\n                raise FailingQueueException('You Lose')\n            return Queue._put(self, item)\n\n        def _get(self):\n            if self.fail_next_get:\n                self.fail_next_get = False\n                raise FailingQueueException('You Lose')\n            return Queue._get(self)\n    self.FailingQueue = FailingQueue\n    q = self.FailingQueue(QUEUE_SIZE)\n    failing_queue_test(q)\n    failing_queue_test(q)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

