test "PyLifoQueueTest.test_basic" {
    (ok, detail) = p2_libtest_run_snippet("import threading\nimport time\nfrom test.support import import_helper\nfrom test.support import threading_helper\npy_queue = import_helper.import_fresh_module('queue', blocked=['_queue'])\nQUEUE_SIZE = 5\n\ndef qfull(q):\n    return q.maxsize > 0 and q.qsize() == q.maxsize\n\nclass _TriggerThread(threading.Thread):\n\n    def __init__(self, fn, args):\n        self.fn = fn\n        self.args = args\n        self.startedEvent = threading.Event()\n        threading.Thread.__init__(self)\n\n    def run(self):\n        time.sleep(0.1)\n        self.startedEvent.set()\n        self.fn(*self.args)\n\nclass _TriggerThread(threading.Thread):\n\n    def __init__(self, fn, args):\n        self.fn = fn\n        self.args = args\n        self.startedEvent = threading.Event()\n        threading.Thread.__init__(self)\n\n    def run(self):\n        time.sleep(0.1)\n        self.startedEvent.set()\n        self.fn(*self.args)\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.LifoQueue\n        self.cum = 0\n        self.cumlock = threading.Lock()\n\n    def do_blocking_test(block_func, block_args, trigger_func, trigger_args):\n        thread = _TriggerThread(trigger_func, trigger_args)\n        thread.start()\n        try:\n            self.result = block_func(*block_args)\n            if not thread.startedEvent.is_set():\n                raise AssertionError('blocking function %r appeared not to block' % block_func)\n            return self.result\n        finally:\n            threading_helper.join_thread(thread)\n\n    def basic_queue_test(q):\n        if q.qsize():\n            raise RuntimeError('Call this function with an empty queue')\n        assert q.empty(), ('assertTrue', q.empty())\n        assert not q.full(), ('assertFalse', q.full())\n        q.put(111)\n        q.put(333)\n        q.put(222)\n        target_order = dict(Queue=[111, 333, 222], LifoQueue=[222, 333, 111], PriorityQueue=[111, 222, 333])\n        actual_order = [q.get(), q.get(), q.get()]\n        assert actual_order == target_order[q.__class__.__name__], ('assertEqual', actual_order, target_order[q.__class__.__name__])\n        for i in range(QUEUE_SIZE - 1):\n            q.put(i)\n            assert q.qsize(), ('assertTrue', q.qsize())\n        assert not qfull(q), ('assertTrue', not qfull(q))\n        last = 2 * QUEUE_SIZE\n        full = 3 * 2 * QUEUE_SIZE\n        q.put(last)\n        assert qfull(q), ('assertTrue', qfull(q))\n        assert not q.empty(), ('assertFalse', q.empty())\n        assert q.full(), ('assertTrue', q.full())\n        try:\n            q.put(full, block=0)\n            raise AssertionError(\"Didn't appear to block with a full queue\")\n        except self.queue.Full:\n            pass\n        try:\n            q.put(full, timeout=0.01)\n            raise AssertionError(\"Didn't appear to time-out with a full queue\")\n        except self.queue.Full:\n            pass\n        do_blocking_test(q.put, (full,), q.get, ())\n        do_blocking_test(q.put, (full, True, 10), q.get, ())\n        for i in range(QUEUE_SIZE):\n            q.get()\n        assert not q.qsize(), ('assertTrue', not q.qsize())\n        try:\n            q.get(block=0)\n            raise AssertionError(\"Didn't appear to block with an empty queue\")\n        except self.queue.Empty:\n            pass\n        try:\n            q.get(timeout=0.01)\n            raise AssertionError(\"Didn't appear to time-out with an empty queue\")\n        except self.queue.Empty:\n            pass\n        do_blocking_test(q.get, (), q.put, ('empty',))\n        do_blocking_test(q.get, (True, 10), q.put, ('empty',))\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = py_queue\n    _SelfNS.queue = py_queue\n    self.type2test = self.queue.LifoQueue\n    self.cum = 0\n    self.cumlock = threading.Lock()\n    q = self.type2test(QUEUE_SIZE)\n    basic_queue_test(q)\n    basic_queue_test(q)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

