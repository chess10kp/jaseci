test "CLifoQueueTest.test_shutdown_all_methods_in_one_thread" {
    (ok, detail) = p2_libtest_run_snippet("import threading\nfrom test.support import import_helper\nc_queue = import_helper.import_fresh_module('queue', fresh=['_queue'])\n\ndef _t():\n\n    def setUp():\n        self.type2test = self.queue.LifoQueue\n        self.cum = 0\n        self.cumlock = threading.Lock()\n\n    def _shutdown_all_methods_in_one_thread(immediate):\n        q = self.type2test(2)\n        q.put('L')\n        q.put_nowait('O')\n        q.shutdown(immediate)\n        try:\n            q.put('E')\n        except self.queue.ShutDown as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            q.put_nowait('W')\n        except self.queue.ShutDown as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        if immediate:\n            try:\n                q.get()\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                q.get_nowait()\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                q.task_done()\n            except ValueError as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            q.join()\n        else:\n            assert q.get() in 'LO', ('assertIn', q.get(), 'LO')\n            q.task_done()\n            assert q.get() in 'LO', ('assertIn', q.get(), 'LO')\n            q.task_done()\n            q.join()\n            try:\n                q.get()\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                q.get_nowait()\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                q.get(True, 1.0)\n            except self.queue.ShutDown as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.queue = c_queue\n    _SelfNS.queue = c_queue\n    self.type2test = self.queue.LifoQueue\n    self.cum = 0\n    self.cumlock = threading.Lock()\n    return _shutdown_all_methods_in_one_thread(False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

