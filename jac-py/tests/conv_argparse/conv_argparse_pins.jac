test "TestArgumentParserPickleable.test_pickle_roundtrip" {
    (ok, detail) = p2_libtest_run_snippet("import argparse\n\ndef _t():\n    import pickle\n    parser = argparse.ArgumentParser(exit_on_error=False)\n    parser.add_argument('--foo', type=int, default=42)\n    parser.add_argument('bar', nargs='?', default='baz')\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        parser2 = pickle.loads(pickle.dumps(parser, protocol=proto))\n        ns = parser2.parse_args(['--foo', '123', 'quux'])\n        assert ns.foo == 123, ('assertEqual', ns.foo, 123)\n        assert ns.bar == 'quux', ('assertEqual', ns.bar, 'quux')\n        ns2 = parser2.parse_args([])\n        assert ns2.foo == 42, ('assertEqual', ns2.foo, 42)\n        assert ns2.bar == 'baz', ('assertEqual', ns2.bar, 'baz')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

