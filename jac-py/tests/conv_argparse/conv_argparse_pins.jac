test "TestTypeFunctionCallOnlyOnce.test_type_function_call_only_once" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n\n    def spam(string_to_convert):\n        assert string_to_convert == 'spam!', ('assertEqual', string_to_convert, 'spam!')\n        return 'foo_converted'\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--foo', type=spam, default='bar')\n    args = parser.parse_args('--foo spam!'.split())\n    assert NS(foo='foo_converted') == args, ('assertEqual', NS(foo='foo_converted'), args)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDeprecatedArguments.test_deprecated_option" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import captured_stderr, force_not_colorized, force_not_colorized_test_class, swap_attr\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser()\n    parser.add_argument('-f', '--foo', deprecated=True)\n    with captured_stderr() as stderr:\n        parser.parse_args(['--foo', 'spam'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: option '--foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '--foo' is deprecated\")\n    assert stderr.count('is deprecated') == 1, ('assertEqual', stderr.count('is deprecated'), 1)\n    with captured_stderr() as stderr:\n        parser.parse_args(['-f', 'spam'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: option '-f' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '-f' is deprecated\")\n    assert stderr.count('is deprecated') == 1, ('assertEqual', stderr.count('is deprecated'), 1)\n    with captured_stderr() as stderr:\n        parser.parse_args(['--foo', 'spam', '-f', 'ham'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: option '--foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '--foo' is deprecated\")\n    assert _re.search(\"warning: option '-f' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '-f' is deprecated\")\n    assert stderr.count('is deprecated') == 2, ('assertEqual', stderr.count('is deprecated'), 2)\n    with captured_stderr() as stderr:\n        parser.parse_args(['--foo', 'spam', '--foo', 'ham'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: option '--foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '--foo' is deprecated\")\n    assert stderr.count('is deprecated') == 1, ('assertEqual', stderr.count('is deprecated'), 1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDeprecatedArguments.test_deprecated_boolean_option" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import captured_stderr, force_not_colorized, force_not_colorized_test_class, swap_attr\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser()\n    parser.add_argument('-f', '--foo', action=argparse.BooleanOptionalAction, deprecated=True)\n    with captured_stderr() as stderr:\n        parser.parse_args(['--foo'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: option '--foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '--foo' is deprecated\")\n    assert stderr.count('is deprecated') == 1, ('assertEqual', stderr.count('is deprecated'), 1)\n    with captured_stderr() as stderr:\n        parser.parse_args(['-f'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: option '-f' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '-f' is deprecated\")\n    assert stderr.count('is deprecated') == 1, ('assertEqual', stderr.count('is deprecated'), 1)\n    with captured_stderr() as stderr:\n        parser.parse_args(['--no-foo'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: option '--no-foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '--no-foo' is deprecated\")\n    assert stderr.count('is deprecated') == 1, ('assertEqual', stderr.count('is deprecated'), 1)\n    with captured_stderr() as stderr:\n        parser.parse_args(['--foo', '--no-foo'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: option '--foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '--foo' is deprecated\")\n    assert _re.search(\"warning: option '--no-foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: option '--no-foo' is deprecated\")\n    assert stderr.count('is deprecated') == 2, ('assertEqual', stderr.count('is deprecated'), 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDeprecatedArguments.test_deprecated_arguments" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import captured_stderr, force_not_colorized, force_not_colorized_test_class, swap_attr\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser()\n    parser.add_argument('foo', nargs='?', deprecated=True)\n    parser.add_argument('bar', nargs='?', deprecated=True)\n    with captured_stderr() as stderr:\n        parser.parse_args([])\n    stderr = stderr.getvalue()\n    assert stderr.count('is deprecated') == 0, ('assertEqual', stderr.count('is deprecated'), 0)\n    with captured_stderr() as stderr:\n        parser.parse_args(['spam'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: argument 'foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: argument 'foo' is deprecated\")\n    assert stderr.count('is deprecated') == 1, ('assertEqual', stderr.count('is deprecated'), 1)\n    with captured_stderr() as stderr:\n        parser.parse_args(['spam', 'ham'])\n    stderr = stderr.getvalue()\n    assert _re.search(\"warning: argument 'foo' is deprecated\", stderr), ('assertRegex', stderr, \"warning: argument 'foo' is deprecated\")\n    assert _re.search(\"warning: argument 'bar' is deprecated\", stderr), ('assertRegex', stderr, \"warning: argument 'bar' is deprecated\")\n    assert stderr.count('is deprecated') == 2, ('assertEqual', stderr.count('is deprecated'), 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

