test "TestParseKnownArgs.test_optionals" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--foo')\n    args, extras = parser.parse_known_args('--foo F --bar --baz'.split())\n    assert NS(foo='F') == args, ('assertEqual', NS(foo='F'), args)\n    assert ['--bar', '--baz'] == extras, ('assertEqual', ['--bar', '--baz'], extras)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestParseKnownArgs.test_mixed" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser()\n    parser.add_argument('-v', nargs='?', const=1, type=int)\n    parser.add_argument('--spam', action='store_false')\n    parser.add_argument('badger')\n    argv = ['B', 'C', '--foo', '-v', '3', '4']\n    args, extras = parser.parse_known_args(argv)\n    assert NS(v=3, spam=True, badger='B') == args, ('assertEqual', NS(v=3, spam=True, badger='B'), args)\n    assert ['C', '--foo', '4'] == extras, ('assertEqual', ['C', '--foo', '4'], extras)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestParseKnownArgs.test_zero_or_more_optional" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser()\n    parser.add_argument('x', nargs='*', choices=('x', 'y'))\n    args = parser.parse_args([])\n    assert NS(x=[]) == args, ('assertEqual', NS(x=[]), args)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDoubleDash.test_single_argument_option" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(exit_on_error=False)\n    parser.add_argument('-f', '--foo')\n    parser.add_argument('bar', nargs='*')\n    args = parser.parse_args(['--foo=--'])\n    assert NS(foo='--', bar=[]) == args, ('assertEqual', NS(foo='--', bar=[]), args)\n    try:\n        parser.parse_args(*(['--foo', '--'],))\n    except argparse.ArgumentError:\n        pass\n    args = parser.parse_args(['-f--'])\n    assert NS(foo='--', bar=[]) == args, ('assertEqual', NS(foo='--', bar=[]), args)\n    try:\n        parser.parse_args(*(['-f', '--'],))\n    except argparse.ArgumentError:\n        pass\n    args = parser.parse_args(['--foo', 'a', '--', 'b', 'c'])\n    assert NS(foo='a', bar=['b', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', 'c']), args)\n    args = parser.parse_args(['a', 'b', '--foo', 'c'])\n    assert NS(foo='c', bar=['a', 'b']) == args, ('assertEqual', NS(foo='c', bar=['a', 'b']), args)\n    args = parser.parse_args(['a', '--', 'b', '--foo', 'c'])\n    assert NS(foo=None, bar=['a', 'b', '--foo', 'c']) == args, ('assertEqual', NS(foo=None, bar=['a', 'b', '--foo', 'c']), args)\n    args = parser.parse_args(['a', '--', 'b', '--', 'c', '--foo', 'd'])\n    assert NS(foo=None, bar=['a', 'b', '--', 'c', '--foo', 'd']) == args, ('assertEqual', NS(foo=None, bar=['a', 'b', '--', 'c', '--foo', 'd']), args)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDoubleDash.test_multiple_argument_option" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(exit_on_error=False)\n    parser.add_argument('-f', '--foo', nargs='*')\n    parser.add_argument('bar', nargs='*')\n    args = parser.parse_args(['--foo=--'])\n    assert NS(foo=['--'], bar=[]) == args, ('assertEqual', NS(foo=['--'], bar=[]), args)\n    args = parser.parse_args(['--foo', '--'])\n    assert NS(foo=[], bar=[]) == args, ('assertEqual', NS(foo=[], bar=[]), args)\n    args = parser.parse_args(['-f--'])\n    assert NS(foo=['--'], bar=[]) == args, ('assertEqual', NS(foo=['--'], bar=[]), args)\n    args = parser.parse_args(['-f', '--'])\n    assert NS(foo=[], bar=[]) == args, ('assertEqual', NS(foo=[], bar=[]), args)\n    args = parser.parse_args(['--foo', 'a', 'b', '--', 'c', 'd'])\n    assert NS(foo=['a', 'b'], bar=['c', 'd']) == args, ('assertEqual', NS(foo=['a', 'b'], bar=['c', 'd']), args)\n    args = parser.parse_args(['a', 'b', '--foo', 'c', 'd'])\n    assert NS(foo=['c', 'd'], bar=['a', 'b']) == args, ('assertEqual', NS(foo=['c', 'd'], bar=['a', 'b']), args)\n    args = parser.parse_args(['a', '--', 'b', '--foo', 'c', 'd'])\n    assert NS(foo=None, bar=['a', 'b', '--foo', 'c', 'd']) == args, ('assertEqual', NS(foo=None, bar=['a', 'b', '--foo', 'c', 'd']), args)\n    args, argv = parser.parse_known_args(['a', 'b', '--foo', 'c', '--', 'd'])\n    assert NS(foo=['c'], bar=['a', 'b']) == args, ('assertEqual', NS(foo=['c'], bar=['a', 'b']), args)\n    assert argv == ['--', 'd'], ('assertEqual', argv, ['--', 'd'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDoubleDash.test_multiple_double_dashes" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(exit_on_error=False)\n    parser.add_argument('foo')\n    parser.add_argument('bar', nargs='*')\n    args = parser.parse_args(['--', 'a', 'b', 'c'])\n    assert NS(foo='a', bar=['b', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', 'c']), args)\n    args = parser.parse_args(['a', '--', 'b', 'c'])\n    assert NS(foo='a', bar=['b', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', 'c']), args)\n    args = parser.parse_args(['a', 'b', '--', 'c'])\n    assert NS(foo='a', bar=['b', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', 'c']), args)\n    args = parser.parse_args(['a', '--', 'b', '--', 'c'])\n    assert NS(foo='a', bar=['b', '--', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', '--', 'c']), args)\n    args = parser.parse_args(['--', '--', 'a', '--', 'b', 'c'])\n    assert NS(foo='--', bar=['a', '--', 'b', 'c']) == args, ('assertEqual', NS(foo='--', bar=['a', '--', 'b', 'c']), args)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDoubleDash.test_remainder" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(exit_on_error=False)\n    parser.add_argument('foo')\n    parser.add_argument('bar', nargs='...')\n    args = parser.parse_args(['--', 'a', 'b', 'c'])\n    assert NS(foo='a', bar=['b', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', 'c']), args)\n    args = parser.parse_args(['a', '--', 'b', 'c'])\n    assert NS(foo='a', bar=['b', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', 'c']), args)\n    args = parser.parse_args(['a', 'b', '--', 'c'])\n    assert NS(foo='a', bar=['b', '--', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', '--', 'c']), args)\n    args = parser.parse_args(['a', '--', 'b', '--', 'c'])\n    assert NS(foo='a', bar=['b', '--', 'c']) == args, ('assertEqual', NS(foo='a', bar=['b', '--', 'c']), args)\n    parser = argparse.ArgumentParser(exit_on_error=False)\n    parser.add_argument('--foo')\n    parser.add_argument('bar', nargs='...')\n    args = parser.parse_args(['--foo', 'a', '--', 'b', '--', 'c'])\n    assert NS(foo='a', bar=['--', 'b', '--', 'c']) == args, ('assertEqual', NS(foo='a', bar=['--', 'b', '--', 'c']), args)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDoubleDash.test_subparser" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(exit_on_error=False)\n    parser.add_argument('foo')\n    subparsers = parser.add_subparsers()\n    parser1 = subparsers.add_parser('run')\n    parser1.add_argument('-f')\n    parser1.add_argument('bar', nargs='*')\n    args = parser.parse_args(['x', 'run', 'a', 'b', '-f', 'c'])\n    assert NS(foo='x', f='c', bar=['a', 'b']) == args, ('assertEqual', NS(foo='x', f='c', bar=['a', 'b']), args)\n    args = parser.parse_args(['x', 'run', 'a', 'b', '--', '-f', 'c'])\n    assert NS(foo='x', f=None, bar=['a', 'b', '-f', 'c']) == args, ('assertEqual', NS(foo='x', f=None, bar=['a', 'b', '-f', 'c']), args)\n    args = parser.parse_args(['x', 'run', 'a', '--', 'b', '-f', 'c'])\n    assert NS(foo='x', f=None, bar=['a', 'b', '-f', 'c']) == args, ('assertEqual', NS(foo='x', f=None, bar=['a', 'b', '-f', 'c']), args)\n    args = parser.parse_args(['x', 'run', '--', 'a', 'b', '-f', 'c'])\n    assert NS(foo='x', f=None, bar=['a', 'b', '-f', 'c']) == args, ('assertEqual', NS(foo='x', f=None, bar=['a', 'b', '-f', 'c']), args)\n    args = parser.parse_args(['x', '--', 'run', 'a', 'b', '-f', 'c'])\n    assert NS(foo='x', f='c', bar=['a', 'b']) == args, ('assertEqual', NS(foo='x', f='c', bar=['a', 'b']), args)\n    args = parser.parse_args(['--', 'x', 'run', 'a', 'b', '-f', 'c'])\n    assert NS(foo='x', f='c', bar=['a', 'b']) == args, ('assertEqual', NS(foo='x', f='c', bar=['a', 'b']), args)\n    args = parser.parse_args(['x', 'run', '--', 'a', '--', 'b'])\n    assert NS(foo='x', f=None, bar=['a', '--', 'b']) == args, ('assertEqual', NS(foo='x', f=None, bar=['a', '--', 'b']), args)\n    args = parser.parse_args(['x', '--', 'run', '--', 'a', '--', 'b'])\n    assert NS(foo='x', f=None, bar=['a', '--', 'b']) == args, ('assertEqual', NS(foo='x', f=None, bar=['a', '--', 'b']), args)\n    try:\n        parser.parse_args(*(['--', 'x', '--', 'run', 'a', 'b'],))\n    except argparse.ArgumentError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDoubleDash.test_subparser_after_multiple_argument_option" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(exit_on_error=False)\n    parser.add_argument('--foo', nargs='*')\n    subparsers = parser.add_subparsers()\n    parser1 = subparsers.add_parser('run')\n    parser1.add_argument('-f')\n    parser1.add_argument('bar', nargs='*')\n    args = parser.parse_args(['--foo', 'x', 'y', '--', 'run', 'a', 'b', '-f', 'c'])\n    assert NS(foo=['x', 'y'], f='c', bar=['a', 'b']) == args, ('assertEqual', NS(foo=['x', 'y'], f='c', bar=['a', 'b']), args)\n    try:\n        parser.parse_args(*(['--foo', 'x', '--', '--', 'run', 'a', 'b'],))\n    except argparse.ArgumentError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIntermixedArgs.test_basic" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(prog='PROG')\n    parser.add_argument('--foo', dest='foo')\n    bar = parser.add_argument('--bar', dest='bar', required=True)\n    parser.add_argument('cmd')\n    parser.add_argument('rest', nargs='*', type=int)\n    argv = 'cmd --foo x 1 --bar y 2 3'.split()\n    args = parser.parse_intermixed_args(argv)\n    assert NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]) == args, ('assertEqual', NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]), args)\n    args, extras = parser.parse_known_args(argv)\n    assert NS(bar='y', cmd='cmd', foo='x', rest=[1]) == args, ('assertEqual', NS(bar='y', cmd='cmd', foo='x', rest=[1]), args)\n    assert ['2', '3'] == extras, ('assertEqual', ['2', '3'], extras)\n    args, extras = parser.parse_known_intermixed_args(argv)\n    assert NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]) == args, ('assertEqual', NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]), args)\n    assert [] == extras, ('assertEqual', [], extras)\n    argv = 'cmd --foo x --error 1 2 --bar y 3'.split()\n    args, extras = parser.parse_known_intermixed_args(argv)\n    assert NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]) == args, ('assertEqual', NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]), args)\n    assert ['--error'] == extras, ('assertEqual', ['--error'], extras)\n    argv = 'cmd --foo x 1 --error 2 --bar y 3'.split()\n    args, extras = parser.parse_known_intermixed_args(argv)\n    assert NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]) == args, ('assertEqual', NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]), args)\n    assert ['--error'] == extras, ('assertEqual', ['--error'], extras)\n    argv = 'cmd --foo x 1 2 --error --bar y 3'.split()\n    args, extras = parser.parse_known_intermixed_args(argv)\n    assert NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]) == args, ('assertEqual', NS(bar='y', cmd='cmd', foo='x', rest=[1, 2, 3]), args)\n    assert ['--error'] == extras, ('assertEqual', ['--error'], extras)\n    assert parser.usage is None, ('assertIsNone', parser.usage)\n    assert bar.required == True, ('assertEqual', bar.required, True)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIntermixedArgs.test_required_exclusive" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(prog='PROG', exit_on_error=False)\n    group = parser.add_mutually_exclusive_group(required=True)\n    group.add_argument('--foo', action='store_true', help='FOO')\n    group.add_argument('--spam', help='SPAM')\n    parser.add_argument('badger', nargs='*', default='X', help='BADGER')\n    args = parser.parse_intermixed_args('--foo 1 2'.split())\n    assert NS(badger=['1', '2'], foo=True, spam=None) == args, ('assertEqual', NS(badger=['1', '2'], foo=True, spam=None), args)\n    args = parser.parse_intermixed_args('1 --foo 2'.split())\n    assert NS(badger=['1', '2'], foo=True, spam=None) == args, ('assertEqual', NS(badger=['1', '2'], foo=True, spam=None), args)\n    try:\n        parser.parse_intermixed_args(*('1 2'.split(),))\n    except argparse.ArgumentError:\n        pass\n    assert group.required == True, ('assertEqual', group.required, True)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

