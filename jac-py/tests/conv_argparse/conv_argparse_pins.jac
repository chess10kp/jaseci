test "TestAddSubparsers.test_subparser_title_help" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport textwrap\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = ErrorRaisingArgumentParser(prog='PROG', description='main description')\n    parser.add_argument('--foo', action='store_true', help='foo help')\n    parser.add_argument('bar', help='bar help')\n    subparsers = parser.add_subparsers(title='subcommands', description='command help', help='additional text')\n    parser1 = subparsers.add_parser('1')\n    parser2 = subparsers.add_parser('2')\n    assert parser.format_usage() == 'usage: PROG [-h] [--foo] bar {1,2} ...\\n', ('assertEqual', parser.format_usage(), 'usage: PROG [-h] [--foo] bar {1,2} ...\\n')\n    assert parser.format_help() == textwrap.dedent('            usage: PROG [-h] [--foo] bar {1,2} ...\\n\\n            main description\\n\\n            positional arguments:\\n              bar         bar help\\n\\n            options:\\n              -h, --help  show this help message and exit\\n              --foo       foo help\\n\\n            subcommands:\\n              command help\\n\\n              {1,2}       additional text\\n            '), ('assertEqual', parser.format_help(), textwrap.dedent('            usage: PROG [-h] [--foo] bar {1,2} ...\\n\\n            main description\\n\\n            positional arguments:\\n              bar         bar help\\n\\n            options:\\n              -h, --help  show this help message and exit\\n              --foo       foo help\\n\\n            subcommands:\\n              command help\\n\\n              {1,2}       additional text\\n            '))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_subparser1_help" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport textwrap\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def _test_subparser_help(args_str, expected_help):\n        try:\n            self.parser.parse_args(args_str.split())\n        except ArgumentParserError as _exc:\n            cm = _exc\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        assert expected_help == cm.stdout, ('assertEqual', expected_help, cm.stdout)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    _test_subparser_help('5.0 1 -h', textwrap.dedent('            usage: PROG bar 1 [-h] [-w W] {a,b,c}\\n\\n            1 description\\n\\n            positional arguments:\\n              {a,b,c}     x help\\n\\n            options:\\n              -h, --help  show this help message and exit\\n              -w W        w help\\n            '))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_subparser2_help" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport textwrap\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def _test_subparser_help(args_str, expected_help):\n        try:\n            self.parser.parse_args(args_str.split())\n        except ArgumentParserError as _exc:\n            cm = _exc\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        assert expected_help == cm.stdout, ('assertEqual', expected_help, cm.stdout)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    _test_subparser_help('5.0 2 -h', textwrap.dedent('            usage: PROG bar 2 [-h] [-y {1,2,3}] [z ...]\\n\\n            2 description\\n\\n            positional arguments:\\n              z           z help\\n\\n            options:\\n              -h, --help  show this help message and exit\\n              -y {1,2,3}  y help\\n            '))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_alias_invocation" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = _get_parser(aliases=True)\n    assert parser.parse_known_args('0.5 1alias1 b'.split()) == (NS(foo=False, bar=0.5, w=None, x='b'), []), ('assertEqual', parser.parse_known_args('0.5 1alias1 b'.split()), (NS(foo=False, bar=0.5, w=None, x='b'), []))\n    assert parser.parse_known_args('0.5 1alias2 b'.split()) == (NS(foo=False, bar=0.5, w=None, x='b'), []), ('assertEqual', parser.parse_known_args('0.5 1alias2 b'.split()), (NS(foo=False, bar=0.5, w=None, x='b'), []))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_error_alias_invocation" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def assertArgumentParserError(*args, **kwargs):\n        try:\n            _p2_fwd_fn, *_p2_fwd_rest = list(args)\n            _p2_fwd_fn(*_p2_fwd_rest, **kwargs)\n        except ArgumentParserError:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = _get_parser(aliases=True)\n    assertArgumentParserError(parser.parse_args, '0.5 1alias3 b'.split())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_alias_help" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport textwrap\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = _get_parser(aliases=True, subparser_help=True)\n    self.maxDiff = None\n    assert parser.format_help() == textwrap.dedent('            usage: PROG [-h] [--foo] bar COMMAND ...\\n\\n            main description\\n\\n            positional arguments:\\n              bar                   bar help\\n\\n            options:\\n              -h, --help            show this help message and exit\\n              --foo                 foo help\\n\\n            commands:\\n              COMMAND\\n                1 (1alias1, 1alias2)\\n                                    1 help\\n                2                   2 help\\n                3                   3 help\\n            '), ('assertEqual', parser.format_help(), textwrap.dedent('            usage: PROG [-h] [--foo] bar COMMAND ...\\n\\n            main description\\n\\n            positional arguments:\\n              bar                   bar help\\n\\n            options:\\n              -h, --help            show this help message and exit\\n              --foo                 foo help\\n\\n            commands:\\n              COMMAND\\n                1 (1alias1, 1alias2)\\n                                    1 help\\n                2                   2 help\\n                3                   3 help\\n            '))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestPositionalsGroups.test_nongroup_first" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = ErrorRaisingArgumentParser()\n    parser.add_argument('foo')\n    group = parser.add_argument_group('g')\n    group.add_argument('bar')\n    parser.add_argument('baz')\n    expected = NS(foo='1', bar='2', baz='3')\n    result = parser.parse_args('1 2 3'.split())\n    assert expected == result, ('assertEqual', expected, result)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestPositionalsGroups.test_group_first" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = ErrorRaisingArgumentParser()\n    group = parser.add_argument_group('xxx')\n    group.add_argument('foo')\n    parser.add_argument('bar')\n    parser.add_argument('baz')\n    expected = NS(foo='1', bar='2', baz='3')\n    result = parser.parse_args('1 2 3'.split())\n    assert expected == result, ('assertEqual', expected, result)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestPositionalsGroups.test_interleaved_groups" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = ErrorRaisingArgumentParser()\n    group = parser.add_argument_group('xxx')\n    parser.add_argument('foo')\n    group.add_argument('bar')\n    parser.add_argument('baz')\n    group = parser.add_argument_group('yyy')\n    group.add_argument('frell')\n    expected = NS(foo='1', bar='2', baz='3', frell='4')\n    result = parser.parse_args('1 2 3 4'.split())\n    assert expected == result, ('assertEqual', expected, result)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
