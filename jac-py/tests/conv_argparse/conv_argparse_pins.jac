rser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def get_parser__TestMutuallyExclusiveSimple(required=None):\n        parser = ErrorRaisingArgumentParser(prog='PROG')\n        group = parser.add_mutually_exclusive_group(required=required)\n        group.add_argument('--bar', help='bar help')\n        group.add_argument('--baz', nargs='?', const='Z', help='baz help')\n        return parser\n\n    def get_parser(required=None):\n        parent = get_parser__TestMutuallyExclusiveSimple(required=required)\n        parser = ErrorRaisingArgumentParser(prog=parent.prog, add_help=False, parents=[parent])\n        return parser\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.failures = ['--bar X --baz Y', '--bar X --baz']\n    _SelfNS.failures = ['--bar X --baz Y', '--bar X --baz']\n    self.help = '\\n        options:\\n          -h, --help   show this help message and exit\\n          --bar BAR    bar help\\n          --baz [BAZ]  baz help\\n        '\n    _SelfNS.help = '\\n        options:\\n          -h, --help   show this help message and exit\\n          --bar BAR    bar help\\n          --baz [BAZ]  baz help\\n        '\n    self.successes = [('--bar X', NS(bar='X', baz=None)), ('--bar X --bar Z', NS(bar='Z', baz=None)), ('--baz Y', NS(bar=None, baz='Y')), ('--baz', NS(bar=None, baz='Z'))]\n    _SelfNS.successes = [('--bar X', NS(bar='X', baz=None)), ('--bar X --bar Z', NS(bar='Z', baz=None)), ('--baz Y', NS(bar=None, baz='Y')), ('--baz', NS(bar=None, baz='Z'))]\n    self.successes_when_not_required = [('', NS(bar=None, baz=None))]\n    _SelfNS.successes_when_not_required = [('', NS(bar=None, baz=None))]\n    self.usage_when_not_required = '        usage: PROG [-h] [--bar BAR | --baz [BAZ]]\\n        '\n    _SelfNS.usage_when_not_required = '        usage: PROG [-h] [--bar BAR | --baz [BAZ]]\\n        '\n    self.usage_when_required = '        usage: PROG [-h] (--bar BAR | --baz [BAZ])\\n        '\n    _SelfNS.usage_when_required = '        usage: PROG [-h] (--bar BAR | --baz [BAZ])\\n        '\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    format_help = get_parser(required=True).format_help\n    help = self.usage_when_required + self.help\n    assert format_help() == textwrap.dedent(help), ('assertEqual', format_help(), textwrap.dedent(help))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

