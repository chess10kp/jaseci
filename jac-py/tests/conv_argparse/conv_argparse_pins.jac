test "TestHelpUsageNoWhitespaceCrash.test_long_mutex_groups_wrap" {
    (ok, detail) = p2_libtest_run_snippet("import textwrap\nimport argparse\nfrom test.support import os_helper\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser(prog='PROG')\n    g = parser.add_mutually_exclusive_group()\n    g.add_argument('--op1', metavar='MET', nargs='?')\n    g.add_argument('--op2', metavar=('MET1', 'MET2'), nargs='*')\n    g.add_argument('--op3', nargs='*')\n    g.add_argument('--op4', metavar=('MET1', 'MET2'), nargs='+')\n    g.add_argument('--op5', nargs='+')\n    g.add_argument('--op6', nargs=3)\n    g.add_argument('--op7', metavar=('MET1', 'MET2', 'MET3'), nargs=3)\n    usage = textwrap.dedent('        usage: PROG [-h] [--op1 [MET] | --op2 [MET1 [MET2 ...]] | --op3 [OP3 ...] |\\n                    --op4 MET1 [MET2 ...] | --op5 OP5 [OP5 ...] | --op6 OP6 OP6 OP6 |\\n                    --op7 MET1 MET2 MET3]\\n        ')\n    assert parser.format_usage() == usage, ('assertEqual', parser.format_usage(), usage)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

