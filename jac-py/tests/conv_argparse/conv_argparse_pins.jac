test "TestNamespace.test_equality" {
    (ok, detail) = p2_libtest_run_snippet("import argparse\nfrom test.support import os_helper\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    ns1 = argparse.Namespace(a=1, b=2)\n    ns2 = argparse.Namespace(b=2, a=1)\n    ns3 = argparse.Namespace(a=1)\n    ns4 = argparse.Namespace(b=2)\n    assert ns1 == ns2, ('assertEqual', ns1, ns2)\n    assert ns1 != ns3, ('assertNotEqual', ns1, ns3)\n    assert ns1 != ns4, ('assertNotEqual', ns1, ns4)\n    assert ns2 != ns3, ('assertNotEqual', ns2, ns3)\n    assert ns2 != ns4, ('assertNotEqual', ns2, ns4)\n    assert ns1 != ns3, ('assertTrue', ns1 != ns3)\n    assert ns1 != ns4, ('assertTrue', ns1 != ns4)\n    assert ns2 != ns3, ('assertTrue', ns2 != ns3)\n    assert ns2 != ns4, ('assertTrue', ns2 != ns4)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

