test "TestAddSubparsers.test_parse_args" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    assert self.parser.parse_args('0.5 1 b -w 7'.split()) == NS(foo=False, bar=0.5, w=7, x='b'), ('assertEqual', self.parser.parse_args('0.5 1 b -w 7'.split()), NS(foo=False, bar=0.5, w=7, x='b'))\n    assert self.parser.parse_args('0.25 --foo 2 -y 2 3j -- -1j'.split()) == NS(foo=True, bar=0.25, y='2', z=[3j, -1j]), ('assertEqual', self.parser.parse_args('0.25 --foo 2 -y 2 3j -- -1j'.split()), NS(foo=True, bar=0.25, y='2', z=[3j, -1j]))\n    assert self.parser.parse_args('--foo 0.125 1 c'.split()) == NS(foo=True, bar=0.125, w=None, x='c'), ('assertEqual', self.parser.parse_args('--foo 0.125 1 c'.split()), NS(foo=True, bar=0.125, w=None, x='c'))\n    assert self.parser.parse_args('-1.5 3 11 -- a --foo 7 -- b'.split()) == NS(foo=False, bar=-1.5, t=11, u=['a', '--foo', '7', '--', 'b']), ('assertEqual', self.parser.parse_args('-1.5 3 11 -- a --foo 7 -- b'.split()), NS(foo=False, bar=-1.5, t=11, u=['a', '--foo', '7', '--', 'b']))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_parse_known_args" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    assert self.parser.parse_known_args('0.5 1 b -w 7'.split()) == (NS(foo=False, bar=0.5, w=7, x='b'), []), ('assertEqual', self.parser.parse_known_args('0.5 1 b -w 7'.split()), (NS(foo=False, bar=0.5, w=7, x='b'), []))\n    assert self.parser.parse_known_args('0.5 -p 1 b -w 7'.split()) == (NS(foo=False, bar=0.5, w=7, x='b'), ['-p']), ('assertEqual', self.parser.parse_known_args('0.5 -p 1 b -w 7'.split()), (NS(foo=False, bar=0.5, w=7, x='b'), ['-p']))\n    assert self.parser.parse_known_args('0.5 1 b -w 7 -p'.split()) == (NS(foo=False, bar=0.5, w=7, x='b'), ['-p']), ('assertEqual', self.parser.parse_known_args('0.5 1 b -w 7 -p'.split()), (NS(foo=False, bar=0.5, w=7, x='b'), ['-p']))\n    assert self.parser.parse_known_args('0.5 1 b -q -rs -w 7'.split()) == (NS(foo=False, bar=0.5, w=7, x='b'), ['-q', '-rs']), ('assertEqual', self.parser.parse_known_args('0.5 1 b -q -rs -w 7'.split()), (NS(foo=False, bar=0.5, w=7, x='b'), ['-q', '-rs']))\n    assert self.parser.parse_known_args('0.5 -W 1 b -X Y -w 7 Z'.split()) == (NS(foo=False, bar=0.5, w=7, x='b'), ['-W', '-X', 'Y', 'Z']), ('assertEqual', self.parser.parse_known_args('0.5 -W 1 b -X Y -w 7 Z'.split()), (NS(foo=False, bar=0.5, w=7, x='b'), ['-W', '-X', 'Y', 'Z']))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_parse_known_args_to_class_namespace" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n\n    class C:\n        pass\n    assert self.parser.parse_known_args('0.5 1 b -w 7 -p'.split(), namespace=C) == (C, ['-p']), ('assertEqual', self.parser.parse_known_args('0.5 1 b -w 7 -p'.split(), namespace=C), (C, ['-p']))\n    assert C.foo is False, ('assertIs', C.foo, False)\n    assert C.bar == 0.5, ('assertEqual', C.bar, 0.5)\n    assert C.w == 7, ('assertEqual', C.w, 7)\n    assert C.x == 'b', ('assertEqual', C.x, 'b')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_abbreviation" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def assertArgumentParserError(*args, **kwargs):\n        try:\n            _p2_fwd_fn, *_p2_fwd_rest = list(args)\n            _p2_fwd_fn(*_p2_fwd_rest, **kwargs)\n        except ArgumentParserError:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = ErrorRaisingArgumentParser()\n    parser.add_argument('--foodle')\n    parser.add_argument('--foonly')\n    subparsers = parser.add_subparsers()\n    parser1 = subparsers.add_parser('bar')\n    parser1.add_argument('--fo')\n    parser1.add_argument('--foonew')\n    assert parser.parse_args(['--food', 'baz', 'bar']) == NS(foodle='baz', foonly=None, fo=None, foonew=None), ('assertEqual', parser.parse_args(['--food', 'baz', 'bar']), NS(foodle='baz', foonly=None, fo=None, foonew=None))\n    assert parser.parse_args(['--foon', 'baz', 'bar']) == NS(foodle=None, foonly='baz', fo=None, foonew=None), ('assertEqual', parser.parse_args(['--foon', 'baz', 'bar']), NS(foodle=None, foonly='baz', fo=None, foonew=None))\n    assertArgumentParserError(parser.parse_args, ['--fo', 'baz', 'bar'])\n    assert parser.parse_args(['bar', '--fo', 'baz']) == NS(foodle=None, foonly=None, fo='baz', foonew=None), ('assertEqual', parser.parse_args(['bar', '--fo', 'baz']), NS(foodle=None, foonly=None, fo='baz', foonew=None))\n    assert parser.parse_args(['bar', '--foo', 'baz']) == NS(foodle=None, foonly=None, fo=None, foonew='baz'), ('assertEqual', parser.parse_args(['bar', '--foo', 'baz']), NS(foodle=None, foonly=None, fo=None, foonew='baz'))\n    assert parser.parse_args(['bar', '--foon', 'baz']) == NS(foodle=None, foonly=None, fo=None, foonew='baz'), ('assertEqual', parser.parse_args(['bar', '--foon', 'baz']), NS(foodle=None, foonly=None, fo=None, foonew='baz'))\n    assertArgumentParserError(parser.parse_args, ['bar', '--food', 'baz'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestAddSubparsers.test_parse_known_args_with_single_dash_option" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def _get_parser(subparser_help=False, prefix_chars=None, aliases=False, usage=None):\n        if prefix_chars:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage, prefix_chars=prefix_chars)\n            parser.add_argument(prefix_chars[0] * 2 + 'foo', action='store_true', help='foo help')\n        else:\n            parser = ErrorRaisingArgumentParser(prog='PROG', description='main description', usage=usage)\n            parser.add_argument('--foo', action='store_true', help='foo help')\n        parser.add_argument('bar', type=float, help='bar help')\n        subparsers_kwargs = {'required': False}\n        if aliases:\n            subparsers_kwargs['metavar'] = 'COMMAND'\n            subparsers_kwargs['title'] = 'commands'\n        else:\n            subparsers_kwargs['help'] = 'command help'\n        subparsers = parser.add_subparsers(**subparsers_kwargs)\n        try:\n            parser.add_subparsers()\n        except ValueError:\n            pass\n        parser1_kwargs = dict(description='1 description')\n        if subparser_help:\n            parser1_kwargs['help'] = '1 help'\n        if aliases:\n            parser1_kwargs['aliases'] = ['1alias1', '1alias2']\n        parser1 = subparsers.add_parser('1', **parser1_kwargs)\n        parser1.add_argument('-w', type=int, help='w help')\n        parser1.add_argument('x', choices=['a', 'b', 'c'], help='x help')\n        parser2_kwargs = dict(description='2 description')\n        if subparser_help:\n            parser2_kwargs['help'] = '2 help'\n        parser2 = subparsers.add_parser('2', **parser2_kwargs)\n        parser2.add_argument('-y', choices=['1', '2', '3'], help='y help')\n        parser2.add_argument('z', type=complex, nargs='*', help='z help')\n        parser3_kwargs = dict(description='3 description', usage='PROG --foo bar 3 t ...')\n        if subparser_help:\n            parser3_kwargs['help'] = '3 help'\n        parser3 = subparsers.add_parser('3', **parser3_kwargs)\n        parser3.add_argument('t', type=int, help='t help')\n        parser3.add_argument('u', nargs='...', help='u help')\n        return parser\n\n    def setUp():\n        self.parser = _get_parser()\n        self.command_help_parser = _get_parser(subparser_help=True)\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def assertArgumentParserError(*args, **kwargs):\n        try:\n            _p2_fwd_fn, *_p2_fwd_rest = list(args)\n            _p2_fwd_fn(*_p2_fwd_rest, **kwargs)\n        except ArgumentParserError:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = _get_parser()\n    self.command_help_parser = _get_parser(subparser_help=True)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = ErrorRaisingArgumentParser()\n    parser.add_argument('-k', '--known', action='count', default=0)\n    parser.add_argument('-n', '--new', action='count', default=0)\n    assert parser.parse_known_args(['-k', '-u']) == (NS(known=1, new=0), ['-u']), ('assertEqual', parser.parse_known_args(['-k', '-u']), (NS(known=1, new=0), ['-u']))\n    assert parser.parse_known_args(['-u', '-k']) == (NS(known=1, new=0), ['-u']), ('assertEqual', parser.parse_known_args(['-u', '-k']), (NS(known=1, new=0), ['-u']))\n    assert parser.parse_known_args(['-ku']) == (NS(known=1, new=0), ['-u']), ('assertEqual', parser.parse_known_args(['-ku']), (NS(known=1, new=0), ['-u']))\n    assertArgumentParserError(parser.parse_known_args, ['-k=u'])\n    assert parser.parse_known_args(['-uk']) == (NS(known=0, new=0), ['-uk']), ('assertEqual', parser.parse_known_args(['-uk']), (NS(known=0, new=0), ['-uk']))\n    assert parser.parse_known_args(['-u=k']) == (NS(known=0, new=0), ['-u=k']), ('assertEqual', parser.parse_known_args(['-u=k']), (NS(known=0, new=0), ['-u=k']))\n    assert parser.parse_known_args(['-kunknown']) == (NS(known=1, new=0), ['-unknown']), ('assertEqual', parser.parse_known_args(['-kunknown']), (NS(known=1, new=0), ['-unknown']))\n    assertArgumentParserError(parser.parse_known_args, ['-k=unknown'])\n    assert parser.parse_known_args(['-ku=nknown']) == (NS(known=1, new=0), ['-u=nknown']), ('assertEqual', parser.parse_known_args(['-ku=nknown']), (NS(known=1, new=0), ['-u=nknown']))\n    assert parser.parse_known_args(['-knew']) == (NS(known=1, new=1), ['-ew']), ('assertEqual', parser.parse_known_args(['-knew']), (NS(known=1, new=1), ['-ew']))\n    assertArgumentParserError(parser.parse_known_args, ['-kn=ew'])\n    assertArgumentParserError(parser.parse_known_args, ['-k-new'])\n    assertArgumentParserError(parser.parse_known_args, ['-kn-ew'])\n    assert parser.parse_known_args(['-kne-w']) == (NS(known=1, new=1), ['-e-w']), ('assertEqual', parser.parse_known_args(['-kne-w']), (NS(known=1, new=1), ['-e-w']))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

