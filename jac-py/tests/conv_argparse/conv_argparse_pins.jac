old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def get_parser__TestMutuallyExclusiveManySuppressed(required):\n        parser = ErrorRaisingArgumentParser(prog='PROG')\n        group = parser.add_mutually_exclusive_group(required=required)\n        add = group.add_argument\n        add('--spam', action='store_true', help=argparse.SUPPRESS)\n        add('--badger', action='store_false', help=argparse.SUPPRESS)\n        add('--bladder', help=argparse.SUPPRESS)\n        return parser\n\n    def get_parser(required=None):\n        parent = get_parser__TestMutuallyExclusiveManySuppressed(required=required)\n        parser = ErrorRaisingArgumentParser(prog=parent.prog, add_help=False, parents=[parent])\n        return parser\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.failures = ['--spam --badger', '--badger --bladder B', '--bladder B --spam']\n    _SelfNS.failures = ['--spam --badger', '--badger --bladder B', '--bladder B --spam']\n    self.help = '\\n        options:\\n          -h, --help  show this help message and exit\\n        '\n    _SelfNS.help = '\\n        options:\\n          -h, --help  show this help message and exit\\n        '\n    self.successes = [('--spam', NS(spam=True, badger=True, bladder=None)), ('--badger', NS(spam=False, badger=False, bladder=None)), ('--bladder B', NS(spam=False, badger=True, bladder='B')), ('--spam --spam', NS(spam=True, badger=True, bladder=None))]\n    _SelfNS.successes = [('--spam', NS(spam=True, badger=True, bladder=None)), ('--badger', NS(spam=False, badger=False, bladder=None)), ('--bladder B', NS(spam=False, badger=True, bladder='B')), ('--spam --spam', NS(spam=True, badger=True, bladder=None))]\n    self.successes_when_not_required = [('', NS(spam=False, badger=True, bladder=None))]\n    _SelfNS.successes_when_not_required = [('', NS(spam=False, badger=True, bladder=None))]\n    self.usage_when_not_required = '        usage: PROG [-h]\\n        '\n    _SelfNS.usage_when_not_required = '        usage: PROG [-h]\\n        '\n    self.usage_when_required = '        usage: PROG [-h]\\n        '\n    _SelfNS.usage_when_required = '        usage: PROG [-h]\\n        '\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parse_args = get_parser(required=True).parse_args\n    error = ArgumentParserError\n    for args_string in self.failures + ['']:\n        try:\n            parse_args(*(args_string.split(),))\n        except error:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestMutuallyExclusiveOptionalAndPositionalParent.test_failures_when_required" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport sys\nimport argparse\nimport warnings\nfrom test.support import os_helper\n\nclass StdIOBuffer(io.TextIOWrapper):\n    \"\"\"Replacement for writable io.StringIO that behaves more like real file\n\n    Unlike StringIO, provides a buffer attribute that holds the underlying\n    binary data, allowing it to replace sys.stdout/sys.stderr in more\n    contexts.\n    \"\"\"\n\n    def __init__(self, initial_value='', newline='\\n'):\n        initial_value = initial_value.encode('utf-8')\n        super().__init__(io.BufferedWriter(io.BytesIO(initial_value)), 'utf-8', newline=newline)\n\n    def getvalue(self):\n        self.flush()\n        return self.buffer.raw.getvalue().decode('utf-8')\n\nclass NS(object):\n\n    def __init__(self, **kwargs):\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        sorted_items = sorted(self.__dict__.items())\n        kwarg_str = ', '.join(['%s=%r' % tup for tup in sorted_items])\n        return '%s(%s)' % (type(self).__name__, kwarg_str)\n\n    def __eq__(self, other):\n        return vars(self) == vars(other)\n\nclass ArgumentParserError(Exception):\n\n    def __init__(self, message, stdout=None, stderr=None, error_code=None):\n        Exception.__init__(self, message, stdout, stderr)\n        self.message = message\n        self.stdout = stdout\n        self.stderr = stderr\n        self.error_code = error_code\n\ndef stderr_to_parser_error(parse_args, *args, **kwargs):\n    if isinstance(sys.stderr, StdIOBuffer) or isinstance(sys.stdout, StdIOBuffer):\n        return parse_args(*args, **kwargs)\n    old_stdout = sys.stdout\n    old_stderr = sys.stderr\n    sys.stdout = StdIOBuffer()\n    sys.stderr = StdIOBuffer()\n    try:\n        try:\n            result = parse_args(*args, **kwargs)\n            for key in list(vars(result)):\n                attr = getattr(result, key)\n                if attr is sys.stdout:\n                    setattr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def get_parser__TestMutuallyExclusiveOptionalAndPositional(required):\n        parser = ErrorRaisingArgumentParser(prog='PROG')\n        group = parser.add_mutually_exclusive_group(required=required)\n        group.add_argument('--foo', action='store_true', help='FOO')\n        group.add_argument('--spam', help='SPAM')\n        group.add_argument('badger', nargs='*', help='BADGER')\n        return parser\n\n    def get_parser(required=None):\n        parent = get_parser__TestMutuallyExclusiveOptionalAndPositional(required=required)\n        parser = ErrorRaisingArgumentParser(prog=parent.prog, add_help=False, parents=[parent])\n        return parser\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.failures = ['--foo --spam S', '--spam S X', 'X --foo', 'X Y Z --spam S', '--foo X Y']\n    _SelfNS.failures = ['--foo --spam S', '--spam S X', 'X --foo', 'X Y Z --spam S', '--foo X Y']\n    self.help = '\\n        positional arguments:\\n          badger       BADGER\\n\\n        options:\\n          -h, --help   show this help message and exit\\n          --foo        FOO\\n          --spam SPAM  SPAM\\n        '\n    _SelfNS.help = '\\n        positional arguments:\\n          badger       BADGER\\n\\n        options:\\n          -h, --help   show this help message and exit\\n          --foo        FOO\\n          --spam SPAM  SPAM\\n        '\n    self.successes = [('--foo', NS(foo=True, spam=None, badger=[])), ('--spam S', NS(foo=False, spam='S', badger=[])), ('X', NS(foo=False, spam=None, badger=['X'])), ('X Y Z', NS(foo=False, spam=None, badger=['X', 'Y', 'Z']))]\n    _SelfNS.successes = [('--foo', NS(foo=True, spam=None, badger=[])), ('--spam S', NS(foo=False, spam='S', badger=[])), ('X', NS(foo=False, spam=None, badger=['X'])), ('X Y Z', NS(foo=False, spam=None, badger=['X', 'Y', 'Z']))]\n    self.successes_when_not_required = [('', NS(foo=False, spam=None, badger=[]))]\n    _SelfNS.successes_when_not_required = [('', NS(foo=False, spam=None, badger=[]))]\n    self.usage_when_not_required = '        usage: PROG [-h] [--foo | --spam SPAM | badger ...]\\n        '\n    _SelfNS.usage_when_not_required = '        usage: PROG [-h] [--foo | --spam SPAM | badger ...]\\n        '\n    self.usage_when_required = '        usage: PROG [-h] (--foo | --spam SPAM | badger ...)\\n        '\n    _SelfNS.usage_when_required = '        usage: PROG [-h] (--foo | --spam SPAM | badger ...)\\n        '\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parse_args = get_parser(required=True).parse_args\n    error = ArgumentParserError\n    for args_string in self.failures + ['']:\n        try:\n            parse_args(*(args_string.split(),))\n        except error:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

