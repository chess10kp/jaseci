test "TestInvalidArgumentConstructors.test_user_defined_action" {
    (ok, detail) = p2_libtest_run_snippet("import argparse\nfrom test.support import os_helper\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n\n    class Success(Exception):\n        pass\n\n    class Action(object):\n\n        def __init__(self, option_strings, dest, const, default, required=False):\n            if dest == 'spam':\n                if const is Success:\n                    if default is Success:\n                        raise Success()\n\n        def __call__(self, *args, **kwargs):\n            pass\n    parser = argparse.ArgumentParser()\n    try:\n        parser.add_argument(*('--spam',), action=Action, default=Success, const=Success)\n    except Success:\n        pass\n    try:\n        parser.add_argument(*('spam',), action=Action, default=Success, const=Success)\n    except Success:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestActionsReturned.test_dest" {
    (ok, detail) = p2_libtest_run_snippet("import argparse\nfrom test.support import os_helper\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = argparse.ArgumentParser()\n    action = parser.add_argument('--foo')\n    assert action.dest == 'foo', ('assertEqual', action.dest, 'foo')\n    action = parser.add_argument('-b', '--bar')\n    assert action.dest == 'bar', ('assertEqual', action.dest, 'bar')\n    action = parser.add_argument('-x', '-y')\n    assert action.dest == 'x', ('assertEqual', action.dest, 'x')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
