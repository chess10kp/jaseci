SCII\n    os.mkdir(self.dirname)\n    compiled = False\n    dirname = os.path.join(self.dirname, os_helper.TESTFN)\n    os.mkdir(dirname)\n    make_script(dirname, '__main__', compiled=compiled)\n    check_usage(f'{py} {dirname}', dirname)\n    dirname2 = os.path.join(os.curdir, dirname)\n    check_usage(f'{py} {dirname2}', dirname2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
