rser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def get_parser__TestMutuallyExclusiveFirstSuppressed(required):\n        parser = ErrorRaisingArgumentParser(prog='PROG')\n        group = parser.add_mutually_exclusive_group(required=required)\n        group.add_argument('-x', help=argparse.SUPPRESS)\n        group.add_argument('-y', action='store_false', help='y help')\n        return parser\n\n    def get_parser(required=None):\n        parent = get_parser__TestMutuallyExclusiveFirstSuppressed(required=required)\n        parser = ErrorRaisingArgumentParser(prog=parent.prog, add_help=False, parents=[parent])\n        return parser\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.failures = ['-x X -y']\n    _SelfNS.failures = ['-x X -y']\n    self.help = '\\n        options:\\n          -h, --help  show this help message and exit\\n          -y          y help\\n        '\n    _SelfNS.help = '\\n        options:\\n          -h, --help  show this help message and exit\\n          -y          y help\\n        '\n    self.successes = [('-x X', NS(x='X', y=True)), ('-x X -x Y', NS(x='Y', y=True)), ('-y', NS(x=None, y=False))]\n    _SelfNS.successes = [('-x X', NS(x='X', y=True)), ('-x X -x Y', NS(x='Y', y=True)), ('-y', NS(x=None, y=False))]\n    self.successes_when_not_required = [('', NS(x=None, y=True))]\n    _SelfNS.successes_when_not_required = [('', NS(x=None, y=True))]\n    self.usage_when_not_required = '        usage: PROG [-h] [-y]\\n        '\n    _SelfNS.usage_when_not_required = '        usage: PROG [-h] [-y]\\n        '\n    self.usage_when_required = '        usage: PROG [-h] -y\\n        '\n    _SelfNS.usage_when_required = '        usage: PROG [-h] -y\\n     