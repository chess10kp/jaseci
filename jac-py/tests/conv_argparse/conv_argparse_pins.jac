ttr(result, key, old_stdout)\n                elif attr is sys.stdout.buffer:\n                    setattr(result, key, getattr(old_stdout, 'buffer', BIN_STDOUT_SENTINEL))\n                elif attr is sys.stderr:\n                    setattr(result, key, old_stderr)\n                elif attr is sys.stderr.buffer:\n                    setattr(result, key, getattr(old_stderr, 'buffer', BIN_STDERR_SENTINEL))\n            return result\n        except SystemExit as e:\n            code = e.code\n            stdout = sys.stdout.getvalue()\n            stderr = sys.stderr.getvalue()\n            raise ArgumentParserError('SystemExit', stdout, stderr, code) from None\n    finally:\n        sys.stdout = old_stdout\n        sys.stderr = old_stderr\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef FileType(*args, **kwargs):\n    with warnings.catch_warnings():\n        warnings.filterwarnings('ignore', 'FileType is deprecated', PendingDeprecationWarning, __name__)\n        return argparse.FileType(*args, **kwargs)\nBIN_STDOUT_SENTINEL = object()\nBIN_STDERR_SENTINEL = object()\n\nclass ErrorRaisingArgumentParser(argparse.ArgumentParser):\n\n    def parse_args(self, *args, **kwargs):\n        parse_args = super(ErrorRaisingArgumentParser, self).parse_args\n        return stderr_to_parser_error(parse_args, *args, **kwargs)\n\n    def exit(self, *args, **kwargs):\n        exit = super(ErrorRaisingArgumentParser, self).exit\n        return stderr_to_parser_error(exit, *args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def get_parser__TestMutuallyExclusiveOptionalAndPositional(required):\n        parser = ErrorRaisingArgumentParser(prog='PROG')\n        group = parser.add_mutually_exclusive_group(required=required)\n        group.add_argument('--foo', action='store_true', help='FOO')\n        group.add_argument('--spam', help='SPAM')\n        group.add_argument('badger', nargs='*', help='BADGER')\n        return parser\n\n    def get_parser(required=None):\n        parent = get_parser__TestMutuallyExclusiveOptionalAndPositional(required=required)\n        parser = ErrorRaisingArgumentParser(prog=parent.prog, add_help=False, parents=[parent])\n        return parser\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.failures = ['--foo --spam S', '--spam S X', 'X --foo', 'X Y Z --spam S', '--foo X Y']\n    _SelfNS.failures = ['--foo --spam S', '--spam S X', 'X --foo', 'X Y Z --spam S', '--foo X Y']\n    self.help = '\\n        positional arguments:\\n          badger       BADGER\\n\\n        options:\\n          -h, --help   show this help message and exit\\n          --foo        FOO\\n          --spam SPAM  SPAM\\n        '\n    _SelfNS.help = '\\n        positional arguments:\\n          badger       BADGER\\n\\n        options:\\n          -h, --help   show this help message and exit\\n          --foo        FOO\\n          --spam SPAM  SPAM\\n        '\n    self.successes = [('--foo', NS(foo=True, spam=None, badger=[])), ('--spam S', NS(foo=False, spam='S', badger=[])), ('X', NS(foo=False, spam=None, badger=['X'])), ('X Y Z', NS(foo=False, spam=None, badger=['X', 'Y', 'Z']))]\n    _SelfNS.successes = [('--foo', NS(foo=True, spam=None, badger=[])), ('--spam S', NS(foo=False, spam='S', badger=[])), ('X', NS(foo=False, spam=None, badger=['X'])), ('X Y Z', NS(foo=False, spam=None, badger=['X', 'Y', 'Z']))]\n    self.successes_when_not_required = [('', NS(foo=False, spam=None, badger=[]))]\n    _SelfNS.successes_when_not_required = [('', NS(foo=False, spam=None, badger=[]))]\n    self.usage_when_not_required = '        usage: PROG [-h] [--foo | --spam SPAM | badger ...]\\n        '\n    _SelfNS.usage_when_not_required = '        usage: PROG [-h] [--foo | --spam SPAM | badger ...]\\n        '\n    self.usage_when_required = '        usage: PROG [-h] (--foo | --spam SPAM | badger ...)\\n        '\n    _SelfNS.usage_when_required = '        usage: PROG [-h] (--foo | --spam SPAM | badger ...)\\n        '\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    format_help = get_parser(required=False).format_help\n    help = self.usage_when_not_required + self.help\n    assert format_help() == textwrap.dedent(help), ('assertEqual', format_help(), textwrap.dedent(help))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

