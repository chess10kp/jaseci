*args, **kwargs)\n\n    def error(self, *args, **kwargs):\n        error = super(ErrorRaisingArgumentParser, self).error\n        return stderr_to_parser_error(error, *args, **kwargs)\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n\n    def get_parser__TestMutuallyExclusiveLong(required=None):\n        parser = ErrorRaisingArgumentParser(prog='PROG')\n        parser.add_argument('--abcde', help='abcde help')\n        parser.add_argument('--fghij', help='fghij help')\n        group = parser.add_mutually_exclusive_group(required=required)\n        group.add_argument('--klmno', help='klmno help')\n        group.add_argument('--pqrst', help='pqrst help')\n        return parser\n\n    def get_parser(required=None):\n        parent = get_parser__TestMutuallyExclusiveLong(required=required)\n        parser = ErrorRaisingArgumentParser(prog=parent.prog, add_help=False, parents=[parent])\n        return parser\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.failures = ['--klmno X --pqrst Y']\n    _SelfNS.failures = ['--klmno X --pqrst Y']\n    self.help = '\\n    options:\\n      -h, --help     show this help message and exit\\n      --abcde ABCDE  abcde help\\n      --fghij FGHIJ  fghij help\\n      --klmno KLMNO  klmno help\\n      --pqrst PQRST  pqrst help\\n    '\n    _SelfNS.help = '\\n    options:\\n      -h, --help     show this help message and exit\\n      --abcde ABCDE  abcde help\\n      --fghij FGHIJ  fghij help\\n      --klmno KLMNO  klmno help\\n      --pqrst PQRST  pqrst help\\n    '\n    self.successes = [('--klmno X', NS(abcde=None, fghij=None, klmno='X', pqrst=None)), ('--abcde Y --klmno X', NS(abcde='Y', fghij=None, klmno='X', pqrst=None)), ('--pqrst X', NS(abcde=None, fghij=None, klmno=None, pqrst='X')), ('--pqrst X --fghij Y', NS(abcde=None, fghij='Y', klmno=None, pqrst='X'))]\n    _SelfNS.successes = [('--klmno X', NS(abcde=None, fghij=None, klmno='X', pqrst