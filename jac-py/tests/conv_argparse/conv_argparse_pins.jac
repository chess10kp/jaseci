test "TestConflictHandling.test_resolve_error" {
    (ok, detail) = p2_libtest_run_snippet("import textwrap\nimport argparse\nfrom test.support import os_helper\n\ndef _t():\n\n    def setUp():\n        env = os_helper.EnvironmentVarGuard().__enter__()\n        env['COLUMNS'] = '80'\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    get_parser = argparse.ArgumentParser\n    parser = get_parser(prog='PROG', conflict_handler='resolve')\n    parser.add_argument('-x', help='OLD X')\n    parser.add_argument('-x', help='NEW X')\n    assert parser.format_help() == textwrap.dedent('            usage: PROG [-h] [-x X]\\n\\n            options:\\n              -h, --help  show this help message and exit\\n              -x X        NEW X\\n            '), ('assertEqual', parser.format_help(), textwrap.dedent('            usage: PROG [-h] [-x X]\\n\\n            options:\\n              -h, --help  show this help message and exit\\n              -x X        NEW X\\n            '))\n    parser.add_argument('--spam', metavar='OLD_SPAM')\n    parser.add_argument('--spam', metavar='NEW_SPAM')\n    assert parser.format_help() == textwrap.dedent('            usage: PROG [-h] [-x X] [--spam NEW_SPAM]\\n\\n            options:\\n              -h, --help       show this help message and exit\\n              -x X             NEW X\\n              --spam NEW_SPAM\\n            '), ('assertEqual', parser.format_help(), textwrap.dedent('            usage: PROG [-h] [-x X] [--spam NEW_SPAM]\\n\\n            options:\\n              -h, --help       show this help message and exit\\n              -x X             NEW X\\n              --spam NEW_SPAM\\n            '))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
