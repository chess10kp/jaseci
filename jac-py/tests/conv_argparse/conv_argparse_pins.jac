parser.format_help(), cm.stdout)\n    env = os_helper.EnvironmentVarGuard().__enter__()\n    env['COLUMNS'] = '80'\n    parser = ErrorRaisingArgumentParser()\n    parser.add_argument('--version', action='version', version='1.0')\n    parser.add_argument('-x', action='store_true')\n    parser.add_argument('y')\n    valid_prefixes = ['', '-x', 'foo', '-x bar', 'baz -x']\n    valid_suffixes = valid_prefixes + ['--bad-option', 'foo bar baz']\n    for prefix in valid_prefixes:\n        for suffix in valid_suffixes:\n            format = '%s %%s %s' % (prefix, suffix)\n        assertPrintHelpExit(parser, format % '-h')\n        assertPrintHelpExit(parser, format % '--help')\n        try:\n            getattr(*(parser, 'format_version'))\n        except AttributeError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
