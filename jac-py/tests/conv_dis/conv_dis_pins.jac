test "InstructionTests.test_co_positions_missing_info" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport dis\n\ndef _t():\n    code = compile('x, y, z', '<test>', 'exec')\n    code_without_location_table = code.replace(co_linetable=b'')\n    actual = dis.get_instructions(code_without_location_table)\n    for instruction in actual:\n        positions = instruction.positions\n        assert len(positions) == 4, ('assertEqual', len(positions), 4)\n        if instruction.opname == 'RESUME':\n            continue\n        assert positions.lineno is None, ('assertIsNone', positions.lineno)\n        assert positions.end_lineno is None, ('assertIsNone', positions.end_lineno)\n        assert positions.col_offset is None, ('assertIsNone', positions.col_offset)\n        assert positions.end_col_offset is None, ('assertIsNone', positions.end_col_offset)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "BytecodeTests.test_instantiation" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport dis\nimport types\n\nclass _C:\n\n    def __init__(self, x):\n        self.x = x == 1\n\n    @staticmethod\n    def sm(x):\n        x = x == 1\n\n    @classmethod\n    def cm(cls, x):\n        cls.x = x == 1\n\ndef _f(a):\n    print(a)\n    return 1\n\ndef _t():\n    for obj in [_f, _C(1).__init__, 'a=1', _f.__code__]:\n        b = dis.Bytecode(obj)\n        assert isinstance(b.codeobj, types.CodeType), ('assertIsInstance', b.codeobj, types.CodeType)\n    try:\n        dis.Bytecode(*(object(),))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

