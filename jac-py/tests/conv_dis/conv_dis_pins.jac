    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport dis\n\ndef simple():\n    pass\n\ndef _t():\n    actual = dis.Bytecode(simple).dis()\n    actual = actual.strip().partition(' ')[0]\n    expected = str(simple.__code__.co_firstlineno)\n    assert actual == expected, ('assertEqual', actual, expected)\n    actual = dis.Bytecode(simple, first_line=350).dis()\n    actual = actual.strip().partition(' ')[0]\n    assert actual == '350', ('assertEqual', actual, '350')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "BytecodeTests.test_from_traceback" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport dis\n\ndef get_tb():\n\n    def _error():\n        try:\n            1 / 0\n        except Exception as e:\n            tb = e.__traceback__\n        return tb\n    tb = _error()\n    while tb.tb_next:\n        tb = tb.tb_next\n    return tb\n\ndef _t():\n    tb = get_tb()\n    b = dis.Bytecode.from_traceback(tb)\n    while tb.tb_next:\n        tb = tb.tb_next\n    assert b.current_offset == tb.tb_lasti, ('assertEqual', b.current_offset, tb.tb_lasti)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "BytecodeTests.test_bytecode_co_positions" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport dis\n\ndef _t():\n    bytecode = dis.Bytecode('a=1')\n    for instr, positions in zip(bytecode, bytecode.codeobj.co_positions()):\n        assert instr.positions == positions\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFinderMethods.test__find_imports" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport dis\n\ndef _t():\n    cases = [('import a.b.c', ('a.b.c', 0, None)), ('from a.b import c', ('a.b', 0, ('c',))), ('from a.b import c as d', ('a.b', 0, ('c',))), ('from a.b import *', ('a.b', 0, ('*',))), ('from ...a.b import c as d', ('a.b', 3, ('c',))), ('from ..a.b import c as d, e as f', ('a.b', 2, ('c', 'e'))), ('from ..a.b import *', ('a.b', 2, ('*',)))]\n    for src, expected in cases:\n        code = compile(src, '<string>', 'exec')\n        res = tuple(dis._find_imports(code))\n        assert len(res) == 1, ('assertEqual', len(res), 1)\n        assert res[0] == expected, ('assertEqual', res[0], expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFinderMethods.test__find_store_names" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport dis\n\ndef _t():\n    cases = [('x+y', ()), ('x=y=1', ('x', 'y')), ('x+=y', ('x',)), ('global x\\nx=y=1', ('x', 'y')), ('global x\\nz=x', ('z',))]\n    for src, expected in cases:\n        code = compile(src, '<string>', 'exec')\n        res = tuple(dis._find_store_names(code))\n        assert res == expected, ('assertEqual', res, expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFinderMethods.test_findlinestarts" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport dis\n\ndef _t():\n\n    def func():\n        pass\n    code = func.__code__\n    offsets = [linestart[0] for linestart in dis.findlinestarts(code)]\n    assert offsets == [0, 2], ('assertEqual', offsets, [0, 2])\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
