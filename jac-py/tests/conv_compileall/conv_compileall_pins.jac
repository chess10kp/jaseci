rectory, '_test3.py')\n    shutil.copyfile(self.source_path, self.source_path3)\n    depth = 3\n    path = self.directory\n    for i in range(1, depth + 1):\n        path = os.path.join(path, f'dir_{i}')\n        source = os.path.join(path, 'script.py')\n        os.mkdir(path)\n        shutil.copyfile(self.source_path, source)\n    pyc_filename = importlib.util.cache_from_source(source)\n    compileall.compile_dir(self.directory, quiet=True, maxlevels=depth - 1)\n    assert not os.path.isfile(pyc_filename), ('assertFalse', os.path.isfile(pyc_filename))\n    compileall.compile_dir(self.directory, quiet=True, maxlevels=depth)\n    assert os.path.isfile(pyc_filename), ('assertTrue', os.path.isfile(pyc_filename))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\nfinally:\n    _run_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

