test "CompileallTestsWithoutSourceEpoch.test_compile_dir_maxlevels" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\n_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nimport compileall\nimport importlib.util\nimport os\nimport shutil\nimport tempfile\n\ndef _t():\n\n    def setUp():\n        self.directory = tempfile.mkdtemp()\n        _add_cleanup(shutil.rmtree, *(self.directory,))\n        self.source_path = os.path.join(self.directory, '_test.py')\n        self.bc_path = importlib.util.cache_from_source(self.source_path)\n        with open(self.source_path, 'w', encoding='utf-8') as file:\n            file.write('x = 123\\n')\n        self.source_path2 = os.path.join(self.directory, '_test2.py')\n        self.bc_path2 = importlib.util.cache_from_source(self.source_path2)\n        shutil.copyfile(self.source_path, self.source_path2)\n        self.subdirectory = os.path.join(self.directory, '_subdir')\n        os.mkdir(self.subdirectory)\n        self.source_path3 = os.path.join(self.subdirectory, '_test3.py')\n        shutil.copyfile(self.source_path, self.source_path3)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.directory = tempfile.mkdtemp()\n    _add_cleanup(shutil.rmtree, *(self.directory,))\n    self.source_path = os.path.join(self.directory, '_test.py')\n    self.bc_path = importlib.util.cache_from_source(self.source_path)\n    with open(self.source_path, 'w', encoding='utf-8') as file:\n        file.write('x = 123\\n')\n    self.source_path2 = os.path.join(self.directory, '_test2.py')\n    self.bc_path2 = importlib.util.cache_from_source(self.source_path2)\n    shutil.copyfile(self.source_path, self.source_path2)\n    self.subdirectory = os.path.join(self.directory, '_subdir')\n    os.mkdir(self.subdirectory)\n    self.source_path3 = os.path.join(self.subdirectory, '_test3.py')\n    shutil.copyfile(self.source_path, self.source_path3)\n    depth = 3\n    path = self.directory\n    for i in range(1, depth + 1):\n        path = os.path.join(path, f'dir_{i}')\n        source = os.path.join(path, 'script.py')\n        os.mkdir(path)\n        shutil.copyfile(self.source_path, source)\n    pyc_filename = importlib.util.cache_from_source(source)\n    compileall.compile_dir(self.directory, quiet=True, maxlevels=depth - 1)\n    assert not os.path.isfile(pyc_filename), ('assertFalse', os.path.isfile(pyc_filename))\n    compileall.compile_dir(self.directory, quiet=True, maxlevels=depth)\n    assert os.path.isfile(pyc_filename), ('assertTrue', os.path.isfile(pyc_filename))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\nfinally:\n    _run_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "EncodingTest.test_error" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport compileall\nimport contextlib\nimport io\nimport os\nimport tempfile\n\ndef _t():\n\n    def setUp():\n        self.directory = tempfile.mkdtemp()\n        self.source_path = os.path.join(self.directory, '_test.py')\n        with open(self.source_path, 'w', encoding='utf-8') as file:\n            file.write('b\"\u20ac\"')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.directory = tempfile.mkdtemp()\n    self.source_path = os.path.join(self.directory, '_test.py')\n    with open(self.source_path, 'w', encoding='utf-8') as file:\n        file.write('b\"\u20ac\"')\n    buffer = io.TextIOWrapper(io.BytesIO(), encoding='ascii')\n    with contextlib.redirect_stdout(buffer):\n        compiled = compileall.compile_dir(self.directory)\n    assert not compiled, ('assertFalse', compiled)\n    buffer.seek(0)\n    res = buffer.read()\n    assert 'SyntaxError: bytes can only contain ASCII literal characters' in res, ('assertIn', 'SyntaxError: bytes can only contain ASCII literal characters', res)\n    assert 'UnicodeEncodeError' not in res, ('assertNotIn', 'UnicodeEncodeError', res)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
