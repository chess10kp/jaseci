th.join(self.subdirectory, '_test3.py')\n    shutil.copyfile(self.source_path, self.source_path3)\n    try:\n        compileall.compile_dir(self.directory, workers=-1)\n    except ValueError as _exc:\n        assert _re.search('workers must be greater or equal to 0', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\nfinally:\n    _run_cleanups()\n");
