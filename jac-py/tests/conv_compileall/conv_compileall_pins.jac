rectory, '_test3.py')\n    shutil.copyfile(self.source_path, self.source_path3)\n    optimize, opt = (1, 1) if __debug__ else (0, '')\n    compileall.compile_dir(self.directory, quiet=True, optimize=optimize)\n    cached = importlib.util.cache_from_source(self.source_path, optimization=opt)\n    assert os.path.isfile(cached), ('assertTrue', os.path.isfile(cached))\n    cached2 = importlib.util.cache_from_source(self.source_path2, optimization=opt)\n    assert os.path.isfile(cached2), ('assertTrue', os.path.isfile(cached2))\n    cached3 = importlib.util.cache_from_source(self.source_path3, optimization=opt)\n    assert os.path.isfile(cached3), ('assertTrue', os.path.isfile(cached3))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\nfinally:\n    _run_cleanups()\n");
