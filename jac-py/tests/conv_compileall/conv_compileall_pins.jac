    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\n_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nimport compileall\nimport importlib.util\nimport os\nimport shutil\nimport tempfile\n\ndef _t():\n\n    def setUp():\n        self.directory = tempfile.mkdtemp()\n        _add_cleanup(shutil.rmtree, *(self.directory,))\n        self.source_path = os.path.join(self.directory, '_test.py')\n        self.bc_path = importlib.util.cache_from_source(self.source_path)\n        with open(self.source_path, 'w', encoding='utf-8') as file:\n            file.write('x = 123\\n')\n        self.source_path2 = os.path.join(self.directory, '_test2.py')\n        self.bc_path2 = importlib.util.cache_from_source(self.source_path2)\n        shutil.copyfile(self.source_path, self.source_path2)\n        self.subdirectory = os.path.join(self.directory, '_subdir')\n        os.mkdir(self.subdirectory)\n        self.source_path3 = os.path.join(self.subdirectory, '_test3.py')\n        shutil.copyfile(self.source_path, self.source_path3)\n\n    def add_bad_source_file():\n        self.bad_source_path = os.path.join(self.directory, '_test_bad.py')\n        with open(self.bad_source_path, 'w', encoding='utf-8') as file:\n            file.write('x (\\n')\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.directory = tempfile.mkdtemp()\n    _add_cleanup(shutil.rmtree, *(self.directory,))\n    self.source_path = os.path.join(self.directory, '_test.py')\n    self.bc_path = importlib.util.cache_from_source(self.source_path)\n    with open(self.source_path, 'w', encoding='utf-8') as file:\n        file.write('x = 123\\n')\n    self.source_path2 = os.path.join(self.directory, '_test2.py')\n    self.bc_path2 = importlib.util.cache_from_source(self.source_path2)\n    shutil.copyfile(self.source_path, self.source_path2)\n    self.subdirectory = os.path.join(self.directory, '_subdir')\n    os.mkdir(self.subdirectory)\n    self.source_path3 = os.path.join(self.subdirectory, '_test3.py')\n    shutil.copyfile(self.source_path, self.source_path3)\n    for fn in (self.bc_path, self.bc_path2):\n        try:\n            os.unlink(fn)\n        except:\n            pass\n    assert compileall.compile_file(self.source_path, force=False, quiet=True), ('assertTrue', compileall.compile_file(self.source_path, force=False, quiet=True))\n    assert os.path.isfile(self.bc_path) and (not os.path.isfile(self.bc_path2)), ('assertTrue', os.path.isfile(self.bc_path) and (not os.path.isfile(self.bc_path2)))\n    os.unlink(self.bc_path)\n    assert compileall.compile_dir(self.directory, force=False, quiet=True), ('assertTrue', compileall.compile_dir(self.directory, force=False, quiet=True))\n    assert os.path.isfile(self.bc_path) and os.path.isfile(self.bc_path2), ('assertTrue', os.path.isfile(self.bc_path) and os.path.isfile(self.bc_path2))\n    os.unlink(self.bc_path)\n    os.unlink(self.bc_path2)\n    add_bad_source_file()\n    assert not compileall.compile_file(self.bad_source_path, force=False, quiet=2), ('assertFalse', compileall.compile_file(self.bad_source_path, force=False, quiet=2))\n    assert not compileall.compile_dir(self.directory, force=False, quiet=2), ('assertFalse', compileall.compile_dir(self.directory, force=False, quiet=2))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\nfinally:\n    _run_cleanups()\n");
