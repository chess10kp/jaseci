test "MmapTests.test_basic" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nimport re\nmmap = import_module('mmap')\nPAGESIZE = mmap.PAGESIZE\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    f = open(TESTFN, 'bw+')\n    try:\n        f.write(b'\\x00' * PAGESIZE)\n        f.write(b'foo')\n        f.write(b'\\x00' * (PAGESIZE - 3))\n        f.flush()\n        m = mmap.mmap(f.fileno(), 2 * PAGESIZE)\n    finally:\n        f.close()\n    tp = str(type(m))\n    assert m.find(b'foo') == PAGESIZE, ('assertEqual', m.find(b'foo'), PAGESIZE)\n    assert len(m) == 2 * PAGESIZE, ('assertEqual', len(m), 2 * PAGESIZE)\n    assert m[0] == 0, ('assertEqual', m[0], 0)\n    assert m[0:3] == b'\\x00\\x00\\x00', ('assertEqual', m[0:3], b'\\x00\\x00\\x00')\n    try:\n        m.__getitem__(*(len(m),))\n    except IndexError:\n        pass\n    try:\n        m.__setitem__(*(len(m), b'\\x00'))\n    except IndexError:\n        pass\n    m[0] = b'3'[0]\n    m[PAGESIZE + 3:PAGESIZE + 3 + 3] = b'bar'\n    assert m[0] == b'3'[0], ('assertEqual', m[0], b'3'[0])\n    assert m[0:3] == b'3\\x00\\x00', ('assertEqual', m[0:3], b'3\\x00\\x00')\n    assert m[PAGESIZE - 1:PAGESIZE + 7] == b'\\x00foobar\\x00', ('assertEqual', m[PAGESIZE - 1:PAGESIZE + 7], b'\\x00foobar\\x00')\n    m.flush()\n    match = re.search(b'[A-Za-z]+', m)\n    if match is None:\n        raise AssertionError('regex match on mmap failed!')\n    else:\n        start, end = match.span(0)\n        length = end - start\n        assert start == PAGESIZE, ('assertEqual', start, PAGESIZE)\n        assert end == PAGESIZE + 6, ('assertEqual', end, PAGESIZE + 6)\n    assert m.seekable(), ('assertTrue', m.seekable())\n    assert m.seek(0, 0) == 0, ('assertEqual', m.seek(0, 0), 0)\n    assert m.tell() == 0, ('assertEqual', m.tell(), 0)\n    assert m.seek(42, 1) == 42, ('assertEqual', m.seek(42, 1), 42)\n    assert m.tell() == 42, ('assertEqual', m.tell(), 42)\n    assert m.seek(0, 2) == len(m), ('assertEqual', m.seek(0, 2), len(m))\n    assert m.tell() == len(m), ('assertEqual', m.tell(), len(m))\n    try:\n        m.seek(*(-1,))\n    except ValueError:\n        pass\n    try:\n        m.seek(*(1, 2))\n    except ValueError:\n        pass\n    try:\n        m.seek(*(-len(m) - 1, 2))\n    except ValueError:\n        pass\n    try:\n        m.resize(512)\n    except SystemError:\n        pass\n    else:\n        assert len(m) == 512, ('assertEqual', len(m), 512)\n        try:\n            m.seek(*(513, 0))\n        except ValueError:\n            pass\n        f = open(TESTFN, 'rb')\n        try:\n            f.seek(0, 2)\n            assert f.tell() == 512, ('assertEqual', f.tell(), 512)\n        finally:\n            f.close()\n        assert m.size() == 512, ('assertEqual', m.size(), 512)\n    m.close()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

