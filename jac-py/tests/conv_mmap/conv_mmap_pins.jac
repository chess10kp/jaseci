test "MmapTests.test_offset" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nmmap = import_module('mmap')\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n\n    def make_mmap_file(f, halfsize):\n        f.write(b'\\x00' * halfsize)\n        f.write(b'foo')\n        f.write(b'\\x00' * (halfsize - 3))\n        f.flush()\n        return mmap.mmap(f.fileno(), 0)\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    f = open(TESTFN, 'w+b')\n    try:\n        halfsize = mmap.ALLOCATIONGRANULARITY\n        m = make_mmap_file(f, halfsize)\n        m.close()\n        f.close()\n        mapsize = halfsize * 2\n        f = open(TESTFN, 'r+b')\n        for offset in [-2, -1, None]:\n            try:\n                m = mmap.mmap(f.fileno(), mapsize, offset=offset)\n                assert 0 == 1, ('assertEqual', 0, 1)\n            except (ValueError, TypeError, OverflowError):\n                pass\n            else:\n                assert 0 == 0, ('assertEqual', 0, 0)\n        f.close()\n        f = open(TESTFN, 'r+b')\n        m = mmap.mmap(f.fileno(), mapsize - halfsize, offset=halfsize)\n        assert m[0:3] == b'foo', ('assertEqual', m[0:3], b'foo')\n        f.close()\n        try:\n            m.resize(512)\n        except SystemError:\n            pass\n        else:\n            assert len(m) == 512, ('assertEqual', len(m), 512)\n            try:\n                m.seek(*(513, 0))\n            except ValueError:\n                pass\n            assert m[0:3] == b'foo', ('assertEqual', m[0:3], b'foo')\n            f = open(TESTFN, 'rb')\n            f.seek(0, 2)\n            assert f.tell() == halfsize + 512, ('assertEqual', f.tell(), halfsize + 512)\n            f.close()\n            assert m.size() == halfsize + 512, ('assertEqual', m.size(), halfsize + 512)\n        m.close()\n    finally:\n        f.close()\n        try:\n            os.unlink(TESTFN)\n        except OSError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

