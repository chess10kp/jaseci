test "MmapTests.test_find_end" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nmmap = import_module('mmap')\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    with open(TESTFN, 'wb+') as f:\n        data = b'one two ones'\n        n = len(data)\n        f.write(data)\n        f.flush()\n        m = mmap.mmap(f.fileno(), n)\n    assert m.find(b'one') == 0, ('assertEqual', m.find(b'one'), 0)\n    assert m.find(b'ones') == 8, ('assertEqual', m.find(b'ones'), 8)\n    assert m.find(b'one', 0, -1) == 0, ('assertEqual', m.find(b'one', 0, -1), 0)\n    assert m.find(b'one', 1) == 8, ('assertEqual', m.find(b'one', 1), 8)\n    assert m.find(b'one', 1, -1) == 8, ('assertEqual', m.find(b'one', 1, -1), 8)\n    assert m.find(b'one', 1, -2) == -1, ('assertEqual', m.find(b'one', 1, -2), -1)\n    assert m.find(bytearray(b'one')) == 0, ('assertEqual', m.find(bytearray(b'one')), 0)\n    for i in range(-n - 1, n + 1):\n        for j in range(-n - 1, n + 1):\n            for p in [b'o', b'on', b'two', b'ones', b's']:\n                expected = data.find(p, i, j)\n                assert m.find(p, i, j) == expected, ('assertEqual', m.find(p, i, j), expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

