ld work on Windows.')\n        else:\n            if not sys.platform.startswith('win'):\n                raise AssertionError('Opening mmap with size+1 should raise ValueError.')\n            m.close()\n        if sys.platform.startswith('win'):\n            with open(TESTFN, 'r+b') as f:\n                f.truncate(mapsize)\n    with open(TESTFN, 'r+b') as f:\n        m = mmap.mmap(f.fileno(), mapsize, access=mmap.ACCESS_WRITE)\n        m[:] = b'c' * mapsize\n        assert m[:] == b'c' * mapsize, ('assertEqual', m[:], b'c' * mapsize)\n        m.flush()\n        m.close()\n    with open(TESTFN, 'rb') as f:\n        stuff = f.read()\n    assert stuff == b'c' * mapsize, ('assertEqual', stuff, b'c' * mapsize)\n    with open(TESTFN, 'r+b') as f:\n        m = mmap.mmap(f.fileno(), mapsize, access=mmap.ACCESS_COPY)\n        m[:] = b'd' * mapsize\n        assert m[:] == b'd' * mapsize, ('assertEqual', m[:], b'd' * mapsize)\n        m.flush()\n        with open(TESTFN, 'rb') as fp:\n            assert fp.read() == b'c' * mapsize, ('assertEqual', fp.read(), b'c' * mapsize)\n        try:\n            m.resize(*(2 * mapsize,))\n        except TypeError:\n            pass\n        m.close()\n    with open(TESTFN, 'r+b') as f:\n        try:\n            mmap.mmap(*(f.fileno(), mapsize), access=4)\n        except ValueError:\n            pass\n    if os.name == 'posix':\n        with open(TESTFN, 'r+b') as f:\n            try:\n                mmap.mmap(*(f.fileno(), mapsize), flags=mmap.MAP_PRIVATE, prot=mmap.PROT_READ, access=mmap.ACCESS_WRITE)\n            except ValueError:\n                pass\n        prot = mmap.PROT_READ | getattr(mmap, 'PROT_EXEC', 0)\n        with open(TESTFN, 'r+b') as f:\n            try:\n                m = mmap.mmap(f.fileno(), mapsize, prot=prot)\n            except PermissionError:\n                pass\n            else:\n                try:\n                    m.write(*(b'abcdef',))\n                except TypeError:\n                    pass\n                try:\n                    m.write_byte(*(0,))\n                except TypeError:\n                    pass\n                m.close()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
