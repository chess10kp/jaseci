test "MmapTests.test_repr" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nimport re\nimport itertools\nmmap = import_module('mmap')\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    open_mmap_repr_pat = re.compile('<mmap.mmap closed=False, access=(?P<access>\\\\S+), length=(?P<length>\\\\d+), pos=(?P<pos>\\\\d+), offset=(?P<offset>\\\\d+)>')\n    closed_mmap_repr_pat = re.compile('<mmap.mmap closed=True>')\n    mapsizes = (50, 100, 1000, 1000000, 10000000)\n    offsets = tuple((mapsize // 2 // mmap.ALLOCATIONGRANULARITY * mmap.ALLOCATIONGRANULARITY for mapsize in mapsizes))\n    for offset, mapsize in zip(offsets, mapsizes):\n        data = b'a' * mapsize\n        length = mapsize - offset\n        accesses = ('ACCESS_DEFAULT', 'ACCESS_READ', 'ACCESS_COPY', 'ACCESS_WRITE')\n        positions = (0, length // 10, length // 5, length // 4)\n        with open(TESTFN, 'wb+') as fp:\n            fp.write(data)\n            fp.flush()\n            for access, pos in itertools.product(accesses, positions):\n                accint = getattr(mmap, access)\n                with mmap.mmap(fp.fileno(), length, access=accint, offset=offset) as mm:\n                    mm.seek(pos)\n                    match = open_mmap_repr_pat.match(repr(mm))\n                    assert match is not None, ('assertIsNotNone', match)\n                    assert match.group('access') == access, ('assertEqual', match.group('access'), access)\n                    assert match.group('length') == str(length), ('assertEqual', match.group('length'), str(length))\n                    assert match.group('pos') == str(pos), ('assertEqual', match.group('pos'), str(pos))\n                    assert match.group('offset') == str(offset), ('assertEqual', match.group('offset'), str(offset))\n                match = closed_mmap_repr_pat.match(repr(mm))\n                assert match is not None, ('assertIsNotNone', match)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MmapTests.test_madvise" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nimport sys\nmmap = import_module('mmap')\nPAGESIZE = mmap.PAGESIZE\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    size = 2 * PAGESIZE\n    m = mmap.mmap(-1, size)\n\n    class Number:\n\n        def __index__(self):\n            return 2\n    try:\n        m.madvise(mmap.MADV_NORMAL, size)\n    except ValueError as _exc:\n        assert _re.search('madvise start out of bounds', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        m.madvise(mmap.MADV_NORMAL, -1)\n    except ValueError as _exc:\n        assert _re.search('madvise start out of bounds', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        m.madvise(mmap.MADV_NORMAL, 0, -1)\n    except ValueError as _exc:\n        assert _re.search('madvise length invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        m.madvise(mmap.MADV_NORMAL, PAGESIZE, sys.maxsize)\n    except OverflowError as _exc:\n        assert _re.search('madvise length too large', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        m.madvise(mmap.MADV_NORMAL, PAGESIZE, 'Not a Number')\n    except TypeError as _exc:\n        assert _re.search(\"'str' object cannot be interpreted as an integer\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert m.madvise(mmap.MADV_NORMAL) == None, ('assertEqual', m.madvise(mmap.MADV_NORMAL), None)\n    assert m.madvise(mmap.MADV_NORMAL, PAGESIZE) == None, ('assertEqual', m.madvise(mmap.MADV_NORMAL, PAGESIZE), None)\n    assert m.madvise(mmap.MADV_NORMAL, PAGESIZE, size) == None, ('assertEqual', m.madvise(mmap.MADV_NORMAL, PAGESIZE, size), None)\n    assert m.madvise(mmap.MADV_NORMAL, 0, 2) == None, ('assertEqual', m.madvise(mmap.MADV_NORMAL, 0, 2), None)\n    assert m.madvise(mmap.MADV_NORMAL, 0, Number()) == None, ('assertEqual', m.madvise(mmap.MADV_NORMAL, 0, Number()), None)\n    assert m.madvise(mmap.MADV_NORMAL, 0, size) == None, ('assertEqual', m.madvise(mmap.MADV_NORMAL, 0, size), None)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MmapTests.test_resize_up_anonymous_mapping" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nimport random\nimport sys\nmmap = import_module('mmap')\nPAGESIZE = mmap.PAGESIZE\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    'If the mmap is backed by the pagefile ensure a resize up can happen\\n        and that the original data is still in place\\n        '\n    start_size = PAGESIZE\n    new_size = 2 * start_size\n    data = random.randbytes(start_size)\n    with mmap.mmap(-1, start_size) as m:\n        m[:] = data\n        if sys.platform.startswith(('linux', 'android')):\n            try:\n                m.resize(new_size)\n            except ValueError as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        else:\n            try:\n                m.resize(new_size)\n            except SystemError:\n                pass\n            else:\n                assert len(m) == new_size, ('assertEqual', len(m), new_size)\n                assert m[:start_size] == data, ('assertEqual', m[:start_size], data)\n                assert m[start_size:] == b'\\x00' * (new_size - start_size), ('assertEqual', m[start_size:], b'\\x00' * (new_size - start_size))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MmapTests.test_resize_up_private_anonymous_mapping" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nimport random\nmmap = import_module('mmap')\nPAGESIZE = mmap.PAGESIZE\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    start_size = PAGESIZE\n    new_size = 2 * start_size\n    data = random.randbytes(start_size)\n    with mmap.mmap(-1, start_size, flags=mmap.MAP_PRIVATE) as m:\n        m[:] = data\n        try:\n            m.resize(new_size)\n        except SystemError:\n            pass\n        else:\n            assert len(m) == new_size, ('assertEqual', len(m), new_size)\n            assert m[:start_size] == data, ('assertEqual', m[:start_size], data)\n            assert m[start_size:] == b'\\x00' * (new_size - start_size), ('assertEqual', m[start_size:], b'\\x00' * (new_size - start_size))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MmapTests.test_resize_down_anonymous_mapping" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nimport random\nimport sys\nmmap = import_module('mmap')\nPAGESIZE = mmap.PAGESIZE\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    'If the mmap is backed by the pagefile ensure a resize down up can happen\\n        and that a truncated form of the original data is still in place\\n        '\n    start_size = 2 * PAGESIZE\n    new_size = start_size // 2\n    data = random.randbytes(start_size)\n    with mmap.mmap(-1, start_size) as m:\n        m[:] = data\n        try:\n            m.resize(new_size)\n        except SystemError:\n            pass\n        else:\n            assert len(m) == new_size, ('assertEqual', len(m), new_size)\n            assert m[:] == data[:new_size], ('assertEqual', m[:], data[:new_size])\n            if sys.platform.startswith(('linux', 'android')):\n                try:\n                    m.resize(start_size)\n                except ValueError as _exc:\n                    pass\n                else:\n                    raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MmapTests.test_mmap_closed_by_int_scenarios" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport os\nimport random\nmmap = import_module('mmap')\n\ndef _t():\n\n    def setUp():\n        if os.path.exists(TESTFN):\n            os.unlink(TESTFN)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    if os.path.exists(TESTFN):\n        os.unlink(TESTFN)\n    '\\n        gh-103987: Test that mmap objects raise ValueError\\n                for closed mmap files\\n        '\n\n    class MmapClosedByIntContext:\n\n        def __init__(self, access) -> None:\n            self.access = access\n\n        def __enter__(self):\n            self.f = open(TESTFN, 'w+b')\n            self.f.write(random.randbytes(100))\n            self.f.flush()\n            m = mmap.mmap(self.f.fileno(), 100, access=self.access)\n\n            class X:\n\n                def __index__(self):\n                    m.close()\n                    return 10\n            return (m, X)\n\n        def __exit__(self, exc_type, exc_value, traceback):\n            self.f.close()\n    read_access_modes = [mmap.ACCESS_READ, mmap.ACCESS_WRITE, mmap.ACCESS_COPY, mmap.ACCESS_DEFAULT]\n    write_access_modes = [mmap.ACCESS_WRITE, mmap.ACCESS_COPY, mmap.ACCESS_DEFAULT]\n    for access in read_access_modes:\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m[X()]\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m[X():20]\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m[X():20:2]\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m[20:X():-2]\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m.read(X())\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m.find(b'1', 1, X())\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n    for access in write_access_modes:\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m[X():20] = b'1' * 10\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m[X():20:2] = b'1' * 5\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m[20:X():-2] = b'1' * 5\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m.move(1, 2, X())\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with MmapClosedByIntContext(access) as (m, X):\n            try:\n                m.write_byte(X())\n            except ValueError as _exc:\n                assert _re.search('mmap closed or invalid', str(_exc)), 'assertRaisesRegex: message mismatch'\n            else:\n                raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "LargeMmapTests.test_large_offset" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import requires, _2G, _4G, gc_collect, cpython_only, is_emscripten, is_apple, in_systemd_nspawn_sync_suppressed\nfrom test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport unittest\nimport sys\nmmap = import_module('mmap')\n\ndef _t():\n\n    def setUp():\n        unlink(TESTFN)\n\n    def _make_test_file(num_zeroes, tail):\n        if sys.platform[:3] == 'win' or is_apple:\n            requires('largefile', 'test requires %s bytes and a long time to run' % str(6442450944))\n        f = open(TESTFN, 'w+b')\n        try:\n            f.seek(num_zeroes)\n            f.write(tail)\n            f.flush()\n        except (OSError, OverflowError, ValueError):\n            try:\n                f.close()\n            except (OSError, OverflowError):\n                pass\n            raise unittest.SkipTest('filesystem does not have largefile support')\n        return f\n    unlink(TESTFN)\n    with _make_test_file(5637144575, b' ') as f:\n        with mmap.mmap(f.fileno(), 0, offset=5368709120, access=mmap.ACCESS_READ) as m:\n            assert m[268435455] == 32, ('assertEqual', m[268435455], 32)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "LargeMmapTests.test_large_filesize" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import requires, _2G, _4G, gc_collect, cpython_only, is_emscripten, is_apple, in_systemd_nspawn_sync_suppressed\nfrom test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport unittest\nimport sys\nmmap = import_module('mmap')\n\ndef _t():\n\n    def setUp():\n        unlink(TESTFN)\n\n    def _make_test_file(num_zeroes, tail):\n        if sys.platform[:3] == 'win' or is_apple:\n            requires('largefile', 'test requires %s bytes and a long time to run' % str(6442450944))\n        f = open(TESTFN, 'w+b')\n        try:\n            f.seek(num_zeroes)\n            f.write(tail)\n            f.flush()\n        except (OSError, OverflowError, ValueError):\n            try:\n                f.close()\n            except (OSError, OverflowError):\n                pass\n            raise unittest.SkipTest('filesystem does not have largefile support')\n        return f\n    unlink(TESTFN)\n    with _make_test_file(6442450943, b' ') as f:\n        if sys.maxsize < 6442450944:\n            try:\n                mmap.mmap(f.fileno(), 6442450944, access=mmap.ACCESS_READ)\n            except OverflowError as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            try:\n                mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)\n            except ValueError as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\n        with mmap.mmap(f.fileno(), 65536, access=mmap.ACCESS_READ) as m:\n            assert m.size() == 6442450944, ('assertEqual', m.size(), 6442450944)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "LargeMmapTests.test_around_2GB" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import requires, _2G, _4G, gc_collect, cpython_only, is_emscripten, is_apple, in_systemd_nspawn_sync_suppressed\nfrom test.support.import_helper import import_module\nfrom test.support.os_helper import TESTFN, unlink\nimport unittest\nimport sys\nmmap = import_module('mmap')\n\ndef _t():\n\n    def setUp():\n        unlink(TESTFN)\n\n    def _make_test_file(num_zeroes, tail):\n        if sys.platform[:3] == 'win' or is_apple:\n            requires('largefile', 'test requires %s bytes and a long time to run' % str(6442450944))\n        f = open(TESTFN, 'w+b')\n        try:\n            f.seek(num_zeroes)\n            f.write(tail)\n            f.flush()\n        except (OSError, OverflowError, ValueError):\n            try:\n                f.close()\n            except (OSError, OverflowError):\n                pass\n            raise unittest.SkipTest('filesystem does not have largefile support')\n        return f\n\n    def _test_around_boundary(boundary):\n        tail = b'  DEARdear  '\n        start = boundary - len(tail) // 2\n        end = start + len(tail)\n        with _make_test_file(start, tail) as f:\n            with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as m:\n                assert m[start:end] == tail, ('assertEqual', m[start:end], tail)\n    unlink(TESTFN)\n    _test_around_boundary(_2G)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

