    (ok, detail) = p2_libtest_run_snippet("from test.support import os_helper\nimport io\nlengths = list(range(1, 257)) + [512, 1000, 1024, 2048, 4096, 8192, 10000, 16384, 32768, 65536, 1000000]\n\ndef _t():\n\n    def try_one(s):\n        os_helper.unlink(os_helper.TESTFN)\n        f = self.open(os_helper.TESTFN, 'wb')\n        try:\n            f.write(s)\n            f.write(b'\\n')\n            f.write(s)\n            f.close()\n            f = self.open(os_helper.TESTFN, 'rb')\n            line = f.readline()\n            assert line == s + b'\\n', ('assertEqual', line, s + b'\\n')\n            line = f.readline()\n            assert line == s, ('assertEqual', line, s)\n            line = f.readline()\n            assert not line, ('assertFalse', line)\n            f.close()\n        finally:\n            os_helper.unlink(os_helper.TESTFN)\n\n    def drive_one(pattern):\n        for length in lengths:\n            q, r = divmod(length, len(pattern))\n            teststring = pattern * q + pattern[:r]\n            assert len(teststring) == length, ('assertEqual', len(teststring), length)\n            try_one(teststring)\n            try_one(teststring + b'x')\n            try_one(teststring[:-1])\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.open = io.open\n    _SelfNS.open = io.open\n    drive_one(b'1234567890\\x00\\x01\\x02\\x03\\x04\\x05\\x06')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
