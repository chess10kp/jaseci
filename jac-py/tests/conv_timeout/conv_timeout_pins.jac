test "TCPTimeoutTestCase.testConnectTimeout" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\n_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nimport functools\nimport unittest\nfrom test import support\nfrom test.support import socket_helper\nimport time\nimport errno\nimport socket\n\n@functools.lru_cache()\ndef resolve_address(host, port):\n    \"\"\"Resolve an (host, port) to an address.\n\n    We must perform name resolution before timeout tests, otherwise it will be\n    performed by connect().\n    \"\"\"\n    with socket_helper.transient_internet(host):\n        return socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM)[0][4]\n\ndef _t():\n\n    def setUp():\n        _cm = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        self.sock = _cm.__enter__()\n        _add_cleanup(_cm.__exit__, _cm, None, None, None)\n        self.addr_remote = resolve_address('www.python.org.', 80)\n\n    def _sock_operation(count, timeout, method, *args):\n        \"\"\"\n        Test the specified socket method.\n\n        The method is run at most `count` times and must raise a TimeoutError\n        within `timeout` + self.fuzz seconds.\n        \"\"\"\n        self.sock.settimeout(timeout)\n        method = getattr(self.sock, method)\n        for i in range(count):\n            t1 = time.monotonic()\n            try:\n                method(*args)\n            except TimeoutError as e:\n                delta = time.monotonic() - t1\n                break\n        else:\n            raise AssertionError('TimeoutError was not raised')\n        assert delta < timeout + self.fuzz, ('assertLess', delta, timeout + self.fuzz)\n        assert delta > timeout - 1.0, ('assertGreater', delta, timeout - 1.0)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.fuzz = 2.0\n    _SelfNS.fuzz = 2.0\n    self.localhost = socket_helper.HOST\n    _SelfNS.localhost = socket_helper.HOST\n    _cm = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    self.sock = _cm.__enter__()\n    _add_cleanup(_cm.__exit__, _cm, None, None, None)\n    self.addr_remote = resolve_address('www.python.org.', 80)\n    blackhole = resolve_address('pythontest.net', 56666)\n    whitehole = resolve_address('pythontest.net', 56667)\n    skip = True\n    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:\n        try:\n            timeout = support.LOOPBACK_TIMEOUT\n            sock.settimeout(timeout)\n            sock.connect(whitehole)\n        except TimeoutError:\n            pass\n        except OSError as err:\n            if err.errno == errno.ECONNREFUSED:\n                skip = False\n    if skip:\n        raise unittest.SkipTest(\"We didn't receive a connection reset (RST) packet from {}:{} within {} seconds, so we're unable to test connect timeout against the corresponding {}:{} (which is configured to silently drop packets).\".format(whitehole[0], whitehole[1], timeout, blackhole[0], blackhole[1]))\n    self.addr_remote = blackhole\n    with socket_helper.transient_internet(self.addr_remote[0]):\n        _sock_operation(1, 0.001, 'connect', self.addr_remote)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\nfinally:\n    _run_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

