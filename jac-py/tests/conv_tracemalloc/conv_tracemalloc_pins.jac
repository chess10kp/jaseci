}

test "TestSnapshot.test_slices" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef create_snapshots():\n    traceback_limit = 2\n    raw_traces = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 66, (('b.py', 1),), 1), (3, 7, (('<unknown>', 0),), 1)]\n    snapshot = tracemalloc.Snapshot(raw_traces, traceback_limit)\n    raw_traces2 = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (2, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 5000, (('a.py', 5), ('b.py', 4)), 3), (4, 400, (('c.py', 578),), 1)]\n    snapshot2 = tracemalloc.Snapshot(raw_traces2, traceback_limit)\n    return (snapshot, snapshot2)\n\ndef traceback(*frames):\n    return tracemalloc.Traceback(frames)\n\ndef _t():\n    snapshot, snapshot2 = create_snapshots()\n    assert snapshot.traces[:2] == (snapshot.traces[0], snapshot.traces[1]), ('assertEqual', snapshot.traces[:2], (snapshot.traces[0], snapshot.traces[1]))\n    traceback = snapshot.traces[0].traceback\n    assert traceback[:2] == (traceback[0], traceback[1]), ('assertEqual', traceback[:2], (traceback[0], traceback[1]))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFilters.test_filter_attributes" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef _t():\n    f = tracemalloc.Filter(True, 'abc')\n    assert f.inclusive == True, ('assertEqual', f.inclusive, True)\n    assert f.filename_pattern == 'abc', ('assertEqual', f.filename_pattern, 'abc')\n    assert f.lineno is None, ('assertIsNone', f.lineno)\n    assert f.all_frames == False, ('assertEqual', f.all_frames, False)\n    f = tracemalloc.Filter(False, 'test.py', 123, True)\n    assert f.inclusive == False, ('assertEqual', f.inclusive, False)\n    assert f.filename_pattern == 'test.py', ('assertEqual', f.filename_pattern, 'test.py')\n    assert f.lineno == 123, ('assertEqual', f.lineno, 123)\n    assert f.all_frames == True, ('assertEqual', f.all_frames, True)\n    f = tracemalloc.Filter(inclusive=False, filename_pattern='test.py', lineno=123, all_frames=True)\n    assert f.inclusive == False, ('assertEqual', f.inclusive, False)\n    assert f.filename_pattern == 'test.py', ('assertEqual', f.filename_pattern, 'test.py')\n    assert f.lineno == 123, ('assertEqual', f.lineno, 123)\n    assert f.all_frames == True, ('assertEqual', f.all_frames, True)\n    try:\n        setattr(*(f, 'filename_pattern', 'abc'))\n    except AttributeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFilters.test_filter_match" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef _t():\n    f = tracemalloc.Filter(True, 'abc')\n    assert f._match_frame('abc', 0), ('assertTrue', f._match_frame('abc', 0))\n    assert f._match_frame('abc', 5), ('assertTrue', f._match_frame('abc', 5))\n    assert f._match_frame('abc', 10), ('assertTrue', f._match_frame('abc', 10))\n    assert not f._match_frame('12356', 0), ('assertFalse', f._match_frame('12356', 0))\n    assert not f._match_frame('12356', 5), ('assertFalse', f._match_frame('12356', 5))\n    assert not f._match_frame('12356', 10), ('assertFalse', f._match_frame('12356', 10))\n    f = tracemalloc.Filter(False, 'abc')\n    assert not f._match_frame('abc', 0), ('assertFalse', f._match_frame('abc', 0))\n    assert not f._match_frame('abc', 5), ('assertFalse', f._match_frame('abc', 5))\n    assert not f._match_frame('abc', 10), ('assertFalse', f._match_frame('abc', 10))\n    assert f._match_frame('12356', 0), ('assertTrue', f._match_frame('12356', 0))\n    assert f._match_frame('12356', 5), ('assertTrue', f._match_frame('12356', 5))\n    assert f._match_frame('12356', 10), ('assertTrue', f._match_frame('12356', 10))\n    f = tracemalloc.Filter(True, 'abc', 5)\n    assert not f._match_frame('abc', 0), ('assertFalse', f._match_frame('abc', 0))\n    assert f._match_frame('abc', 5), ('assertTrue', f._match_frame('abc', 5))\n    assert not f._match_frame('abc', 10), ('assertFalse', f._match_frame('abc', 10))\n    assert not f._match_frame('12356', 0), ('assertFalse', f._match_frame('12356', 0))\n    assert not f._match_frame('12356', 5), ('assertFalse', f._match_frame('12356', 5))\n    assert not f._match_frame('12356', 10), ('assertFalse', f._match_frame('12356', 10))\n    f = tracemalloc.Filter(False, 'abc', 5)\n    assert f._match_frame('abc', 0), ('assertTrue', f._match_frame('abc', 0))\n    assert not f._match_frame('abc', 5), ('assertFalse', f._match_frame('abc', 5))\n    assert f._match_frame('abc', 10), ('assertTrue', f._match_frame('abc', 10))\n    assert f._match_frame('12356', 0), ('assertTrue', f._match_frame('12356', 0))\n    assert f._match_frame('12356', 5), ('assertTrue', f._match_frame('12356', 5))\n    assert f._match_frame('12356', 10), ('assertTrue', f._match_frame('12356', 10))\n    f = tracemalloc.Filter(True, 'abc', 0)\n    assert f._match_frame('abc', 0), ('assertTrue', f._match_frame('abc', 0))\n    assert not f._match_frame('abc', 5), ('assertFalse', f._match_frame('abc', 5))\n    assert not f._match_frame('abc', 10), ('assertFalse', f._match_frame('abc', 10))\n    assert not f._match_frame('12356', 0), ('assertFalse', f._match_frame('12356', 0))\n    assert not f._match_frame('12356', 5), ('assertFalse', f._match_frame('12356', 5))\n    assert not f._match_frame('12356', 10), ('assertFalse', f._match_frame('12356', 10))\n    f = tracemalloc.Filter(False, 'abc', 0)\n    assert not f._match_frame('abc', 0), ('assertFalse', f._match_frame('abc', 0))\n    assert f._match_frame('abc', 5), ('assertTrue', f._match_frame('abc', 5))\n    assert f._match_frame('abc', 10), ('assertTrue', f._match_frame('abc', 10))\n    assert f._match_frame('12356', 0), ('assertTrue', f._match_frame('12356', 0))\n    assert f._match_frame('12356', 5), ('assertTrue', f._match_frame('12356', 5))\n    assert f._match_frame('12356', 10), ('assertTrue', f._match_frame('12356', 10))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFilters.test_filter_match_filename" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef _t():\n\n    def fnmatch(inclusive, filename, pattern):\n        f = tracemalloc.Filter(inclusive, pattern)\n        return f._match_frame(filename, 0)\n    assert fnmatch(True, 'abc', 'abc'), ('assertTrue', fnmatch(True, 'abc', 'abc'))\n    assert not fnmatch(True, '12356', 'abc'), ('assertFalse', fnmatch(True, '12356', 'abc'))\n    assert not fnmatch(True, '<unknown>', 'abc'), ('assertFalse', fnmatch(True, '<unknown>', 'abc'))\n    assert not fnmatch(False, 'abc', 'abc'), ('assertFalse', fnmatch(False, 'abc', 'abc'))\n    assert fnmatch(False, '12356', 'abc'), ('assertTrue', fnmatch(False, '12356', 'abc'))\n    assert fnmatch(False, '<unknown>', 'abc'), ('assertTrue', fnmatch(False, '<unknown>', 'abc'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFilters.test_filter_match_filename_joker" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport tracemalloc\n\ndef _t():\n\n    def fnmatch(filename, pattern):\n        filter = tracemalloc.Filter(True, pattern)\n        return filter._match_frame(filename, 0)\n    assert not fnmatch('abc', ''), ('assertFalse', fnmatch('abc', ''))\n    assert not fnmatch('', 'abc'), ('assertFalse', fnmatch('', 'abc'))\n    assert fnmatch('', ''), ('assertTrue', fnmatch('', ''))\n    assert fnmatch('', '*'), ('assertTrue', fnmatch('', '*'))\n    assert fnmatch('abc', 'abc'), ('assertTrue', fnmatch('abc', 'abc'))\n    assert not fnmatch('abc', 'abcd'), ('assertFalse', fnmatch('abc', 'abcd'))\n    assert not fnmatch('abc', 'def'), ('assertFalse', fnmatch('abc', 'def'))\n    assert fnmatch('abc', 'a*'), ('assertTrue', fnmatch('abc', 'a*'))\n    assert fnmatch('abc', 'abc*'), ('assertTrue', fnmatch('abc', 'abc*'))\n    assert not fnmatch('abc', 'b*'), ('assertFalse', fnmatch('abc', 'b*'))\n    assert not fnmatch('abc', 'abcd*'), ('assertFalse', fnmatch('abc', 'abcd*'))\n    assert fnmatch('abc', 'a*c'), ('assertTrue', fnmatch('abc', 'a*c'))\n    assert fnmatch('abcdcx', 'a*cx'), ('assertTrue', fnmatch('abcdcx', 'a*cx'))\n    assert not fnmatch('abb', 'a*c'), ('assertFalse', fnmatch('abb', 'a*c'))\n    assert not fnmatch('abcdce', 'a*cx'), ('assertFalse', fnmatch('abcdce', 'a*cx'))\n    assert fnmatch('abcde', 'a*c*e'), ('assertTrue', fnmatch('abcde', 'a*c*e'))\n    assert fnmatch('abcbdefeg', 'a*bd*eg'), ('assertTrue', fnmatch('abcbdefeg', 'a*bd*eg'))\n    assert not fnmatch('abcdd', 'a*c*e'), ('assertFalse', fnmatch('abcdd', 'a*c*e'))\n    assert not fnmatch('abcbdefef', 'a*bd*eg'), ('assertFalse', fnmatch('abcbdefef', 'a*bd*eg'))\n    assert fnmatch('a.pyc', 'a.py'), ('assertTrue', fnmatch('a.pyc', 'a.py'))\n    assert fnmatch('a.py', 'a.pyc'), ('assertTrue', fnmatch('a.py', 'a.pyc'))\n    if os.name == 'nt':\n        assert fnmatch('aBC', 'ABc'), ('assertTrue', fnmatch('aBC', 'ABc'))\n        assert fnmatch('aBcDe', 'Ab*dE'), ('assertTrue', fnmatch('aBcDe', 'Ab*dE'))\n        assert fnmatch('a.pyc', 'a.PY'), ('assertTrue', fnmatch('a.pyc', 'a.PY'))\n        assert fnmatch('a.py', 'a.PYC'), ('assertTrue', fnmatch('a.py', 'a.PYC'))\n    else:\n        assert not fnmatch('aBC', 'ABc'), ('assertFalse', fnmatch('aBC', 'ABc'))\n        assert not fnmatch('aBcDe', 'Ab*dE'), ('assertFalse', fnmatch('aBcDe', 'Ab*dE'))\n        assert not fnmatch('a.pyc', 'a.PY'), ('assertFalse', fnmatch('a.pyc', 'a.PY'))\n        assert not fnmatch('a.py', 'a.PYC'), ('assertFalse', fnmatch('a.py', 'a.PYC'))\n    if os.name == 'nt':\n        assert fnmatch('a/b', 'a\\\\b'), ('assertTrue', fnmatch('a/b', 'a\\\\b'))\n        assert fnmatch('a\\\\b', 'a/b'), ('assertTrue', fnmatch('a\\\\b', 'a/b'))\n        assert fnmatch('a/b\\\\c', 'a\\\\b/c'), ('assertTrue', fnmatch('a/b\\\\c', 'a\\\\b/c'))\n        assert fnmatch('a/b/c', 'a\\\\b\\\\c'), ('assertTrue', fnmatch('a/b/c', 'a\\\\b\\\\c'))\n    else:\n        assert not fnmatch('a/b', 'a\\\\b'), ('assertFalse', fnmatch('a/b', 'a\\\\b'))\n        assert not fnmatch('a\\\\b', 'a/b'), ('assertFalse', fnmatch('a\\\\b', 'a/b'))\n        assert not fnmatch('a/b\\\\c', 'a\\\\b/c'), ('assertFalse', fnmatch('a/b\\\\c', 'a\\\\b/c'))\n        assert not fnmatch('a/b/c', 'a\\\\b\\\\c'), ('assertFalse', fnmatch('a/b/c', 'a\\\\b\\\\c'))\n    assert not fnmatch('a.pyo', 'a.py'), ('assertFalse', fnmatch('a.pyo', 'a.py'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFilters.test_filter_match_trace" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef _t():\n    t1 = (('a.py', 2), ('b.py', 3))\n    t2 = (('b.py', 4), ('b.py', 5))\n    t3 = (('c.py', 5), ('<unknown>', 0))\n    unknown = (('<unknown>', 0),)\n    f = tracemalloc.Filter(True, 'b.py', all_frames=True)\n    assert f._match_traceback(t1), ('assertTrue', f._match_traceback(t1))\n    assert f._match_traceback(t2), ('assertTrue', f._match_traceback(t2))\n    assert not f._match_traceback(t3), ('assertFalse', f._match_traceback(t3))\n    assert not f._match_traceback(unknown), ('assertFalse', f._match_traceback(unknown))\n    f = tracemalloc.Filter(True, 'b.py', all_frames=False)\n    assert not f._match_traceback(t1), ('assertFalse', f._match_traceback(t1))\n    assert f._match_traceback(t2), ('assertTrue', f._match_traceback(t2))\n    assert not f._match_traceback(t3), ('assertFalse', f._match_traceback(t3))\n    assert not f._match_traceback(unknown), ('assertFalse', f._match_traceback(unknown))\n    f = tracemalloc.Filter(False, 'b.py', all_frames=True)\n    assert not f._match_traceback(t1), ('assertFalse', f._match_traceback(t1))\n    assert not f._match_traceback(t2), ('assertFalse', f._match_traceback(t2))\n    assert f._match_traceback(t3), ('assertTrue', f._match_traceback(t3))\n    assert f._match_traceback(unknown), ('assertTrue', f._match_traceback(unknown))\n    f = tracemalloc.Filter(False, 'b.py', all_frames=False)\n    assert f._match_traceback(t1), ('assertTrue', f._match_traceback(t1))\n    assert not f._match_traceback(t2), ('assertFalse', f._match_traceback(t2))\n    assert f._match_traceback(t3), ('assertTrue', f._match_traceback(t3))\n    assert f._match_traceback(unknown), ('assertTrue', f._match_traceback(unknown))\n    f = tracemalloc.Filter(False, '<unknown>', all_frames=False)\n    assert f._match_traceback(t1), ('assertTrue', f._match_traceback(t1))\n    assert f._match_traceback(t2), ('assertTrue', f._match_traceback(t2))\n    assert f._match_traceback(t3), ('assertTrue', f._match_traceback(t3))\n    assert not f._match_traceback(unknown), ('assertFalse', f._match_traceback(unknown))\n    f = tracemalloc.Filter(True, '<unknown>', all_frames=True)\n    assert not f._match_traceback(t1), ('assertFalse', f._match_traceback(t1))\n    assert not f._match_traceback(t2), ('assertFalse', f._match_traceback(t2))\n    assert f._match_traceback(t3), ('assertTrue', f._match_traceback(t3))\n    assert f._match_traceback(unknown), ('assertTrue', f._match_traceback(unknown))\n    f = tracemalloc.Filter(False, '<unknown>', all_frames=True)\n    assert f._match_traceback(t1), ('assertTrue', f._match_traceback(t1))\n    assert f._match_traceback(t2), ('assertTrue', f._match_traceback(t2))\n    assert not f._match_traceback(t3), ('assertFalse', f._match_traceback(t3))\n    assert not f._match_traceback(unknown), ('assertFalse', f._match_traceback(unknown))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
