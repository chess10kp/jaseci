test "TestSnapshot.test_create_snapshot" {
    (ok, detail) = p2_libtest_run_snippet("import contextlib\nimport tracemalloc\nfrom unittest.mock import patch\n\ndef _t():\n    raw_traces = [(0, 5, (('a.py', 2),), 10)]\n    with contextlib.ExitStack() as stack:\n        stack.enter_context(patch.object(tracemalloc, 'is_tracing', return_value=True))\n        stack.enter_context(patch.object(tracemalloc, 'get_traceback_limit', return_value=5))\n        stack.enter_context(patch.object(tracemalloc, '_get_traces', return_value=raw_traces))\n        snapshot = tracemalloc.take_snapshot()\n        assert snapshot.traceback_limit == 5, ('assertEqual', snapshot.traceback_limit, 5)\n        assert len(snapshot.traces) == 1, ('assertEqual', len(snapshot.traces), 1)\n        trace = snapshot.traces[0]\n        assert trace.size == 5, ('assertEqual', trace.size, 5)\n        assert trace.traceback.total_nframe == 10, ('assertEqual', trace.traceback.total_nframe, 10)\n        assert len(trace.traceback) == 1, ('assertEqual', len(trace.traceback), 1)\n        assert trace.traceback[0].filename == 'a.py', ('assertEqual', trace.traceback[0].filename, 'a.py')\n        assert trace.traceback[0].lineno == 2, ('assertEqual', trace.traceback[0].lineno, 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSnapshot.test_filter_traces" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef create_snapshots():\n    traceback_limit = 2\n    raw_traces = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 66, (('b.py', 1),), 1), (3, 7, (('<unknown>', 0),), 1)]\n    snapshot = tracemalloc.Snapshot(raw_traces, traceback_limit)\n    raw_traces2 = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (2, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 5000, (('a.py', 5), ('b.py', 4)), 3), (4, 400, (('c.py', 578),), 1)]\n    snapshot2 = tracemalloc.Snapshot(raw_traces2, traceback_limit)\n    return (snapshot, snapshot2)\n\ndef _t():\n    snapshot, snapshot2 = create_snapshots()\n    filter1 = tracemalloc.Filter(False, 'b.py')\n    filter2 = tracemalloc.Filter(True, 'a.py', 2)\n    filter3 = tracemalloc.Filter(True, 'a.py', 5)\n    original_traces = list(snapshot.traces._traces)\n    snapshot3 = snapshot.filter_traces((filter1,))\n    assert snapshot3.traces._traces == [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3), (3, 7, (('<unknown>', 0),), 1)], ('assertEqual', snapshot3.traces._traces, [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3), (3, 7, (('<unknown>', 0),), 1)])\n    assert snapshot.traces._traces == original_traces, ('assertEqual', snapshot.traces._traces, original_traces)\n    snapshot4 = snapshot3.filter_traces((filter2, filter3))\n    assert snapshot4.traces._traces == [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3)], ('assertEqual', snapshot4.traces._traces, [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3)])\n    snapshot5 = snapshot.filter_traces(())\n    assert snapshot5 is not snapshot, ('assertIsNot', snapshot5, snapshot)\n    assert snapshot5.traces is not snapshot.traces, ('assertIsNot', snapshot5.traces, snapshot.traces)\n    assert snapshot5.traces == snapshot.traces, ('assertEqual', snapshot5.traces, snapshot.traces)\n    try:\n        snapshot.filter_traces(*(filter1,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

