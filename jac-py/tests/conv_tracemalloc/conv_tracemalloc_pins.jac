test "TestTracemallocEnabled.test_reset_peak" {
    (ok, detail) = p2_libtest_run_snippet("import sys\nimport tracemalloc\nimport unittest\nEMPTY_STRING_SIZE = sys.getsizeof(b'')\n\ndef get_frames(nframe, lineno_delta):\n    frames = []\n    frame = sys._getframe(1)\n    for index in range(nframe):\n        code = frame.f_code\n        lineno = frame.f_lineno + lineno_delta\n        frames.append((code.co_filename, lineno))\n        lineno_delta = 0\n        frame = frame.f_back\n        if frame is None:\n            break\n    return tuple(frames)\n\ndef allocate_bytes(size):\n    nframe = tracemalloc.get_traceback_limit()\n    bytes_len = size - EMPTY_STRING_SIZE\n    frames = get_frames(nframe, 1)\n    data = b'x' * bytes_len\n    return (data, tracemalloc.Traceback(frames, min(len(frames), nframe)))\n\ndef frame(filename, lineno):\n    return tracemalloc._Frame((filename, lineno))\n\ndef _t():\n\n    def setUp():\n        if tracemalloc.is_tracing():\n            raise unittest.SkipTest('tracemalloc must be stopped before the test')\n        tracemalloc.start(1)\n    if tracemalloc.is_tracing():\n        raise unittest.SkipTest('tracemalloc must be stopped before the test')\n    tracemalloc.start(1)\n    tracemalloc.clear_traces()\n    large_sum = sum(list(range(100000)))\n    size1, peak1 = tracemalloc.get_traced_memory()\n    tracemalloc.reset_peak()\n    size2, peak2 = tracemalloc.get_traced_memory()\n    assert peak2 >= size2, ('assertGreaterEqual', peak2, size2)\n    assert peak2 < peak1, ('assertLess', peak2, peak1)\n    obj_size = 1024 * 1024\n    obj, obj_traceback = allocate_bytes(obj_size)\n    size3, peak3 = tracemalloc.get_traced_memory()\n    assert peak3 >= size3, ('assertGreaterEqual', peak3, size3)\n    assert peak3 > peak2, ('assertGreater', peak3, peak2)\n    assert peak3 - peak2 >= obj_size, ('assertGreaterEqual', peak3 - peak2, obj_size)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
