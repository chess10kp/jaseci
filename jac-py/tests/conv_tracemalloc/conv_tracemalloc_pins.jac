test "TestSnapshot.test_snapshot_group_by_line" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef create_snapshots():\n    traceback_limit = 2\n    raw_traces = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 66, (('b.py', 1),), 1), (3, 7, (('<unknown>', 0),), 1)]\n    snapshot = tracemalloc.Snapshot(raw_traces, traceback_limit)\n    raw_traces2 = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (2, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 5000, (('a.py', 5), ('b.py', 4)), 3), (4, 400, (('c.py', 578),), 1)]\n    snapshot2 = tracemalloc.Snapshot(raw_traces2, traceback_limit)\n    return (snapshot, snapshot2)\n\ndef traceback(*frames):\n    return tracemalloc.Traceback(frames)\n\ndef traceback_lineno(filename, lineno):\n    return traceback((filename, lineno))\n\ndef _t():\n    snapshot, snapshot2 = create_snapshots()\n    tb_0 = traceback_lineno('<unknown>', 0)\n    tb_a_2 = traceback_lineno('a.py', 2)\n    tb_a_5 = traceback_lineno('a.py', 5)\n    tb_b_1 = traceback_lineno('b.py', 1)\n    tb_c_578 = traceback_lineno('c.py', 578)\n    stats1 = snapshot.statistics('lineno')\n    assert stats1 == [tracemalloc.Statistic(tb_b_1, 66, 1), tracemalloc.Statistic(tb_a_2, 30, 3), tracemalloc.Statistic(tb_0, 7, 1), tracemalloc.Statistic(tb_a_5, 2, 1)], ('assertEqual', stats1, [tracemalloc.Statistic(tb_b_1, 66, 1), tracemalloc.Statistic(tb_a_2, 30, 3), tracemalloc.Statistic(tb_0, 7, 1), tracemalloc.Statistic(tb_a_5, 2, 1)])\n    stats2 = snapshot2.statistics('lineno')\n    assert stats2 == [tracemalloc.Statistic(tb_a_5, 5002, 2), tracemalloc.Statistic(tb_c_578, 400, 1), tracemalloc.Statistic(tb_a_2, 30, 3)], ('assertEqual', stats2, [tracemalloc.Statistic(tb_a_5, 5002, 2), tracemalloc.Statistic(tb_c_578, 400, 1), tracemalloc.Statistic(tb_a_2, 30, 3)])\n    statistics = snapshot2.compare_to(snapshot, 'lineno')\n    assert statistics == [tracemalloc.StatisticDiff(tb_a_5, 5002, 5000, 2, 1), tracemalloc.StatisticDiff(tb_c_578, 400, 400, 1, 1), tracemalloc.StatisticDiff(tb_b_1, 0, -66, 0, -1), tracemalloc.StatisticDiff(tb_0, 0, -7, 0, -1), tracemalloc.StatisticDiff(tb_a_2, 30, 0, 3, 0)], ('assertEqual', statistics, [tracemalloc.StatisticDiff(tb_a_5, 5002, 5000, 2, 1), tracemalloc.StatisticDiff(tb_c_578, 400, 400, 1, 1), tracemalloc.StatisticDiff(tb_b_1, 0, -66, 0, -1), tracemalloc.StatisticDiff(tb_0, 0, -7, 0, -1), tracemalloc.StatisticDiff(tb_a_2, 30, 0, 3, 0)])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSnapshot.test_snapshot_group_by_file" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef create_snapshots():\n    traceback_limit = 2\n    raw_traces = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 66, (('b.py', 1),), 1), (3, 7, (('<unknown>', 0),), 1)]\n    snapshot = tracemalloc.Snapshot(raw_traces, traceback_limit)\n    raw_traces2 = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (2, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 5000, (('a.py', 5), ('b.py', 4)), 3), (4, 400, (('c.py', 578),), 1)]\n    snapshot2 = tracemalloc.Snapshot(raw_traces2, traceback_limit)\n    return (snapshot, snapshot2)\n\ndef traceback(*frames):\n    return tracemalloc.Traceback(frames)\n\ndef traceback_lineno(filename, lineno):\n    return traceback((filename, lineno))\n\ndef traceback_filename(filename):\n    return traceback_lineno(filename, 0)\n\ndef _t():\n    snapshot, snapshot2 = create_snapshots()\n    tb_0 = traceback_filename('<unknown>')\n    tb_a = traceback_filename('a.py')\n    tb_b = traceback_filename('b.py')\n    tb_c = traceback_filename('c.py')\n    stats1 = snapshot.statistics('filename')\n    assert stats1 == [tracemalloc.Statistic(tb_b, 66, 1), tracemalloc.Statistic(tb_a, 32, 4), tracemalloc.Statistic(tb_0, 7, 1)], ('assertEqual', stats1, [tracemalloc.Statistic(tb_b, 66, 1), tracemalloc.Statistic(tb_a, 32, 4), tracemalloc.Statistic(tb_0, 7, 1)])\n    stats2 = snapshot2.statistics('filename')\n    assert stats2 == [tracemalloc.Statistic(tb_a, 5032, 5), tracemalloc.Statistic(tb_c, 400, 1)], ('assertEqual', stats2, [tracemalloc.Statistic(tb_a, 5032, 5), tracemalloc.Statistic(tb_c, 400, 1)])\n    diff = snapshot2.compare_to(snapshot, 'filename')\n    assert diff == [tracemalloc.StatisticDiff(tb_a, 5032, 5000, 5, 1), tracemalloc.StatisticDiff(tb_c, 400, 400, 1, 1), tracemalloc.StatisticDiff(tb_b, 0, -66, 0, -1), tracemalloc.StatisticDiff(tb_0, 0, -7, 0, -1)], ('assertEqual', diff, [tracemalloc.StatisticDiff(tb_a, 5032, 5000, 5, 1), tracemalloc.StatisticDiff(tb_c, 400, 400, 1, 1), tracemalloc.StatisticDiff(tb_b, 0, -66, 0, -1), tracemalloc.StatisticDiff(tb_0, 0, -7, 0, -1)])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSnapshot.test_snapshot_group_by_traceback" {
    (ok, detail) = p2_libtest_run_snippet("import tracemalloc\n\ndef create_snapshots():\n    traceback_limit = 2\n    raw_traces = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (1, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 66, (('b.py', 1),), 1), (3, 7, (('<unknown>', 0),), 1)]\n    snapshot = tracemalloc.Snapshot(raw_traces, traceback_limit)\n    raw_traces2 = [(0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (0, 10, (('a.py', 2), ('b.py', 4)), 3), (2, 2, (('a.py', 5), ('b.py', 4)), 3), (2, 5000, (('a.py', 5), ('b.py', 4)), 3), (4, 400, (('c.py', 578),), 1)]\n    snapshot2 = tracemalloc.Snapshot(raw_traces2, traceback_limit)\n    return (snapshot, snapshot2)\n\ndef traceback(*frames):\n    return tracemalloc.Traceback(frames)\n\ndef _t():\n    snapshot, snapshot2 = create_snapshots()\n    tb1 = traceback(('a.py', 2), ('b.py', 4))\n    tb2 = traceback(('a.py', 5), ('b.py', 4))\n    tb3 = traceback(('b.py', 1))\n    tb4 = traceback(('<unknown>', 0))\n    stats1 = snapshot.statistics('traceback')\n    assert stats1 == [tracemalloc.Statistic(tb3, 66, 1), tracemalloc.Statistic(tb1, 30, 3), tracemalloc.Statistic(tb4, 7, 1), tracemalloc.Statistic(tb2, 2, 1)], ('assertEqual', stats1, [tracemalloc.Statistic(tb3, 66, 1), tracemalloc.Statistic(tb1, 30, 3), tracemalloc.Statistic(tb4, 7, 1), tracemalloc.Statistic(tb2, 2, 1)])\n    tb5 = traceback(('c.py', 578))\n    stats2 = snapshot2.statistics('traceback')\n    assert stats2 == [tracemalloc.Statistic(tb2, 5002, 2), tracemalloc.Statistic(tb5, 400, 1), tracemalloc.Statistic(tb1, 30, 3)], ('assertEqual', stats2, [tracemalloc.Statistic(tb2, 5002, 2), tracemalloc.Statistic(tb5, 400, 1), tracemalloc.Statistic(tb1, 30, 3)])\n    diff = snapshot2.compare_to(snapshot, 'traceback')\n    assert diff == [tracemalloc.StatisticDiff(tb2, 5002, 5000, 2, 1), tracemalloc.StatisticDiff(tb5, 400, 400, 1, 1), tracemalloc.StatisticDiff(tb3, 0, -66, 0, -1), tracemalloc.StatisticDiff(tb4, 0, -7, 0, -1), tracemalloc.StatisticDiff(tb1, 30, 0, 3, 0)], ('assertEqual', diff, [tracemalloc.StatisticDiff(tb2, 5002, 5000, 2, 1), tracemalloc.StatisticDiff(tb5, 400, 400, 1, 1), tracemalloc.StatisticDiff(tb3, 0, -66, 0, -1), tracemalloc.StatisticDiff(tb4, 0, -7, 0, -1), tracemalloc.StatisticDiff(tb1, 30, 0, 3, 0)])\n    try:\n        snapshot.statistics(*('traceback',), cumulative=True)\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

