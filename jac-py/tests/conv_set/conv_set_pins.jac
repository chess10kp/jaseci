test "TestMutate.test_add_until_full" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.values = ['a', 'b', 'c']\n    self.set = set(self.values)\n    tmp = set()\n    expected_len = 0\n    for v in self.values:\n        tmp.add(v)\n        expected_len += 1\n        assert len(tmp) == expected_len, ('assertEqual', len(tmp), expected_len)\n    assert tmp == self.set, ('assertEqual', tmp, self.set)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
