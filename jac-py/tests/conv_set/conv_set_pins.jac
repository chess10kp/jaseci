  for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.set = set()\n    dup = self.set.copy()\n    dup_list = sorted(dup, key=repr)\n    set_list = sorted(self.set, key=repr)\n    assert len(dup_list) == len(set_list), ('assertEqual', len(dup_list), len(set_list))\n    for i in range(len(dup_list)):\n        assert dup_list[i] is set_list[i], ('assertTrue', dup_list[i] is set_list[i])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
