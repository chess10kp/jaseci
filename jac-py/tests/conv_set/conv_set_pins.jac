test "TestCopyingTriple.test_deep_copy" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.set = set(['zero', 0, None])\n    dup = copy.deepcopy(self.set)\n    dup_list = sorted(dup, key=repr)\n    set_list = sorted(self.set, key=repr)\n    assert len(dup_list) == len(set_list), ('assertEqual', len(dup_list), len(set_list))\n    for i in range(len(dup_list)):\n        assert dup_list[i] == set_list[i], ('assertEqual', dup_list[i], set_list[i])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopyingTuple.test_deep_copy" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.set = set([(1, 2)])\n    dup = copy.deepcopy(self.set)\n    dup_list = sorted(dup, key=repr)\n    set_list = sorted(self.set, key=repr)\n    assert len(dup_list) == len(set_list), ('assertEqual', len(dup_list), len(set_list))\n    for i in range(len(dup_list)):\n        assert dup_list[i] == set_list[i], ('assertEqual', dup_list[i], set_list[i])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopyingNested.test_deep_copy" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.set = set([((1, 2), (3, 4))])\n    dup = copy.deepcopy(self.set)\n    dup_list = sorted(dup, key=repr)\n    set_list = sorted(self.set, key=repr)\n    assert len(dup_list) == len(set_list), ('assertEqual', len(dup_list), len(set_list))\n    for i in range(len(dup_list)):\n        assert dup_list[i] == set_list[i], ('assertEqual', dup_list[i], set_list[i])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIdentities.test_binopsVsSubsets" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.a = set('abracadabra')\n    self.b = set('alacazam')\n    a, b = (self.a, self.b)\n    assert a - b < a, ('assertTrue', a - b < a)\n    assert b - a < b, ('assertTrue', b - a < b)\n    assert a & b < a, ('assertTrue', a & b < a)\n    assert a & b < b, ('assertTrue', a & b < b)\n    assert a | b > a, ('assertTrue', a | b > a)\n    assert a | b > b, ('assertTrue', a | b > b)\n    assert a ^ b < a | b, ('assertTrue', a ^ b < a | b)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIdentities.test_commutativity" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.a = set('abracadabra')\n    self.b = set('alacazam')\n    a, b = (self.a, self.b)\n    assert a & b == b & a, ('assertEqual', a & b, b & a)\n    assert a | b == b | a, ('assertEqual', a | b, b | a)\n    assert a ^ b == b ^ a, ('assertEqual', a ^ b, b ^ a)\n    if a != b:\n        assert a - b != b - a, ('assertNotEqual', a - b, b - a)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIdentities.test_summations" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.a = set('abracadabra')\n    self.b = set('alacazam')\n    a, b = (self.a, self.b)\n    assert a - b | a & b | b - a == a | b, ('assertEqual', a - b | a & b | b - a, a | b)\n    assert a & b | a ^ b == a | b, ('assertEqual', a & b | a ^ b, a | b)\n    assert a | b - a == a | b, ('assertEqual', a | b - a, a | b)\n    assert a - b | b == a | b, ('assertEqual', a - b | b, a | b)\n    assert a - b | a & b == a, ('assertEqual', a - b | a & b, a)\n    assert b - a | a & b == b, ('assertEqual', b - a | a & b, b)\n    assert a - b | b - a == a ^ b, ('assertEqual', a - b | b - a, a ^ b)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIdentities.test_exclusion" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.a = set('abracadabra')\n    self.b = set('alacazam')\n    a, b, zero = (self.a, self.b, set())\n    assert a - b & b == zero, ('assertEqual', a - b & b, zero)\n    assert b - a & a == zero, ('assertEqual', b - a & a, zero)\n    assert a & b & (a ^ b) == zero, ('assertEqual', a & b & (a ^ b), zero)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_constructor" {
    (ok, detail) = p2_libtest_run_snippet("def R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n    for cons in (set, frozenset):\n        for s in ('123', '', range(1000), ('do', 1.2), range(2000, 2200, 5)):\n            for g in (G, I, Ig, S, L, R):\n                assert sorted(cons(g(s)), key=repr) == sorted(g(s), key=repr), ('assertEqual', sorted(cons(g(s)), key=repr), sorted(g(s), key=repr))\n            try:\n                cons(*(X(s),))\n            except TypeError:\n                pass\n            try:\n                cons(*(N(s),))\n            except TypeError:\n                pass\n            try:\n                cons(*(E(s),))\n            except ZeroDivisionError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_inline_methods" {
    (ok, detail) = p2_libtest_run_snippet("def R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n    s = set('november')\n    for data in ('123', '', range(1000), ('do', 1.2), range(2000, 2200, 5), 'december'):\n        for meth in (s.union, s.intersection, s.difference, s.symmetric_difference, s.isdisjoint):\n            for g in (G, I, Ig, L, R):\n                expected = meth(data)\n                actual = meth(g(data))\n                if isinstance(expected, bool):\n                    assert actual == expected, ('assertEqual', actual, expected)\n                else:\n                    assert sorted(actual, key=repr) == sorted(expected, key=repr), ('assertEqual', sorted(actual, key=repr), sorted(expected, key=repr))\n            try:\n                meth(*(X(s),))\n            except TypeError:\n                pass\n            try:\n                meth(*(N(s),))\n            except TypeError:\n                pass\n            try:\n                meth(*(E(s),))\n            except ZeroDivisionError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVariousIteratorArgs.test_inplace_methods" {
    (ok, detail) = p2_libtest_run_snippet("def R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass I:\n    \"\"\"Sequence using iterator protocol\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass X:\n    \"\"\"Missing __getitem__ and __iter__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __next__(self):\n        if self.i >= len(self.seqn):\n            raise StopIteration\n        v = self.seqn[self.i]\n        self.i += 1\n        return v\n\nclass N:\n    \"\"\"Iterator missing __next__()\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\nclass E:\n    \"\"\"Test propagation of exceptions\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        3 // 0\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n    for data in ('123', '', range(1000), ('do', 1.2), range(2000, 2200, 5), 'december'):\n        for methname in ('update', 'intersection_update', 'difference_update', 'symmetric_difference_update'):\n            for g in (G, I, Ig, S, L, R):\n                s = set('january')\n                t = s.copy()\n                getattr(s, methname)(list(g(data)))\n                getattr(t, methname)(g(data))\n                assert sorted(s, key=repr) == sorted(t, key=repr), ('assertEqual', sorted(s, key=repr), sorted(t, key=repr))\n            try:\n                getattr(set('january'), methname)(*(X(data),))\n            except TypeError:\n                pass\n            try:\n                getattr(set('january'), methname)(*(N(data),))\n            except TypeError:\n                pass\n            try:\n                getattr(set('january'), methname)(*(E(data),))\n            except ZeroDivisionError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestWeirdBugs.test_8420_set_merge" {
    (ok, detail) = p2_libtest_run_snippet("class bad_eq:\n\n    def __eq__(self, other):\n        if be_bad:\n            set2.clear()\n            raise ZeroDivisionError\n        return self is other\n\n    def __hash__(self):\n        return 0\n\nclass bad_dict_clear:\n\n    def __eq__(self, other):\n        if be_bad:\n            dict2.clear()\n        return self is other\n\n    def __hash__(self):\n        return 0\n\ndef _t():\n    global be_bad, set2, dict2\n    be_bad = False\n    set1 = {bad_eq()}\n    set2 = {bad_eq() for i in range(75)}\n    be_bad = True\n    try:\n        set1.update(*(set2,))\n    except ZeroDivisionError:\n        pass\n    be_bad = False\n    set1 = {bad_dict_clear()}\n    dict2 = {bad_dict_clear(): None}\n    be_bad = True\n    set1.symmetric_difference_update(dict2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

