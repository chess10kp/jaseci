test "TestSubsetEqualEmpty.test_issubset" {
    (ok, detail) = p2_libtest_run_snippet("class TestSubsets:\n    case2method = {'<=': 'issubset', '>=': 'issuperset'}\n    reverse = {'==': '==', '!=': '!=', '<': '>', '>': '<', '<=': '>=', '>=': '<='}\n\n    def test_issubset(self):\n        x = self.left\n        y = self.right\n        for case in ('!=', '==', '<', '<=', '>', '>='):\n            expected = case in self.cases\n            result = eval('x' + case + 'y', locals())\n            assert result == expected, ('assertEqual', result, expected)\n            if case in TestSubsets.case2method:\n                method = getattr(x, TestSubsets.case2method[case])\n                result = method(y)\n                assert result == expected, ('assertEqual', result, expected)\n            rcase = TestSubsets.reverse[case]\n            result = eval('y' + rcase + 'x', locals())\n            assert result == expected, ('assertEqual', result, expected)\n            if rcase in TestSubsets.case2method:\n                method = getattr(y, TestSubsets.case2method[rcase])\n                result = method(x)\n                assert result == expected, ('assertEqual', result, expected)\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\n\nclass S:\n    \"\"\"Test immediate stop\"\"\"\n\n    def __init__(self, seqn):\n        pass\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        raise StopIteration\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.case2method = {'<=': 'issubset', '>=': 'issuperset'}\n    self.cases = ('==', '<=', '>=')\n    self.left = set()\n    self.name = 'both empty'\n    self.reverse = {'==': '==', '!=': '!=', '<': '>', '>': '<', '<=': '>=', '>=': '<='}\n    self.right = set()\n    x = self.left\n    y = self.right\n    for case in ('!=', '==', '<', '<=', '>', '>='):\n        expected = case in self.cases\n        result = eval('x' + case + 'y', locals())\n        assert result == expected, ('assertEqual', result, expected)\n        if case in TestSubsets.case2method:\n            method = getattr(x, TestSubsets.case2method[case])\n            result = method(y)\n            assert result == expected, ('assertEqual', result, expected)\n        rcase = TestSubsets.reverse[case]\n        result = eval('y' + rcase + 'x', locals())\n        assert result == expected, ('assertEqual', result, expected)\n        if rcase in TestSubsets.case2method:\n            method = getattr(y, TestSubsets.case2method[rcase])\n            result = method(x)\n            assert result == expected, ('assertEqual', result, expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

