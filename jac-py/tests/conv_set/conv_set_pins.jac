test "TestBasicOpsEmpty.test_iteration" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.case = 'empty set'\n    self.values = []\n    self.set = set(self.values)\n    self.dup = set(self.values)\n    self.length = 0\n    self.repr = 'set()'\n    for v in self.set:\n        assert v in self.values, ('assertIn', v, self.values)\n    setiter = iter(self.set)\n    assert setiter.__length_hint__() == len(self.set), ('assertEqual', setiter.__length_hint__(), len(self.set))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

