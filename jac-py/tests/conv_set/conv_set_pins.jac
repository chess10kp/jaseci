  for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef setUp():\n\n    def gen():\n        for i in range(0, 10, 2):\n            yield i\n    self.set = set((1, 2, 3))\n    self.other = gen()\n    self.otherIsIterable = True\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    def gen():\n        for i in range(0, 10, 2):\n            yield i\n    self.set = set((1, 2, 3))\n    self.other = gen()\n    self.otherIsIterable = True\n    assert (self.other == self.set) == False, ('assertEqual', (self.other == self.set), False)\n    assert (self.set == self.other) == False, ('assertEqual', (self.set == self.other), False)\n    assert (self.other != self.set) == True, ('assertEqual', (self.other != self.set), True)\n    assert (self.set != self.other) == True, ('assertEqual', (self.set != self.other), True)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
