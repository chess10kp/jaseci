test "TestBasicOpsEmpty.test_pickling" {
    (ok, detail) = p2_libtest_run_snippet("import copy\nimport pickle\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.case = 'empty set'\n    self.values = []\n    self.set = set(self.values)\n    self.dup = set(self.values)\n    self.length = 0\n    self.repr = 'set()'\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        p = pickle.dumps(self.set, proto)\n        copy = pickle.loads(p)\n        assert self.set == copy, ('assertEqual', self.set, copy)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

