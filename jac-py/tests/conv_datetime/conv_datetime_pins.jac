test "TestLocalTimeDisambiguation.test_vilnius_1941_fromutc" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\nHOUR = timedelta(hours=1)\n\nclass Europe_Vilnius_1941(tzinfo):\n\n    def _utc_fold(self):\n        return [datetime(1941, 6, 23, 21, tzinfo=self), datetime(1941, 6, 23, 22, tzinfo=self)]\n\n    def _loc_fold(self):\n        return [datetime(1941, 6, 23, 23, tzinfo=self), datetime(1941, 6, 24, 0, tzinfo=self)]\n\n    def utcoffset(self, dt):\n        fold_start, fold_stop = self._loc_fold()\n        if dt < fold_start:\n            return 3 * HOUR\n        if dt < fold_stop:\n            return (2 if dt.fold else 3) * HOUR\n        return 2 * HOUR\n\n    def dst(self, dt):\n        fold_start, fold_stop = self._loc_fold()\n        if dt < fold_start:\n            return 0 * HOUR\n        if dt < fold_stop:\n            return (1 if dt.fold else 0) * HOUR\n        return 1 * HOUR\n\n    def tzname(self, dt):\n        fold_start, fold_stop = self._loc_fold()\n        if dt < fold_start:\n            return 'MSK'\n        if dt < fold_stop:\n            return ('MSK', 'CEST')[dt.fold]\n        return 'CEST'\n\n    def fromutc(self, dt):\n        assert dt.fold == 0\n        assert dt.tzinfo is self\n        if dt.year != 1941:\n            raise NotImplementedError\n        fold_start, fold_stop = self._utc_fold()\n        if dt < fold_start:\n            return dt + 3 * HOUR\n        if dt < fold_stop:\n            return (dt + 2 * HOUR).replace(fold=1)\n        return dt + 2 * HOUR\n\ndef _t():\n    Vilnius = Europe_Vilnius_1941()\n    gdt = datetime(1941, 6, 23, 20, 59, 59, tzinfo=timezone.utc)\n    ldt = gdt.astimezone(Vilnius)\n    assert ldt.strftime('%a %b %d %H:%M:%S %Y %Z%z') == 'Mon Jun 23 23:59:59 1941 MSK+0300', ('assertEqual', ldt.strftime('%a %b %d %H:%M:%S %Y %Z%z'), 'Mon Jun 23 23:59:59 1941 MSK+0300')\n    assert ldt.fold == 0, ('assertEqual', ldt.fold, 0)\n    assert not ldt.dst(), ('assertFalse', ldt.dst())\n    gdt = datetime(1941, 6, 23, 21, tzinfo=timezone.utc)\n    ldt = gdt.astimezone(Vilnius)\n    assert ldt.strftime('%a %b %d %H:%M:%S %Y %Z%z') == 'Mon Jun 23 23:00:00 1941 CEST+0200', ('assertEqual', ldt.strftime('%a %b %d %H:%M:%S %Y %Z%z'), 'Mon Jun 23 23:00:00 1941 CEST+0200')\n    assert ldt.fold == 1, ('assertEqual', ldt.fold, 1)\n    assert ldt.dst(), ('assertTrue', ldt.dst())\n    gdt = datetime(1941, 6, 23, 22, tzinfo=timezone.utc)\n    ldt = gdt.astimezone(Vilnius)\n    assert ldt.strftime('%a %b %d %H:%M:%S %Y %Z%z') == 'Tue Jun 24 00:00:00 1941 CEST+0200', ('assertEqual', ldt.strftime('%a %b %d %H:%M:%S %Y %Z%z'), 'Tue Jun 24 00:00:00 1941 CEST+0200')\n    assert ldt.fold == 0, ('assertEqual', ldt.fold, 0)\n    assert ldt.dst(), ('assertTrue', ldt.dst())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

