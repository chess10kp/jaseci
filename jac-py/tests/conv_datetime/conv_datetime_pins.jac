test "TestDateTimeTZ.test_zones" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\ndef _t():\n    est = FixedOffset(-300, 'EST')\n    utc = FixedOffset(0, 'UTC')\n    met = FixedOffset(60, 'MET')\n    t1 = datetime(2002, 3, 19, 7, 47, tzinfo=est)\n    t2 = datetime(2002, 3, 19, 12, 47, tzinfo=utc)\n    t3 = datetime(2002, 3, 19, 13, 47, tzinfo=met)\n    assert t1.tzinfo == est, ('assertEqual', t1.tzinfo, est)\n    assert t2.tzinfo == utc, ('assertEqual', t2.tzinfo, utc)\n    assert t3.tzinfo == met, ('assertEqual', t3.tzinfo, met)\n    assert t1.utcoffset() == timedelta(minutes=-300), ('assertEqual', t1.utcoffset(), timedelta(minutes=-300))\n    assert t2.utcoffset() == timedelta(minutes=0), ('assertEqual', t2.utcoffset(), timedelta(minutes=0))\n    assert t3.utcoffset() == timedelta(minutes=60), ('assertEqual', t3.utcoffset(), timedelta(minutes=60))\n    assert t1.tzname() == 'EST', ('assertEqual', t1.tzname(), 'EST')\n    assert t2.tzname() == 'UTC', ('assertEqual', t2.tzname(), 'UTC')\n    assert t3.tzname() == 'MET', ('assertEqual', t3.tzname(), 'MET')\n    assert hash(t1) == hash(t2), ('assertEqual', hash(t1), hash(t2))\n    assert hash(t1) == hash(t3), ('assertEqual', hash(t1), hash(t3))\n    assert hash(t2) == hash(t3), ('assertEqual', hash(t2), hash(t3))\n    assert t1 == t2, ('assertEqual', t1, t2)\n    assert t1 == t3, ('assertEqual', t1, t3)\n    assert t2 == t3, ('assertEqual', t2, t3)\n    assert str(t1) == '2002-03-19 07:47:00-05:00', ('assertEqual', str(t1), '2002-03-19 07:47:00-05:00')\n    assert str(t2) == '2002-03-19 12:47:00+00:00', ('assertEqual', str(t2), '2002-03-19 12:47:00+00:00')\n    assert str(t3) == '2002-03-19 13:47:00+01:00', ('assertEqual', str(t3), '2002-03-19 13:47:00+01:00')\n    d = 'datetime.datetime(2002, 3, 19, '\n    assert repr(t1) == d + '7, 47, tzinfo=est)', ('assertEqual', repr(t1), d + '7, 47, tzinfo=est)')\n    assert repr(t2) == d + '12, 47, tzinfo=utc)', ('assertEqual', repr(t2), d + '12, 47, tzinfo=utc)')\n    assert repr(t3) == d + '13, 47, tzinfo=met)', ('assertEqual', repr(t3), d + '13, 47, tzinfo=met)')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_combine" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import time\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\ndef _t():\n    met = FixedOffset(60, 'MET')\n    d = date(2002, 3, 4)\n    tz = time(18, 45, 3, 1234, tzinfo=met)\n    dt = datetime.combine(d, tz)\n    assert dt == datetime(2002, 3, 4, 18, 45, 3, 1234, tzinfo=met), ('assertEqual', dt, datetime(2002, 3, 4, 18, 45, 3, 1234, tzinfo=met))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_extract" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import time\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    met = FixedOffset(60, 'MET')\n    dt = self.theclass(2002, 3, 4, 18, 45, 3, 1234, tzinfo=met)\n    assert dt.date() == date(2002, 3, 4), ('assertEqual', dt.date(), date(2002, 3, 4))\n    assert dt.time() == time(18, 45, 3, 1234), ('assertEqual', dt.time(), time(18, 45, 3, 1234))\n    assert dt.timetz() == time(18, 45, 3, 1234, tzinfo=met), ('assertEqual', dt.timetz(), time(18, 45, 3, 1234, tzinfo=met))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_tz_aware_arithmetic" {
    (ok, detail) = p2_libtest_run_snippet("import random\nfrom datetime import MINYEAR, MAXYEAR\nfrom datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\nHOUR = timedelta(hours=1)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    now = self.theclass.now()\n    tz55 = FixedOffset(-330, 'west 5:30')\n    timeaware = now.time().replace(tzinfo=tz55)\n    nowaware = self.theclass.combine(now.date(), timeaware)\n    assert nowaware.tzinfo is tz55, ('assertIs', nowaware.tzinfo, tz55)\n    assert nowaware.timetz() == timeaware, ('assertEqual', nowaware.timetz(), timeaware)\n    try:\n        (lambda: now - nowaware)()\n    except TypeError:\n        pass\n    try:\n        (lambda: nowaware - now)()\n    except TypeError:\n        pass\n    try:\n        (lambda: now + nowaware)()\n    except TypeError:\n        pass\n    try:\n        (lambda: nowaware + now)()\n    except TypeError:\n        pass\n    try:\n        (lambda: nowaware + nowaware)()\n    except TypeError:\n        pass\n    assert now - now == timedelta(0), ('assertEqual', now - now, timedelta(0))\n    assert nowaware - nowaware == timedelta(0), ('assertEqual', nowaware - nowaware, timedelta(0))\n    delta = timedelta(weeks=1, minutes=12, microseconds=5678)\n    nowawareplus = nowaware + delta\n    assert nowaware.tzinfo is tz55, ('assertIs', nowaware.tzinfo, tz55)\n    nowawareplus2 = delta + nowaware\n    assert nowawareplus2.tzinfo is tz55, ('assertIs', nowawareplus2.tzinfo, tz55)\n    assert nowawareplus == nowawareplus2, ('assertEqual', nowawareplus, nowawareplus2)\n    diff = nowawareplus - delta\n    assert diff.tzinfo is tz55, ('assertIs', diff.tzinfo, tz55)\n    assert nowaware == diff, ('assertEqual', nowaware, diff)\n    try:\n        (lambda: delta - nowawareplus)()\n    except TypeError:\n        pass\n    assert nowawareplus - nowaware == delta, ('assertEqual', nowawareplus - nowaware, delta)\n    tzr = FixedOffset(random.randrange(-1439, 1440), 'randomtimezone')\n    nowawareplus = nowawareplus.replace(tzinfo=tzr)\n    assert nowawareplus.tzinfo is tzr, ('assertIs', nowawareplus.tzinfo, tzr)\n    got = nowaware - nowawareplus\n    expected = nowawareplus.utcoffset() - nowaware.utcoffset() - delta\n    assert got == expected, ('assertEqual', got, expected)\n    min = self.theclass(1, 1, 1, tzinfo=FixedOffset(1439, 'min'))\n    max = self.theclass(MAXYEAR, 12, 31, 23, 59, 59, 999999, tzinfo=FixedOffset(-1439, 'max'))\n    maxdiff = max - min\n    assert maxdiff == self.theclass.max - self.theclass.min + timedelta(minutes=2 * 1439), ('assertEqual', maxdiff, self.theclass.max - self.theclass.min + timedelta(minutes=2 * 1439))\n    tza = timezone(HOUR, 'A')\n    tzb = timezone(HOUR, 'B')\n    delta = min.replace(tzinfo=tza) - max.replace(tzinfo=tzb)\n    assert delta == self.theclass.min - self.theclass.max, ('assertEqual', delta, self.theclass.min - self.theclass.max)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_tzinfo_timetuple" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n\n    class DST(tzinfo):\n\n        def __init__(self, dstvalue):\n            if isinstance(dstvalue, int):\n                dstvalue = timedelta(minutes=dstvalue)\n            self.dstvalue = dstvalue\n\n        def dst(self, dt):\n            return self.dstvalue\n    cls = self.theclass\n    for dstvalue, flag in ((-33, 1), (33, 1), (0, 0), (None, -1)):\n        d = cls(1, 1, 1, 10, 20, 30, 40, tzinfo=DST(dstvalue))\n        t = d.timetuple()\n        assert 1 == t.tm_year, ('assertEqual', 1, t.tm_year)\n        assert 1 == t.tm_mon, ('assertEqual', 1, t.tm_mon)\n        assert 1 == t.tm_mday, ('assertEqual', 1, t.tm_mday)\n        assert 10 == t.tm_hour, ('assertEqual', 10, t.tm_hour)\n        assert 20 == t.tm_min, ('assertEqual', 20, t.tm_min)\n        assert 30 == t.tm_sec, ('assertEqual', 30, t.tm_sec)\n        assert 0 == t.tm_wday, ('assertEqual', 0, t.tm_wday)\n        assert 1 == t.tm_yday, ('assertEqual', 1, t.tm_yday)\n        assert flag == t.tm_isdst, ('assertEqual', flag, t.tm_isdst)\n    try:\n        cls(1, 1, 1, tzinfo=DST('x')).timetuple()\n    except TypeError:\n        pass\n    assert cls(1, 1, 1, tzinfo=DST(1439)).timetuple().tm_isdst == 1, ('assertEqual', cls(1, 1, 1, tzinfo=DST(1439)).timetuple().tm_isdst, 1)\n    assert cls(1, 1, 1, tzinfo=DST(-1439)).timetuple().tm_isdst == 1, ('assertEqual', cls(1, 1, 1, tzinfo=DST(-1439)).timetuple().tm_isdst, 1)\n    try:\n        cls(1, 1, 1, tzinfo=DST(1440)).timetuple()\n    except ValueError:\n        pass\n    try:\n        cls(1, 1, 1, tzinfo=DST(-1440)).timetuple()\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_utctimetuple" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import MINYEAR, MAXYEAR\nfrom datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\nMINUTE = timedelta(minutes=1)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n\n    class DST(tzinfo):\n\n        def __init__(self, dstvalue=0):\n            if isinstance(dstvalue, int):\n                dstvalue = timedelta(minutes=dstvalue)\n            self.dstvalue = dstvalue\n\n        def dst(self, dt):\n            return self.dstvalue\n    cls = self.theclass\n    try:\n        cls(1, 1, 1, tzinfo=DST(0)).utcoffset()\n    except NotImplementedError:\n        pass\n\n    class UOFS(DST):\n\n        def __init__(self, uofs, dofs=None):\n            DST.__init__(self, dofs)\n            self.uofs = timedelta(minutes=uofs)\n\n        def utcoffset(self, dt):\n            return self.uofs\n    for dstvalue in (-33, 33, 0, None):\n        d = cls(1, 2, 3, 10, 20, 30, 40, tzinfo=UOFS(-53, dstvalue))\n        t = d.utctimetuple()\n        assert d.year == t.tm_year, ('assertEqual', d.year, t.tm_year)\n        assert d.month == t.tm_mon, ('assertEqual', d.month, t.tm_mon)\n        assert d.day == t.tm_mday, ('assertEqual', d.day, t.tm_mday)\n        assert 11 == t.tm_hour, ('assertEqual', 11, t.tm_hour)\n        assert 13 == t.tm_min, ('assertEqual', 13, t.tm_min)\n        assert d.second == t.tm_sec, ('assertEqual', d.second, t.tm_sec)\n        assert d.weekday() == t.tm_wday, ('assertEqual', d.weekday(), t.tm_wday)\n        assert d.toordinal() - date(1, 1, 1).toordinal() + 1 == t.tm_yday, ('assertEqual', d.toordinal() - date(1, 1, 1).toordinal() + 1, t.tm_yday)\n        assert 0 == t.tm_isdst, ('assertEqual', 0, t.tm_isdst)\n    d = cls(1, 2, 3, 10, 20, 30, 40)\n    t = d.utctimetuple()\n    assert t[:-1] == d.timetuple()[:-1], ('assertEqual', t[:-1], d.timetuple()[:-1])\n    assert 0 == t.tm_isdst, ('assertEqual', 0, t.tm_isdst)\n\n    class NOFS(DST):\n\n        def utcoffset(self, dt):\n            return None\n    d = cls(1, 2, 3, 10, 20, 30, 40, tzinfo=NOFS())\n    t = d.utctimetuple()\n    assert t[:-1] == d.timetuple()[:-1], ('assertEqual', t[:-1], d.timetuple()[:-1])\n    assert 0 == t.tm_isdst, ('assertEqual', 0, t.tm_isdst)\n\n    class BOFS(DST):\n\n        def utcoffset(self, dt):\n            return 'EST'\n    d = cls(1, 2, 3, 10, 20, 30, 40, tzinfo=BOFS())\n    try:\n        d.utctimetuple()\n    except TypeError:\n        pass\n    d = cls(2010, 11, 13, 14, 15, 16, 171819)\n    for tz in [timezone.min, timezone.utc, timezone.max]:\n        dtz = d.replace(tzinfo=tz)\n        assert dtz.utctimetuple()[:-1] == dtz.astimezone(timezone.utc).timetuple()[:-1], ('assertEqual', dtz.utctimetuple()[:-1], dtz.astimezone(timezone.utc).timetuple()[:-1])\n    tiny = cls(MINYEAR, 1, 1, 0, 0, 37, tzinfo=UOFS(1439))\n    try:\n        tiny.utctimetuple()\n    except OverflowError:\n        pass\n    huge = cls(MAXYEAR, 12, 31, 23, 59, 37, 999999, tzinfo=UOFS(-1439))\n    try:\n        huge.utctimetuple()\n    except OverflowError:\n        pass\n    tiny = cls.min.replace(tzinfo=timezone(MINUTE))\n    try:\n        tiny.utctimetuple()\n    except OverflowError:\n        pass\n    huge = cls.max.replace(tzinfo=timezone(-MINUTE))\n    try:\n        huge.utctimetuple()\n    except OverflowError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_tzinfo_isoformat" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    zero = FixedOffset(0, '+00:00')\n    plus = FixedOffset(220, '+03:40')\n    minus = FixedOffset(-231, '-03:51')\n    unknown = FixedOffset(None, '')\n    cls = self.theclass\n    datestr = '0001-02-03'\n    for ofs in (None, zero, plus, minus, unknown):\n        for us in (0, 987001):\n            d = cls(1, 2, 3, 4, 5, 59, us, tzinfo=ofs)\n            timestr = '04:05:59' + (us and '.987001' or '')\n            ofsstr = ofs is not None and d.tzname() or ''\n            tailstr = timestr + ofsstr\n            iso = d.isoformat()\n            assert iso == datestr + 'T' + tailstr, ('assertEqual', iso, datestr + 'T' + tailstr)\n            assert iso == d.isoformat('T'), ('assertEqual', iso, d.isoformat('T'))\n            assert d.isoformat('k') == datestr + 'k' + tailstr, ('assertEqual', d.isoformat('k'), datestr + 'k' + tailstr)\n            assert d.isoformat('\u1234') == datestr + '\u1234' + tailstr, ('assertEqual', d.isoformat('\u1234'), datestr + '\u1234' + tailstr)\n            assert str(d) == datestr + ' ' + tailstr, ('assertEqual', str(d), datestr + ' ' + tailstr)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_more_astimezone" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    fnone = FixedOffset(None, 'None')\n    f44m = FixedOffset(44, '44')\n    fm5h = FixedOffset(-timedelta(hours=5), 'm300')\n    dt = self.theclass.now(tz=f44m)\n    assert dt.tzinfo is f44m, ('assertIs', dt.tzinfo, f44m)\n    try:\n        dt.astimezone(*(fnone,))\n    except ValueError:\n        pass\n    x = dt.astimezone(dt.tzinfo)\n    assert x.tzinfo is f44m, ('assertIs', x.tzinfo, f44m)\n    assert x.date() == dt.date(), ('assertEqual', x.date(), dt.date())\n    assert x.time() == dt.time(), ('assertEqual', x.time(), dt.time())\n    got = dt.astimezone(fm5h)\n    assert got.tzinfo is fm5h, ('assertIs', got.tzinfo, fm5h)\n    assert got.utcoffset() == timedelta(hours=-5), ('assertEqual', got.utcoffset(), timedelta(hours=-5))\n    expected = dt - dt.utcoffset()\n    expected += fm5h.utcoffset(dt)\n    expected = expected.replace(tzinfo=fm5h)\n    assert got.date() == expected.date(), ('assertEqual', got.date(), expected.date())\n    assert got.time() == expected.time(), ('assertEqual', got.time(), expected.time())\n    assert got.timetz() == expected.timetz(), ('assertEqual', got.timetz(), expected.timetz())\n    assert got.tzinfo is expected.tzinfo, ('assertIs', got.tzinfo, expected.tzinfo)\n    assert got == expected, ('assertEqual', got, expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_aware_subtract" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    cls = self.theclass\n\n    class OperandDependentOffset(tzinfo):\n\n        def utcoffset(self, t):\n            if t.minute < 10:\n                return timedelta(minutes=t.minute)\n            else:\n                return timedelta(minutes=59)\n    base = cls(8, 9, 10, 11, 12, 13, 14, tzinfo=OperandDependentOffset())\n    d0 = base.replace(minute=3)\n    d1 = base.replace(minute=9)\n    d2 = base.replace(minute=11)\n    for x in (d0, d1, d2):\n        for y in (d0, d1, d2):\n            got = x - y\n            expected = timedelta(minutes=x.minute - y.minute)\n            assert got == expected, ('assertEqual', got, expected)\n    base = cls(8, 9, 10, 11, 12, 13, 14)\n    d0 = base.replace(minute=3, tzinfo=OperandDependentOffset())\n    d1 = base.replace(minute=9, tzinfo=OperandDependentOffset())\n    d2 = base.replace(minute=11, tzinfo=OperandDependentOffset())\n    for x in (d0, d1, d2):\n        for y in (d0, d1, d2):\n            got = x - y\n            if (x is d0 or x is d1) and (y is d0 or y is d1):\n                expected = timedelta(0)\n            elif x is y is d2:\n                expected = timedelta(0)\n            elif x is d2:\n                expected = timedelta(minutes=11 - 59 - 0)\n            else:\n                assert y is d2\n                expected = timedelta(minutes=0 - (11 - 59))\n            assert got == expected, ('assertEqual', got, expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_mixed_compare" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    t1 = datetime(1, 2, 3, 4, 5, 6, 7)\n    t2 = datetime(1, 2, 3, 4, 5, 6, 7)\n    assert t1 == t2, ('assertEqual', t1, t2)\n    t2 = t2.replace(tzinfo=None)\n    assert t1 == t2, ('assertEqual', t1, t2)\n    t2 = t2.replace(tzinfo=FixedOffset(None, ''))\n    assert t1 == t2, ('assertEqual', t1, t2)\n    t2 = t2.replace(tzinfo=FixedOffset(0, ''))\n    assert t1 != t2, ('assertNotEqual', t1, t2)\n\n    class Varies(tzinfo):\n\n        def __init__(self):\n            self.offset = timedelta(minutes=22)\n\n        def utcoffset(self, t):\n            self.offset += timedelta(minutes=1)\n            return self.offset\n    v = Varies()\n    t1 = t2.replace(tzinfo=v)\n    t2 = t2.replace(tzinfo=v)\n    assert t1.utcoffset() == timedelta(minutes=23), ('assertEqual', t1.utcoffset(), timedelta(minutes=23))\n    assert t2.utcoffset() == timedelta(minutes=24), ('assertEqual', t2.utcoffset(), timedelta(minutes=24))\n    assert t1 == t2, ('assertEqual', t1, t2)\n    t2 = t2.replace(tzinfo=Varies())\n    assert t1 < t2, ('assertTrue', t1 < t2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

