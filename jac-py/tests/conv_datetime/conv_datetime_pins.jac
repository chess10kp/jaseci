    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import timezone\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    t = self.theclass(1970, 1, 1, tzinfo=timezone.utc)\n    assert t.timestamp() == 0.0, ('assertEqual', t.timestamp(), 0.0)\n    t = self.theclass(1970, 1, 1, 1, 2, 3, 4, tzinfo=timezone.utc)\n    assert t.timestamp() == 3600 + 2 * 60 + 3 + 4 * 1e-06, ('assertEqual', t.timestamp(), 3600 + 2 * 60 + 3 + 4 * 1e-06)\n    t = self.theclass(1970, 1, 1, 1, 2, 3, 4, tzinfo=timezone(timedelta(hours=-5), 'EST'))\n    assert t.timestamp() == 18000 + 3600 + 2 * 60 + 3 + 4 * 1e-06, ('assertEqual', t.timestamp(), 18000 + 3600 + 2 * 60 + 3 + 4 * 1e-06)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
