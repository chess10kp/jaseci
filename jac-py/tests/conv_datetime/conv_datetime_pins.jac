test "TestSubclassDateTime.test_combine" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import time\nfrom datetime import timezone\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    d = date(2002, 3, 4)\n    t = time(18, 45, 3, 1234)\n    expected = self.theclass(2002, 3, 4, 18, 45, 3, 1234)\n    combine = self.theclass.combine\n    dt = combine(d, t)\n    assert dt == expected, ('assertEqual', dt, expected)\n    dt = combine(time=t, date=d)\n    assert dt == expected, ('assertEqual', dt, expected)\n    assert d == dt.date(), ('assertEqual', d, dt.date())\n    assert t == dt.time(), ('assertEqual', t, dt.time())\n    assert dt == combine(dt.date(), dt.time()), ('assertEqual', dt, combine(dt.date(), dt.time()))\n    try:\n        combine()\n    except TypeError:\n        pass\n    try:\n        combine(*(d,))\n    except TypeError:\n        pass\n    try:\n        combine(*(t, d))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, t, 1))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, t, 1, 2))\n    except TypeError:\n        pass\n    try:\n        combine(*('date', 'time'))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, 'time'))\n    except TypeError:\n        pass\n    try:\n        combine(*('date', t))\n    except TypeError:\n        pass\n    dt = combine(d, t, timezone.utc)\n    assert dt.tzinfo is timezone.utc, ('assertIs', dt.tzinfo, timezone.utc)\n    dt = combine(d, t, tzinfo=timezone.utc)\n    assert dt.tzinfo is timezone.utc, ('assertIs', dt.tzinfo, timezone.utc)\n    t = time()\n    dt = combine(dt, t)\n    assert dt.date() == d, ('assertEqual', dt.date(), d)\n    assert dt.time() == t, ('assertEqual', dt.time(), t)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_combine" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import time\nfrom datetime import timezone\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    d = date(2002, 3, 4)\n    t = time(18, 45, 3, 1234)\n    expected = self.theclass(2002, 3, 4, 18, 45, 3, 1234)\n    combine = self.theclass.combine\n    dt = combine(d, t)\n    assert dt == expected, ('assertEqual', dt, expected)\n    dt = combine(time=t, date=d)\n    assert dt == expected, ('assertEqual', dt, expected)\n    assert d == dt.date(), ('assertEqual', d, dt.date())\n    assert t == dt.time(), ('assertEqual', t, dt.time())\n    assert dt == combine(dt.date(), dt.time()), ('assertEqual', dt, combine(dt.date(), dt.time()))\n    try:\n        combine()\n    except TypeError:\n        pass\n    try:\n        combine(*(d,))\n    except TypeError:\n        pass\n    try:\n        combine(*(t, d))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, t, 1))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, t, 1, 2))\n    except TypeError:\n        pass\n    try:\n        combine(*('date', 'time'))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, 'time'))\n    except TypeError:\n        pass\n    try:\n        combine(*('date', t))\n    except TypeError:\n        pass\n    dt = combine(d, t, timezone.utc)\n    assert dt.tzinfo is timezone.utc, ('assertIs', dt.tzinfo, timezone.utc)\n    dt = combine(d, t, tzinfo=timezone.utc)\n    assert dt.tzinfo is timezone.utc, ('assertIs', dt.tzinfo, timezone.utc)\n    t = time()\n    dt = combine(dt, t)\n    assert dt.date() == d, ('assertEqual', dt.date(), d)\n    assert dt.time() == t, ('assertEqual', dt.time(), t)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSubclassDateTime.test_fromisoformat_datetime" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import timezone\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    base_dates = [(1, 1, 1), (1900, 1, 1), (2004, 11, 12), (2017, 5, 30)]\n    base_times = [(0, 0, 0, 0), (0, 0, 0, 241000), (0, 0, 0, 234567), (12, 30, 45, 234567)]\n    separators = [' ', 'T']\n    tzinfos = [None, timezone.utc, timezone(timedelta(hours=-5)), timezone(timedelta(hours=2))]\n    dts = [self.theclass(*date_tuple, *time_tuple, tzinfo=tzi) for date_tuple in base_dates for time_tuple in base_times for tzi in tzinfos]\n    for dt in dts:\n        for sep in separators:\n            dtstr = dt.isoformat(sep=sep)\n            dt_rt = self.theclass.fromisoformat(dtstr)\n            assert dt == dt_rt, ('assertEqual', dt, dt_rt)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

