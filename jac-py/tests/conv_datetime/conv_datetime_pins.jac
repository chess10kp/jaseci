test "TestSubclassDateTime.test_computations" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    a = self.theclass(2002, 1, 31)\n    b = self.theclass(1956, 1, 31)\n    c = self.theclass(2001, 2, 1)\n    diff = a - b\n    assert diff.days == 46 * 365 + len(range(1956, 2002, 4)), ('assertEqual', diff.days, 46 * 365 + len(range(1956, 2002, 4)))\n    assert diff.seconds == 0, ('assertEqual', diff.seconds, 0)\n    assert diff.microseconds == 0, ('assertEqual', diff.microseconds, 0)\n    day = timedelta(1)\n    week = timedelta(7)\n    a = self.theclass(2002, 3, 2)\n    assert a + day == self.theclass(2002, 3, 3), ('assertEqual', a + day, self.theclass(2002, 3, 3))\n    assert day + a == self.theclass(2002, 3, 3), ('assertEqual', day + a, self.theclass(2002, 3, 3))\n    assert a - day == self.theclass(2002, 3, 1), ('assertEqual', a - day, self.theclass(2002, 3, 1))\n    assert -day + a == self.theclass(2002, 3, 1), ('assertEqual', -day + a, self.theclass(2002, 3, 1))\n    assert a + week == self.theclass(2002, 3, 9), ('assertEqual', a + week, self.theclass(2002, 3, 9))\n    assert a - week == self.theclass(2002, 2, 23), ('assertEqual', a - week, self.theclass(2002, 2, 23))\n    assert a + 52 * week == self.theclass(2003, 3, 1), ('assertEqual', a + 52 * week, self.theclass(2003, 3, 1))\n    assert a - 52 * week == self.theclass(2001, 3, 3), ('assertEqual', a - 52 * week, self.theclass(2001, 3, 3))\n    assert a + week - a == week, ('assertEqual', a + week - a, week)\n    assert a + day - a == day, ('assertEqual', a + day - a, day)\n    assert a - week - a == -week, ('assertEqual', a - week - a, -week)\n    assert a - day - a == -day, ('assertEqual', a - day - a, -day)\n    assert a - (a + week) == -week, ('assertEqual', a - (a + week), -week)\n    assert a - (a + day) == -day, ('assertEqual', a - (a + day), -day)\n    assert a - (a - week) == week, ('assertEqual', a - (a - week), week)\n    assert a - (a - day) == day, ('assertEqual', a - (a - day), day)\n    assert c - (c - day) == day, ('assertEqual', c - (c - day), day)\n    for i in (1, 1.0):\n        try:\n            (lambda: a + i)()\n        except TypeError:\n            pass\n        try:\n            (lambda: a - i)()\n        except TypeError:\n            pass\n        try:\n            (lambda: i + a)()\n        except TypeError:\n            pass\n        try:\n            (lambda: i - a)()\n        except TypeError:\n            pass\n    try:\n        (lambda: day - a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: day * a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a * day)()\n    except TypeError:\n        pass\n    try:\n        (lambda: day // a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a // day)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a * a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a // a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a + a)()\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

