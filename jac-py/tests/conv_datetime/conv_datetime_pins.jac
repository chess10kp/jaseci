nfo)\n            assert type(derived) is otype, ('assertIs', type(derived), otype)\n            assert derived.utcoffset(None) == offset, ('assertEqual', derived.utcoffset(None), offset)\n            assert derived.tzname(None) == oname, ('assertEqual', derived.tzname(None), oname)\n            assert not hasattr(derived, 'spam'), ('assertNotHasAttr', derived, 'spam')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
