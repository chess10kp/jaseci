test "TestSubclassDateTime.test_pickling" {
    (ok, detail) = p2_libtest_run_snippet("import pickle\nfrom datetime import date, datetime\npickle_choices = [(pickle, pickle, proto) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    args = (6, 7, 23)\n    orig = self.theclass(*args)\n    for pickler, unpickler, proto in pickle_choices:\n        green = pickler.dumps(orig, proto)\n        derived = unpickler.loads(green)\n        assert orig == derived, ('assertEqual', orig, derived)\n    assert orig.__reduce__() == orig.__reduce_ex__(2), ('assertEqual', orig.__reduce__(), orig.__reduce_ex__(2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

