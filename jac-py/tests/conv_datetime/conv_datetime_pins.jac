fset()\n    except ValueError:\n        pass\n    try:\n        t.dst()\n    except ValueError:\n        pass\n\n    class C7(tzinfo):\n\n        def utcoffset(self, dt):\n            return timedelta(microseconds=61)\n\n        def dst(self, dt):\n            return timedelta(microseconds=-81)\n    t = cls(1, 1, 1, tzinfo=C7())\n    assert t.utcoffset() == timedelta(microseconds=61), ('assertEqual', t.utcoffset(), timedelta(microseconds=61))\n    assert t.dst() == timedelta(microseconds=-81), ('assertEqual', t.dst(), timedelta(microseconds=-81))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
