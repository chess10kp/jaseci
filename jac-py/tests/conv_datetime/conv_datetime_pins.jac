elf.theclass(2000, 1, 31, 23, 59, 59)\n    try:\n        self.theclass(*(2000, 1, 31, 23, 59, -1))\n    except ValueError:\n        pass\n    try:\n        self.theclass(*(2000, 1, 31, 23, 59, 60))\n    except ValueError:\n        pass\n    self.theclass(2000, 1, 31, 23, 59, 59, 0)\n    self.theclass(2000, 1, 31, 23, 59, 59, 999999)\n    try:\n        self.theclass(*(2000, 1, 31, 23, 59, 59, -1))\n    except ValueError:\n        pass\n    try:\n        self.theclass(*(2000, 1, 31, 23, 59, 59, 1000000))\n    except ValueError:\n        pass\n    try:\n        self.theclass(*(2000, 1, 31), fold=-1)\n    except ValueError:\n        pass\n    try:\n        self.theclass(*(2000, 1, 31), fold=2)\n    except ValueError:\n        pass\n    try:\n        self.theclass(*(2000, 1, 31, 23, 59, 59, 0, None, 1))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
