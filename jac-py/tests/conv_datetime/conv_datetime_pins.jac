test "TestDateTimeTZ.test_strftime" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    t = self.theclass(2005, 3, 2)\n    assert t.strftime('m:%m d:%d y:%y') == 'm:03 d:02 y:05', ('assertEqual', t.strftime('m:%m d:%d y:%y'), 'm:03 d:02 y:05')\n    assert t.strftime('') == '', ('assertEqual', t.strftime(''), '')\n    assert t.strftime('x' * 1000) == 'x' * 1000, ('assertEqual', t.strftime('x' * 1000), 'x' * 1000)\n    try:\n        t.strftime()\n    except TypeError:\n        pass\n    try:\n        t.strftime(*('one', 'two'))\n    except TypeError:\n        pass\n    try:\n        t.strftime(*(42,))\n    except TypeError:\n        pass\n    assert t.strftime('%m') == '03', ('assertEqual', t.strftime('%m'), '03')\n    assert t.strftime(\"'%z' '%:z' '%Z'\") == \"'' '' ''\", ('assertEqual', t.strftime(\"'%z' '%:z' '%Z'\"), \"'' '' ''\")\n    for f in ['%e', '%', '%#']:\n        try:\n            t.strftime(f)\n        except ValueError:\n            pass\n    try:\n        t.strftime('%y\\ud800%m')\n    except UnicodeEncodeError:\n        pass\n    t.strftime('%f')\n    t.strftime(format='%f')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
