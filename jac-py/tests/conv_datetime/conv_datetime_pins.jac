ame(None))\n    assert 'UTC-01:06:40.000001' == timezone(-timedelta(0, 4000, 1)).tzname(None), ('assertEqual', 'UTC-01:06:40.000001', timezone(-timedelta(0, 4000, 1)).tzname(None))\n    try:\n        self.EST.tzname('')\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        self.EST.tzname(5)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
