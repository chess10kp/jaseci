}

test "TestSubclassDateTime.test_isoformat" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    t = self.theclass(1, 2, 3, 4, 5, 1, 123)\n    assert t.isoformat() == '0001-02-03T04:05:01.000123', ('assertEqual', t.isoformat(), '0001-02-03T04:05:01.000123')\n    assert t.isoformat('T') == '0001-02-03T04:05:01.000123', ('assertEqual', t.isoformat('T'), '0001-02-03T04:05:01.000123')\n    assert t.isoformat(' ') == '0001-02-03 04:05:01.000123', ('assertEqual', t.isoformat(' '), '0001-02-03 04:05:01.000123')\n    assert t.isoformat('\\x00') == '0001-02-03\\x0004:05:01.000123', ('assertEqual', t.isoformat('\\x00'), '0001-02-03\\x0004:05:01.000123')\n    assert t.isoformat('\\ud800') == '0001-02-03\\ud80004:05:01.000123', ('assertEqual', t.isoformat('\\ud800'), '0001-02-03\\ud80004:05:01.000123')\n    assert t.isoformat(timespec='hours') == '0001-02-03T04', ('assertEqual', t.isoformat(timespec='hours'), '0001-02-03T04')\n    assert t.isoformat(timespec='minutes') == '0001-02-03T04:05', ('assertEqual', t.isoformat(timespec='minutes'), '0001-02-03T04:05')\n    assert t.isoformat(timespec='seconds') == '0001-02-03T04:05:01', ('assertEqual', t.isoformat(timespec='seconds'), '0001-02-03T04:05:01')\n    assert t.isoformat(timespec='milliseconds') == '0001-02-03T04:05:01.000', ('assertEqual', t.isoformat(timespec='milliseconds'), '0001-02-03T04:05:01.000')\n    assert t.isoformat(timespec='microseconds') == '0001-02-03T04:05:01.000123', ('assertEqual', t.isoformat(timespec='microseconds'), '0001-02-03T04:05:01.000123')\n    assert t.isoformat(timespec='auto') == '0001-02-03T04:05:01.000123', ('assertEqual', t.isoformat(timespec='auto'), '0001-02-03T04:05:01.000123')\n    assert t.isoformat(sep=' ', timespec='minutes') == '0001-02-03 04:05', ('assertEqual', t.isoformat(sep=' ', timespec='minutes'), '0001-02-03 04:05')\n    try:\n        t.isoformat(timespec='foo')\n    except ValueError:\n        pass\n    try:\n        t.isoformat(timespec='\\ud800')\n    except ValueError:\n        pass\n    assert str(t) == '0001-02-03 04:05:01.000123', ('assertEqual', str(t), '0001-02-03 04:05:01.000123')\n    t = self.theclass(1, 2, 3, 4, 5, 1, 999500, tzinfo=timezone.utc)\n    assert t.isoformat(timespec='milliseconds') == '0001-02-03T04:05:01.999+00:00', ('assertEqual', t.isoformat(timespec='milliseconds'), '0001-02-03T04:05:01.999+00:00')\n    t = self.theclass(1, 2, 3, 4, 5, 1, 999500)\n    assert t.isoformat(timespec='milliseconds') == '0001-02-03T04:05:01.999', ('assertEqual', t.isoformat(timespec='milliseconds'), '0001-02-03T04:05:01.999')\n    t = self.theclass(1, 2, 3, 4, 5, 1)\n    assert t.isoformat(timespec='auto') == '0001-02-03T04:05:01', ('assertEqual', t.isoformat(timespec='auto'), '0001-02-03T04:05:01')\n    assert t.isoformat(timespec='milliseconds') == '0001-02-03T04:05:01.000', ('assertEqual', t.isoformat(timespec='milliseconds'), '0001-02-03T04:05:01.000')\n    assert t.isoformat(timespec='microseconds') == '0001-02-03T04:05:01.000000', ('assertEqual', t.isoformat(timespec='microseconds'), '0001-02-03T04:05:01.000000')\n    t = self.theclass(2, 3, 2)\n    assert t.isoformat() == '0002-03-02T00:00:00', ('assertEqual', t.isoformat(), '0002-03-02T00:00:00')\n    assert t.isoformat('T') == '0002-03-02T00:00:00', ('assertEqual', t.isoformat('T'), '0002-03-02T00:00:00')\n    assert t.isoformat(' ') == '0002-03-02 00:00:00', ('assertEqual', t.isoformat(' '), '0002-03-02 00:00:00')\n    assert str(t) == '0002-03-02 00:00:00', ('assertEqual', str(t), '0002-03-02 00:00:00')\n    tz = FixedOffset(timedelta(seconds=16), 'XXX')\n    t = self.theclass(2, 3, 2, tzinfo=tz)\n    assert t.isoformat() == '0002-03-02T00:00:00+00:00:16', ('assertEqual', t.isoformat(), '0002-03-02T00:00:00+00:00:16')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

