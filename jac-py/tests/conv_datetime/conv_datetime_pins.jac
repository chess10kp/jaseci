test "TestSubclassDateTime.test_iso_long_years" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    ISO_LONG_YEARS_TABLE = '\\n              4   32   60   88\\n              9   37   65   93\\n             15   43   71   99\\n             20   48   76\\n             26   54   82\\n\\n            105  133  161  189\\n            111  139  167  195\\n            116  144  172\\n            122  150  178\\n            128  156  184\\n\\n            201  229  257  285\\n            207  235  263  291\\n            212  240  268  296\\n            218  246  274\\n            224  252  280\\n\\n            303  331  359  387\\n            308  336  364  392\\n            314  342  370  398\\n            320  348  376\\n            325  353  381\\n        '\n    iso_long_years = sorted(map(int, ISO_LONG_YEARS_TABLE.split()))\n    L = []\n    for i in range(400):\n        d = self.theclass(2000 + i, 12, 31)\n        d1 = self.theclass(1600 + i, 12, 31)\n        assert d.isocalendar()[1:] == d1.isocalendar()[1:], ('assertEqual', d.isocalendar()[1:], d1.isocalendar()[1:])\n        if d.isocalendar()[1] == 53:\n            L.append(i)\n    assert L == iso_long_years, ('assertEqual', L, iso_long_years)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

