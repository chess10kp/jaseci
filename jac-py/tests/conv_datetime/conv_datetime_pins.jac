test "TestTimeDelta.test_division" {
    (ok, detail) = p2_libtest_run_snippet("from operator import lt, le, gt, ge, eq, ne, truediv, floordiv, mod\nfrom datetime import timedelta\n\ndef _t():\n    t = timedelta(hours=1, minutes=24, seconds=19)\n    second = timedelta(seconds=1)\n    assert t / second == 5059.0, ('assertEqual', t / second, 5059.0)\n    assert t // second == 5059, ('assertEqual', t // second, 5059)\n    t = timedelta(minutes=2, seconds=30)\n    minute = timedelta(minutes=1)\n    assert t / minute == 2.5, ('assertEqual', t / minute, 2.5)\n    assert t // minute == 2, ('assertEqual', t // minute, 2)\n    zerotd = timedelta(0)\n    try:\n        truediv(*(t, zerotd))\n    except ZeroDivisionError:\n        pass\n    try:\n        floordiv(*(t, zerotd))\n    except ZeroDivisionError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

