test "TestSubclassDateTime.test_fromisoformat_fails_surrogate" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport re\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    dtstr = '2018-01-03\\ud80001:0113'\n    try:\n        self.theclass.fromisoformat(dtstr)\n    except ValueError as _exc:\n        assert _re.search(re.escape(repr(dtstr)), str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

