}

test "TestDateTimeTZ.test_strftime_special" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    t = self.theclass(2004, 12, 31, 6, 22, 33, 47)\n    s1 = t.strftime('%c')\n    s2 = t.strftime('%B')\n    assert t.strftime('\ud83d\udc0d') == '\ud83d\udc0d', ('assertEqual', t.strftime('\ud83d\udc0d'), '\ud83d\udc0d')\n    assert t.strftime('\ud83d\udcbb%c\ud83d\udc0d%B') == f'\ud83d\udcbb{s1}\ud83d\udc0d{s2}', ('assertEqual', t.strftime('\ud83d\udcbb%c\ud83d\udc0d%B'), f'\ud83d\udcbb{s1}\ud83d\udc0d{s2}')\n    assert t.strftime('%c\ud83d\udcbb%B\ud83d\udc0d') == f'{s1}\ud83d\udcbb{s2}\ud83d\udc0d', ('assertEqual', t.strftime('%c\ud83d\udcbb%B\ud83d\udc0d'), f'{s1}\ud83d\udcbb{s2}\ud83d\udc0d')\n    assert t.strftime('\\ud83d') == '\\ud83d', ('assertEqual', t.strftime('\\ud83d'), '\\ud83d')\n    assert t.strftime('\\udc0d') == '\\udc0d', ('assertEqual', t.strftime('\\udc0d'), '\\udc0d')\n    assert t.strftime('\\ud83d%c\\udc0d%B') == f'\\ud83d{s1}\\udc0d{s2}', ('assertEqual', t.strftime('\\ud83d%c\\udc0d%B'), f'\\ud83d{s1}\\udc0d{s2}')\n    assert t.strftime('%c\\ud83d%B\\udc0d') == f'{s1}\\ud83d{s2}\\udc0d', ('assertEqual', t.strftime('%c\\ud83d%B\\udc0d'), f'{s1}\\ud83d{s2}\\udc0d')\n    assert t.strftime('%c\\udc0d%B\\ud83d') == f'{s1}\\udc0d{s2}\\ud83d', ('assertEqual', t.strftime('%c\\udc0d%B\\ud83d'), f'{s1}\\udc0d{s2}\\ud83d')\n    assert t.strftime('\\ud83d\\udc0d') == '\\ud83d\\udc0d', ('assertEqual', t.strftime('\\ud83d\\udc0d'), '\\ud83d\\udc0d')\n    assert t.strftime('%c\\ud83d\\udc0d%B') == f'{s1}\\ud83d\\udc0d{s2}', ('assertEqual', t.strftime('%c\\ud83d\\udc0d%B'), f'{s1}\\ud83d\\udc0d{s2}')\n    assert t.strftime('\\udcf0\\udc9f\\udc90\\udc8d') == '\\udcf0\\udc9f\\udc90\\udc8d', ('assertEqual', t.strftime('\\udcf0\\udc9f\\udc90\\udc8d'), '\\udcf0\\udc9f\\udc90\\udc8d')\n    assert t.strftime('%c\\udcf0\\udc9f\\udc90\\udc8d%B') == f'{s1}\\udcf0\\udc9f\\udc90\\udc8d{s2}', ('assertEqual', t.strftime('%c\\udcf0\\udc9f\\udc90\\udc8d%B'), f'{s1}\\udcf0\\udc9f\\udc90\\udc8d{s2}')\n    assert t.strftime('\\x00') == '\\x00', ('assertEqual', t.strftime('\\x00'), '\\x00')\n    assert t.strftime('\\x00' * 1000) == '\\x00' * 1000, ('assertEqual', t.strftime('\\x00' * 1000), '\\x00' * 1000)\n    assert t.strftime('\\x00%c\\x00%B') == f'\\x00{s1}\\x00{s2}', ('assertEqual', t.strftime('\\x00%c\\x00%B'), f'\\x00{s1}\\x00{s2}')\n    assert t.strftime('%c\\x00%B\\x00') == f'{s1}\\x00{s2}\\x00', ('assertEqual', t.strftime('%c\\x00%B\\x00'), f'{s1}\\x00{s2}\\x00')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_astimezone" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    dt = self.theclass.now()\n    f = FixedOffset(44, '0044')\n    dt_utc = dt.replace(tzinfo=timezone(timedelta(hours=-4), 'EDT'))\n    assert dt.astimezone() == dt_utc, ('assertEqual', dt.astimezone(), dt_utc)\n    try:\n        dt.astimezone(*(f, f))\n    except TypeError:\n        pass\n    try:\n        dt.astimezone(*(dt,))\n    except TypeError:\n        pass\n    dt_f = dt.replace(tzinfo=f) + timedelta(hours=4, minutes=44)\n    assert dt.astimezone(f) == dt_f, ('assertEqual', dt.astimezone(f), dt_f)\n    assert dt.astimezone(tz=f) == dt_f, ('assertEqual', dt.astimezone(tz=f), dt_f)\n\n    class Bogus(tzinfo):\n\n        def utcoffset(self, dt):\n            return None\n\n        def dst(self, dt):\n            return timedelta(0)\n    bog = Bogus()\n    try:\n        dt.astimezone(*(bog,))\n    except ValueError:\n        pass\n    assert dt.replace(tzinfo=bog).astimezone(f) == dt_f, ('assertEqual', dt.replace(tzinfo=bog).astimezone(f), dt_f)\n\n    class AlsoBogus(tzinfo):\n\n        def utcoffset(self, dt):\n            return timedelta(0)\n\n        def dst(self, dt):\n            return None\n    alsobog = AlsoBogus()\n    try:\n        dt.astimezone(*(alsobog,))\n    except ValueError:\n        pass\n\n    class Broken(tzinfo):\n\n        def utcoffset(self, dt):\n            return 1\n\n        def dst(self, dt):\n            return 1\n    broken = Broken()\n    dt_broken = dt.replace(tzinfo=broken)\n    try:\n        dt_broken.astimezone()\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

