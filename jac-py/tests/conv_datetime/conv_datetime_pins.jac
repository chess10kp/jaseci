test "TestLocalTimeDisambiguation.test_replace" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import time\nfrom datetime import date, datetime\n\ndef first_sunday_on_or_after(dt):\n    days_to_go = 6 - dt.weekday()\n    if days_to_go:\n        dt += timedelta(days_to_go)\n    return dt\nZERO = timedelta(0)\nHOUR = timedelta(hours=1)\nDSTSTART = datetime(1, 4, 1, 2)\nDSTEND = datetime(1, 10, 25, 1)\n\nclass USTimeZone(tzinfo):\n\n    def __init__(self, hours, reprname, stdname, dstname):\n        self.stdoffset = timedelta(hours=hours)\n        self.reprname = reprname\n        self.stdname = stdname\n        self.dstname = dstname\n\n    def __repr__(self):\n        return self.reprname\n\n    def tzname(self, dt):\n        if self.dst(dt):\n            return self.dstname\n        else:\n            return self.stdname\n\n    def utcoffset(self, dt):\n        return self.stdoffset + self.dst(dt)\n\n    def dst(self, dt):\n        if dt is None or dt.tzinfo is None:\n            return ZERO\n        assert dt.tzinfo is self\n        start = first_sunday_on_or_after(DSTSTART.replace(year=dt.year))\n        assert start.weekday() == 6 and start.month == 4 and (start.day <= 7)\n        end = first_sunday_on_or_after(DSTEND.replace(year=dt.year))\n        assert end.weekday() == 6 and end.month == 10 and (end.day >= 25)\n        if start <= dt.replace(tzinfo=None) < end:\n            return HOUR\n        else:\n            return ZERO\nEastern = USTimeZone(-5, 'Eastern', 'EST', 'EDT')\n\ndef _t():\n    t = time(0)\n    dt = datetime(1, 1, 1)\n    assert t.replace(fold=1).fold == 1, ('assertEqual', t.replace(fold=1).fold, 1)\n    assert dt.replace(fold=1).fold == 1, ('assertEqual', dt.replace(fold=1).fold, 1)\n    assert t.replace(fold=0).fold == 0, ('assertEqual', t.replace(fold=0).fold, 0)\n    assert dt.replace(fold=0).fold == 0, ('assertEqual', dt.replace(fold=0).fold, 0)\n    t = t.replace(fold=1, tzinfo=Eastern)\n    dt = dt.replace(fold=1, tzinfo=Eastern)\n    assert t.replace(tzinfo=None).fold == 1, ('assertEqual', t.replace(tzinfo=None).fold, 1)\n    assert dt.replace(tzinfo=None).fold == 1, ('assertEqual', dt.replace(tzinfo=None).fold, 1)\n    try:\n        t.replace(fold=2)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dt.replace(fold=2)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        t.replace(1, 1, 1, None, 1)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dt.replace(1, 1, 1, 1, 1, 1, 1, None, 1)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

