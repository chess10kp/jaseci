test "TestTimeTZ.test_utc_offset_out_of_bounds" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import time\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = time\n    _SelfNS.theclass = time\n\n    class Edgy(tzinfo):\n\n        def __init__(self, offset):\n            self.offset = timedelta(minutes=offset)\n\n        def utcoffset(self, dt):\n            return self.offset\n    cls = self.theclass\n    for offset, legit in ((-1440, False), (-1439, True), (1439, True), (1440, False)):\n        if cls is time:\n            t = cls(1, 2, 3, tzinfo=Edgy(offset))\n        elif cls is datetime:\n            t = cls(6, 6, 6, 1, 2, 3, tzinfo=Edgy(offset))\n        else:\n            assert 0, 'impossible'\n        if legit:\n            aofs = abs(offset)\n            h, m = divmod(aofs, 60)\n            tag = '%c%02d:%02d' % (offset < 0 and '-' or '+', h, m)\n            if isinstance(t, datetime):\n                t = t.timetz()\n            assert str(t) == '01:02:03' + tag, ('assertEqual', str(t), '01:02:03' + tag)\n        else:\n            try:\n                str(*(t,))\n            except ValueError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

