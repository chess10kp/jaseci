test "TestSubclassDateTime.test_overflow" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    tiny = self.theclass.resolution\n    for delta in [tiny, timedelta(1), timedelta(2)]:\n        dt = self.theclass.min + delta\n        dt -= delta\n        try:\n            dt.__sub__(*(delta,))\n        except OverflowError:\n            pass\n        try:\n            dt.__add__(*(-delta,))\n        except OverflowError:\n            pass\n        dt = self.theclass.max - delta\n        dt += delta\n        try:\n            dt.__add__(*(delta,))\n        except OverflowError:\n            pass\n        try:\n            dt.__sub__(*(-delta,))\n        except OverflowError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

