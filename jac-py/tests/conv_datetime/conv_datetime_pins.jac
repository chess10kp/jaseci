test "TestSubclassDateTime.test_subclass_alternate_constructors" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import time\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n\n    class DateSubclass(self.theclass):\n\n        def __new__(cls, *args, **kwargs):\n            result = self.theclass.__new__(cls, *args, **kwargs)\n            result.extra = 7\n            return result\n    args = (2003, 4, 14)\n    d_ord = 731319\n    d_isoformat = '2003-04-14'\n    base_d = DateSubclass(*args)\n    assert isinstance(base_d, DateSubclass), ('assertIsInstance', base_d, DateSubclass)\n    assert base_d.extra == 7, ('assertEqual', base_d.extra, 7)\n    ts = datetime.combine(base_d, time(0)).timestamp()\n    test_cases = [('fromordinal', (d_ord,)), ('fromtimestamp', (ts,)), ('fromisoformat', (d_isoformat,))]\n    for constr_name, constr_args in test_cases:\n        for base_obj in (DateSubclass, base_d):\n            constr = getattr(base_obj, constr_name)\n            dt = constr(*constr_args)\n            assert isinstance(dt, DateSubclass), ('assertIsInstance', dt, DateSubclass)\n            assert dt == base_d, ('assertEqual', dt, base_d)\n            assert dt.extra == 7, ('assertEqual', dt.extra, 7)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

