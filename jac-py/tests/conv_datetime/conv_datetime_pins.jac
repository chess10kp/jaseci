test "TestTimeDelta.test_overflow" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\n\ndef _t():\n    tiny = timedelta.resolution\n    td = timedelta.min + tiny\n    td -= tiny\n    try:\n        td.__sub__(*(tiny,))\n    except OverflowError:\n        pass\n    try:\n        td.__add__(*(-tiny,))\n    except OverflowError:\n        pass\n    td = timedelta.max - tiny\n    td += tiny\n    try:\n        td.__add__(*(tiny,))\n    except OverflowError:\n        pass\n    try:\n        td.__sub__(*(-tiny,))\n    except OverflowError:\n        pass\n    try:\n        (lambda: -timedelta.max)()\n    except OverflowError:\n        pass\n    day = timedelta(1)\n    try:\n        day.__mul__(*(10 ** 9,))\n    except OverflowError:\n        pass\n    try:\n        day.__mul__(*(1000000000.0,))\n    except OverflowError:\n        pass\n    try:\n        day.__truediv__(*(1e-20,))\n    except OverflowError:\n        pass\n    try:\n        day.__truediv__(*(1e-10,))\n    except OverflowError:\n        pass\n    try:\n        day.__truediv__(*(9e-10,))\n    except OverflowError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

