test "TestSubclassDateTime.test_isocalendar_pickling" {
    (ok, detail) = p2_libtest_run_snippet("import pickle\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    'Test that the result of datetime.isocalendar() can be pickled.\\n\\n        The result of a round trip should be a plain tuple.\\n        '\n    d = self.theclass(2019, 1, 1)\n    p = pickle.dumps(d.isocalendar())\n    res = pickle.loads(p)\n    assert type(res) == tuple, ('assertEqual', type(res), tuple)\n    assert res == (2019, 1, 2), ('assertEqual', res, (2019, 1, 2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

