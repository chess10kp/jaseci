test "TestTimeTZ.test_strftime_special" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import time\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = time\n    _SelfNS.theclass = time\n    t = self.theclass(1, 2, 3, 4)\n    s1 = t.strftime('%I%p%Z')\n    s2 = t.strftime('%X')\n    assert t.strftime('\ud83d\udc0d') == '\ud83d\udc0d', ('assertEqual', t.strftime('\ud83d\udc0d'), '\ud83d\udc0d')\n    assert t.strftime('\ud83d\udcbb%I%p%Z\ud83d\udc0d%X') == f'\ud83d\udcbb{s1}\ud83d\udc0d{s2}', ('assertEqual', t.strftime('\ud83d\udcbb%I%p%Z\ud83d\udc0d%X'), f'\ud83d\udcbb{s1}\ud83d\udc0d{s2}')\n    assert t.strftime('%I%p%Z\ud83d\udcbb%X\ud83d\udc0d') == f'{s1}\ud83d\udcbb{s2}\ud83d\udc0d', ('assertEqual', t.strftime('%I%p%Z\ud83d\udcbb%X\ud83d\udc0d'), f'{s1}\ud83d\udcbb{s2}\ud83d\udc0d')\n    assert t.strftime('\\ud83d') == '\\ud83d', ('assertEqual', t.strftime('\\ud83d'), '\\ud83d')\n    assert t.strftime('\\udc0d') == '\\udc0d', ('assertEqual', t.strftime('\\udc0d'), '\\udc0d')\n    assert t.strftime('\\ud83d%I%p%Z\\udc0d%X') == f'\\ud83d{s1}\\udc0d{s2}', ('assertEqual', t.strftime('\\ud83d%I%p%Z\\udc0d%X'), f'\\ud83d{s1}\\udc0d{s2}')\n    assert t.strftime('%I%p%Z\\ud83d%X\\udc0d') == f'{s1}\\ud83d{s2}\\udc0d', ('assertEqual', t.strftime('%I%p%Z\\ud83d%X\\udc0d'), f'{s1}\\ud83d{s2}\\udc0d')\n    assert t.strftime('%I%p%Z\\udc0d%X\\ud83d') == f'{s1}\\udc0d{s2}\\ud83d', ('assertEqual', t.strftime('%I%p%Z\\udc0d%X\\ud83d'), f'{s1}\\udc0d{s2}\\ud83d')\n    assert t.strftime('\\ud83d\\udc0d') == '\\ud83d\\udc0d', ('assertEqual', t.strftime('\\ud83d\\udc0d'), '\\ud83d\\udc0d')\n    assert t.strftime('%I%p%Z\\ud83d\\udc0d%X') == f'{s1}\\ud83d\\udc0d{s2}', ('assertEqual', t.strftime('%I%p%Z\\ud83d\\udc0d%X'), f'{s1}\\ud83d\\udc0d{s2}')\n    assert t.strftime('\\udcf0\\udc9f\\udc90\\udc8d') == '\\udcf0\\udc9f\\udc90\\udc8d', ('assertEqual', t.strftime('\\udcf0\\udc9f\\udc90\\udc8d'), '\\udcf0\\udc9f\\udc90\\udc8d')\n    assert t.strftime('%I%p%Z\\udcf0\\udc9f\\udc90\\udc8d%X') == f'{s1}\\udcf0\\udc9f\\udc90\\udc8d{s2}', ('assertEqual', t.strftime('%I%p%Z\\udcf0\\udc9f\\udc90\\udc8d%X'), f'{s1}\\udcf0\\udc9f\\udc90\\udc8d{s2}')\n    assert t.strftime('\\x00') == '\\x00', ('assertEqual', t.strftime('\\x00'), '\\x00')\n    assert t.strftime('\\x00' * 1000) == '\\x00' * 1000, ('assertEqual', t.strftime('\\x00' * 1000), '\\x00' * 1000)\n    assert t.strftime('\\x00%I%p%Z\\x00%X') == f'\\x00{s1}\\x00{s2}', ('assertEqual', t.strftime('\\x00%I%p%Z\\x00%X'), f'\\x00{s1}\\x00{s2}')\n    assert t.strftime('%I%p%Z\\x00%X\\x00') == f'{s1}\\x00{s2}\\x00', ('assertEqual', t.strftime('%I%p%Z\\x00%X\\x00'), f'{s1}\\x00{s2}\\x00')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestTimeTZ.test_format" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom datetime import time\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = time\n    _SelfNS.theclass = time\n    t = self.theclass(1, 2, 3, 4)\n    assert t.__format__('') == str(t), ('assertEqual', t.__format__(''), str(t))\n    try:\n        t.__format__(123)\n    except TypeError as _exc:\n        assert _re.search('must be str, not int', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\n    class A(self.theclass):\n\n        def __str__(self):\n            return 'A'\n    a = A(1, 2, 3, 4)\n    assert a.__format__('') == 'A', ('assertEqual', a.__format__(''), 'A')\n\n    class B(self.theclass):\n\n        def strftime(self, format_spec):\n            return 'B'\n    b = B(1, 2, 3, 4)\n    assert b.__format__('') == str(t), ('assertEqual', b.__format__(''), str(t))\n    for fmt in ['%H %M %S']:\n        assert t.__format__(fmt) == t.strftime(fmt), ('assertEqual', t.__format__(fmt), t.strftime(fmt))\n        assert a.__format__(fmt) == t.strftime(fmt), ('assertEqual', a.__format__(fmt), t.strftime(fmt))\n        assert b.__format__(fmt) == 'B', ('assertEqual', b.__format__(fmt), 'B')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

