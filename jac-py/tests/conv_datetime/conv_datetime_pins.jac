test "TestSubclassDateTime.test_more_strftime" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import timezone\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    t = self.theclass(2004, 12, 31, 6, 22, 33, 47)\n    assert t.strftime('%m %d %y %f %S %M %H %j') == '12 31 04 000047 33 22 06 366', ('assertEqual', t.strftime('%m %d %y %f %S %M %H %j'), '12 31 04 000047 33 22 06 366')\n    for (s, us), z in [((33, 123), '33.000123'), ((33, 0), '33')]:\n        tz = timezone(-timedelta(hours=2, seconds=s, microseconds=us))\n        t = t.replace(tzinfo=tz)\n        assert t.strftime('%z') == '-0200' + z, ('assertEqual', t.strftime('%z'), '-0200' + z)\n        assert t.strftime('%:z') == '-02:00:' + z, ('assertEqual', t.strftime('%:z'), '-02:00:' + z)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

