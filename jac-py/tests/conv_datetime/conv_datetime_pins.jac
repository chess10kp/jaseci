test "TestDateTimeTZ.test_utc_offset_out_of_bounds" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import time\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n\n    class Edgy(tzinfo):\n\n        def __init__(self, offset):\n            self.offset = timedelta(minutes=offset)\n\n        def utcoffset(self, dt):\n            return self.offset\n    cls = self.theclass\n    for offset, legit in ((-1440, False), (-1439, True), (1439, True), (1440, False)):\n        if cls is time:\n            t = cls(1, 2, 3, tzinfo=Edgy(offset))\n        elif cls is datetime:\n            t = cls(6, 6, 6, 1, 2, 3, tzinfo=Edgy(offset))\n        else:\n            assert 0, 'impossible'\n        if legit:\n            aofs = abs(offset)\n            h, m = divmod(aofs, 60)\n            tag = '%c%02d:%02d' % (offset < 0 and '-' or '+', h, m)\n            if isinstance(t, datetime):\n                t = t.timetz()\n            assert str(t) == '01:02:03' + tag, ('assertEqual', str(t), '01:02:03' + tag)\n        else:\n            try:\n                str(*(t,))\n            except ValueError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_tzinfo_classes" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    cls = self.theclass\n\n    class C1(tzinfo):\n\n        def utcoffset(self, dt):\n            return None\n\n        def dst(self, dt):\n            return None\n\n        def tzname(self, dt):\n            return None\n    for t in (cls(1, 1, 1), cls(1, 1, 1, tzinfo=None), cls(1, 1, 1, tzinfo=C1())):\n        assert t.utcoffset() is None, ('assertIsNone', t.utcoffset())\n        assert t.dst() is None, ('assertIsNone', t.dst())\n        assert t.tzname() is None, ('assertIsNone', t.tzname())\n\n    class C3(tzinfo):\n\n        def utcoffset(self, dt):\n            return timedelta(minutes=-1439)\n\n        def dst(self, dt):\n            return timedelta(minutes=1439)\n\n        def tzname(self, dt):\n            return 'aname'\n    t = cls(1, 1, 1, tzinfo=C3())\n    assert t.utcoffset() == timedelta(minutes=-1439), ('assertEqual', t.utcoffset(), timedelta(minutes=-1439))\n    assert t.dst() == timedelta(minutes=1439), ('assertEqual', t.dst(), timedelta(minutes=1439))\n    assert t.tzname() == 'aname', ('assertEqual', t.tzname(), 'aname')\n\n    class C4(tzinfo):\n\n        def utcoffset(self, dt):\n            return 'aname'\n\n        def dst(self, dt):\n            return 7\n\n        def tzname(self, dt):\n            return 0\n    t = cls(1, 1, 1, tzinfo=C4())\n    try:\n        t.utcoffset()\n    except TypeError:\n        pass\n    try:\n        t.dst()\n    except TypeError:\n        pass\n    try:\n        t.tzname()\n    except TypeError:\n        pass\n\n    class C6(tzinfo):\n\n        def utcoffset(self, dt):\n            return timedelta(hours=-24)\n\n        def dst(self, dt):\n            return timedelta(hours=24)\n    t = cls(1, 1, 1, tzinfo=C6())\n    try:\n        t.utcoffset()\n    except ValueError:\n        pass\n    try:\n        t.dst()\n    except ValueError:\n        pass\n\n    class C7(tzinfo):\n\n        def utcoffset(self, dt):\n            return timedelta(microseconds=61)\n\n        def dst(self, dt):\n            return timedelta(microseconds=-81)\n    t = cls(1, 1, 1, tzinfo=C7())\n    assert t.utcoffset() == timedelta(microseconds=61), ('assertEqual', t.utcoffset(), timedelta(microseconds=61))\n    assert t.dst() == timedelta(microseconds=-81), ('assertEqual', t.dst(), timedelta(microseconds=-81))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_aware_compare" {
    (ok, detail) = p2_libtest_run_snippet("from operator import lt, le, gt, ge, eq, ne, truediv, floordiv, mod\nfrom datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import time\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    cls = self.theclass\n\n    class OperandDependentOffset(tzinfo):\n\n        def utcoffset(self, t):\n            if t.minute < 10:\n                return timedelta(minutes=t.minute)\n            else:\n                return timedelta(minutes=59)\n    base = cls(8, 9, 10, tzinfo=OperandDependentOffset())\n    d0 = base.replace(minute=3)\n    d1 = base.replace(minute=9)\n    d2 = base.replace(minute=11)\n    for x in (d0, d1, d2):\n        for y in (d0, d1, d2):\n            for op in (lt, le, gt, ge, eq, ne):\n                got = op(x, y)\n                expected = op(x.minute, y.minute)\n                assert got == expected, ('assertEqual', got, expected)\n    if cls is not time:\n        d0 = base.replace(minute=3, tzinfo=OperandDependentOffset())\n        d1 = base.replace(minute=9, tzinfo=OperandDependentOffset())\n        d2 = base.replace(minute=11, tzinfo=OperandDependentOffset())\n        for x in (d0, d1, d2):\n            for y in (d0, d1, d2):\n                got = (x > y) - (x < y)\n                if (x is d0 or x is d1) and (y is d0 or y is d1):\n                    expected = 0\n                elif x is y is d2:\n                    expected = 0\n                elif x is d2:\n                    expected = -1\n                else:\n                    assert y is d2\n                    expected = 1\n                assert got == expected, ('assertEqual', got, expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_ordinal_conversions" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import MINYEAR, MAXYEAR\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    for y, m, d, n in [(1, 1, 1, 1), (1, 12, 31, 365), (2, 1, 1, 366), (1945, 11, 12, 710347)]:\n        d = self.theclass(y, m, d)\n        assert n == d.toordinal(), ('assertEqual', n, d.toordinal())\n        fromord = self.theclass.fromordinal(n)\n        assert d == fromord, ('assertEqual', d, fromord)\n        if hasattr(fromord, 'hour'):\n            assert fromord.hour == 0, ('assertEqual', fromord.hour, 0)\n            assert fromord.minute == 0, ('assertEqual', fromord.minute, 0)\n            assert fromord.second == 0, ('assertEqual', fromord.second, 0)\n            assert fromord.microsecond == 0, ('assertEqual', fromord.microsecond, 0)\n    for year in range(MINYEAR, MAXYEAR + 1, 7):\n        d = self.theclass(year, 1, 1)\n        n = d.toordinal()\n        d2 = self.theclass.fromordinal(n)\n        assert d == d2, ('assertEqual', d, d2)\n        if year > 1:\n            d = self.theclass.fromordinal(n - 1)\n            d2 = self.theclass(year - 1, 12, 31)\n            assert d == d2, ('assertEqual', d, d2)\n            assert d2.toordinal() == n - 1, ('assertEqual', d2.toordinal(), n - 1)\n    dim = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n    for year, isleap in ((2000, True), (2002, False)):\n        n = self.theclass(year, 1, 1).toordinal()\n        for month, maxday in zip(range(1, 13), dim):\n            if month == 2 and isleap:\n                maxday += 1\n            for day in range(1, maxday + 1):\n                d = self.theclass(year, month, day)\n                assert d.toordinal() == n, ('assertEqual', d.toordinal(), n)\n                assert d == self.theclass.fromordinal(n), ('assertEqual', d, self.theclass.fromordinal(n))\n                n += 1\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_extreme_ordinals" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    a = self.theclass.min\n    a = self.theclass(a.year, a.month, a.day)\n    aord = a.toordinal()\n    b = a.fromordinal(aord)\n    assert a == b, ('assertEqual', a, b)\n    try:\n        (lambda: a.fromordinal(aord - 1))()\n    except ValueError:\n        pass\n    b = a + timedelta(days=1)\n    assert b.toordinal() == aord + 1, ('assertEqual', b.toordinal(), aord + 1)\n    assert b == self.theclass.fromordinal(aord + 1), ('assertEqual', b, self.theclass.fromordinal(aord + 1))\n    a = self.theclass.max\n    a = self.theclass(a.year, a.month, a.day)\n    aord = a.toordinal()\n    b = a.fromordinal(aord)\n    assert a == b, ('assertEqual', a, b)\n    try:\n        (lambda: a.fromordinal(aord + 1))()\n    except ValueError:\n        pass\n    b = a - timedelta(days=1)\n    assert b.toordinal() == aord - 1, ('assertEqual', b.toordinal(), aord - 1)\n    assert b == self.theclass.fromordinal(aord - 1), ('assertEqual', b, self.theclass.fromordinal(aord - 1))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_overflow" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    tiny = self.theclass.resolution\n    for delta in [tiny, timedelta(1), timedelta(2)]:\n        dt = self.theclass.min + delta\n        dt -= delta\n        try:\n            dt.__sub__(*(delta,))\n        except OverflowError:\n            pass\n        try:\n            dt.__add__(*(-delta,))\n        except OverflowError:\n            pass\n        dt = self.theclass.max - delta\n        dt += delta\n        try:\n            dt.__add__(*(delta,))\n        except OverflowError:\n            pass\n        try:\n            dt.__sub__(*(-delta,))\n        except OverflowError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

