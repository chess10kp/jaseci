test "TestSubclassDateTime.test_compare" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\nOTHERSTUFF = (10, 34.5, 'abc', {}, [], ())\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    t1 = self.theclass(2, 3, 4)\n    t2 = self.theclass(2, 3, 4)\n    assert t1 == t2, ('assertEqual', t1, t2)\n    assert t1 <= t2, ('assertTrue', t1 <= t2)\n    assert t1 >= t2, ('assertTrue', t1 >= t2)\n    assert not t1 != t2, ('assertFalse', t1 != t2)\n    assert not t1 < t2, ('assertFalse', t1 < t2)\n    assert not t1 > t2, ('assertFalse', t1 > t2)\n    for args in ((3, 3, 3), (2, 4, 4), (2, 3, 5)):\n        t2 = self.theclass(*args)\n        assert t1 < t2, ('assertTrue', t1 < t2)\n        assert t2 > t1, ('assertTrue', t2 > t1)\n        assert t1 <= t2, ('assertTrue', t1 <= t2)\n        assert t2 >= t1, ('assertTrue', t2 >= t1)\n        assert t1 != t2, ('assertTrue', t1 != t2)\n        assert t2 != t1, ('assertTrue', t2 != t1)\n        assert not t1 == t2, ('assertFalse', t1 == t2)\n        assert not t2 == t1, ('assertFalse', t2 == t1)\n        assert not t1 > t2, ('assertFalse', t1 > t2)\n        assert not t2 < t1, ('assertFalse', t2 < t1)\n        assert not t1 >= t2, ('assertFalse', t1 >= t2)\n        assert not t2 <= t1, ('assertFalse', t2 <= t1)\n    for badarg in OTHERSTUFF:\n        assert (t1 == badarg) == False, ('assertEqual', (t1 == badarg), False)\n        assert (t1 != badarg) == True, ('assertEqual', (t1 != badarg), True)\n        assert (badarg == t1) == False, ('assertEqual', (badarg == t1), False)\n        assert (badarg != t1) == True, ('assertEqual', (badarg != t1), True)\n        try:\n            (lambda: t1 < badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: t1 > badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: t1 >= badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg <= t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg < t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg > t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg >= t1)()\n        except TypeError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_compare" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\nOTHERSTUFF = (10, 34.5, 'abc', {}, [], ())\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    t1 = self.theclass(2, 3, 4)\n    t2 = self.theclass(2, 3, 4)\n    assert t1 == t2, ('assertEqual', t1, t2)\n    assert t1 <= t2, ('assertTrue', t1 <= t2)\n    assert t1 >= t2, ('assertTrue', t1 >= t2)\n    assert not t1 != t2, ('assertFalse', t1 != t2)\n    assert not t1 < t2, ('assertFalse', t1 < t2)\n    assert not t1 > t2, ('assertFalse', t1 > t2)\n    for args in ((3, 3, 3), (2, 4, 4), (2, 3, 5)):\n        t2 = self.theclass(*args)\n        assert t1 < t2, ('assertTrue', t1 < t2)\n        assert t2 > t1, ('assertTrue', t2 > t1)\n        assert t1 <= t2, ('assertTrue', t1 <= t2)\n        assert t2 >= t1, ('assertTrue', t2 >= t1)\n        assert t1 != t2, ('assertTrue', t1 != t2)\n        assert t2 != t1, ('assertTrue', t2 != t1)\n        assert not t1 == t2, ('assertFalse', t1 == t2)\n        assert not t2 == t1, ('assertFalse', t2 == t1)\n        assert not t1 > t2, ('assertFalse', t1 > t2)\n        assert not t2 < t1, ('assertFalse', t2 < t1)\n        assert not t1 >= t2, ('assertFalse', t1 >= t2)\n        assert not t2 <= t1, ('assertFalse', t2 <= t1)\n    for badarg in OTHERSTUFF:\n        assert (t1 == badarg) == False, ('assertEqual', (t1 == badarg), False)\n        assert (t1 != badarg) == True, ('assertEqual', (t1 != badarg), True)\n        assert (badarg == t1) == False, ('assertEqual', (badarg == t1), False)\n        assert (badarg != t1) == True, ('assertEqual', (badarg != t1), True)\n        try:\n            (lambda: t1 < badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: t1 > badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: t1 >= badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg <= t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg < t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg > t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg >= t1)()\n        except TypeError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSubclassDateTime.test_mixed_compare" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    our = self.theclass(2000, 4, 5)\n    assert (our == 1) == False, ('assertEqual', (our == 1), False)\n    assert (1 == our) == False, ('assertEqual', (1 == our), False)\n    assert (our != 1) == True, ('assertEqual', (our != 1), True)\n    assert (1 != our) == True, ('assertEqual', (1 != our), True)\n    try:\n        (lambda: our < 1)()\n    except TypeError:\n        pass\n    try:\n        (lambda: 1 < our)()\n    except TypeError:\n        pass\n\n    class SomeClass:\n        pass\n    their = SomeClass()\n    assert (our == their) == False, ('assertEqual', (our == their), False)\n    assert (their == our) == False, ('assertEqual', (their == our), False)\n    assert (our != their) == True, ('assertEqual', (our != their), True)\n    assert (their != our) == True, ('assertEqual', (their != our), True)\n    try:\n        (lambda: our < their)()\n    except TypeError:\n        pass\n    try:\n        (lambda: their < our)()\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

