test "TestSubclassDateTime.test_ordinal_conversions" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import MINYEAR, MAXYEAR\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    for y, m, d, n in [(1, 1, 1, 1), (1, 12, 31, 365), (2, 1, 1, 366), (1945, 11, 12, 710347)]:\n        d = self.theclass(y, m, d)\n        assert n == d.toordinal(), ('assertEqual', n, d.toordinal())\n        fromord = self.theclass.fromordinal(n)\n        assert d == fromord, ('assertEqual', d, fromord)\n        if hasattr(fromord, 'hour'):\n            assert fromord.hour == 0, ('assertEqual', fromord.hour, 0)\n            assert fromord.minute == 0, ('assertEqual', fromord.minute, 0)\n            assert fromord.second == 0, ('assertEqual', fromord.second, 0)\n            assert fromord.microsecond == 0, ('assertEqual', fromord.microsecond, 0)\n    for year in range(MINYEAR, MAXYEAR + 1, 7):\n        d = self.theclass(year, 1, 1)\n        n = d.toordinal()\n        d2 = self.theclass.fromordinal(n)\n        assert d == d2, ('assertEqual', d, d2)\n        if year > 1:\n            d = self.theclass.fromordinal(n - 1)\n            d2 = self.theclass(year - 1, 12, 31)\n            assert d == d2, ('assertEqual', d, d2)\n            assert d2.toordinal() == n - 1, ('assertEqual', d2.toordinal(), n - 1)\n    dim = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n    for year, isleap in ((2000, True), (2002, False)):\n        n = self.theclass(year, 1, 1).toordinal()\n        for month, maxday in zip(range(1, 13), dim):\n            if month == 2 and isleap:\n                maxday += 1\n            for day in range(1, maxday + 1):\n                d = self.theclass(year, month, day)\n                assert d.toordinal() == n, ('assertEqual', d.toordinal(), n)\n                assert d == self.theclass.fromordinal(n), ('assertEqual', d, self.theclass.fromordinal(n))\n                n += 1\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

