test "TestSubclassDateTime.test_strftime_special" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    t = self.theclass(2004, 12, 31, 6, 22, 33, 47)\n    s1 = t.strftime('%c')\n    s2 = t.strftime('%B')\n    assert t.strftime('\ud83d\udc0d') == '\ud83d\udc0d', ('assertEqual', t.strftime('\ud83d\udc0d'), '\ud83d\udc0d')\n    assert t.strftime('\ud83d\udcbb%c\ud83d\udc0d%B') == f'\ud83d\udcbb{s1}\ud83d\udc0d{s2}', ('assertEqual', t.strftime('\ud83d\udcbb%c\ud83d\udc0d%B'), f'\ud83d\udcbb{s1}\ud83d\udc0d{s2}')\n    assert t.strftime('%c\ud83d\udcbb%B\ud83d\udc0d') == f'{s1}\ud83d\udcbb{s2}\ud83d\udc0d', ('assertEqual', t.strftime('%c\ud83d\udcbb%B\ud83d\udc0d'), f'{s1}\ud83d\udcbb{s2}\ud83d\udc0d')\n    assert t.strftime('\\ud83d') == '\\ud83d', ('assertEqual', t.strftime('\\ud83d'), '\\ud83d')\n    assert t.strftime('\\udc0d') == '\\udc0d', ('assertEqual', t.strftime('\\udc0d'), '\\udc0d')\n    assert t.strftime('\\ud83d%c\\udc0d%B') == f'\\ud83d{s1}\\udc0d{s2}', ('assertEqual', t.strftime('\\ud83d%c\\udc0d%B'), f'\\ud83d{s1}\\udc0d{s2}')\n    assert t.strftime('%c\\ud83d%B\\udc0d') == f'{s1}\\ud83d{s2}\\udc0d', ('assertEqual', t.strftime('%c\\ud83d%B\\udc0d'), f'{s1}\\ud83d{s2}\\udc0d')\n    assert t.strftime('%c\\udc0d%B\\ud83d') == f'{s1}\\udc0d{s2}\\ud83d', ('assertEqual', t.strftime('%c\\udc0d%B\\ud83d'), f'{s1}\\udc0d{s2}\\ud83d')\n    assert t.strftime('\\ud83d\\udc0d') == '\\ud83d\\udc0d', ('assertEqual', t.strftime('\\ud83d\\udc0d'), '\\ud83d\\udc0d')\n    assert t.strftime('%c\\ud83d\\udc0d%B') == f'{s1}\\ud83d\\udc0d{s2}', ('assertEqual', t.strftime('%c\\ud83d\\udc0d%B'), f'{s1}\\ud83d\\udc0d{s2}')\n    assert t.strftime('\\udcf0\\udc9f\\udc90\\udc8d') == '\\udcf0\\udc9f\\udc90\\udc8d', ('assertEqual', t.strftime('\\udcf0\\udc9f\\udc90\\udc8d'), '\\udcf0\\udc9f\\udc90\\udc8d')\n    assert t.strftime('%c\\udcf0\\udc9f\\udc90\\udc8d%B') == f'{s1}\\udcf0\\udc9f\\udc90\\udc8d{s2}', ('assertEqual', t.strftime('%c\\udcf0\\udc9f\\udc90\\udc8d%B'), f'{s1}\\udcf0\\udc9f\\udc90\\udc8d{s2}')\n    assert t.strftime('\\x00') == '\\x00', ('assertEqual', t.strftime('\\x00'), '\\x00')\n    assert t.strftime('\\x00' * 1000) == '\\x00' * 1000, ('assertEqual', t.strftime('\\x00' * 1000), '\\x00' * 1000)\n    assert t.strftime('\\x00%c\\x00%B') == f'\\x00{s1}\\x00{s2}', ('assertEqual', t.strftime('\\x00%c\\x00%B'), f'\\x00{s1}\\x00{s2}')\n    assert t.strftime('%c\\x00%B\\x00') == f'{s1}\\x00{s2}\\x00', ('assertEqual', t.strftime('%c\\x00%B\\x00'), f'{s1}\\x00{s2}\\x00')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
