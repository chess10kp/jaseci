test "TestDateTimeTZ.test_pickling_subclass_datetime" {
    (ok, detail) = p2_libtest_run_snippet("import pickle\nfrom datetime import date, datetime\npickle_choices = [(pickle, pickle, proto) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n    args = (6, 7, 23, 20, 59, 1, 64 ** 2)\n    orig = SubclassDatetime(*args)\n    for pickler, unpickler, proto in pickle_choices:\n        green = pickler.dumps(orig, proto)\n        derived = unpickler.loads(green)\n        assert orig == derived, ('assertEqual', orig, derived)\n        assert isinstance(derived, SubclassDatetime), ('assertTrue', isinstance(derived, SubclassDatetime))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_more_compare" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    args = [2000, 11, 29, 20, 58, 16, 999998]\n    t1 = self.theclass(*args)\n    t2 = self.theclass(*args)\n    assert t1 == t2, ('assertEqual', t1, t2)\n    assert t1 <= t2, ('assertTrue', t1 <= t2)\n    assert t1 >= t2, ('assertTrue', t1 >= t2)\n    assert not t1 != t2, ('assertFalse', t1 != t2)\n    assert not t1 < t2, ('assertFalse', t1 < t2)\n    assert not t1 > t2, ('assertFalse', t1 > t2)\n    for i in range(len(args)):\n        newargs = args[:]\n        newargs[i] = args[i] + 1\n        t2 = self.theclass(*newargs)\n        assert t1 < t2, ('assertTrue', t1 < t2)\n        assert t2 > t1, ('assertTrue', t2 > t1)\n        assert t1 <= t2, ('assertTrue', t1 <= t2)\n        assert t2 >= t1, ('assertTrue', t2 >= t1)\n        assert t1 != t2, ('assertTrue', t1 != t2)\n        assert t2 != t1, ('assertTrue', t2 != t1)\n        assert not t1 == t2, ('assertFalse', t1 == t2)\n        assert not t2 == t1, ('assertFalse', t2 == t1)\n        assert not t1 > t2, ('assertFalse', t1 > t2)\n        assert not t2 < t1, ('assertFalse', t2 < t1)\n        assert not t1 >= t2, ('assertFalse', t1 >= t2)\n        assert not t2 <= t1, ('assertFalse', t2 <= t1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

