    (ok, detail) = p2_libtest_run_snippet("from datetime import MINYEAR, MAXYEAR\nfrom datetime import timedelta\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    dt1 = self.theclass(2002, 3, 1, 9, 0, 0)\n    dt2 = self.theclass(2002, 3, 1, 10, 0, 0)\n    dt3 = self.theclass(2002, 3, 1, 9, 0, 0)\n    assert dt1 == dt3, ('assertEqual', dt1, dt3)\n    assert dt2 > dt3, ('assertTrue', dt2 > dt3)\n    dt1 = self.theclass(MAXYEAR, 12, 31, 23, 59, 59, 999998)\n    us = timedelta(microseconds=1)\n    dt2 = dt1 + us\n    assert dt2 - dt1 == us, ('assertEqual', dt2 - dt1, us)\n    assert dt1 < dt2, ('assertTrue', dt1 < dt2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
