test "TestSubclassDateTime.test_backdoor_resistance" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    base = b'1995-03-25'\n    if not issubclass(self.theclass, datetime):\n        base = base[:4]\n    for month_byte in (b'9', b'\\x00', b'\\r', b'\\xff'):\n        try:\n            self.theclass(*(base[:2] + month_byte + base[3:],))\n        except TypeError:\n            pass\n    if issubclass(self.theclass, datetime):\n        try:\n            self.theclass(bytes([1] * len(base)), 'EST')\n        except TypeError as _exc:\n            assert _re.search('^bad tzinfo state arg$', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n    for ord_byte in range(1, 13):\n        self.theclass(base[:2] + bytes([ord_byte]) + base[3:])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

