test "TestSubclassDateTime.test_resolution_info" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    if issubclass(self.theclass, datetime):\n        expected_class = datetime\n    else:\n        expected_class = date\n    assert isinstance(self.theclass.min, expected_class), ('assertIsInstance', self.theclass.min, expected_class)\n    assert isinstance(self.theclass.max, expected_class), ('assertIsInstance', self.theclass.max, expected_class)\n    assert isinstance(self.theclass.resolution, timedelta), ('assertIsInstance', self.theclass.resolution, timedelta)\n    assert self.theclass.max > self.theclass.min, ('assertTrue', self.theclass.max > self.theclass.min)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
