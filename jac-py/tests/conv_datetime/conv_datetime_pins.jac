}

test "TestDateTimeTZ.test_computations" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    a = self.theclass(2002, 1, 31)\n    b = self.theclass(1956, 1, 31)\n    diff = a - b\n    assert diff.days == 46 * 365 + len(range(1956, 2002, 4)), ('assertEqual', diff.days, 46 * 365 + len(range(1956, 2002, 4)))\n    assert diff.seconds == 0, ('assertEqual', diff.seconds, 0)\n    assert diff.microseconds == 0, ('assertEqual', diff.microseconds, 0)\n    a = self.theclass(2002, 3, 2, 17, 6)\n    millisec = timedelta(0, 0, 1000)\n    hour = timedelta(0, 3600)\n    day = timedelta(1)\n    week = timedelta(7)\n    assert a + hour == self.theclass(2002, 3, 2, 18, 6), ('assertEqual', a + hour, self.theclass(2002, 3, 2, 18, 6))\n    assert hour + a == self.theclass(2002, 3, 2, 18, 6), ('assertEqual', hour + a, self.theclass(2002, 3, 2, 18, 6))\n    assert a + 10 * hour == self.theclass(2002, 3, 3, 3, 6), ('assertEqual', a + 10 * hour, self.theclass(2002, 3, 3, 3, 6))\n    assert a - hour == self.theclass(2002, 3, 2, 16, 6), ('assertEqual', a - hour, self.theclass(2002, 3, 2, 16, 6))\n    assert -hour + a == self.theclass(2002, 3, 2, 16, 6), ('assertEqual', -hour + a, self.theclass(2002, 3, 2, 16, 6))\n    assert a - hour == a + -hour, ('assertEqual', a - hour, a + -hour)\n    assert a - 20 * hour == self.theclass(2002, 3, 1, 21, 6), ('assertEqual', a - 20 * hour, self.theclass(2002, 3, 1, 21, 6))\n    assert a + day == self.theclass(2002, 3, 3, 17, 6), ('assertEqual', a + day, self.theclass(2002, 3, 3, 17, 6))\n    assert a - day == self.theclass(2002, 3, 1, 17, 6), ('assertEqual', a - day, self.theclass(2002, 3, 1, 17, 6))\n    assert a + week == self.theclass(2002, 3, 9, 17, 6), ('assertEqual', a + week, self.theclass(2002, 3, 9, 17, 6))\n    assert a - week == self.theclass(2002, 2, 23, 17, 6), ('assertEqual', a - week, self.theclass(2002, 2, 23, 17, 6))\n    assert a + 52 * week == self.theclass(2003, 3, 1, 17, 6), ('assertEqual', a + 52 * week, self.theclass(2003, 3, 1, 17, 6))\n    assert a - 52 * week == self.theclass(2001, 3, 3, 17, 6), ('assertEqual', a - 52 * week, self.theclass(2001, 3, 3, 17, 6))\n    assert a + week - a == week, ('assertEqual', a + week - a, week)\n    assert a + day - a == day, ('assertEqual', a + day - a, day)\n    assert a + hour - a == hour, ('assertEqual', a + hour - a, hour)\n    assert a + millisec - a == millisec, ('assertEqual', a + millisec - a, millisec)\n    assert a - week - a == -week, ('assertEqual', a - week - a, -week)\n    assert a - day - a == -day, ('assertEqual', a - day - a, -day)\n    assert a - hour - a == -hour, ('assertEqual', a - hour - a, -hour)\n    assert a - millisec - a == -millisec, ('assertEqual', a - millisec - a, -millisec)\n    assert a - (a + week) == -week, ('assertEqual', a - (a + week), -week)\n    assert a - (a + day) == -day, ('assertEqual', a - (a + day), -day)\n    assert a - (a + hour) == -hour, ('assertEqual', a - (a + hour), -hour)\n    assert a - (a + millisec) == -millisec, ('assertEqual', a - (a + millisec), -millisec)\n    assert a - (a - week) == week, ('assertEqual', a - (a - week), week)\n    assert a - (a - day) == day, ('assertEqual', a - (a - day), day)\n    assert a - (a - hour) == hour, ('assertEqual', a - (a - hour), hour)\n    assert a - (a - millisec) == millisec, ('assertEqual', a - (a - millisec), millisec)\n    assert a + (week + day + hour + millisec) == self.theclass(2002, 3, 10, 18, 6, 0, 1000), ('assertEqual', a + (week + day + hour + millisec), self.theclass(2002, 3, 10, 18, 6, 0, 1000))\n    assert a + (week + day + hour + millisec) == a + week + day + hour + millisec, ('assertEqual', a + (week + day + hour + millisec), a + week + day + hour + millisec)\n    assert a - (week + day + hour + millisec) == self.theclass(2002, 2, 22, 16, 5, 59, 999000), ('assertEqual', a - (week + day + hour + millisec), self.theclass(2002, 2, 22, 16, 5, 59, 999000))\n    assert a - (week + day + hour + millisec) == a - week - day - hour - millisec, ('assertEqual', a - (week + day + hour + millisec), a - week - day - hour - millisec)\n    for i in (1, 1.0):\n        try:\n            (lambda: a + i)()\n        except TypeError:\n            pass\n        try:\n            (lambda: a - i)()\n        except TypeError:\n            pass\n        try:\n            (lambda: i + a)()\n        except TypeError:\n            pass\n        try:\n            (lambda: i - a)()\n        except TypeError:\n            pass\n    try:\n        (lambda: day - a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: day * a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a * day)()\n    except TypeError:\n        pass\n    try:\n        (lambda: day // a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a // day)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a * a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a // a)()\n    except TypeError:\n        pass\n    try:\n        (lambda: a + a)()\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_more_pickling" {
