test "TestTimeTZ.test_hash_equality" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import time\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = time\n    _SelfNS.theclass = time\n    d = self.theclass(23, 30, 17)\n    e = self.theclass(23, 30, 17)\n    assert d == e, ('assertEqual', d, e)\n    assert hash(d) == hash(e), ('assertEqual', hash(d), hash(e))\n    dic = {d: 1}\n    dic[e] = 2\n    assert len(dic) == 1, ('assertEqual', len(dic), 1)\n    assert dic[d] == 2, ('assertEqual', dic[d], 2)\n    assert dic[e] == 2, ('assertEqual', dic[e], 2)\n    d = self.theclass(0, 5, 17)\n    e = self.theclass(0, 5, 17)\n    assert d == e, ('assertEqual', d, e)\n    assert hash(d) == hash(e), ('assertEqual', hash(d), hash(e))\n    dic = {d: 1}\n    dic[e] = 2\n    assert len(dic) == 1, ('assertEqual', len(dic), 1)\n    assert dic[d] == 2, ('assertEqual', dic[d], 2)\n    assert dic[e] == 2, ('assertEqual', dic[e], 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestTimeTZ.test_isoformat" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import time\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = time\n    _SelfNS.theclass = time\n    t = self.theclass(4, 5, 1, 123)\n    assert t.isoformat() == '04:05:01.000123', ('assertEqual', t.isoformat(), '04:05:01.000123')\n    assert t.isoformat() == str(t), ('assertEqual', t.isoformat(), str(t))\n    t = self.theclass()\n    assert t.isoformat() == '00:00:00', ('assertEqual', t.isoformat(), '00:00:00')\n    assert t.isoformat() == str(t), ('assertEqual', t.isoformat(), str(t))\n    t = self.theclass(microsecond=1)\n    assert t.isoformat() == '00:00:00.000001', ('assertEqual', t.isoformat(), '00:00:00.000001')\n    assert t.isoformat() == str(t), ('assertEqual', t.isoformat(), str(t))\n    t = self.theclass(microsecond=10)\n    assert t.isoformat() == '00:00:00.000010', ('assertEqual', t.isoformat(), '00:00:00.000010')\n    assert t.isoformat() == str(t), ('assertEqual', t.isoformat(), str(t))\n    t = self.theclass(microsecond=100)\n    assert t.isoformat() == '00:00:00.000100', ('assertEqual', t.isoformat(), '00:00:00.000100')\n    assert t.isoformat() == str(t), ('assertEqual', t.isoformat(), str(t))\n    t = self.theclass(microsecond=1000)\n    assert t.isoformat() == '00:00:00.001000', ('assertEqual', t.isoformat(), '00:00:00.001000')\n    assert t.isoformat() == str(t), ('assertEqual', t.isoformat(), str(t))\n    t = self.theclass(microsecond=10000)\n    assert t.isoformat() == '00:00:00.010000', ('assertEqual', t.isoformat(), '00:00:00.010000')\n    assert t.isoformat() == str(t), ('assertEqual', t.isoformat(), str(t))\n    t = self.theclass(microsecond=100000)\n    assert t.isoformat() == '00:00:00.100000', ('assertEqual', t.isoformat(), '00:00:00.100000')\n    assert t.isoformat() == str(t), ('assertEqual', t.isoformat(), str(t))\n    t = self.theclass(hour=12, minute=34, second=56, microsecond=123456)\n    assert t.isoformat(timespec='hours') == '12', ('assertEqual', t.isoformat(timespec='hours'), '12')\n    assert t.isoformat(timespec='minutes') == '12:34', ('assertEqual', t.isoformat(timespec='minutes'), '12:34')\n    assert t.isoformat(timespec='seconds') == '12:34:56', ('assertEqual', t.isoformat(timespec='seconds'), '12:34:56')\n    assert t.isoformat(timespec='milliseconds') == '12:34:56.123', ('assertEqual', t.isoformat(timespec='milliseconds'), '12:34:56.123')\n    assert t.isoformat(timespec='microseconds') == '12:34:56.123456', ('assertEqual', t.isoformat(timespec='microseconds'), '12:34:56.123456')\n    assert t.isoformat(timespec='auto') == '12:34:56.123456', ('assertEqual', t.isoformat(timespec='auto'), '12:34:56.123456')\n    try:\n        t.isoformat(timespec='monkey')\n    except ValueError:\n        pass\n    try:\n        t.isoformat(timespec='\\ud800')\n    except ValueError:\n        pass\n    t = self.theclass(hour=12, minute=34, second=56, microsecond=999500)\n    assert t.isoformat(timespec='milliseconds') == '12:34:56.999', ('assertEqual', t.isoformat(timespec='milliseconds'), '12:34:56.999')\n    t = self.theclass(hour=12, minute=34, second=56, microsecond=0)\n    assert t.isoformat(timespec='milliseconds') == '12:34:56.000', ('assertEqual', t.isoformat(timespec='milliseconds'), '12:34:56.000')\n    assert t.isoformat(timespec='microseconds') == '12:34:56.000000', ('assertEqual', t.isoformat(timespec='microseconds'), '12:34:56.000000')\n    assert t.isoformat(timespec='auto') == '12:34:56', ('assertEqual', t.isoformat(timespec='auto'), '12:34:56')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestTimeTZ.test_isoformat_timezone" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import time\nfrom datetime import timezone\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = time\n    _SelfNS.theclass = time\n    tzoffsets = [('05:00', timedelta(hours=5)), ('02:00', timedelta(hours=2)), ('06:27', timedelta(hours=6, minutes=27)), ('12:32:30', timedelta(hours=12, minutes=32, seconds=30)), ('02:04:09.123456', timedelta(hours=2, minutes=4, seconds=9, microseconds=123456))]\n    tzinfos = [('', None), ('+00:00', timezone.utc), ('+00:00', timezone(timedelta(0)))]\n    tzinfos += [(prefix + expected, timezone(sign * td)) for expected, td in tzoffsets for prefix, sign in [('-', -1), ('+', 1)]]\n    t_base = self.theclass(12, 37, 9)\n    exp_base = '12:37:09'\n    for exp_tz, tzi in tzinfos:\n        t = t_base.replace(tzinfo=tzi)\n        exp = exp_base + exp_tz\n        assert t.isoformat() == exp\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

