test "TestSubclassDateTime.test_more_timetuple" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    t = self.theclass(2004, 12, 31, 6, 22, 33)\n    assert t.timetuple() == (2004, 12, 31, 6, 22, 33, 4, 366, -1), ('assertEqual', t.timetuple(), (2004, 12, 31, 6, 22, 33, 4, 366, -1))\n    assert t.timetuple() == (t.year, t.month, t.day, t.hour, t.minute, t.second, t.weekday(), t.toordinal() - date(t.year, 1, 1).toordinal() + 1, -1), ('assertEqual', t.timetuple(), (t.year, t.month, t.day, t.hour, t.minute, t.second, t.weekday(), t.toordinal() - date(t.year, 1, 1).toordinal() + 1, -1))\n    tt = t.timetuple()\n    assert tt.tm_year == t.year, ('assertEqual', tt.tm_year, t.year)\n    assert tt.tm_mon == t.month, ('assertEqual', tt.tm_mon, t.month)\n    assert tt.tm_mday == t.day, ('assertEqual', tt.tm_mday, t.day)\n    assert tt.tm_hour == t.hour, ('assertEqual', tt.tm_hour, t.hour)\n    assert tt.tm_min == t.minute, ('assertEqual', tt.tm_min, t.minute)\n    assert tt.tm_sec == t.second, ('assertEqual', tt.tm_sec, t.second)\n    assert tt.tm_wday == t.weekday(), ('assertEqual', tt.tm_wday, t.weekday())\n    assert tt.tm_yday == t.toordinal() - date(t.year, 1, 1).toordinal() + 1, ('assertEqual', tt.tm_yday, t.toordinal() - date(t.year, 1, 1).toordinal() + 1)\n    assert tt.tm_isdst == -1, ('assertEqual', tt.tm_isdst, -1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

