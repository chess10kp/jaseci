test "TestDateTimeTZ.test_timestamp_naive" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    t = self.theclass(1970, 1, 1)\n    assert t.timestamp() == 18000.0, ('assertEqual', t.timestamp(), 18000.0)\n    t = self.theclass(1970, 1, 1, 1, 2, 3, 4)\n    assert t.timestamp() == 18000.0 + 3600 + 2 * 60 + 3 + 4 * 1e-06, ('assertEqual', t.timestamp(), 18000.0 + 3600 + 2 * 60 + 3 + 4 * 1e-06)\n    t0 = self.theclass(2012, 3, 11, 2, 30)\n    t1 = t0.replace(fold=1)\n    assert self.theclass.fromtimestamp(t1.timestamp()) == t0 - timedelta(hours=1), ('assertEqual', self.theclass.fromtimestamp(t1.timestamp()), t0 - timedelta(hours=1))\n    assert self.theclass.fromtimestamp(t0.timestamp()) == t1 + timedelta(hours=1), ('assertEqual', self.theclass.fromtimestamp(t0.timestamp()), t1 + timedelta(hours=1))\n    t = self.theclass(2012, 11, 4, 1, 30)\n    assert self.theclass.fromtimestamp(t.timestamp()) == t, ('assertEqual', self.theclass.fromtimestamp(t.timestamp()), t)\n    for t in [self.theclass(2, 1, 1), self.theclass(9998, 12, 12)]:\n        try:\n            s = t.timestamp()\n        except OverflowError:\n            pass\n        else:\n            assert self.theclass.fromtimestamp(s) == t, ('assertEqual', self.theclass.fromtimestamp(s), t)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
