test "TestTimeTZ.test_comparing" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import time\nOTHERSTUFF = (10, 34.5, 'abc', {}, [], ())\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = time\n    _SelfNS.theclass = time\n    args = [1, 2, 3, 4]\n    t1 = self.theclass(*args)\n    t2 = self.theclass(*args)\n    assert t1 == t2, ('assertEqual', t1, t2)\n    assert t1 <= t2, ('assertTrue', t1 <= t2)\n    assert t1 >= t2, ('assertTrue', t1 >= t2)\n    assert not t1 != t2, ('assertFalse', t1 != t2)\n    assert not t1 < t2, ('assertFalse', t1 < t2)\n    assert not t1 > t2, ('assertFalse', t1 > t2)\n    for i in range(len(args)):\n        newargs = args[:]\n        newargs[i] = args[i] + 1\n        t2 = self.theclass(*newargs)\n        assert t1 < t2, ('assertTrue', t1 < t2)\n        assert t2 > t1, ('assertTrue', t2 > t1)\n        assert t1 <= t2, ('assertTrue', t1 <= t2)\n        assert t2 >= t1, ('assertTrue', t2 >= t1)\n        assert t1 != t2, ('assertTrue', t1 != t2)\n        assert t2 != t1, ('assertTrue', t2 != t1)\n        assert not t1 == t2, ('assertFalse', t1 == t2)\n        assert not t2 == t1, ('assertFalse', t2 == t1)\n        assert not t1 > t2, ('assertFalse', t1 > t2)\n        assert not t2 < t1, ('assertFalse', t2 < t1)\n        assert not t1 >= t2, ('assertFalse', t1 >= t2)\n        assert not t2 <= t1, ('assertFalse', t2 <= t1)\n    for badarg in OTHERSTUFF:\n        assert (t1 == badarg) == False, ('assertEqual', (t1 == badarg), False)\n        assert (t1 != badarg) == True, ('assertEqual', (t1 != badarg), True)\n        assert (badarg == t1) == False, ('assertEqual', (badarg == t1), False)\n        assert (badarg != t1) == True, ('assertEqual', (badarg != t1), True)\n        try:\n            (lambda: t1 <= badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: t1 < badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: t1 > badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: t1 >= badarg)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg <= t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg < t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg > t1)()\n        except TypeError:\n            pass\n        try:\n            (lambda: badarg >= t1)()\n        except TypeError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

