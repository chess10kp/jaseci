test "TestDateTimeTZ.test_even_more_compare" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import MINYEAR, MAXYEAR\nfrom datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    t1 = self.theclass(1, 1, 1, tzinfo=FixedOffset(1439, ''))\n    t2 = self.theclass(MAXYEAR, 12, 31, 23, 59, 59, 999999, tzinfo=FixedOffset(-1439, ''))\n    assert t1 < t2, ('assertTrue', t1 < t2)\n    assert t1 != t2, ('assertTrue', t1 != t2)\n    assert t2 > t1, ('assertTrue', t2 > t1)\n    assert t1 == t1, ('assertEqual', t1, t1)\n    assert t2 == t2, ('assertEqual', t2, t2)\n    t1 = self.theclass(1, 12, 31, 23, 59, tzinfo=FixedOffset(1, ''))\n    t2 = self.theclass(2, 1, 1, 3, 13, tzinfo=FixedOffset(3 * 60 + 13 + 2, ''))\n    assert t1 == t2, ('assertEqual', t1, t2)\n    t1 = self.theclass(1, 12, 31, 23, 59, tzinfo=FixedOffset(0, ''))\n    assert t1 > t2, ('assertTrue', t1 > t2)\n    t1 = self.theclass(1, 12, 31, 23, 59, tzinfo=FixedOffset(2, ''))\n    assert t1 < t2, ('assertTrue', t1 < t2)\n    t1 = self.theclass(1, 12, 31, 23, 59, tzinfo=FixedOffset(1, ''), second=1)\n    assert t1 > t2, ('assertTrue', t1 > t2)\n    t1 = self.theclass(1, 12, 31, 23, 59, tzinfo=FixedOffset(1, ''), microsecond=1)\n    assert t1 > t2, ('assertTrue', t1 > t2)\n    t2 = self.theclass.min\n    assert t1 != t2, ('assertNotEqual', t1, t2)\n    assert t2 == t2, ('assertEqual', t2, t2)\n    try:\n        t1 > t2\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\n    class Naive(tzinfo):\n\n        def utcoffset(self, dt):\n            return None\n    t2 = self.theclass(5, 6, 7, tzinfo=Naive())\n    assert t1 != t2, ('assertNotEqual', t1, t2)\n    assert t2 == t2, ('assertEqual', t2, t2)\n    t1 = self.theclass(5, 6, 7)\n    assert t1 == t2, ('assertEqual', t1, t2)\n\n    class Bogus(tzinfo):\n\n        def utcoffset(self, dt):\n            return timedelta(minutes=1440)\n    t1 = self.theclass(2, 2, 2, tzinfo=Bogus())\n    t2 = self.theclass(2, 2, 2, tzinfo=FixedOffset(0, ''))\n    try:\n        (lambda: t1 == t2)()\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDateTimeTZ.test_pickling" {
    (ok, detail) = p2_libtest_run_snippet("import pickle\nfrom datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\npickle_choices = [(pickle, pickle, proto) for proto in range(pickle.HIGHEST_PROTOCOL + 1)]\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\nclass PicklableFixedOffset(FixedOffset):\n\n    def __init__(self, offset=None, name=None, dstoffset=None):\n        FixedOffset.__init__(self, offset, name, dstoffset)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    args = (6, 7, 23, 20, 59, 1, 64 ** 2)\n    orig = self.theclass(*args)\n    for pickler, unpickler, proto in pickle_choices:\n        green = pickler.dumps(orig, proto)\n        derived = unpickler.loads(green)\n        assert orig == derived, ('assertEqual', orig, derived)\n    assert orig.__reduce__() == orig.__reduce_ex__(2), ('assertEqual', orig.__reduce__(), orig.__reduce_ex__(2))\n    tinfo = PicklableFixedOffset(-300, 'cookie')\n    orig = self.theclass(*args, **{'tzinfo': tinfo})\n    derived = self.theclass(1, 1, 1, tzinfo=FixedOffset(0, '', 0))\n    for pickler, unpickler, proto in pickle_choices:\n        green = pickler.dumps(orig, proto)\n        derived = unpickler.loads(green)\n        assert orig == derived, ('assertEqual', orig, derived)\n        assert isinstance(derived.tzinfo, PicklableFixedOffset), ('assertIsInstance', derived.tzinfo, PicklableFixedOffset)\n        assert derived.utcoffset() == timedelta(minutes=-300), ('assertEqual', derived.utcoffset(), timedelta(minutes=-300))\n        assert derived.tzname() == 'cookie', ('assertEqual', derived.tzname(), 'cookie')\n    assert orig.__reduce__() == orig.__reduce_ex__(2), ('assertEqual', orig.__reduce__(), orig.__reduce_ex__(2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

