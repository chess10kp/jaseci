test "TestSubclassDateTime.test_combine" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import time\nfrom datetime import timezone\nfrom datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    d = date(2002, 3, 4)\n    t = time(18, 45, 3, 1234)\n    expected = self.theclass(2002, 3, 4, 18, 45, 3, 1234)\n    combine = self.theclass.combine\n    dt = combine(d, t)\n    assert dt == expected, ('assertEqual', dt, expected)\n    dt = combine(time=t, date=d)\n    assert dt == expected, ('assertEqual', dt, expected)\n    assert d == dt.date(), ('assertEqual', d, dt.date())\n    assert t == dt.time(), ('assertEqual', t, dt.time())\n    assert dt == combine(dt.date(), dt.time()), ('assertEqual', dt, combine(dt.date(), dt.time()))\n    try:\n        combine()\n    except TypeError:\n        pass\n    try:\n        combine(*(d,))\n    except TypeError:\n        pass\n    try:\n        combine(*(t, d))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, t, 1))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, t, 1, 2))\n    except TypeError:\n        pass\n    try:\n        combine(*('date', 'time'))\n    except TypeError:\n        pass\n    try:\n        combine(*(d, 'time'))\n    except TypeError:\n        pass\n    try:\n        combine(*('date', t))\n    except TypeError:\n        pass\n    dt = combine(d, t, timezone.utc)\n    assert dt.tzinfo is timezone.utc, ('assertIs', dt.tzinfo, timezone.utc)\n    dt = combine(d, t, tzinfo=timezone.utc)\n    assert dt.tzinfo is timezone.utc, ('assertIs', dt.tzinfo, timezone.utc)\n    t = time()\n    dt = combine(dt, t)\n    assert dt.date() == d, ('assertEqual', dt.date(), d)\n    assert dt.time() == t, ('assertEqual', dt.time(), t)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSubclassDateTime.test_astimezone" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\n\nclass FixedOffset(tzinfo):\n\n    def __init__(self, offset, name, dstoffset=42):\n        if isinstance(offset, int):\n            offset = timedelta(minutes=offset)\n        if isinstance(dstoffset, int):\n            dstoffset = timedelta(minutes=dstoffset)\n        self.__offset = offset\n        self.__name = name\n        self.__dstoffset = dstoffset\n\n    def __repr__(self):\n        return self.__name.lower()\n\n    def utcoffset(self, dt):\n        return self.__offset\n\n    def tzname(self, dt):\n        return self.__name\n\n    def dst(self, dt):\n        return self.__dstoffset\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    dt = self.theclass.now()\n    f = FixedOffset(44, '0044')\n    dt_utc = dt.replace(tzinfo=timezone(timedelta(hours=-4), 'EDT'))\n    assert dt.astimezone() == dt_utc, ('assertEqual', dt.astimezone(), dt_utc)\n    try:\n        dt.astimezone(*(f, f))\n    except TypeError:\n        pass\n    try:\n        dt.astimezone(*(dt,))\n    except TypeError:\n        pass\n    dt_f = dt.replace(tzinfo=f) + timedelta(hours=4, minutes=44)\n    assert dt.astimezone(f) == dt_f, ('assertEqual', dt.astimezone(f), dt_f)\n    assert dt.astimezone(tz=f) == dt_f, ('assertEqual', dt.astimezone(tz=f), dt_f)\n\n    class Bogus(tzinfo):\n\n        def utcoffset(self, dt):\n            return None\n\n        def dst(self, dt):\n            return timedelta(0)\n    bog = Bogus()\n    try:\n        dt.astimezone(*(bog,))\n    except ValueError:\n        pass\n    assert dt.replace(tzinfo=bog).astimezone(f) == dt_f, ('assertEqual', dt.replace(tzinfo=bog).astimezone(f), dt_f)\n\n    class AlsoBogus(tzinfo):\n\n        def utcoffset(self, dt):\n            return timedelta(0)\n\n        def dst(self, dt):\n            return None\n    alsobog = AlsoBogus()\n    try:\n        dt.astimezone(*(alsobog,))\n    except ValueError:\n        pass\n\n    class Broken(tzinfo):\n\n        def utcoffset(self, dt):\n            return 1\n\n        def dst(self, dt):\n            return 1\n    broken = Broken()\n    dt_broken = dt.replace(tzinfo=broken)\n    try:\n        dt_broken.astimezone()\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

