test "TestSubclassDateTime.test_hash_equality" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    d = self.theclass(2000, 12, 31, 23, 30, 17)\n    e = self.theclass(2000, 12, 31, 23, 30, 17)\n    assert d == e, ('assertEqual', d, e)\n    assert hash(d) == hash(e), ('assertEqual', hash(d), hash(e))\n    dic = {d: 1}\n    dic[e] = 2\n    assert len(dic) == 1, ('assertEqual', len(dic), 1)\n    assert dic[d] == 2, ('assertEqual', dic[d], 2)\n    assert dic[e] == 2, ('assertEqual', dic[e], 2)\n    d = self.theclass(2001, 1, 1, 0, 5, 17)\n    e = self.theclass(2001, 1, 1, 0, 5, 17)\n    assert d == e, ('assertEqual', d, e)\n    assert hash(d) == hash(e), ('assertEqual', hash(d), hash(e))\n    dic = {d: 1}\n    dic[e] = 2\n    assert len(dic) == 1, ('assertEqual', len(dic), 1)\n    assert dic[d] == 2, ('assertEqual', dic[d], 2)\n    assert dic[e] == 2, ('assertEqual', dic[e], 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

