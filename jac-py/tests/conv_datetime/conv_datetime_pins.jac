test "TestLocalTimeDisambiguation.test_dst" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\ndef first_sunday_on_or_after(dt):\n    days_to_go = 6 - dt.weekday()\n    if days_to_go:\n        dt += timedelta(days_to_go)\n    return dt\nZERO = timedelta(0)\nHOUR = timedelta(hours=1)\nDSTSTART = datetime(1, 4, 1, 2)\nDSTEND = datetime(1, 10, 25, 1)\n\nclass tzinfo2(tzinfo):\n\n    def fromutc(self, dt):\n        \"\"\"datetime in UTC -> datetime in local time.\"\"\"\n        if not isinstance(dt, datetime):\n            raise TypeError('fromutc() requires a datetime argument')\n        if dt.tzinfo is not self:\n            raise ValueError('dt.tzinfo is not self')\n        off0 = dt.replace(fold=0).utcoffset()\n        off1 = dt.replace(fold=1).utcoffset()\n        if off0 is None or off1 is None or dt.dst() is None:\n            raise ValueError\n        if off0 == off1:\n            ldt = dt + off0\n            off1 = ldt.utcoffset()\n            if off0 == off1:\n                return ldt\n        for off in [off0, off1]:\n            ldt = dt + off\n            if ldt.utcoffset() == off:\n                return ldt\n            ldt = ldt.replace(fold=1)\n            if ldt.utcoffset() == off:\n                return ldt\n        raise ValueError('No suitable local time found')\n\nclass USTimeZone2(tzinfo2):\n\n    def __init__(self, hours, reprname, stdname, dstname):\n        self.stdoffset = timedelta(hours=hours)\n        self.reprname = reprname\n        self.stdname = stdname\n        self.dstname = dstname\n\n    def __repr__(self):\n        return self.reprname\n\n    def tzname(self, dt):\n        if self.dst(dt):\n            return self.dstname\n        else:\n            return self.stdname\n\n    def utcoffset(self, dt):\n        return self.stdoffset + self.dst(dt)\n\n    def dst(self, dt):\n        if dt is None or dt.tzinfo is None:\n            return ZERO\n        assert dt.tzinfo is self\n        start = first_sunday_on_or_after(DSTSTART.replace(year=dt.year))\n        assert start.weekday() == 6 and start.month == 4 and (start.day <= 7)\n        end = first_sunday_on_or_after(DSTEND.replace(year=dt.year))\n        assert end.weekday() == 6 and end.month == 10 and (end.day >= 25)\n        dt = dt.replace(tzinfo=None)\n        if start + HOUR <= dt < end:\n            return HOUR\n        elif end <= dt < end + HOUR:\n            return ZERO if dt.fold else HOUR\n        elif start <= dt < start + HOUR:\n            return HOUR if dt.fold else ZERO\n        else:\n            return ZERO\nEastern2 = USTimeZone2(-5, 'Eastern2', 'EST', 'EDT')\n\ndef _t():\n    dt_summer = datetime(2002, 10, 27, 1, tzinfo=Eastern2) - timedelta.resolution\n    dt_winter = datetime(2002, 10, 27, 2, tzinfo=Eastern2)\n    assert dt_summer.dst() == HOUR, ('assertEqual', dt_summer.dst(), HOUR)\n    assert dt_winter.dst() == ZERO, ('assertEqual', dt_winter.dst(), ZERO)\n    assert dt_summer.replace(fold=1).dst() == HOUR, ('assertEqual', dt_summer.replace(fold=1).dst(), HOUR)\n    assert dt_winter.replace(fold=1).dst() == ZERO, ('assertEqual', dt_winter.replace(fold=1).dst(), ZERO)\n    for minute in [0, 30, 59]:\n        dt = datetime(2002, 10, 27, 1, minute, tzinfo=Eastern2)\n        assert dt.dst() == HOUR, ('assertEqual', dt.dst(), HOUR)\n        assert dt.replace(fold=1).dst() == ZERO, ('assertEqual', dt.replace(fold=1).dst(), ZERO)\n    for minute in [0, 30, 59]:\n        dt = datetime(2002, 4, 7, 2, minute, tzinfo=Eastern2)\n        assert dt.dst() == ZERO, ('assertEqual', dt.dst(), ZERO)\n        assert dt.replace(fold=1).dst() == HOUR, ('assertEqual', dt.replace(fold=1).dst(), HOUR)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestLocalTimeDisambiguation.test_utcoffset" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\ndef first_sunday_on_or_after(dt):\n    days_to_go = 6 - dt.weekday()\n    if days_to_go:\n        dt += timedelta(days_to_go)\n    return dt\nZERO = timedelta(0)\nHOUR = timedelta(hours=1)\nDSTSTART = datetime(1, 4, 1, 2)\nDSTEND = datetime(1, 10, 25, 1)\n\nclass tzinfo2(tzinfo):\n\n    def fromutc(self, dt):\n        \"\"\"datetime in UTC -> datetime in local time.\"\"\"\n        if not isinstance(dt, datetime):\n            raise TypeError('fromutc() requires a datetime argument')\n        if dt.tzinfo is not self:\n            raise ValueError('dt.tzinfo is not self')\n        off0 = dt.replace(fold=0).utcoffset()\n        off1 = dt.replace(fold=1).utcoffset()\n        if off0 is None or off1 is None or dt.dst() is None:\n            raise ValueError\n        if off0 == off1:\n            ldt = dt + off0\n            off1 = ldt.utcoffset()\n            if off0 == off1:\n                return ldt\n        for off in [off0, off1]:\n            ldt = dt + off\n            if ldt.utcoffset() == off:\n                return ldt\n            ldt = ldt.replace(fold=1)\n            if ldt.utcoffset() == off:\n                return ldt\n        raise ValueError('No suitable local time found')\n\nclass USTimeZone2(tzinfo2):\n\n    def __init__(self, hours, reprname, stdname, dstname):\n        self.stdoffset = timedelta(hours=hours)\n        self.reprname = reprname\n        self.stdname = stdname\n        self.dstname = dstname\n\n    def __repr__(self):\n        return self.reprname\n\n    def tzname(self, dt):\n        if self.dst(dt):\n            return self.dstname\n        else:\n            return self.stdname\n\n    def utcoffset(self, dt):\n        return self.stdoffset + self.dst(dt)\n\n    def dst(self, dt):\n        if dt is None or dt.tzinfo is None:\n            return ZERO\n        assert dt.tzinfo is self\n        start = first_sunday_on_or_after(DSTSTART.replace(year=dt.year))\n        assert start.weekday() == 6 and start.month == 4 and (start.day <= 7)\n        end = first_sunday_on_or_after(DSTEND.replace(year=dt.year))\n        assert end.weekday() == 6 and end.month == 10 and (end.day >= 25)\n        dt = dt.replace(tzinfo=None)\n        if start + HOUR <= dt < end:\n            return HOUR\n        elif end <= dt < end + HOUR:\n            return ZERO if dt.fold else HOUR\n        elif start <= dt < start + HOUR:\n            return HOUR if dt.fold else ZERO\n        else:\n            return ZERO\nEastern2 = USTimeZone2(-5, 'Eastern2', 'EST', 'EDT')\n\ndef _t():\n    dt_summer = datetime(2002, 10, 27, 1, tzinfo=Eastern2) - timedelta.resolution\n    dt_winter = datetime(2002, 10, 27, 2, tzinfo=Eastern2)\n    assert dt_summer.utcoffset() == -4 * HOUR, ('assertEqual', dt_summer.utcoffset(), -4 * HOUR)\n    assert dt_winter.utcoffset() == -5 * HOUR, ('assertEqual', dt_winter.utcoffset(), -5 * HOUR)\n    assert dt_summer.replace(fold=1).utcoffset() == -4 * HOUR, ('assertEqual', dt_summer.replace(fold=1).utcoffset(), -4 * HOUR)\n    assert dt_winter.replace(fold=1).utcoffset() == -5 * HOUR, ('assertEqual', dt_winter.replace(fold=1).utcoffset(), -5 * HOUR)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestLocalTimeDisambiguation.test_fromutc" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\ndef first_sunday_on_or_after(dt):\n    days_to_go = 6 - dt.weekday()\n    if days_to_go:\n        dt += timedelta(days_to_go)\n    return dt\nZERO = timedelta(0)\nHOUR = timedelta(hours=1)\nDSTSTART = datetime(1, 4, 1, 2)\nDSTEND = datetime(1, 10, 25, 1)\n\nclass tzinfo2(tzinfo):\n\n    def fromutc(self, dt):\n        \"\"\"datetime in UTC -> datetime in local time.\"\"\"\n        if not isinstance(dt, datetime):\n            raise TypeError('fromutc() requires a datetime argument')\n        if dt.tzinfo is not self:\n            raise ValueError('dt.tzinfo is not self')\n        off0 = dt.replace(fold=0).utcoffset()\n        off1 = dt.replace(fold=1).utcoffset()\n        if off0 is None or off1 is None or dt.dst() is None:\n            raise ValueError\n        if off0 == off1:\n            ldt = dt + off0\n            off1 = ldt.utcoffset()\n            if off0 == off1:\n                return ldt\n        for off in [off0, off1]:\n            ldt = dt + off\n            if ldt.utcoffset() == off:\n                return ldt\n            ldt = ldt.replace(fold=1)\n            if ldt.utcoffset() == off:\n                return ldt\n        raise ValueError('No suitable local time found')\n\nclass USTimeZone2(tzinfo2):\n\n    def __init__(self, hours, reprname, stdname, dstname):\n        self.stdoffset = timedelta(hours=hours)\n        self.reprname = reprname\n        self.stdname = stdname\n        self.dstname = dstname\n\n    def __repr__(self):\n        return self.reprname\n\n    def tzname(self, dt):\n        if self.dst(dt):\n            return self.dstname\n        else:\n            return self.stdname\n\n    def utcoffset(self, dt):\n        return self.stdoffset + self.dst(dt)\n\n    def dst(self, dt):\n        if dt is None or dt.tzinfo is None:\n            return ZERO\n        assert dt.tzinfo is self\n        start = first_sunday_on_or_after(DSTSTART.replace(year=dt.year))\n        assert start.weekday() == 6 and start.month == 4 and (start.day <= 7)\n        end = first_sunday_on_or_after(DSTEND.replace(year=dt.year))\n        assert end.weekday() == 6 and end.month == 10 and (end.day >= 25)\n        dt = dt.replace(tzinfo=None)\n        if start + HOUR <= dt < end:\n            return HOUR\n        elif end <= dt < end + HOUR:\n            return ZERO if dt.fold else HOUR\n        elif start <= dt < start + HOUR:\n            return HOUR if dt.fold else ZERO\n        else:\n            return ZERO\nEastern2 = USTimeZone2(-5, 'Eastern2', 'EST', 'EDT')\n\ndef _t():\n    u_summer = datetime(2002, 10, 27, 6, tzinfo=Eastern2) - timedelta.resolution\n    u_winter = datetime(2002, 10, 27, 7, tzinfo=Eastern2)\n    t_summer = Eastern2.fromutc(u_summer)\n    t_winter = Eastern2.fromutc(u_winter)\n    assert t_summer == u_summer - 4 * HOUR, ('assertEqual', t_summer, u_summer - 4 * HOUR)\n    assert t_winter == u_winter - 5 * HOUR, ('assertEqual', t_winter, u_winter - 5 * HOUR)\n    assert t_summer.fold == 0, ('assertEqual', t_summer.fold, 0)\n    assert t_winter.fold == 0, ('assertEqual', t_winter.fold, 0)\n    u = datetime(2002, 10, 27, 5, 30, tzinfo=Eastern2)\n    t0 = Eastern2.fromutc(u)\n    u += HOUR\n    t1 = Eastern2.fromutc(u)\n    assert t0 == t1, ('assertEqual', t0, t1)\n    assert t0.fold == 0, ('assertEqual', t0.fold, 0)\n    assert t1.fold == 1, ('assertEqual', t1.fold, 1)\n    u = datetime(2002, 10, 27, 1, 30, tzinfo=Eastern2)\n    t = Eastern2.fromutc(u)\n    assert (t.day, t.hour) == (26, 21), ('assertEqual', (t.day, t.hour), (26, 21))\n    u = datetime(2002, 10, 27, 6, 30, tzinfo=Eastern2)\n    t = Eastern2.fromutc(u)\n    assert (t.day, t.hour) == (27, 1), ('assertEqual', (t.day, t.hour), (27, 1))\n    u = datetime(2002, 4, 7, 2, 0, tzinfo=Eastern2)\n    t = Eastern2.fromutc(u)\n    assert (t.day, t.hour) == (6, 21), ('assertEqual', (t.day, t.hour), (6, 21))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestLocalTimeDisambiguation.test_mixed_compare_regular" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\n\ndef first_sunday_on_or_after(dt):\n    days_to_go = 6 - dt.weekday()\n    if days_to_go:\n        dt += timedelta(days_to_go)\n    return dt\nZERO = timedelta(0)\nHOUR = timedelta(hours=1)\nDSTSTART = datetime(1, 4, 1, 2)\nDSTEND = datetime(1, 10, 25, 1)\n\nclass tzinfo2(tzinfo):\n\n    def fromutc(self, dt):\n        \"\"\"datetime in UTC -> datetime in local time.\"\"\"\n        if not isinstance(dt, datetime):\n            raise TypeError('fromutc() requires a datetime argument')\n        if dt.tzinfo is not self:\n            raise ValueError('dt.tzinfo is not self')\n        off0 = dt.replace(fold=0).utcoffset()\n        off1 = dt.replace(fold=1).utcoffset()\n        if off0 is None or off1 is None or dt.dst() is None:\n            raise ValueError\n        if off0 == off1:\n            ldt = dt + off0\n            off1 = ldt.utcoffset()\n            if off0 == off1:\n                return ldt\n        for off in [off0, off1]:\n            ldt = dt + off\n            if ldt.utcoffset() == off:\n                return ldt\n            ldt = ldt.replace(fold=1)\n            if ldt.utcoffset() == off:\n                return ldt\n        raise ValueError('No suitable local time found')\n\nclass USTimeZone2(tzinfo2):\n\n    def __init__(self, hours, reprname, stdname, dstname):\n        self.stdoffset = timedelta(hours=hours)\n        self.reprname = reprname\n        self.stdname = stdname\n        self.dstname = dstname\n\n    def __repr__(self):\n        return self.reprname\n\n    def tzname(self, dt):\n        if self.dst(dt):\n            return self.dstname\n        else:\n            return self.stdname\n\n    def utcoffset(self, dt):\n        return self.stdoffset + self.dst(dt)\n\n    def dst(self, dt):\n        if dt is None or dt.tzinfo is None:\n            return ZERO\n        assert dt.tzinfo is self\n        start = first_sunday_on_or_after(DSTSTART.replace(year=dt.year))\n        assert start.weekday() == 6 and start.month == 4 and (start.day <= 7)\n        end = first_sunday_on_or_after(DSTEND.replace(year=dt.year))\n        assert end.weekday() == 6 and end.month == 10 and (end.day >= 25)\n        dt = dt.replace(tzinfo=None)\n        if start + HOUR <= dt < end:\n            return HOUR\n        elif end <= dt < end + HOUR:\n            return ZERO if dt.fold else HOUR\n        elif start <= dt < start + HOUR:\n            return HOUR if dt.fold else ZERO\n        else:\n            return ZERO\nEastern2 = USTimeZone2(-5, 'Eastern2', 'EST', 'EDT')\n\ndef _t():\n    t = datetime(2000, 1, 1, tzinfo=Eastern2)\n    assert t == t.astimezone(timezone.utc), ('assertEqual', t, t.astimezone(timezone.utc))\n    t = datetime(2000, 6, 1, tzinfo=Eastern2)\n    assert t == t.astimezone(timezone.utc), ('assertEqual', t, t.astimezone(timezone.utc))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestLocalTimeDisambiguation.test_mixed_compare_fold" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\n\ndef first_sunday_on_or_after(dt):\n    days_to_go = 6 - dt.weekday()\n    if days_to_go:\n        dt += timedelta(days_to_go)\n    return dt\nZERO = timedelta(0)\nHOUR = timedelta(hours=1)\nDSTSTART = datetime(1, 4, 1, 2)\nDSTEND = datetime(1, 10, 25, 1)\n\nclass tzinfo2(tzinfo):\n\n    def fromutc(self, dt):\n        \"\"\"datetime in UTC -> datetime in local time.\"\"\"\n        if not isinstance(dt, datetime):\n            raise TypeError('fromutc() requires a datetime argument')\n        if dt.tzinfo is not self:\n            raise ValueError('dt.tzinfo is not self')\n        off0 = dt.replace(fold=0).utcoffset()\n        off1 = dt.replace(fold=1).utcoffset()\n        if off0 is None or off1 is None or dt.dst() is None:\n            raise ValueError\n        if off0 == off1:\n            ldt = dt + off0\n            off1 = ldt.utcoffset()\n            if off0 == off1:\n                return ldt\n        for off in [off0, off1]:\n            ldt = dt + off\n            if ldt.utcoffset() == off:\n                return ldt\n            ldt = ldt.replace(fold=1)\n            if ldt.utcoffset() == off:\n                return ldt\n        raise ValueError('No suitable local time found')\n\nclass USTimeZone2(tzinfo2):\n\n    def __init__(self, hours, reprname, stdname, dstname):\n        self.stdoffset = timedelta(hours=hours)\n        self.reprname = reprname\n        self.stdname = stdname\n        self.dstname = dstname\n\n    def __repr__(self):\n        return self.reprname\n\n    def tzname(self, dt):\n        if self.dst(dt):\n            return self.dstname\n        else:\n            return self.stdname\n\n    def utcoffset(self, dt):\n        return self.stdoffset + self.dst(dt)\n\n    def dst(self, dt):\n        if dt is None or dt.tzinfo is None:\n            return ZERO\n        assert dt.tzinfo is self\n        start = first_sunday_on_or_after(DSTSTART.replace(year=dt.year))\n        assert start.weekday() == 6 and start.month == 4 and (start.day <= 7)\n        end = first_sunday_on_or_after(DSTEND.replace(year=dt.year))\n        assert end.weekday() == 6 and end.month == 10 and (end.day >= 25)\n        dt = dt.replace(tzinfo=None)\n        if start + HOUR <= dt < end:\n            return HOUR\n        elif end <= dt < end + HOUR:\n            return ZERO if dt.fold else HOUR\n        elif start <= dt < start + HOUR:\n            return HOUR if dt.fold else ZERO\n        else:\n            return ZERO\nEastern2 = USTimeZone2(-5, 'Eastern2', 'EST', 'EDT')\n\ndef _t():\n    t_fold = datetime(2002, 10, 27, 1, 45, tzinfo=Eastern2)\n    t_fold_utc = t_fold.astimezone(timezone.utc)\n    assert t_fold != t_fold_utc, ('assertNotEqual', t_fold, t_fold_utc)\n    assert t_fold_utc != t_fold, ('assertNotEqual', t_fold_utc, t_fold)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestLocalTimeDisambiguation.test_mixed_compare_gap" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import timezone\nfrom datetime import date, datetime\n\ndef first_sunday_on_or_after(dt):\n    days_to_go = 6 - dt.weekday()\n    if days_to_go:\n        dt += timedelta(days_to_go)\n    return dt\nZERO = timedelta(0)\nHOUR = timedelta(hours=1)\nDSTSTART = datetime(1, 4, 1, 2)\nDSTEND = datetime(1, 10, 25, 1)\n\nclass tzinfo2(tzinfo):\n\n    def fromutc(self, dt):\n        \"\"\"datetime in UTC -> datetime in local time.\"\"\"\n        if not isinstance(dt, datetime):\n            raise TypeError('fromutc() requires a datetime argument')\n        if dt.tzinfo is not self:\n            raise ValueError('dt.tzinfo is not self')\n        off0 = dt.replace(fold=0).utcoffset()\n        off1 = dt.replace(fold=1).utcoffset()\n        if off0 is None or off1 is None or dt.dst() is None:\n            raise ValueError\n        if off0 == off1:\n            ldt = dt + off0\n            off1 = ldt.utcoffset()\n            if off0 == off1:\n                return ldt\n        for off in [off0, off1]:\n            ldt = dt + off\n            if ldt.utcoffset() == off:\n                return ldt\n            ldt = ldt.replace(fold=1)\n            if ldt.utcoffset() == off:\n                return ldt\n        raise ValueError('No suitable local time found')\n\nclass USTimeZone2(tzinfo2):\n\n    def __init__(self, hours, reprname, stdname, dstname):\n        self.stdoffset = timedelta(hours=hours)\n        self.reprname = reprname\n        self.stdname = stdname\n        self.dstname = dstname\n\n    def __repr__(self):\n        return self.reprname\n\n    def tzname(self, dt):\n        if self.dst(dt):\n            return self.dstname\n        else:\n            return self.stdname\n\n    def utcoffset(self, dt):\n        return self.stdoffset + self.dst(dt)\n\n    def dst(self, dt):\n        if dt is None or dt.tzinfo is None:\n            return ZERO\n        assert dt.tzinfo is self\n        start = first_sunday_on_or_after(DSTSTART.replace(year=dt.year))\n        assert start.weekday() == 6 and start.month == 4 and (start.day <= 7)\n        end = first_sunday_on_or_after(DSTEND.replace(year=dt.year))\n        assert end.weekday() == 6 and end.month == 10 and (end.day >= 25)\n        dt = dt.replace(tzinfo=None)\n        if start + HOUR <= dt < end:\n            return HOUR\n        elif end <= dt < end + HOUR:\n            return ZERO if dt.fold else HOUR\n        elif start <= dt < start + HOUR:\n            return HOUR if dt.fold else ZERO\n        else:\n            return ZERO\nEastern2 = USTimeZone2(-5, 'Eastern2', 'EST', 'EDT')\n\ndef _t():\n    t_gap = datetime(2002, 4, 7, 2, 45, tzinfo=Eastern2)\n    t_gap_utc = t_gap.astimezone(timezone.utc)\n    assert t_gap != t_gap_utc, ('assertNotEqual', t_gap, t_gap_utc)\n    assert t_gap_utc != t_gap, ('assertNotEqual', t_gap_utc, t_gap)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestLocalTimeDisambiguation.test_hash_aware" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import timedelta\nfrom datetime import tzinfo\nfrom datetime import date, datetime\n\ndef first_sunday_on_or_after(dt):\n    days_to_go = 6 - dt.weekday()\n    if days_to_go:\n        dt += timedelta(days_to_go)\n    return dt\nZERO = timedelta(0)\nHOUR = timedelta(hours=1)\nDSTSTART = datetime(1, 4, 1, 2)\nDSTEND = datetime(1, 10, 25, 1)\n\nclass tzinfo2(tzinfo):\n\n    def fromutc(self, dt):\n        \"\"\"datetime in UTC -> datetime in local time.\"\"\"\n        if not isinstance(dt, datetime):\n            raise TypeError('fromutc() requires a datetime argument')\n        if dt.tzinfo is not self:\n            raise ValueError('dt.tzinfo is not self')\n        off0 = dt.replace(fold=0).utcoffset()\n        off1 = dt.replace(fold=1).utcoffset()\n        if off0 is None or off1 is None or dt.dst() is None:\n            raise ValueError\n        if off0 == off1:\n            ldt = dt + off0\n            off1 = ldt.utcoffset()\n            if off0 == off1:\n                return ldt\n        for off in [off0, off1]:\n            ldt = dt + off\n            if ldt.utcoffset() == off:\n                return ldt\n            ldt = ldt.replace(fold=1)\n            if ldt.utcoffset() == off:\n                return ldt\n        raise ValueError('No suitable local time found')\n\nclass USTimeZone2(tzinfo2):\n\n    def __init__(self, hours, reprname, stdname, dstname):\n        self.stdoffset = timedelta(hours=hours)\n        self.reprname = reprname\n        self.stdname = stdname\n        self.dstname = dstname\n\n    def __repr__(self):\n        return self.reprname\n\n    def tzname(self, dt):\n        if self.dst(dt):\n            return self.dstname\n        else:\n            return self.stdname\n\n    def utcoffset(self, dt):\n        return self.stdoffset + self.dst(dt)\n\n    def dst(self, dt):\n        if dt is None or dt.tzinfo is None:\n            return ZERO\n        assert dt.tzinfo is self\n        start = first_sunday_on_or_after(DSTSTART.replace(year=dt.year))\n        assert start.weekday() == 6 and start.month == 4 and (start.day <= 7)\n        end = first_sunday_on_or_after(DSTEND.replace(year=dt.year))\n        assert end.weekday() == 6 and end.month == 10 and (end.day >= 25)\n        dt = dt.replace(tzinfo=None)\n        if start + HOUR <= dt < end:\n            return HOUR\n        elif end <= dt < end + HOUR:\n            return ZERO if dt.fold else HOUR\n        elif start <= dt < start + HOUR:\n            return HOUR if dt.fold else ZERO\n        else:\n            return ZERO\nEastern2 = USTimeZone2(-5, 'Eastern2', 'EST', 'EDT')\n\ndef _t():\n    t = datetime(2000, 1, 1, tzinfo=Eastern2)\n    assert hash(t) == hash(t.replace(fold=1)), ('assertEqual', hash(t), hash(t.replace(fold=1)))\n    t_fold = datetime(2002, 10, 27, 1, 45, tzinfo=Eastern2)\n    t_gap = datetime(2002, 4, 7, 2, 45, tzinfo=Eastern2)\n    assert hash(t_fold) == hash(t_fold.replace(fold=1)), ('assertEqual', hash(t_fold), hash(t_fold.replace(fold=1)))\n    assert hash(t_gap) == hash(t_gap.replace(fold=1)), ('assertEqual', hash(t_gap), hash(t_gap.replace(fold=1)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
