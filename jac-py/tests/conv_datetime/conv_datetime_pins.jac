test "TestDateTimeTZ.test_roundtrip" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = datetime\n    _SelfNS.theclass = datetime\n    for dt in (self.theclass(1, 2, 3, 4, 5, 6, 7), self.theclass.now()):\n        s = repr(dt)\n        assert s.startswith('datetime.'), ('assertStartsWith', s, 'datetime.')\n        s = s[9:]\n        dt2 = eval(s)\n        assert dt == dt2, ('assertEqual', dt, dt2)\n        dt2 = self.theclass(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, dt.microsecond)\n        assert dt == dt2, ('assertEqual', dt, dt2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
