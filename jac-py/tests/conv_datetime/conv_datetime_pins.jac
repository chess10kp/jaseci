test "TestSubclassDateTime.test_timetuple" {
    (ok, detail) = p2_libtest_run_snippet("from datetime import date, datetime\n\nclass SubclassDatetime(datetime):\n    sub_var = 1\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.theclass = SubclassDatetime\n    _SelfNS.theclass = SubclassDatetime\n    for i in range(7):\n        d = self.theclass(1956, 1, 2 + i)\n        t = d.timetuple()\n        assert t == (1956, 1, 2 + i, 0, 0, 0, i, 2 + i, -1), ('assertEqual', t, (1956, 1, 2 + i, 0, 0, 0, i, 2 + i, -1))\n        d = self.theclass(1956, 2, 1 + i)\n        t = d.timetuple()\n        assert t == (1956, 2, 1 + i, 0, 0, 0, (2 + i) % 7, 32 + i, -1), ('assertEqual', t, (1956, 2, 1 + i, 0, 0, 0, (2 + i) % 7, 32 + i, -1))\n        d = self.theclass(1956, 3, 1 + i)\n        t = d.timetuple()\n        assert t == (1956, 3, 1 + i, 0, 0, 0, (3 + i) % 7, 61 + i, -1), ('assertEqual', t, (1956, 3, 1 + i, 0, 0, 0, (3 + i) % 7, 61 + i, -1))\n        assert t.tm_year == 1956, ('assertEqual', t.tm_year, 1956)\n        assert t.tm_mon == 3, ('assertEqual', t.tm_mon, 3)\n        assert t.tm_mday == 1 + i, ('assertEqual', t.tm_mday, 1 + i)\n        assert t.tm_hour == 0, ('assertEqual', t.tm_hour, 0)\n        assert t.tm_min == 0, ('assertEqual', t.tm_min, 0)\n        assert t.tm_sec == 0, ('assertEqual', t.tm_sec, 0)\n        assert t.tm_wday == (3 + i) % 7, ('assertEqual', t.tm_wday, (3 + i) % 7)\n        assert t.tm_yday == 61 + i, ('assertEqual', t.tm_yday, 61 + i)\n        assert t.tm_isdst == -1, ('assertEqual', t.tm_isdst, -1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

