}

test "TclTest.test_exprboolean" {
    (ok, detail) = p2_libtest_run_snippet("from tkinter import Tcl\nfrom _tkinter import TclError\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    tcl = self.interp\n    tcl.call('set', 'a', 3)\n    tcl.call('set', 'b', 6)\n\n    def check(expr, expected):\n        result = tcl.exprboolean(expr)\n        assert result == expected, ('assertEqual', result, expected)\n        assert isinstance(result, int), ('assertIsInstance', result, int)\n        assert not isinstance(result, bool), ('assertIsInstance', result, bool)\n    try:\n        tcl.exprboolean()\n    except TypeError:\n        pass\n    try:\n        tcl.exprboolean(*('8.2', '+6'))\n    except TypeError:\n        pass\n    try:\n        tcl.exprboolean(*(b'8.2 + 6',))\n    except TypeError:\n        pass\n    try:\n        tcl.exprboolean(*('spam',))\n    except TclError:\n        pass\n    check('', False)\n    for value in ('0', 'false', 'no', 'off'):\n        check(value, False)\n        check('\"%s\"' % value, False)\n        check('{%s}' % value, False)\n    for value in ('1', 'true', 'yes', 'on'):\n        check(value, True)\n        check('\"%s\"' % value, True)\n        check('{%s}' % value, True)\n    check('8.2 + 6', True)\n    check('3.1 + $a', True)\n    check('2 + \"$a.$b\"', True)\n    check('4*[llength \"6 2\"]', True)\n    check('{word one} < \"word $a\"', False)\n    check('4*2 < 7', False)\n    check('hypot($a, 4)', True)\n    check('5 / 4', True)\n    check('5 / 4.0', True)\n    check('5 / ( [string length \"abcd\"] + 0.0 )', True)\n    check('20.0/5.0', True)\n    check('\"0x03\" > \"2\"', True)\n    check('[string length \"a\u00bd\u20ac\"]', True)\n    check('[string length \"a\\\\xbd\\\\u20ac\"]', True)\n    try:\n        tcl.exprboolean(*('\"abc\"',))\n    except TclError:\n        pass\n    check('2**64', True)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TclTest.test_booleans" {
    (ok, detail) = p2_libtest_run_snippet("from tkinter import Tcl\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    tcl = self.interp\n\n    def check(expr, expected):\n        result = tcl.call('expr', expr)\n        if tcl.wantobjects():\n            assert result == expected, ('assertEqual', result, expected)\n            assert isinstance(result, int), ('assertIsInstance', result, int)\n        else:\n            assert result in (expr, str(int(expected))), ('assertIn', result, (expr, str(int(expected))))\n            assert isinstance(result, str), ('assertIsInstance', result, str)\n    check('true', True)\n    check('yes', True)\n    check('on', True)\n    check('false', False)\n    check('no', False)\n    check('off', False)\n    check('1 < 2', True)\n    check('1 > 2', False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TclTest.test_expr_bignum" {
    (ok, detail) = p2_libtest_run_snippet("from tkinter import Tcl\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    def get_integers():\n        return (0, 1, -1, 2 ** 31 - 1, -2 ** 31, 2 ** 31, -2 ** 31 - 1, 2 ** 63 - 1, -2 ** 63, 2 ** 63, -2 ** 63 - 1, 2 ** 1000, -2 ** 1000)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    tcl = self.interp\n    for i in get_integers():\n        result = tcl.call('expr', str(i))\n        if self.wantobjects:\n            assert result == i, ('assertEqual', result, i)\n            assert isinstance(result, int), ('assertIsInstance', result, int)\n        else:\n            assert result == str(i), ('assertEqual', result, str(i))\n            assert isinstance(result, str), ('assertIsInstance', result, str)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TclTest.test_passing_tcl_obj" {
    (ok, detail) = p2_libtest_run_snippet("_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nfrom tkinter import Tcl\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    tcl = self.interp.tk\n    a = None\n\n    def testfunc(arg):\n        nonlocal a\n        a = arg\n    self.interp.createcommand('testfunc', testfunc)\n    _add_cleanup(self.interp.tk.deletecommand, *('testfunc',))\n    tcl.eval('set a \"\\\\u20ac \\\\ud83d\\\\udcbb \\\\0 \\\\udcab\"; regexp -about $a')\n    tcl.eval('testfunc $a')\n    expected = '\u20ac \ud83d\udcbb \\x00 \\udced\\udcb2\\udcab'\n    if self.wantobjects >= 2:\n        assert str(a) == expected, ('assertEqual', str(a), expected)\n        assert a.string == expected, ('assertEqual', a.string, expected)\n        assert a.typename == 'regexp', ('assertEqual', a.typename, 'regexp')\n    else:\n        assert a == expected, ('assertEqual', a, expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _run_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TclTest.test_splitdict" {
    (ok, detail) = p2_libtest_run_snippet("import tkinter\nfrom tkinter import Tcl\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    splitdict = tkinter._splitdict\n    tcl = self.interp.tk\n    arg = '-a {1 2 3} -something foo status {}'\n    assert splitdict(tcl, arg, False) == {'-a': '1 2 3', '-something': 'foo', 'status': ''}, ('assertEqual', splitdict(tcl, arg, False), {'-a': '1 2 3', '-something': 'foo', 'status': ''})\n    assert splitdict(tcl, arg) == {'a': '1 2 3', 'something': 'foo', 'status': ''}, ('assertEqual', splitdict(tcl, arg), {'a': '1 2 3', 'something': 'foo', 'status': ''})\n    arg = ('-a', (1, 2, 3), '-something', 'foo', 'status', '{}')\n    assert splitdict(tcl, arg, False) == {'-a': (1, 2, 3), '-something': 'foo', 'status': '{}'}, ('assertEqual', splitdict(tcl, arg, False), {'-a': (1, 2, 3), '-something': 'foo', 'status': '{}'})\n    assert splitdict(tcl, arg) == {'a': (1, 2, 3), 'something': 'foo', 'status': '{}'}, ('assertEqual', splitdict(tcl, arg), {'a': (1, 2, 3), 'something': 'foo', 'status': '{}'})\n    try:\n        splitdict(*(tcl, '-a b -c '))\n    except RuntimeError:\n        pass\n    try:\n        splitdict(*(tcl, ('-a', 'b', '-c')))\n    except RuntimeError:\n        pass\n    arg = tcl.call('list', '-a', (1, 2, 3), '-something', 'foo', 'status', ())\n    assert splitdict(tcl, arg) == {'a': (1, 2, 3) if self.wantobjects else '1 2 3', 'something': 'foo', 'status': ''}, ('assertEqual', splitdict(tcl, arg), {'a': (1, 2, 3) if self.wantobjects else '1 2 3', 'something': 'foo', 'status': ''})\n    arg = tcl.call('dict', 'create', '-a', (1, 2, 3), '-something', 'foo', 'status', ())\n    if not self.wantobjects:\n        expected = {'a': '1 2 3', 'something': 'foo', 'status': ''}\n    else:\n        expected = {'a': (1, 2, 3), 'something': 'foo', 'status': ''}\n    assert splitdict(tcl, arg) == expected, ('assertEqual', splitdict(tcl, arg), expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TclTest.test_join" {
    (ok, detail) = p2_libtest_run_snippet("import tkinter\nfrom tkinter import Tcl\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    join = tkinter._join\n    tcl = self.interp.tk\n\n    def unpack(s):\n        return tcl.call('lindex', s, 0)\n\n    def check(value):\n        assert unpack(join([value])) == value, ('assertEqual', unpack(join([value])), value)\n        assert unpack(join([value, 0])) == value, ('assertEqual', unpack(join([value, 0])), value)\n        assert unpack(unpack(join([[value]]))) == value, ('assertEqual', unpack(unpack(join([[value]]))), value)\n        assert unpack(unpack(join([[value, 0]]))) == value, ('assertEqual', unpack(unpack(join([[value, 0]]))), value)\n        assert unpack(unpack(join([[value], 0]))) == value, ('assertEqual', unpack(unpack(join([[value], 0]))), value)\n        assert unpack(unpack(join([[value, 0], 0]))) == value, ('assertEqual', unpack(unpack(join([[value, 0], 0]))), value)\n    check('')\n    check('spam')\n    check('sp am')\n    check('sp\\tam')\n    check('sp\\nam')\n    check(' \\t\\n')\n    check('{spam}')\n    check('{sp am}')\n    check('\"spam\"')\n    check('\"sp am\"')\n    check('{\"spam\"}')\n    check('\"{spam}\"')\n    check('sp\\\\am')\n    check('\"sp\\\\am\"')\n    check('\"{}\" \"{}\"')\n    check('\"\\\\')\n    check('\"{')\n    check('\"}')\n    check('\\n\\\\')\n    check('\\n{')\n    check('\\n}')\n    check('\\\\\\n')\n    check('{\\n')\n    check('}\\n')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
