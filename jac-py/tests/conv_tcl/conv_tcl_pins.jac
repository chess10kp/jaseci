    (ok, detail) = p2_libtest_run_snippet("from tkinter import Tcl\nfrom _tkinter import TclError\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    tcl = self.interp\n    tcl.call('set', 'a', 3)\n    tcl.call('set', 'b', 6)\n\n    def check(expr, expected):\n        result = tcl.exprlong(expr)\n        assert result == expected, ('assertEqual', result, expected)\n        assert isinstance(result, int), ('assertIsInstance', result, int)\n    try:\n        tcl.exprlong()\n    except TypeError:\n        pass\n    try:\n        tcl.exprlong(*('8.2', '+6'))\n    except TypeError:\n        pass\n    try:\n        tcl.exprlong(*(b'8.2 + 6',))\n    except TypeError:\n        pass\n    try:\n        tcl.exprlong(*('spam',))\n    except TclError:\n        pass\n    check('', 0)\n    check('8.2 + 6', 14)\n    check('3.1 + $a', 6)\n    check('2 + \"$a.$b\"', 5)\n    check('4*[llength \"6 2\"]', 8)\n    check('{word one} < \"word $a\"', 0)\n    check('4*2 < 7', 0)\n    check('hypot($a, 4)', 5)\n    check('5 / 4', 1)\n    check('5 / 4.0', 1)\n    check('5 / ( [string length \"abcd\"] + 0.0 )', 1)\n    check('20.0/5.0', 4)\n    check('\"0x03\" > \"2\"', 1)\n    check('[string length \"a\u00bd\u20ac\"]', 3)\n    check('[string length \"a\\\\xbd\\\\u20ac\"]', 3)\n    try:\n        tcl.exprlong(*('\"abc\"',))\n    except TclError:\n        pass\n    try:\n        tcl.exprlong(*('2**64',))\n    except TclError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
