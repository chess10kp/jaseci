test "TclTest.testUnsetVar" {
    (ok, detail) = p2_libtest_run_snippet("from tkinter import Tcl\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    tcl = self.interp\n    tcl.setvar('a', 1)\n    assert tcl.eval('info exists a') == '1', ('assertEqual', tcl.eval('info exists a'), '1')\n    tcl.unsetvar('a')\n    assert tcl.eval('info exists a') == '0', ('assertEqual', tcl.eval('info exists a'), '0')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

