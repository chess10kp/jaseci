test "TclTest.test_getdouble" {
    (ok, detail) = p2_libtest_run_snippet("from tkinter import Tcl\nfrom _tkinter import TclError\n\ndef _t():\n\n    def setUp():\n        self.interp = Tcl()\n        self.wantobjects = self.interp.tk.wantobjects()\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.interp = Tcl()\n    self.wantobjects = self.interp.tk.wantobjects()\n    tcl = self.interp.tk\n    assert tcl.getdouble(' 42 ') == 42.0, ('assertEqual', tcl.getdouble(' 42 '), 42.0)\n    assert tcl.getdouble(' 42.5 ') == 42.5, ('assertEqual', tcl.getdouble(' 42.5 '), 42.5)\n    assert tcl.getdouble(42.5) == 42.5, ('assertEqual', tcl.getdouble(42.5), 42.5)\n    assert tcl.getdouble(42) == 42.0, ('assertEqual', tcl.getdouble(42), 42.0)\n    try:\n        tcl.getdouble()\n    except TypeError:\n        pass\n    try:\n        tcl.getdouble(*('42.5', '10'))\n    except TypeError:\n        pass\n    try:\n        tcl.getdouble(*(b'42.5',))\n    except TypeError:\n        pass\n    try:\n        tcl.getdouble(*('a',))\n    except TclError:\n        pass\n    try:\n        tcl.getdouble(*('42.5\\x00',))\n    except (TypeError, ValueError, TclError):\n        pass\n    try:\n        tcl.getdouble(*('42.5\\ud800',))\n    except (UnicodeEncodeError, ValueError, TclError):\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

