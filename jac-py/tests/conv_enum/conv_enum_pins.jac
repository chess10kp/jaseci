tr(OkayEnum.one), 'OkayEnum.one')\n    assert '{}'.format(OkayEnum.one) == 'OkayEnum.one', ('assertEqual', '{}'.format(OkayEnum.one), 'OkayEnum.one')\n    assert repr(OkayEnum.one) == \"<OkayEnum.one: '1'>\", ('assertEqual', repr(OkayEnum.one), \"<OkayEnum.one: '1'>\")\n\n    class DumbMixin:\n\n        def __str__(self):\n            return \"don't do this\"\n\n    class DumbStrEnum(DumbMixin, CustomStrEnum):\n        five = '5'\n        six = '6'\n        seven = '7'\n        __str__ = DumbMixin.__str__\n    assert DumbStrEnum.seven == '7', ('assertEqual', DumbStrEnum.seven, '7')\n    assert str(DumbStrEnum.seven) == \"don't do this\", ('assertEqual', str(DumbStrEnum.seven), \"don't do this\")\n\n    class EnumMixin(Enum):\n\n        def hello(self):\n            print('hello from %s' % (self,))\n\n    class HelloEnum(EnumMixin, CustomStrEnum):\n        eight = '8'\n    assert HelloEnum.eight == '8', ('assertEqual', HelloEnum.eight, '8')\n    assert str(HelloEnum.eight) == 'HelloEnum.eight', ('assertEqual', str(HelloEnum.eight), 'HelloEnum.eight')\n\n    class GoodbyeMixin:\n\n        def goodbye(self):\n            print('%s wishes you a fond farewell')\n\n    class GoodbyeEnum(GoodbyeMixin, EnumMixin, CustomStrEnum):\n        nine = '9'\n    assert GoodbyeEnum.nine == '9', ('assertEqual', GoodbyeEnum.nine, '9')\n    assert str(GoodbyeEnum.nine) == 'GoodbyeEnum.nine', ('assertEqual', str(GoodbyeEnum.nine), 'GoodbyeEnum.nine')\n\n    class FirstFailedStrEnum(CustomStrEnum):\n        one = 1\n        two = '2'\n\n    class SecondFailedStrEnum(CustomStrEnum):\n        one = '1'\n        two = (2,)\n        three = '3'\n\n    class ThirdFailedStrEnum(CustomStrEnum):\n        one = '1'\n        two = 2\n    try:\n\n        class ThirdFailedStrEnum(CustomStrEnum):\n            one = '1'\n            two = (b'2', sys.getdefaultencoding)\n    except TypeError as _exc:\n        assert _re.search(\"argument (2|'encoding') must be str, not \", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        class ThirdFailedStrEnum(CustomStrEnum):\n            one = '1'\n            two = (b'2', 'ascii', 9)\n    except TypeError as _exc:\n        assert _re.search(\"argument (3|'errors') must be str, not \", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

