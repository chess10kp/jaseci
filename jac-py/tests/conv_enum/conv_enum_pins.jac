ePart(Enum):\n        ONE = (1, 1.0, 'one')\n        TWO = (2, 2.0, 'two')\n        THREE = (3, 3.0, 'three')\n    assert ThreePart((3, 3.0, 'three')) is ThreePart.THREE, ('assertIs', ThreePart((3, 3.0, 'three')), ThreePart.THREE)\n    assert ThreePart(3, 3.0, 'three') is ThreePart.THREE, ('assertIs', ThreePart(3, 3.0, 'three'), ThreePart.THREE)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
