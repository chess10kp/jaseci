test "TestSpecial.test_strenum" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport re as _re\nimport sys\nfrom datetime import date\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\n\ndef _t():\n\n    def setUp():\n\n        class Season(Enum):\n            SPRING = 1\n            SUMMER = 2\n            AUTUMN = 3\n            WINTER = 4\n        self.Season = Season\n\n        class Grades(IntEnum):\n            A = 5\n            B = 4\n            C = 3\n            D = 2\n            F = 0\n        self.Grades = Grades\n\n        class Directional(str, Enum):\n            EAST = 'east'\n            WEST = 'west'\n            NORTH = 'north'\n            SOUTH = 'south'\n        self.Directional = Directional\n        from datetime import date\n\n        class Holiday(date, Enum):\n            NEW_YEAR = (2013, 1, 1)\n            IDES_OF_MARCH = (2013, 3, 15)\n        self.Holiday = Holiday\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class Season(Enum):\n        SPRING = 1\n        SUMMER = 2\n        AUTUMN = 3\n        WINTER = 4\n    self.Season = Season\n\n    class Grades(IntEnum):\n        A = 5\n        B = 4\n        C = 3\n        D = 2\n        F = 0\n    self.Grades = Grades\n\n    class Directional(str, Enum):\n        EAST = 'east'\n        WEST = 'west'\n        NORTH = 'north'\n        SOUTH = 'south'\n    self.Directional = Directional\n    from datetime import date\n\n    class Holiday(date, Enum):\n        NEW_YEAR = (2013, 1, 1)\n        IDES_OF_MARCH = (2013, 3, 15)\n    self.Holiday = Holiday\n\n    class GoodStrEnum(StrEnum):\n        one = '1'\n        two = '2'\n        three = (b'3', 'ascii')\n        four = (b'4', 'latin1', 'strict')\n    assert GoodStrEnum.one == '1', ('assertEqual', GoodStrEnum.one, '1')\n    assert str(GoodStrEnum.one) == '1', ('assertEqual', str(GoodStrEnum.one), '1')\n    assert '{}'.format(GoodStrEnum.one) == '1', ('assertEqual', '{}'.format(GoodStrEnum.one), '1')\n    assert GoodStrEnum.one == str(GoodStrEnum.one), ('assertEqual', GoodStrEnum.one, str(GoodStrEnum.one))\n    assert GoodStrEnum.one == '{}'.format(GoodStrEnum.one), ('assertEqual', GoodStrEnum.one, '{}'.format(GoodStrEnum.one))\n    assert repr(GoodStrEnum.one) == \"<GoodStrEnum.one: '1'>\", ('assertEqual', repr(GoodStrEnum.one), \"<GoodStrEnum.one: '1'>\")\n\n    class DumbMixin:\n\n        def __str__(self):\n            return \"don't do this\"\n\n    class DumbStrEnum(DumbMixin, StrEnum):\n        five = '5'\n        six = '6'\n        seven = '7'\n        __str__ = DumbMixin.__str__\n    assert DumbStrEnum.seven == '7', ('assertEqual', DumbStrEnum.seven, '7')\n    assert str(DumbStrEnum.seven) == \"don't do this\", ('assertEqual', str(DumbStrEnum.seven), \"don't do this\")\n\n    class EnumMixin(Enum):\n\n        def hello(self):\n            print('hello from %s' % (self,))\n\n    class HelloEnum(EnumMixin, StrEnum):\n        eight = '8'\n    assert HelloEnum.eight == '8', ('assertEqual', HelloEnum.eight, '8')\n    assert HelloEnum.eight == str(HelloEnum.eight), ('assertEqual', HelloEnum.eight, str(HelloEnum.eight))\n\n    class GoodbyeMixin:\n\n        def goodbye(self):\n            print('%s wishes you a fond farewell')\n\n    class GoodbyeEnum(GoodbyeMixin, EnumMixin, StrEnum):\n        nine = '9'\n    assert GoodbyeEnum.nine == '9', ('assertEqual', GoodbyeEnum.nine, '9')\n    assert GoodbyeEnum.nine == str(GoodbyeEnum.nine), ('assertEqual', GoodbyeEnum.nine, str(GoodbyeEnum.nine))\n    try:\n\n        class FirstFailedStrEnum(StrEnum):\n            one = 1\n            two = '2'\n    except TypeError as _exc:\n        assert _re.search('1 is not a string', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        class SecondFailedStrEnum(StrEnum):\n            one = '1'\n            two = (2,)\n            three = '3'\n    except TypeError as _exc:\n        assert _re.search('2 is not a string', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        class ThirdFailedStrEnum(StrEnum):\n            one = '1'\n            two = 2\n    except TypeError as _exc:\n        assert _re.search('2 is not a string', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        class ThirdFailedStrEnum(StrEnum):\n            one = '1'\n            two = (b'2', sys.getdefaultencoding)\n    except TypeError as _exc:\n        assert _re.search('encoding must be a string, not %r' % (sys.getdefaultencoding,), str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        class ThirdFailedStrEnum(StrEnum):\n            one = '1'\n            two = (b'2', 'ascii', 9)\n    except TypeError as _exc:\n        assert _re.search('errors must be a string, not 9', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

