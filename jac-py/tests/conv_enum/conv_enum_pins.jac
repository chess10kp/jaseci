test "OldTestFlag.test_boundary" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport enum\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\nfrom enum import STRICT, CONFORM, EJECT, KEEP, _simple_enum, _test_simple_enum\n\ndef _t():\n    assert enum.Flag._boundary_ is STRICT, ('assertIs', enum.Flag._boundary_, STRICT)\n\n    class Iron(Flag, boundary=CONFORM):\n        ONE = 1\n        TWO = 2\n        EIGHT = 8\n    assert Iron._boundary_ is CONFORM, ('assertIs', Iron._boundary_, CONFORM)\n\n    class Water(Flag, boundary=STRICT):\n        ONE = 1\n        TWO = 2\n        EIGHT = 8\n    assert Water._boundary_ is STRICT, ('assertIs', Water._boundary_, STRICT)\n\n    class Space(Flag, boundary=EJECT):\n        ONE = 1\n        TWO = 2\n        EIGHT = 8\n    assert Space._boundary_ is EJECT, ('assertIs', Space._boundary_, EJECT)\n\n    class Bizarre(Flag, boundary=KEEP):\n        b = 3\n        c = 4\n        d = 6\n    try:\n        Water(*(7,))\n    except ValueError:\n        pass\n    assert Iron(7) is Iron.ONE | Iron.TWO, ('assertIs', Iron(7), Iron.ONE | Iron.TWO)\n    assert Iron(~9) is Iron.TWO, ('assertIs', Iron(~9), Iron.TWO)\n    assert Space(7) == 7, ('assertEqual', Space(7), 7)\n    assert type(Space(7)) is int, ('assertTrue', type(Space(7)) is int)\n    assert list(Bizarre) == [Bizarre.c], ('assertEqual', list(Bizarre), [Bizarre.c])\n    assert Bizarre(3) is Bizarre.b, ('assertIs', Bizarre(3), Bizarre.b)\n    assert Bizarre(6) is Bizarre.d, ('assertIs', Bizarre(6), Bizarre.d)\n\n    class SkipFlag(enum.Flag):\n        A = 1\n        B = 2\n        C = 4 | B\n    assert SkipFlag.C in SkipFlag.A | SkipFlag.C, ('assertTrue', SkipFlag.C in SkipFlag.A | SkipFlag.C)\n    try:\n        SkipFlag(*(42,))\n    except ValueError:\n        pass\n\n    class SkipIntFlag(enum.IntFlag):\n        A = 1\n        B = 2\n        C = 4 | B\n    assert SkipIntFlag.C in SkipIntFlag.A | SkipIntFlag.C, ('assertTrue', SkipIntFlag.C in SkipIntFlag.A | SkipIntFlag.C)\n    assert SkipIntFlag(42).value == 42, ('assertEqual', SkipIntFlag(42).value, 42)\n\n    class MethodHint(Flag):\n        HiddenText = 16\n        DigitsOnly = 1\n        LettersOnly = 2\n        OnlyMask = 15\n    assert str(MethodHint.HiddenText | MethodHint.OnlyMask) == 'MethodHint.HiddenText|DigitsOnly|LettersOnly|OnlyMask', ('assertEqual', str(MethodHint.HiddenText | MethodHint.OnlyMask), 'MethodHint.HiddenText|DigitsOnly|LettersOnly|OnlyMask')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "OldTestFlag.test_programatic_function_string" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\n\nclass Perm(Flag):\n    R, W, X = (4, 2, 1)\n\ndef _t():\n    Perm = Flag('Perm', 'R W X')\n    lst = list(Perm)\n    assert len(lst) == len(Perm), ('assertEqual', len(lst), len(Perm))\n    assert len(Perm) == 3, ('assertEqual', len(Perm), 3)\n    assert lst == [Perm.R, Perm.W, Perm.X], ('assertEqual', lst, [Perm.R, Perm.W, Perm.X])\n    for i, n in enumerate('R W X'.split()):\n        v = 1 << i\n        e = Perm(v)\n        assert e.value == v, ('assertEqual', e.value, v)\n        assert type(e.value) == int, ('assertEqual', type(e.value), int)\n        assert e.name == n, ('assertEqual', e.name, n)\n        assert e in Perm, ('assertIn', e, Perm)\n        assert type(e) is Perm, ('assertIs', type(e), Perm)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

