test "TestVerify.test_continuous" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport re as _re\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\nfrom enum import verify, UNIQUE, CONTINUOUS, NAMED_FLAGS, ReprEnum\n\ndef _t():\n\n    @verify(CONTINUOUS)\n    class Auto(Enum):\n        FIRST = auto()\n        SECOND = auto()\n        THIRD = auto()\n        FORTH = auto()\n\n    @verify(CONTINUOUS)\n    class Manual(Enum):\n        FIRST = 3\n        SECOND = 4\n        THIRD = 5\n        FORTH = 6\n    try:\n\n        @verify(CONTINUOUS)\n        class Missing(Enum):\n            FIRST = 3\n            SECOND = 4\n            THIRD = 11\n            FORTH = 13\n    except ValueError as _exc:\n        assert _re.search('invalid enum .Missing.: missing values 5, 6, 7, 8, 9, 10, 12', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        @verify(CONTINUOUS)\n        class Incomplete(Flag):\n            FIRST = 4\n            SECOND = 8\n            THIRD = 16\n            FORTH = 64\n    except ValueError as _exc:\n        assert _re.search('invalid flag .Incomplete.: missing values 32', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        @verify(CONTINUOUS)\n        class StillIncomplete(Flag):\n            FIRST = 4\n            SECOND = 8\n            THIRD = 11\n            FORTH = 32\n    except ValueError as _exc:\n        assert _re.search('invalid flag .StillIncomplete.: missing values 16', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestVerify.test_composite" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport re as _re\nimport enum\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\nfrom enum import verify, UNIQUE, CONTINUOUS, NAMED_FLAGS, ReprEnum\n\ndef _t():\n\n    class Bizarre(Flag):\n        b = 3\n        c = 4\n        d = 6\n    assert list(Bizarre) == [Bizarre.c], ('assertEqual', list(Bizarre), [Bizarre.c])\n    assert Bizarre.b.value == 3, ('assertEqual', Bizarre.b.value, 3)\n    assert Bizarre.c.value == 4, ('assertEqual', Bizarre.c.value, 4)\n    assert Bizarre.d.value == 6, ('assertEqual', Bizarre.d.value, 6)\n    try:\n\n        @verify(NAMED_FLAGS)\n        class Bizarre(Flag):\n            b = 3\n            c = 4\n            d = 6\n    except ValueError as _exc:\n        assert _re.search(\"invalid Flag 'Bizarre': aliases b and d are missing combined values of 0x3 .use enum.show_flag_values.value. for details.\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert enum.show_flag_values(3) == [1, 2], ('assertEqual', enum.show_flag_values(3), [1, 2])\n\n    class Bizarre(IntFlag):\n        b = 3\n        c = 4\n        d = 6\n    assert list(Bizarre) == [Bizarre.c], ('assertEqual', list(Bizarre), [Bizarre.c])\n    assert Bizarre.b.value == 3, ('assertEqual', Bizarre.b.value, 3)\n    assert Bizarre.c.value == 4, ('assertEqual', Bizarre.c.value, 4)\n    assert Bizarre.d.value == 6, ('assertEqual', Bizarre.d.value, 6)\n    try:\n\n        @verify(NAMED_FLAGS)\n        class Bizarre(IntFlag):\n            c = 4\n            d = 6\n    except ValueError as _exc:\n        assert _re.search(\"invalid Flag 'Bizarre': alias d is missing value 0x2 .use enum.show_flag_values.value. for details.\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert enum.show_flag_values(2) == [2], ('assertEqual', enum.show_flag_values(2), [2])\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

