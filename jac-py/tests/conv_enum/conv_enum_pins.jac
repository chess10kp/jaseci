test "TestInternals.test_sunder" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport enum\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.dunder_names = ('__mal__', '__bien__', '__que_que__')\n    _SelfNS.dunder_names = ('__mal__', '__bien__', '__que_que__')\n    self.private_and_sunder_names = ('_MyEnum__private_', '_MyEnum__also_private_')\n    _SelfNS.private_and_sunder_names = ('_MyEnum__private_', '_MyEnum__also_private_')\n    self.private_names = ('_MyEnum__private', '_MyEnum__still_private')\n    _SelfNS.private_names = ('_MyEnum__private', '_MyEnum__still_private')\n    self.random_names = ('okay', '_semi_private', '_weird__', '_MyEnum__')\n    _SelfNS.random_names = ('okay', '_semi_private', '_weird__', '_MyEnum__')\n    self.sunder_names = ('_bad_', '_good_', '_what_ho_')\n    _SelfNS.sunder_names = ('_bad_', '_good_', '_what_ho_')\n    for name in self.sunder_names + self.private_and_sunder_names:\n        assert enum._is_sunder(name), ('assertTrue', enum._is_sunder(name))\n    for name in self.dunder_names + self.private_names + self.random_names:\n        assert not enum._is_sunder(name), ('assertFalse', enum._is_sunder(name))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

