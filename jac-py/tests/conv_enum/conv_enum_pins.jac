n as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecial.test_int_flags_copy" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport copy\nfrom datetime import date\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\n\ndef _t():\n\n    def setUp():\n\n        class Season(Enum):\n            SPRING = 1\n            SUMMER = 2\n            AUTUMN = 3\n            WINTER = 4\n        self.Season = Season\n\n        class Grades(IntEnum):\n            A = 5\n            B = 4\n            C = 3\n            D = 2\n            F = 0\n        self.Grades = Grades\n\n        class Directional(str, Enum):\n            EAST = 'east'\n            WEST = 'west'\n            NORTH = 'north'\n            SOUTH = 'south'\n        self.Directional = Directional\n        from datetime import date\n\n        class Holiday(date, Enum):\n            NEW_YEAR = (2013, 1, 1)\n            IDES_OF_MARCH = (2013, 3, 15)\n        self.Holiday = Holiday\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class Season(Enum):\n        SPRING = 1\n        SUMMER = 2\n        AUTUMN = 3\n        WINTER = 4\n    self.Season = Season\n\n    class Grades(IntEnum):\n        A = 5\n        B = 4\n        C = 3\n        D = 2\n        F = 0\n    self.Grades = Grades\n\n    class Directional(str, Enum):\n        EAST = 'east'\n        WEST = 'west'\n        NORTH = 'north'\n        SOUTH = 'south'\n    self.Directional = Directional\n    from datetime import date\n\n    class Holiday(date, Enum):\n        NEW_YEAR = (2013, 1, 1)\n        IDES_OF_MARCH = (2013, 3, 15)\n    self.Holiday = Holiday\n\n    class MyIntFlag(IntFlag):\n        ONE = 1\n        TWO = 2\n        FOUR = 4\n    flags = MyIntFlag.ONE | MyIntFlag.TWO\n    copied = copy.copy(flags)\n    deep = copy.deepcopy(flags)\n    assert copied == flags, ('assertEqual', copied, flags)\n    assert deep == flags, ('assertEqual', deep, flags)\n    flags = MyIntFlag.ONE | MyIntFlag.TWO | 8\n    copied = copy.copy(flags)\n    deep = copy.deepcopy(flags)\n    assert copied == flags, ('assertEqual', copied, flags)\n    assert deep == flags, ('assertEqual', deep, flags)\n    assert copied.value == 1 | 2 | 8, ('assertEqual', copied.value, 1 | 2 | 8)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecial.test_flag_with_custom_new" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom datetime import date\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\nfrom enum import STRICT, CONFORM, EJECT, KEEP, _simple_enum, _test_simple_enum\n\ndef _t():\n\n    def setUp():\n\n        class Season(Enum):\n            SPRING = 1\n            SUMMER = 2\n            AUTUMN = 3\n            WINTER = 4\n        self.Season = Season\n\n        class Grades(IntEnum):\n            A = 5\n            B = 4\n            C = 3\n            D = 2\n            F = 0\n        self.Grades = Grades\n\n        class Directional(str, Enum):\n            EAST = 'east'\n            WEST = 'west'\n            NORTH = 'north'\n            SOUTH = 'south'\n        self.Directional = Directional\n        from datetime import date\n\n        class Holiday(date, Enum):\n            NEW_YEAR = (2013, 1, 1)\n            IDES_OF_MARCH = (2013, 3, 15)\n        self.Holiday = Holiday\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class Season(Enum):\n        SPRING = 1\n        SUMMER = 2\n        AUTUMN = 3\n        WINTER = 4\n    self.Season = Season\n\n    class Grades(IntEnum):\n        A = 5\n        B = 4\n        C = 3\n        D = 2\n        F = 0\n    self.Grades = Grades\n\n    class Directional(str, Enum):\n        EAST = 'east'\n        WEST = 'west'\n        NORTH = 'north'\n        SOUTH = 'south'\n    self.Directional = Directional\n    from datetime import date\n\n    class Holiday(date, Enum):\n        NEW_YEAR = (2013, 1, 1)\n        IDES_OF_MARCH = (2013, 3, 15)\n    self.Holiday = Holiday\n\n    class FlagFromChar(IntFlag):\n\n        def __new__(cls, c):\n            value = 1 << c\n            self = int.__new__(cls, value)\n            self._value_ = value\n            return self\n        a = ord('a')\n    assert FlagFromChar._all_bits_ == 316912650057057350374175801343, ('assertEqual', FlagFromChar._all_bits_, 316912650057057350374175801343)\n    assert FlagFromChar._flag_mask_ == 158456325028528675187087900672, ('assertEqual', FlagFromChar._flag_mask_, 158456325028528675187087900672)\n    assert FlagFromChar.a == 158456325028528675187087900672, ('assertEqual', FlagFromChar.a, 158456325028528675187087900672)\n    assert FlagFromChar.a | 1 == 158456325028528675187087900673, ('assertEqual', FlagFromChar.a | 1, 158456325028528675187087900673)\n\n    class FlagFromChar(Flag):\n\n        def __new__(cls, c):\n            value = 1 << c\n            self = object.__new__(cls)\n            self._value_ = value\n            return self\n        a = ord('a')\n        z = 1\n    assert FlagFromChar._all_bits_ == 316912650057057350374175801343, ('assertEqual', FlagFromChar._all_bits_, 316912650057057350374175801343)\n    assert FlagFromChar._flag_mask_ == 158456325028528675187087900674, ('assertEqual', FlagFromChar._flag_mask_, 158456325028528675187087900674)\n    assert FlagFromChar.a.value == 158456325028528675187087900672, ('assertEqual', FlagFromChar.a.value, 158456325028528675187087900672)\n    assert (FlagFromChar.a | FlagFromChar.z).value == 158456325028528675187087900674, ('assertEqual', (FlagFromChar.a | FlagFromChar.z).value, 158456325028528675187087900674)\n\n    class FlagFromChar(int, Flag, boundary=KEEP):\n\n        def __new__(cls, c):\n            value = 1 << c\n            self = int.__new__(cls, value)\n            self._value_ = value\n            return self\n        a = ord('a')\n    assert FlagFromChar._all_bits_ == 316912650057057350374175801343, ('assertEqual', FlagFromChar._all_bits_, 316912650057057350374175801343)\n    assert FlagFromChar._flag_mask_ == 158456325028528675187087900672, ('assertEqual', FlagFromChar._flag_mask_, 158456325028528675187087900672)\n    assert FlagFromChar.a == 158456325028528675187087900672, ('assertEqual', FlagFromChar.a, 158456325028528675187087900672)\n    assert FlagFromChar.a | 1 == 158456325028528675187087900673, ('assertEqual', FlagFromChar.a | 1, 158456325028528675187087900673)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

