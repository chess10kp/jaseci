      TestEnum('invalid_value')\n            except ValueError:\n                pass\n    class_1_ref = weakref.ref(Class1())\n    class_2_ref = weakref.ref(Class2())\n    gc.collect()\n    assert class_1_ref() is None, ('assertIs', class_1_ref(), None)\n    assert class_2_ref() is None, ('assertIs', class_2_ref(), None)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
