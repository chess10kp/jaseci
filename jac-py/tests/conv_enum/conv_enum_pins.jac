omplete')\n    assert list(LabelledList) == [LabelledList.unprocessed, LabelledList.payment_complete], ('assertEqual', list(LabelledList), [LabelledList.unprocessed, LabelledList.payment_complete])\n    assert LabelledList.unprocessed == 1, ('assertEqual', LabelledList.unprocessed, 1)\n    assert LabelledList(1) == LabelledList.unprocessed, ('assertEqual', LabelledList(1), LabelledList.unprocessed)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
