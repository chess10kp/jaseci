test "OldTestIntFlag.test_boundary" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport enum\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\nfrom enum import STRICT, CONFORM, EJECT, KEEP, _simple_enum, _test_simple_enum\n\ndef _t():\n    assert enum.IntFlag._boundary_ is KEEP, ('assertIs', enum.IntFlag._boundary_, KEEP)\n\n    class Simple(IntFlag, boundary=KEEP):\n        SINGLE = 1\n\n    class Iron(IntFlag, boundary=STRICT):\n        ONE = 1\n        TWO = 2\n        EIGHT = 8\n    assert Iron._boundary_ is STRICT, ('assertIs', Iron._boundary_, STRICT)\n\n    class Water(IntFlag, boundary=CONFORM):\n        ONE = 1\n        TWO = 2\n        EIGHT = 8\n    assert Water._boundary_ is CONFORM, ('assertIs', Water._boundary_, CONFORM)\n\n    class Space(IntFlag, boundary=EJECT):\n        ONE = 1\n        TWO = 2\n        EIGHT = 8\n    assert Space._boundary_ is EJECT, ('assertIs', Space._boundary_, EJECT)\n\n    class Bizarre(IntFlag, boundary=KEEP):\n        b = 3\n        c = 4\n        d = 6\n    try:\n        Iron(*(5,))\n    except ValueError:\n        pass\n    assert Water(7) is Water.ONE | Water.TWO, ('assertIs', Water(7), Water.ONE | Water.TWO)\n    assert Water(~9) is Water.TWO, ('assertIs', Water(~9), Water.TWO)\n    assert Space(7) == 7, ('assertEqual', Space(7), 7)\n    assert type(Space(7)) is int, ('assertTrue', type(Space(7)) is int)\n    assert list(Bizarre) == [Bizarre.c], ('assertEqual', list(Bizarre), [Bizarre.c])\n    assert Bizarre(3) is Bizarre.b, ('assertIs', Bizarre(3), Bizarre.b)\n    assert Bizarre(6) is Bizarre.d, ('assertIs', Bizarre(6), Bizarre.d)\n    simple = Simple.SINGLE | Iron.TWO\n    assert simple == 3, ('assertEqual', simple, 3)\n    assert isinstance(simple, Simple), ('assertIsInstance', simple, Simple)\n    assert repr(simple) == '<Simple.SINGLE|<Iron.TWO: 2>: 3>', ('assertEqual', repr(simple), '<Simple.SINGLE|<Iron.TWO: 2>: 3>')\n    assert str(simple) == '3', ('assertEqual', str(simple), '3')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "OldTestIntFlag.test_programatic_function_string" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\n\nclass Perm(IntFlag):\n    R = 1 << 2\n    W = 1 << 1\n    X = 1 << 0\n\ndef _t():\n    Perm = IntFlag('Perm', 'R W X')\n    lst = list(Perm)\n    assert len(lst) == len(Perm), ('assertEqual', len(lst), len(Perm))\n    assert len(Perm) == 3, ('assertEqual', len(Perm), 3)\n    assert lst == [Perm.R, Perm.W, Perm.X], ('assertEqual', lst, [Perm.R, Perm.W, Perm.X])\n    for i, n in enumerate('R W X'.split()):\n        v = 1 << i\n        e = Perm(v)\n        assert e.value == v, ('assertEqual', e.value, v)\n        assert type(e.value) == int, ('assertEqual', type(e.value), int)\n        assert e == v, ('assertEqual', e, v)\n        assert e.name == n, ('assertEqual', e.name, n)\n        assert e in Perm, ('assertIn', e, Perm)\n        assert type(e) is Perm, ('assertIs', type(e), Perm)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

