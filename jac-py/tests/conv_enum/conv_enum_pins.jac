test "TestSpecial.test_too_many_data_types" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport re as _re\nfrom datetime import date\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\n\ndef _t():\n\n    def setUp():\n\n        class Season(Enum):\n            SPRING = 1\n            SUMMER = 2\n            AUTUMN = 3\n            WINTER = 4\n        self.Season = Season\n\n        class Grades(IntEnum):\n            A = 5\n            B = 4\n            C = 3\n            D = 2\n            F = 0\n        self.Grades = Grades\n\n        class Directional(str, Enum):\n            EAST = 'east'\n            WEST = 'west'\n            NORTH = 'north'\n            SOUTH = 'south'\n        self.Directional = Directional\n        from datetime import date\n\n        class Holiday(date, Enum):\n            NEW_YEAR = (2013, 1, 1)\n            IDES_OF_MARCH = (2013, 3, 15)\n        self.Holiday = Holiday\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class Season(Enum):\n        SPRING = 1\n        SUMMER = 2\n        AUTUMN = 3\n        WINTER = 4\n    self.Season = Season\n\n    class Grades(IntEnum):\n        A = 5\n        B = 4\n        C = 3\n        D = 2\n        F = 0\n    self.Grades = Grades\n\n    class Directional(str, Enum):\n        EAST = 'east'\n        WEST = 'west'\n        NORTH = 'north'\n        SOUTH = 'south'\n    self.Directional = Directional\n    from datetime import date\n\n    class Holiday(date, Enum):\n        NEW_YEAR = (2013, 1, 1)\n        IDES_OF_MARCH = (2013, 3, 15)\n    self.Holiday = Holiday\n    try:\n\n        class Huh(str, int, Enum):\n            One = 1\n    except TypeError as _exc:\n        assert _re.search('too many data types', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\n    class MyStr(str):\n\n        def hello(self):\n            return 'hello, %s' % self\n\n    class MyInt(int):\n\n        def repr(self):\n            return hex(self)\n    try:\n\n        class Huh(MyStr, MyInt, Enum):\n            One = 1\n    except TypeError as _exc:\n        assert _re.search('too many data types', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
