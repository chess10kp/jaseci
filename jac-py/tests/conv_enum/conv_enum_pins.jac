test "MiscTestCase.test_doc_4" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nfrom enum import Enum, EnumMeta, IntEnum, StrEnum, EnumType, Flag, IntFlag, unique, auto\n\ndef _t():\n\n    class Quadruple(Enum):\n        ONE = 1\n        TWO = 2\n        THREE = 3\n        FOUR = 4\n    assert Quadruple.__doc__ == None, ('assertEqual', Quadruple.__doc__, None)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
