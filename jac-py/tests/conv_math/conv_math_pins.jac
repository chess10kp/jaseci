test "MathTests.testFloor" {
    (ok, detail) = p2_libtest_run_snippet("import math\n\nclass FloatLike:\n\n    def __init__(self, value):\n        self.value = value\n\n    def __float__(self):\n        return self.value\n\nclass BadDescr:\n\n    def __get__(self, obj, objtype=None):\n        raise ValueError\n\ndef _t():\n    try:\n        math.floor()\n    except TypeError:\n        pass\n    assert int == type(math.floor(0.5)), ('assertEqual', int, type(math.floor(0.5)))\n    assert math.floor(0.5) == 0, ('assertEqual', math.floor(0.5), 0)\n    assert math.floor(1.0) == 1, ('assertEqual', math.floor(1.0), 1)\n    assert math.floor(1.5) == 1, ('assertEqual', math.floor(1.5), 1)\n    assert math.floor(-0.5) == -1, ('assertEqual', math.floor(-0.5), -1)\n    assert math.floor(-1.0) == -1, ('assertEqual', math.floor(-1.0), -1)\n    assert math.floor(-1.5) == -2, ('assertEqual', math.floor(-1.5), -2)\n\n    class TestFloorIsNone(float):\n        __floor__ = None\n\n    class TestFloor:\n\n        def __floor__(self):\n            return 42\n\n    class FloatFloor(float):\n\n        def __floor__(self):\n            return 42\n\n    class TestNoFloor:\n        pass\n\n    class TestBadFloor:\n        __floor__ = BadDescr()\n    assert math.floor(TestFloor()) == 42, ('assertEqual', math.floor(TestFloor()), 42)\n    assert math.floor(FloatFloor()) == 42, ('assertEqual', math.floor(FloatFloor()), 42)\n    assert math.floor(FloatLike(41.9)) == 41, ('assertEqual', math.floor(FloatLike(41.9)), 41)\n    try:\n        math.floor(*(TestNoFloor(),))\n    except TypeError:\n        pass\n    try:\n        math.floor(*(TestBadFloor(),))\n    except ValueError:\n        pass\n    try:\n        math.floor(*(TestFloorIsNone(3.5),))\n    except TypeError:\n        pass\n    t = TestNoFloor()\n    t.__floor__ = lambda *args: args\n    try:\n        math.floor(*(t,))\n    except TypeError:\n        pass\n    try:\n        math.floor(*(t, 0))\n    except TypeError:\n        pass\n    assert math.floor(FloatLike(+1.0)) == +1.0, ('assertEqual', math.floor(FloatLike(+1.0)), +1.0)\n    assert math.floor(FloatLike(-1.0)) == -1.0, ('assertEqual', math.floor(FloatLike(-1.0)), -1.0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testFmod" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.fmod()\n    except TypeError:\n        pass\n    ftest('fmod(10, 1)', math.fmod(10, 1), 0.0)\n    ftest('fmod(10, 0.5)', math.fmod(10, 0.5), 0.0)\n    ftest('fmod(10, 1.5)', math.fmod(10, 1.5), 1.0)\n    ftest('fmod(-10, 1)', math.fmod(-10, 1), -0.0)\n    ftest('fmod(-10, 0.5)', math.fmod(-10, 0.5), -0.0)\n    ftest('fmod(-10, 1.5)', math.fmod(-10, 1.5), -1.0)\n    assert math.isnan(math.fmod(NAN, 1.0)), ('assertTrue', math.isnan(math.fmod(NAN, 1.0)))\n    assert math.isnan(math.fmod(1.0, NAN)), ('assertTrue', math.isnan(math.fmod(1.0, NAN)))\n    assert math.isnan(math.fmod(NAN, NAN)), ('assertTrue', math.isnan(math.fmod(NAN, NAN)))\n    try:\n        math.fmod(*(1.0, 0.0))\n    except ValueError:\n        pass\n    try:\n        math.fmod(*(INF, 1.0))\n    except ValueError:\n        pass\n    try:\n        math.fmod(*(NINF, 1.0))\n    except ValueError:\n        pass\n    try:\n        math.fmod(*(INF, 0.0))\n    except ValueError:\n        pass\n    assert math.fmod(3.0, INF) == 3.0, ('assertEqual', math.fmod(3.0, INF), 3.0)\n    assert math.fmod(-3.0, INF) == -3.0, ('assertEqual', math.fmod(-3.0, INF), -3.0)\n    assert math.fmod(3.0, NINF) == 3.0, ('assertEqual', math.fmod(3.0, NINF), 3.0)\n    assert math.fmod(-3.0, NINF) == -3.0, ('assertEqual', math.fmod(-3.0, NINF), -3.0)\n    assert math.fmod(0.0, 3.0) == 0.0, ('assertEqual', math.fmod(0.0, 3.0), 0.0)\n    assert math.fmod(0.0, NINF) == 0.0, ('assertEqual', math.fmod(0.0, NINF), 0.0)\n    try:\n        math.fmod(*(INF, INF))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testFrexp" {
    (ok, detail) = p2_libtest_run_snippet("import math\neps = 1e-05\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\n\ndef _t():\n    try:\n        math.frexp()\n    except TypeError:\n        pass\n\n    def testfrexp(name, result, expected):\n        (mant, exp), (emant, eexp) = (result, expected)\n        if abs(mant - emant) > eps or exp != eexp:\n            raise AssertionError('%s returned %r, expected %r' % (name, result, expected))\n    testfrexp('frexp(-1)', math.frexp(-1), (-0.5, 1))\n    testfrexp('frexp(0)', math.frexp(0), (0, 0))\n    testfrexp('frexp(1)', math.frexp(1), (0.5, 1))\n    testfrexp('frexp(2)', math.frexp(2), (0.5, 2))\n    assert math.frexp(INF)[0] == INF, ('assertEqual', math.frexp(INF)[0], INF)\n    assert math.frexp(NINF)[0] == NINF, ('assertEqual', math.frexp(NINF)[0], NINF)\n    assert math.isnan(math.frexp(NAN)[0]), ('assertTrue', math.isnan(math.frexp(NAN)[0]))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testFsum" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport random\nx, y = (1e+16, 2.9999)\n\nclass FloatLike:\n\n    def __init__(self, value):\n        self.value = value\n\n    def __float__(self):\n        return self.value\n\ndef _t():\n    from sys import float_info\n    mant_dig = float_info.mant_dig\n    etiny = float_info.min_exp - mant_dig\n\n    def msum(iterable):\n        \"\"\"Full precision summation.  Compute sum(iterable) without any\n            intermediate accumulation of error.  Based on the 'lsum' function\n            at https://code.activestate.com/recipes/393090-binary-floating-point-summation-accurate-to-full-p/\n\n            \"\"\"\n        tmant, texp = (0, 0)\n        for x in iterable:\n            mant, exp = math.frexp(x)\n            mant, exp = (int(math.ldexp(mant, mant_dig)), exp - mant_dig)\n            if texp > exp:\n                tmant <<= texp - exp\n                texp = exp\n            else:\n                mant <<= exp - texp\n            tmant += mant\n        tail = max(len(bin(abs(tmant))) - 2 - mant_dig, etiny - texp)\n        if tail > 0:\n            h = 1 << tail - 1\n            tmant = tmant // (2 * h) + bool(tmant & h and tmant & 3 * h - 1)\n            texp += tail\n        return math.ldexp(tmant, texp)\n    test_values = [([], 0.0), ([0.0], 0.0), ([1e+100, 1.0, -1e+100, 1e-100, 1e+50, -1.0, -1e+50], 1e-100), ([1e+100, 1.0, -1e+100, 1e-100, 1e+50, -1, -1e+50], 1e-100), ([2.0 ** 53, -0.5, -2.0 ** (-54)], 2.0 ** 53 - 1.0), ([2.0 ** 53, 1.0, 2.0 ** (-100)], 2.0 ** 53 + 2.0), ([2.0 ** 53 + 10.0, 1.0, 2.0 ** (-100)], 2.0 ** 53 + 12.0), ([2.0 ** 53 - 4.0, 0.5, 2.0 ** (-54)], 2.0 ** 53 - 3.0), ([1.0 / n for n in range(1, 1001)], float.fromhex('0x1.df11f45f4e61ap+2')), ([(-1.0) ** n / n for n in range(1, 1001)], float.fromhex('-0x1.62a2af1bd3624p-1')), ([1e+16, 1.0, 1e-16], 1.0000000000000002e+16), ([1e+16 - 2.0, 1.0 - 2.0 ** (-53), -(1e+16 - 2.0), -(1.0 - 2.0 ** (-53))], 0.0), ([2.0 ** n - 2.0 ** (n + 50) + 2.0 ** (n + 52) for n in range(-1074, 972, 2)] + [-2.0 ** 1022], float.fromhex('0x1.5555555555555p+970'))]\n    terms = [1.7 ** i for i in range(1001)]\n    test_values.append(([terms[i + 1] - terms[i] for i in range(1000)] + [-terms[1000]], -terms[0]))\n    for i, (vals, expected) in enumerate(test_values):\n        try:\n            actual = math.fsum(vals)\n        except OverflowError:\n            raise AssertionError('test %d failed: got OverflowError, expected %r for math.fsum(%.100r)' % (i, expected, vals))\n        except ValueError:\n            raise AssertionError('test %d failed: got ValueError, expected %r for math.fsum(%.100r)' % (i, expected, vals))\n        assert actual == expected, ('assertEqual', actual, expected)\n    from random import random, gauss, shuffle\n    for j in range(1000):\n        vals = [7, 1e+100, -7, -1e+100, -9e-20, 8e-20] * 10\n        s = 0\n        for i in range(200):\n            v = gauss(0, random()) ** 7 - s\n            s += v\n            vals.append(v)\n        shuffle(vals)\n        s = msum(vals)\n        assert msum(vals) == math.fsum(vals), ('assertEqual', msum(vals), math.fsum(vals))\n    assert math.fsum([1.0, math.inf]) == math.inf, ('assertEqual', math.fsum([1.0, math.inf]), math.inf)\n    assert math.isnan(math.fsum([math.nan, 1.0])), ('assertTrue', math.isnan(math.fsum([math.nan, 1.0])))\n    assert math.fsum([1e+100, FloatLike(1.0), -1e+100, 1e-100, 1e+50, FloatLike(-1.0), -1e+50]) == 1e-100, ('assertEqual', math.fsum([1e+100, FloatLike(1.0), -1e+100, 1e-100, 1e+50, FloatLike(-1.0), -1e+50]), 1e-100)\n    try:\n        math.fsum(*([1e+308, 1e+308],))\n    except OverflowError:\n        pass\n    try:\n        math.fsum(*([math.inf, -math.inf],))\n    except ValueError:\n        pass\n    try:\n        math.fsum(*(['spam'],))\n    except TypeError:\n        pass\n    try:\n        math.fsum(*(1,))\n    except TypeError:\n        pass\n    try:\n        math.fsum(*([10 ** 1000],))\n    except OverflowError:\n        pass\n\n    def bad_iter():\n        yield 1.0\n        raise ZeroDivisionError\n    try:\n        math.fsum(*(bad_iter(),))\n    except ZeroDivisionError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testGcd" {
    (ok, detail) = p2_libtest_run_snippet("import math\nx, y = (1e+16, 2.9999)\n\nclass MyIndexable(object):\n\n    def __init__(self, value):\n        self.value = value\n\n    def __index__(self):\n        return self.value\n\ndef _t():\n    gcd = math.gcd\n    assert gcd(0, 0) == 0, ('assertEqual', gcd(0, 0), 0)\n    assert gcd(1, 0) == 1, ('assertEqual', gcd(1, 0), 1)\n    assert gcd(-1, 0) == 1, ('assertEqual', gcd(-1, 0), 1)\n    assert gcd(0, 1) == 1, ('assertEqual', gcd(0, 1), 1)\n    assert gcd(0, -1) == 1, ('assertEqual', gcd(0, -1), 1)\n    assert gcd(7, 1) == 1, ('assertEqual', gcd(7, 1), 1)\n    assert gcd(7, -1) == 1, ('assertEqual', gcd(7, -1), 1)\n    assert gcd(-23, 15) == 1, ('assertEqual', gcd(-23, 15), 1)\n    assert gcd(120, 84) == 12, ('assertEqual', gcd(120, 84), 12)\n    assert gcd(84, -120) == 12, ('assertEqual', gcd(84, -120), 12)\n    assert gcd(1216342683557601535506311712, 436522681849110124616458784) == 32, ('assertEqual', gcd(1216342683557601535506311712, 436522681849110124616458784), 32)\n    x = 434610456570399902378880679233098819019853229470286994367836600566\n    y = 1064502245825115327754847244914921553977\n    for c in (652560, 576559230871654959816130551884856912003141446781646602790216406874):\n        a = x * c\n        b = y * c\n        assert gcd(a, b) == c, ('assertEqual', gcd(a, b), c)\n        assert gcd(b, a) == c, ('assertEqual', gcd(b, a), c)\n        assert gcd(-a, b) == c, ('assertEqual', gcd(-a, b), c)\n        assert gcd(b, -a) == c, ('assertEqual', gcd(b, -a), c)\n        assert gcd(a, -b) == c, ('assertEqual', gcd(a, -b), c)\n        assert gcd(-b, a) == c, ('assertEqual', gcd(-b, a), c)\n        assert gcd(-a, -b) == c, ('assertEqual', gcd(-a, -b), c)\n        assert gcd(-b, -a) == c, ('assertEqual', gcd(-b, -a), c)\n    assert gcd() == 0, ('assertEqual', gcd(), 0)\n    assert gcd(120) == 120, ('assertEqual', gcd(120), 120)\n    assert gcd(-120) == 120, ('assertEqual', gcd(-120), 120)\n    assert gcd(120, 84, 102) == 6, ('assertEqual', gcd(120, 84, 102), 6)\n    assert gcd(120, 1, 84) == 1, ('assertEqual', gcd(120, 1, 84), 1)\n    try:\n        gcd(*(120.0,))\n    except TypeError:\n        pass\n    try:\n        gcd(*(120.0, 84))\n    except TypeError:\n        pass\n    try:\n        gcd(*(120, 84.0))\n    except TypeError:\n        pass\n    try:\n        gcd(*(120, 1, 84.0))\n    except TypeError:\n        pass\n    assert gcd(MyIndexable(120), MyIndexable(84)) == 12, ('assertEqual', gcd(MyIndexable(120), MyIndexable(84)), 12)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testHypot" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport sys\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nFLOAT_MAX = sys.float_info.max\nFLOAT_MIN = sys.float_info.min\n\nclass FloatLike:\n\n    def __init__(self, value):\n        self.value = value\n\n    def __float__(self):\n        return self.value\n\ndef _t():\n    from decimal import Decimal\n    from fractions import Fraction\n    hypot = math.hypot\n    args = (math.e, math.pi, math.sqrt(2.0), math.gamma(3.5), math.sin(2.1))\n    for i in range(len(args) + 1):\n        assert round(hypot(*args[:i]) - math.sqrt(sum((s ** 2 for s in args[:i]))), 7) == 0, ('assertAlmostEqual', hypot(*args[:i]), math.sqrt(sum((s ** 2 for s in args[:i]))))\n    assert hypot(12.0, 5.0) == 13.0, ('assertEqual', hypot(12.0, 5.0), 13.0)\n    assert hypot(12, 5) == 13, ('assertEqual', hypot(12, 5), 13)\n    assert hypot(0.75, -1) == 1.25, ('assertEqual', hypot(0.75, -1), 1.25)\n    assert hypot(-1, 0.75) == 1.25, ('assertEqual', hypot(-1, 0.75), 1.25)\n    assert hypot(0.75, FloatLike(-1.0)) == 1.25, ('assertEqual', hypot(0.75, FloatLike(-1.0)), 1.25)\n    assert hypot(FloatLike(-1.0), 0.75) == 1.25, ('assertEqual', hypot(FloatLike(-1.0), 0.75), 1.25)\n    assert hypot(Decimal(12), Decimal(5)) == 13, ('assertEqual', hypot(Decimal(12), Decimal(5)), 13)\n    assert hypot(Fraction(12, 32), Fraction(5, 32)) == Fraction(13, 32), ('assertEqual', hypot(Fraction(12, 32), Fraction(5, 32)), Fraction(13, 32))\n    assert hypot(True, False, True, True, True) == 2.0, ('assertEqual', hypot(True, False, True, True, True), 2.0)\n    assert hypot(0.0, 0.0) == 0.0, ('assertEqual', hypot(0.0, 0.0), 0.0)\n    assert hypot(-10.5) == 10.5, ('assertEqual', hypot(-10.5), 10.5)\n    assert hypot() == 0.0, ('assertEqual', hypot(), 0.0)\n    assert 1.0 == math.copysign(1.0, hypot(-0.0)), ('assertEqual', 1.0, math.copysign(1.0, hypot(-0.0)))\n    assert hypot(1.5, 1.5, 0.5) == hypot(1.5, 0.5, 1.5), ('assertEqual', hypot(1.5, 1.5, 0.5), hypot(1.5, 0.5, 1.5))\n    try:\n        hypot(x=1)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        hypot(1.1, 'string', 2.2)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    int_too_big_for_float = 10 ** (sys.float_info.max_10_exp + 5)\n    try:\n        hypot(1, int_too_big_for_float)\n    except (ValueError, OverflowError) as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert hypot(INF) == INF, ('assertEqual', hypot(INF), INF)\n    assert hypot(0, INF) == INF, ('assertEqual', hypot(0, INF), INF)\n    assert hypot(10, INF) == INF, ('assertEqual', hypot(10, INF), INF)\n    assert hypot(-10, INF) == INF, ('assertEqual', hypot(-10, INF), INF)\n    assert hypot(NAN, INF) == INF, ('assertEqual', hypot(NAN, INF), INF)\n    assert hypot(INF, NAN) == INF, ('assertEqual', hypot(INF, NAN), INF)\n    assert hypot(NINF, NAN) == INF, ('assertEqual', hypot(NINF, NAN), INF)\n    assert hypot(NAN, NINF) == INF, ('assertEqual', hypot(NAN, NINF), INF)\n    assert hypot(-INF, INF) == INF, ('assertEqual', hypot(-INF, INF), INF)\n    assert hypot(-INF, -INF) == INF, ('assertEqual', hypot(-INF, -INF), INF)\n    assert hypot(10, -INF) == INF, ('assertEqual', hypot(10, -INF), INF)\n    assert math.isnan(hypot(NAN)), ('assertTrue', math.isnan(hypot(NAN)))\n    assert math.isnan(hypot(0, NAN)), ('assertTrue', math.isnan(hypot(0, NAN)))\n    assert math.isnan(hypot(NAN, 10)), ('assertTrue', math.isnan(hypot(NAN, 10)))\n    assert math.isnan(hypot(10, NAN)), ('assertTrue', math.isnan(hypot(10, NAN)))\n    assert math.isnan(hypot(NAN, NAN)), ('assertTrue', math.isnan(hypot(NAN, NAN)))\n    assert math.isnan(hypot(NAN)), ('assertTrue', math.isnan(hypot(NAN)))\n    fourthmax = FLOAT_MAX / 4.0\n    for n in range(32):\n        assert math.isclose(hypot(*[fourthmax] * n), fourthmax * math.sqrt(n)), ('assertTrue', math.isclose(hypot(*[fourthmax] * n), fourthmax * math.sqrt(n)))\n    for exp in range(32):\n        scale = FLOAT_MIN / 2.0 ** exp\n        assert math.hypot(4 * scale, 3 * scale) == 5 * scale, ('assertEqual', math.hypot(4 * scale, 3 * scale), 5 * scale)\n    try:\n        math.hypot(*(*[1.0] * 18, 'spam'))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testHypotAccuracy" {
    (ok, detail) = p2_libtest_run_snippet("import decimal\nimport math\nx, y = (1e+16, 2.9999)\n\ndef _t():\n    hypot = math.hypot\n    Decimal = decimal.Decimal\n    high_precision = decimal.Context(prec=500)\n    for hx, hy in [('0x1.10e89518dca48p+29', '0x1.1970f7565b7efp+30'), ('0x1.10106eb4b44a2p+29', '0x1.ef0596cdc97f8p+29'), ('0x1.459c058e20bb7p+30', '0x1.993ca009b9178p+29'), ('0x1.378371ae67c0cp+30', '0x1.fbe6619854b4cp+29'), ('0x1.f4cd0574fb97ap+29', '0x1.50fe31669340ep+30'), ('0x1.494b2cdd3d446p+29', '0x1.212a5367b4c7cp+29'), ('0x1.f84e649f1e46dp+29', '0x1.1fa56bef8eec4p+30'), ('0x1.2e817edd3d6fap+30', '0x1.eb0814f1e9602p+29'), ('0x1.0d3a6e3d04245p+29', '0x1.32a62fea52352p+30'), ('0x1.888e19611bfc5p+29', '0x1.52b8e70b24353p+29'), ('0x1.538816d48a13fp+29', '0x1.7967c5ca43e16p+29'), ('0x1.57b47b7234530p+29', '0x1.74e2c7040e772p+29'), ('0x1.821b685e9b168p+30', '0x1.677dc1c1e3dc6p+29'), ('0x1.9e8247f67097bp+29', '0x1.24bd2dc4f4baep+29'), ('0x1.b73b59e0cb5f9p+29', '0x1.da899ab784a97p+28'), ('0x1.94a8d2842a7cfp+30', '0x1.326a51d4d8d8ap+30'), ('0x1.e930b9cd99035p+29', '0x1.5a1030e18dff9p+30'), ('0x1.1592bbb0e4690p+29', '0x1.a9c337b33fb9ap+29'), ('0x1.1243a50751fd4p+29', '0x1.a5a10175622d9p+29'), ('0x1.57a8596e74722p+30', '0x1.42d1af9d04da9p+30'), ('0x1.ee7dbd9565899p+29', '0x1.7ab4d6fc6e4b4p+29'), ('0x1.5c6bfbec5c4dcp+30', '0x1.02511184b4970p+30'), ('0x1.59dcebba995cap+30', '0x1.50ca7e7c38854p+29'), ('0x1.768cdd94cf5aap+29', '0x1.9cfdc5571d38ep+29'), ('0x1.dcf137d60262ep+29', '0x1.1101621990b3ep+30'), ('0x1.3a2d006e288b0p+30', '0x1.e9a240914326cp+29'), ('0x1.62a32f7f53c61p+29', '0x1.47eb6cd72684fp+29'), ('0x1.d3bcb60748ef2p+29', '0x1.3f13c4056312cp+30'), ('0x1.282bdb82f17f3p+30', '0x1.640ba4c4eed3ap+30'), ('0x1.89d8c423ea0c6p+29', '0x1.d35dcfe902bc3p+29')]:\n        x = float.fromhex(hx)\n        y = float.fromhex(hy)\n        with decimal.localcontext(high_precision):\n            z = float((Decimal(x) ** 2 + Decimal(y) ** 2).sqrt())\n        assert hypot(x, y) == z, ('assertEqual', hypot(x, y), z)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testDist" {
    (ok, detail) = p2_libtest_run_snippet("import itertools\nimport math\nimport random\nimport sys\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nFLOAT_MAX = sys.float_info.max\nFLOAT_MIN = sys.float_info.min\n\nclass FloatLike:\n\n    def __init__(self, value):\n        self.value = value\n\n    def __float__(self):\n        return self.value\n\nclass BadDescr:\n\n    def __get__(self, obj, objtype=None):\n        raise ValueError\n\ndef _t():\n    from decimal import Decimal as D\n    from fractions import Fraction as F\n    dist = math.dist\n    sqrt = math.sqrt\n    assert dist((1.0, 2.0, 3.0), (4.0, 2.0, -1.0)) == 5.0, ('assertEqual', dist((1.0, 2.0, 3.0), (4.0, 2.0, -1.0)), 5.0)\n    assert dist((1, 2, 3), (4, 2, -1)) == 5.0, ('assertEqual', dist((1, 2, 3), (4, 2, -1)), 5.0)\n    for i in range(9):\n        for j in range(5):\n            p = tuple((random.uniform(-5, 5) for k in range(i)))\n            q = tuple((random.uniform(-5, 5) for k in range(i)))\n            assert round(dist(p, q) - sqrt(sum(((px - qx) ** 2.0 for px, qx in zip(p, q)))), 7) == 0, ('assertAlmostEqual', dist(p, q), sqrt(sum(((px - qx) ** 2.0 for px, qx in zip(p, q)))))\n    assert dist([1.0, 2.0, 3.0], [4.0, 2.0, -1.0]) == 5.0, ('assertEqual', dist([1.0, 2.0, 3.0], [4.0, 2.0, -1.0]), 5.0)\n    assert dist(iter([1.0, 2.0, 3.0]), iter([4.0, 2.0, -1.0])) == 5.0, ('assertEqual', dist(iter([1.0, 2.0, 3.0]), iter([4.0, 2.0, -1.0])), 5.0)\n    assert dist((14.0, 1.0), (2.0, -4.0)) == 13.0, ('assertEqual', dist((14.0, 1.0), (2.0, -4.0)), 13.0)\n    assert dist((14, 1), (2, -4)) == 13, ('assertEqual', dist((14, 1), (2, -4)), 13)\n    assert dist((FloatLike(14.0), 1), (2, -4)) == 13, ('assertEqual', dist((FloatLike(14.0), 1), (2, -4)), 13)\n    assert dist((11, 1), (FloatLike(-1.0), -4)) == 13, ('assertEqual', dist((11, 1), (FloatLike(-1.0), -4)), 13)\n    assert dist((14, FloatLike(-1.0)), (2, -6)) == 13, ('assertEqual', dist((14, FloatLike(-1.0)), (2, -6)), 13)\n    assert dist((14, -1), (2, -6)) == 13, ('assertEqual', dist((14, -1), (2, -6)), 13)\n    assert dist((D(14), D(1)), (D(2), D(-4))) == D(13), ('assertEqual', dist((D(14), D(1)), (D(2), D(-4))), D(13))\n    assert dist((F(14, 32), F(1, 32)), (F(2, 32), F(-4, 32))) == F(13, 32), ('assertEqual', dist((F(14, 32), F(1, 32)), (F(2, 32), F(-4, 32))), F(13, 32))\n    assert dist((True, True, False, False, True, True), (True, False, True, False, False, False)) == 2.0, ('assertEqual', dist((True, True, False, False, True, True), (True, False, True, False, False, False)), 2.0)\n    assert dist((13.25, 12.5, -3.25), (13.25, 12.5, -3.25)) == 0.0, ('assertEqual', dist((13.25, 12.5, -3.25), (13.25, 12.5, -3.25)), 0.0)\n    assert dist((), ()) == 0.0, ('assertEqual', dist((), ()), 0.0)\n    assert 1.0 == math.copysign(1.0, dist((-0.0,), (0.0,))), ('assertEqual', 1.0, math.copysign(1.0, dist((-0.0,), (0.0,))))\n    assert 1.0 == math.copysign(1.0, dist((0.0,), (-0.0,))), ('assertEqual', 1.0, math.copysign(1.0, dist((0.0,), (-0.0,))))\n    assert dist((1.5, 1.5, 0.5), (0, 0, 0)) == dist((1.5, 0.5, 1.5), (0, 0, 0)), ('assertEqual', dist((1.5, 1.5, 0.5), (0, 0, 0)), dist((1.5, 0.5, 1.5), (0, 0, 0)))\n\n    class T(tuple):\n        pass\n    assert dist(T((1, 2, 3)), (4, 2, -1)) == 5.0, ('assertEqual', dist(T((1, 2, 3)), (4, 2, -1)), 5.0)\n    try:\n        dist(p=(1, 2, 3), q=(4, 5, 6))\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist((1, 2, 3))\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist((1, 2, 3), (4, 5, 6), (7, 8, 9))\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist(1, 2)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist((1.1, 'string', 2.2), (1, 2, 3))\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist((1, 2, 3, 4), (5, 6, 7))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist((1, 2, 3), (4, 5, 6, 7))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist((1,) * 17 + ('spam',), (1,) * 18)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist('abc', 'xyz')\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    int_too_big_for_float = 10 ** (sys.float_info.max_10_exp + 5)\n    try:\n        dist((1, int_too_big_for_float), (2, 3))\n    except (ValueError, OverflowError) as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist((2, 3), (1, int_too_big_for_float))\n    except (ValueError, OverflowError) as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist((1,), 2)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dist([1], 2)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\n    class BadFloat:\n        __float__ = BadDescr()\n    try:\n        dist([1], [BadFloat()])\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    for i in range(20):\n        p, q = (random.random(), random.random())\n        assert dist((p,), (q,)) == abs(p - q), ('assertEqual', dist((p,), (q,)), abs(p - q))\n    values = [NINF, -10.5, -0.0, 0.0, 10.5, INF, NAN]\n    for p in itertools.product(values, repeat=3):\n        for q in itertools.product(values, repeat=3):\n            diffs = [px - qx for px, qx in zip(p, q)]\n            if any(map(math.isinf, diffs)):\n                assert dist(p, q) == INF, ('assertEqual', dist(p, q), INF)\n            elif any(map(math.isnan, diffs)):\n                assert math.isnan(dist(p, q)), ('assertTrue', math.isnan(dist(p, q)))\n    fourthmax = FLOAT_MAX / 4.0\n    for n in range(32):\n        p = (fourthmax,) * n\n        q = (0.0,) * n\n        assert math.isclose(dist(p, q), fourthmax * math.sqrt(n)), ('assertTrue', math.isclose(dist(p, q), fourthmax * math.sqrt(n)))\n        assert math.isclose(dist(q, p), fourthmax * math.sqrt(n)), ('assertTrue', math.isclose(dist(q, p), fourthmax * math.sqrt(n)))\n    for exp in range(32):\n        scale = FLOAT_MIN / 2.0 ** exp\n        p = (4 * scale, 3 * scale)\n        q = (0.0, 0.0)\n        assert math.dist(p, q) == 5 * scale, ('assertEqual', math.dist(p, q), 5 * scale)\n        assert math.dist(q, p) == 5 * scale, ('assertEqual', math.dist(q, p), 5 * scale)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.test_math_dist_leak" {
    (ok, detail) = p2_libtest_run_snippet("import math\n\ndef _t():\n    try:\n        math.dist([1, 2], [3, 4, 5])\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testIsqrt" {
    (ok, detail) = p2_libtest_run_snippet("import decimal\nimport math\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    test_values = list(range(1000)) + list(range(10 ** 6 - 1000, 10 ** 6 + 1000)) + [2 ** e + i for e in range(60, 200) for i in range(-40, 40)] + [3 ** 9999, 10 ** 5001]\n    for value in test_values:\n        s = math.isqrt(value)\n        assert type(s) is int, ('assertIs', type(s), int)\n        assert s * s <= value, ('assertLessEqual', s * s, value)\n        assert value < (s + 1) * (s + 1), ('assertLess', value, (s + 1) * (s + 1))\n    try:\n        math.isqrt(-1)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    s = math.isqrt(True)\n    assert type(s) is int, ('assertIs', type(s), int)\n    assert s == 1, ('assertEqual', s, 1)\n    s = math.isqrt(False)\n    assert type(s) is int, ('assertIs', type(s), int)\n    assert s == 0, ('assertEqual', s, 0)\n\n    class IntegerLike(object):\n\n        def __init__(self, value):\n            self.value = value\n\n        def __index__(self):\n            return self.value\n    s = math.isqrt(IntegerLike(1729))\n    assert type(s) is int, ('assertIs', type(s), int)\n    assert s == 41, ('assertEqual', s, 41)\n    try:\n        math.isqrt(IntegerLike(-3))\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    bad_values = [3.5, 'a string', decimal.Decimal('3.5'), 3.5j, 100.0, -4.0]\n    for value in bad_values:\n        try:\n            math.isqrt(value)\n        except TypeError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.test_lcm" {
    (ok, detail) = p2_libtest_run_snippet("import math\nx, y = (1e+16, 2.9999)\n\nclass MyIndexable(object):\n\n    def __init__(self, value):\n        self.value = value\n\n    def __index__(self):\n        return self.value\n\ndef _t():\n    lcm = math.lcm\n    assert lcm(0, 0) == 0, ('assertEqual', lcm(0, 0), 0)\n    assert lcm(1, 0) == 0, ('assertEqual', lcm(1, 0), 0)\n    assert lcm(-1, 0) == 0, ('assertEqual', lcm(-1, 0), 0)\n    assert lcm(0, 1) == 0, ('assertEqual', lcm(0, 1), 0)\n    assert lcm(0, -1) == 0, ('assertEqual', lcm(0, -1), 0)\n    assert lcm(7, 1) == 7, ('assertEqual', lcm(7, 1), 7)\n    assert lcm(7, -1) == 7, ('assertEqual', lcm(7, -1), 7)\n    assert lcm(-23, 15) == 345, ('assertEqual', lcm(-23, 15), 345)\n    assert lcm(120, 84) == 840, ('assertEqual', lcm(120, 84), 840)\n    assert lcm(84, -120) == 840, ('assertEqual', lcm(84, -120), 840)\n    assert lcm(1216342683557601535506311712, 436522681849110124616458784) == 16592536571065866494401400422922201534178938447014944, ('assertEqual', lcm(1216342683557601535506311712, 436522681849110124616458784), 16592536571065866494401400422922201534178938447014944)\n    x = 43461045657039990237\n    y = 10645022458251153277\n    for c in (652560, 57655923087165495981):\n        a = x * c\n        b = y * c\n        d = x * y * c\n        assert lcm(a, b) == d, ('assertEqual', lcm(a, b), d)\n        assert lcm(b, a) == d, ('assertEqual', lcm(b, a), d)\n        assert lcm(-a, b) == d, ('assertEqual', lcm(-a, b), d)\n        assert lcm(b, -a) == d, ('assertEqual', lcm(b, -a), d)\n        assert lcm(a, -b) == d, ('assertEqual', lcm(a, -b), d)\n        assert lcm(-b, a) == d, ('assertEqual', lcm(-b, a), d)\n        assert lcm(-a, -b) == d, ('assertEqual', lcm(-a, -b), d)\n        assert lcm(-b, -a) == d, ('assertEqual', lcm(-b, -a), d)\n    assert lcm() == 1, ('assertEqual', lcm(), 1)\n    assert lcm(120) == 120, ('assertEqual', lcm(120), 120)\n    assert lcm(-120) == 120, ('assertEqual', lcm(-120), 120)\n    assert lcm(120, 84, 102) == 14280, ('assertEqual', lcm(120, 84, 102), 14280)\n    assert lcm(120, 0, 84) == 0, ('assertEqual', lcm(120, 0, 84), 0)\n    try:\n        lcm(*(120.0,))\n    except TypeError:\n        pass\n    try:\n        lcm(*(120.0, 84))\n    except TypeError:\n        pass\n    try:\n        lcm(*(120, 84.0))\n    except TypeError:\n        pass\n    try:\n        lcm(*(120, 0, 84.0))\n    except TypeError:\n        pass\n    assert lcm(MyIndexable(120), MyIndexable(84)) == 840, ('assertEqual', lcm(MyIndexable(120), MyIndexable(84)), 840)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testLdexp" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.ldexp()\n    except TypeError:\n        pass\n    try:\n        math.ldexp(*(2.0, 1.1))\n    except TypeError:\n        pass\n    ftest('ldexp(0,1)', math.ldexp(0, 1), 0)\n    ftest('ldexp(1,1)', math.ldexp(1, 1), 2)\n    ftest('ldexp(1,-1)', math.ldexp(1, -1), 0.5)\n    ftest('ldexp(-1,1)', math.ldexp(-1, 1), -2)\n    try:\n        math.ldexp(*(1.0, 1000000))\n    except OverflowError:\n        pass\n    try:\n        math.ldexp(*(-1.0, 1000000))\n    except OverflowError:\n        pass\n    assert math.ldexp(1.0, -1000000) == 0.0, ('assertEqual', math.ldexp(1.0, -1000000), 0.0)\n    assert math.ldexp(-1.0, -1000000) == -0.0, ('assertEqual', math.ldexp(-1.0, -1000000), -0.0)\n    assert math.ldexp(INF, 30) == INF, ('assertEqual', math.ldexp(INF, 30), INF)\n    assert math.ldexp(NINF, -213) == NINF, ('assertEqual', math.ldexp(NINF, -213), NINF)\n    assert math.isnan(math.ldexp(NAN, 0)), ('assertTrue', math.isnan(math.ldexp(NAN, 0)))\n    for n in [10 ** 5, 10 ** 10, 10 ** 20, 10 ** 40]:\n        assert math.ldexp(INF, -n) == INF, ('assertEqual', math.ldexp(INF, -n), INF)\n        assert math.ldexp(NINF, -n) == NINF, ('assertEqual', math.ldexp(NINF, -n), NINF)\n        assert math.ldexp(1.0, -n) == 0.0, ('assertEqual', math.ldexp(1.0, -n), 0.0)\n        assert math.ldexp(-1.0, -n) == -0.0, ('assertEqual', math.ldexp(-1.0, -n), -0.0)\n        assert math.ldexp(0.0, -n) == 0.0, ('assertEqual', math.ldexp(0.0, -n), 0.0)\n        assert math.ldexp(-0.0, -n) == -0.0, ('assertEqual', math.ldexp(-0.0, -n), -0.0)\n        assert math.isnan(math.ldexp(NAN, -n)), ('assertTrue', math.isnan(math.ldexp(NAN, -n)))\n        try:\n            math.ldexp(*(1.0, n))\n        except OverflowError:\n            pass\n        try:\n            math.ldexp(*(-1.0, n))\n        except OverflowError:\n            pass\n        assert math.ldexp(0.0, n) == 0.0, ('assertEqual', math.ldexp(0.0, n), 0.0)\n        assert math.ldexp(-0.0, n) == -0.0, ('assertEqual', math.ldexp(-0.0, n), -0.0)\n        assert math.ldexp(INF, n) == INF, ('assertEqual', math.ldexp(INF, n), INF)\n        assert math.ldexp(NINF, n) == NINF, ('assertEqual', math.ldexp(NINF, n), NINF)\n        assert math.isnan(math.ldexp(NAN, n)), ('assertTrue', math.isnan(math.ldexp(NAN, n)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

