test "MathTests.testAtan" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.atan()\n    except TypeError:\n        pass\n    ftest('atan(-1)', math.atan(-1), -math.pi / 4)\n    ftest('atan(0)', math.atan(0), 0)\n    ftest('atan(1)', math.atan(1), math.pi / 4)\n    ftest('atan(inf)', math.atan(INF), math.pi / 2)\n    ftest('atan(-inf)', math.atan(NINF), -math.pi / 2)\n    assert math.isnan(math.atan(NAN)), ('assertTrue', math.isnan(math.atan(NAN)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testAtanh" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.atan()\n    except TypeError:\n        pass\n    ftest('atanh(0)', math.atanh(0), 0)\n    ftest('atanh(0.5)', math.atanh(0.5), 0.5493061443340549)\n    ftest('atanh(-0.5)', math.atanh(-0.5), -0.5493061443340549)\n    try:\n        math.atanh(*(1,))\n    except ValueError:\n        pass\n    try:\n        math.atanh(*(-1,))\n    except ValueError:\n        pass\n    try:\n        math.atanh(*(INF,))\n    except ValueError:\n        pass\n    try:\n        math.atanh(*(NINF,))\n    except ValueError:\n        pass\n    assert math.isnan(math.atanh(NAN)), ('assertTrue', math.isnan(math.atanh(NAN)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testAtan2" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.atan2()\n    except TypeError:\n        pass\n    ftest('atan2(-1, 0)', math.atan2(-1, 0), -math.pi / 2)\n    ftest('atan2(-1, 1)', math.atan2(-1, 1), -math.pi / 4)\n    ftest('atan2(0, 1)', math.atan2(0, 1), 0)\n    ftest('atan2(1, 1)', math.atan2(1, 1), math.pi / 4)\n    ftest('atan2(1, 0)', math.atan2(1, 0), math.pi / 2)\n    ftest('atan2(1, -1)', math.atan2(1, -1), 3 * math.pi / 4)\n    ftest('atan2(0., -inf)', math.atan2(0.0, NINF), math.pi)\n    ftest('atan2(0., -2.3)', math.atan2(0.0, -2.3), math.pi)\n    ftest('atan2(0., -0.)', math.atan2(0.0, -0.0), math.pi)\n    assert math.atan2(0.0, 0.0) == 0.0, ('assertEqual', math.atan2(0.0, 0.0), 0.0)\n    assert math.atan2(0.0, 2.3) == 0.0, ('assertEqual', math.atan2(0.0, 2.3), 0.0)\n    assert math.atan2(0.0, INF) == 0.0, ('assertEqual', math.atan2(0.0, INF), 0.0)\n    assert math.isnan(math.atan2(0.0, NAN)), ('assertTrue', math.isnan(math.atan2(0.0, NAN)))\n    ftest('atan2(-0., -inf)', math.atan2(-0.0, NINF), -math.pi)\n    ftest('atan2(-0., -2.3)', math.atan2(-0.0, -2.3), -math.pi)\n    ftest('atan2(-0., -0.)', math.atan2(-0.0, -0.0), -math.pi)\n    assert math.atan2(-0.0, 0.0) == -0.0, ('assertEqual', math.atan2(-0.0, 0.0), -0.0)\n    assert math.atan2(-0.0, 2.3) == -0.0, ('assertEqual', math.atan2(-0.0, 2.3), -0.0)\n    assert math.atan2(-0.0, INF) == -0.0, ('assertEqual', math.atan2(-0.0, INF), -0.0)\n    assert math.isnan(math.atan2(-0.0, NAN)), ('assertTrue', math.isnan(math.atan2(-0.0, NAN)))\n    ftest('atan2(inf, -inf)', math.atan2(INF, NINF), math.pi * 3 / 4)\n    ftest('atan2(inf, -2.3)', math.atan2(INF, -2.3), math.pi / 2)\n    ftest('atan2(inf, -0.)', math.atan2(INF, -0.0), math.pi / 2)\n    ftest('atan2(inf, 0.)', math.atan2(INF, 0.0), math.pi / 2)\n    ftest('atan2(inf, 2.3)', math.atan2(INF, 2.3), math.pi / 2)\n    ftest('atan2(inf, inf)', math.atan2(INF, INF), math.pi / 4)\n    assert math.isnan(math.atan2(INF, NAN)), ('assertTrue', math.isnan(math.atan2(INF, NAN)))\n    ftest('atan2(-inf, -inf)', math.atan2(NINF, NINF), -math.pi * 3 / 4)\n    ftest('atan2(-inf, -2.3)', math.atan2(NINF, -2.3), -math.pi / 2)\n    ftest('atan2(-inf, -0.)', math.atan2(NINF, -0.0), -math.pi / 2)\n    ftest('atan2(-inf, 0.)', math.atan2(NINF, 0.0), -math.pi / 2)\n    ftest('atan2(-inf, 2.3)', math.atan2(NINF, 2.3), -math.pi / 2)\n    ftest('atan2(-inf, inf)', math.atan2(NINF, INF), -math.pi / 4)\n    assert math.isnan(math.atan2(NINF, NAN)), ('assertTrue', math.isnan(math.atan2(NINF, NAN)))\n    ftest('atan2(2.3, -inf)', math.atan2(2.3, NINF), math.pi)\n    ftest('atan2(2.3, -0.)', math.atan2(2.3, -0.0), math.pi / 2)\n    ftest('atan2(2.3, 0.)', math.atan2(2.3, 0.0), math.pi / 2)\n    assert math.atan2(2.3, INF) == 0.0, ('assertEqual', math.atan2(2.3, INF), 0.0)\n    assert math.isnan(math.atan2(2.3, NAN)), ('assertTrue', math.isnan(math.atan2(2.3, NAN)))\n    ftest('atan2(-2.3, -inf)', math.atan2(-2.3, NINF), -math.pi)\n    ftest('atan2(-2.3, -0.)', math.atan2(-2.3, -0.0), -math.pi / 2)\n    ftest('atan2(-2.3, 0.)', math.atan2(-2.3, 0.0), -math.pi / 2)\n    assert math.atan2(-2.3, INF) == -0.0, ('assertEqual', math.atan2(-2.3, INF), -0.0)\n    assert math.isnan(math.atan2(-2.3, NAN)), ('assertTrue', math.isnan(math.atan2(-2.3, NAN)))\n    assert math.isnan(math.atan2(NAN, NINF)), ('assertTrue', math.isnan(math.atan2(NAN, NINF)))\n    assert math.isnan(math.atan2(NAN, -2.3)), ('assertTrue', math.isnan(math.atan2(NAN, -2.3)))\n    assert math.isnan(math.atan2(NAN, -0.0)), ('assertTrue', math.isnan(math.atan2(NAN, -0.0)))\n    assert math.isnan(math.atan2(NAN, 0.0)), ('assertTrue', math.isnan(math.atan2(NAN, 0.0)))\n    assert math.isnan(math.atan2(NAN, 2.3)), ('assertTrue', math.isnan(math.atan2(NAN, 2.3)))\n    assert math.isnan(math.atan2(NAN, INF)), ('assertTrue', math.isnan(math.atan2(NAN, INF)))\n    assert math.isnan(math.atan2(NAN, NAN)), ('assertTrue', math.isnan(math.atan2(NAN, NAN)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testCbrt" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.cbrt()\n    except TypeError:\n        pass\n    ftest('cbrt(0)', math.cbrt(0), 0)\n    ftest('cbrt(1)', math.cbrt(1), 1)\n    ftest('cbrt(8)', math.cbrt(8), 2)\n    ftest('cbrt(0.0)', math.cbrt(0.0), 0.0)\n    ftest('cbrt(-0.0)', math.cbrt(-0.0), -0.0)\n    ftest('cbrt(1.2)', math.cbrt(1.2), 1.062658569182611)\n    ftest('cbrt(-2.6)', math.cbrt(-2.6), -1.375068867074141)\n    ftest('cbrt(27)', math.cbrt(27), 3)\n    ftest('cbrt(-1)', math.cbrt(-1), -1)\n    ftest('cbrt(-27)', math.cbrt(-27), -3)\n    assert math.cbrt(INF) == INF, ('assertEqual', math.cbrt(INF), INF)\n    assert math.cbrt(NINF) == NINF, ('assertEqual', math.cbrt(NINF), NINF)\n    assert math.isnan(math.cbrt(NAN)), ('assertTrue', math.isnan(math.cbrt(NAN)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testCeil" {
    (ok, detail) = p2_libtest_run_snippet("import math\n\nclass FloatLike:\n\n    def __init__(self, value):\n        self.value = value\n\n    def __float__(self):\n        return self.value\n\nclass BadDescr:\n\n    def __get__(self, obj, objtype=None):\n        raise ValueError\n\ndef _t():\n    try:\n        math.ceil()\n    except TypeError:\n        pass\n    assert int == type(math.ceil(0.5)), ('assertEqual', int, type(math.ceil(0.5)))\n    assert math.ceil(0.5) == 1, ('assertEqual', math.ceil(0.5), 1)\n    assert math.ceil(1.0) == 1, ('assertEqual', math.ceil(1.0), 1)\n    assert math.ceil(1.5) == 2, ('assertEqual', math.ceil(1.5), 2)\n    assert math.ceil(-0.5) == 0, ('assertEqual', math.ceil(-0.5), 0)\n    assert math.ceil(-1.0) == -1, ('assertEqual', math.ceil(-1.0), -1)\n    assert math.ceil(-1.5) == -1, ('assertEqual', math.ceil(-1.5), -1)\n    assert math.ceil(0.0) == 0, ('assertEqual', math.ceil(0.0), 0)\n    assert math.ceil(-0.0) == 0, ('assertEqual', math.ceil(-0.0), 0)\n\n    class TestCeil:\n\n        def __ceil__(self):\n            return 42\n\n    class FloatCeil(float):\n\n        def __ceil__(self):\n            return 42\n\n    class TestNoCeil:\n        pass\n\n    class TestBadCeil:\n        __ceil__ = BadDescr()\n    assert math.ceil(TestCeil()) == 42, ('assertEqual', math.ceil(TestCeil()), 42)\n    assert math.ceil(FloatCeil()) == 42, ('assertEqual', math.ceil(FloatCeil()), 42)\n    assert math.ceil(FloatLike(42.5)) == 43, ('assertEqual', math.ceil(FloatLike(42.5)), 43)\n    try:\n        math.ceil(*(TestNoCeil(),))\n    except TypeError:\n        pass\n    try:\n        math.ceil(*(TestBadCeil(),))\n    except ValueError:\n        pass\n    t = TestNoCeil()\n    t.__ceil__ = lambda *args: args\n    try:\n        math.ceil(*(t,))\n    except TypeError:\n        pass\n    try:\n        math.ceil(*(t, 0))\n    except TypeError:\n        pass\n    assert math.ceil(FloatLike(+1.0)) == +1.0, ('assertEqual', math.ceil(FloatLike(+1.0)), +1.0)\n    assert math.ceil(FloatLike(-1.0)) == -1.0, ('assertEqual', math.ceil(FloatLike(-1.0)), -1.0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testCopysign" {
    (ok, detail) = p2_libtest_run_snippet("import math\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\n\ndef _t():\n    assert math.copysign(1, 42) == 1.0, ('assertEqual', math.copysign(1, 42), 1.0)\n    assert math.copysign(0.0, 42) == 0.0, ('assertEqual', math.copysign(0.0, 42), 0.0)\n    assert math.copysign(1.0, -42) == -1.0, ('assertEqual', math.copysign(1.0, -42), -1.0)\n    assert math.copysign(3, 0.0) == 3.0, ('assertEqual', math.copysign(3, 0.0), 3.0)\n    assert math.copysign(4.0, -0.0) == -4.0, ('assertEqual', math.copysign(4.0, -0.0), -4.0)\n    try:\n        math.copysign()\n    except TypeError:\n        pass\n    assert math.copysign(1.0, 0.0) == 1.0, ('assertEqual', math.copysign(1.0, 0.0), 1.0)\n    assert math.copysign(1.0, -0.0) == -1.0, ('assertEqual', math.copysign(1.0, -0.0), -1.0)\n    assert math.copysign(INF, 0.0) == INF, ('assertEqual', math.copysign(INF, 0.0), INF)\n    assert math.copysign(INF, -0.0) == NINF, ('assertEqual', math.copysign(INF, -0.0), NINF)\n    assert math.copysign(NINF, 0.0) == INF, ('assertEqual', math.copysign(NINF, 0.0), INF)\n    assert math.copysign(NINF, -0.0) == NINF, ('assertEqual', math.copysign(NINF, -0.0), NINF)\n    assert math.copysign(1.0, INF) == 1.0, ('assertEqual', math.copysign(1.0, INF), 1.0)\n    assert math.copysign(1.0, NINF) == -1.0, ('assertEqual', math.copysign(1.0, NINF), -1.0)\n    assert math.copysign(INF, INF) == INF, ('assertEqual', math.copysign(INF, INF), INF)\n    assert math.copysign(INF, NINF) == NINF, ('assertEqual', math.copysign(INF, NINF), NINF)\n    assert math.copysign(NINF, INF) == INF, ('assertEqual', math.copysign(NINF, INF), INF)\n    assert math.copysign(NINF, NINF) == NINF, ('assertEqual', math.copysign(NINF, NINF), NINF)\n    assert math.isnan(math.copysign(NAN, 1.0)), ('assertTrue', math.isnan(math.copysign(NAN, 1.0)))\n    assert math.isnan(math.copysign(NAN, INF)), ('assertTrue', math.isnan(math.copysign(NAN, INF)))\n    assert math.isnan(math.copysign(NAN, NINF)), ('assertTrue', math.isnan(math.copysign(NAN, NINF)))\n    assert math.isnan(math.copysign(NAN, NAN)), ('assertTrue', math.isnan(math.copysign(NAN, NAN)))\n    assert math.isinf(math.copysign(INF, NAN)), ('assertTrue', math.isinf(math.copysign(INF, NAN)))\n    assert abs(math.copysign(2.0, NAN)) == 2.0, ('assertEqual', abs(math.copysign(2.0, NAN)), 2.0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testCos" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.cos()\n    except TypeError:\n        pass\n    ftest('cos(-pi/2)', math.cos(-math.pi / 2), 0, abs_tol=math.ulp(1))\n    ftest('cos(0)', math.cos(0), 1)\n    ftest('cos(pi/2)', math.cos(math.pi / 2), 0, abs_tol=math.ulp(1))\n    ftest('cos(pi)', math.cos(math.pi), -1)\n    try:\n        assert math.isnan(math.cos(INF)), ('assertTrue', math.isnan(math.cos(INF)))\n        assert math.isnan(math.cos(NINF)), ('assertTrue', math.isnan(math.cos(NINF)))\n    except ValueError:\n        try:\n            math.cos(*(INF,))\n        except ValueError:\n            pass\n        try:\n            math.cos(*(NINF,))\n        except ValueError:\n            pass\n    assert math.isnan(math.cos(NAN)), ('assertTrue', math.isnan(math.cos(NAN)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testCosh" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.cosh()\n    except TypeError:\n        pass\n    ftest('cosh(0)', math.cosh(0), 1)\n    ftest('cosh(2)-2*cosh(1)**2', math.cosh(2) - 2 * math.cosh(1) ** 2, -1)\n    assert math.cosh(INF) == INF, ('assertEqual', math.cosh(INF), INF)\n    assert math.cosh(NINF) == INF, ('assertEqual', math.cosh(NINF), INF)\n    assert math.isnan(math.cosh(NAN)), ('assertTrue', math.isnan(math.cosh(NAN)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testDegrees" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.degrees()\n    except TypeError:\n        pass\n    ftest('degrees(pi)', math.degrees(math.pi), 180.0)\n    ftest('degrees(pi/2)', math.degrees(math.pi / 2), 90.0)\n    ftest('degrees(-pi/4)', math.degrees(-math.pi / 4), -45.0)\n    ftest('degrees(0)', math.degrees(0), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MathTests.testExp" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\nNAN = float('nan')\nINF = float('inf')\nNINF = float('-inf')\nx, y = (1e+16, 2.9999)\n\ndef to_ulps(x):\n    \"\"\"Convert a non-NaN float x to an integer, in such a way that\n    adjacent floats are converted to adjacent integers.  Then\n    abs(ulps(x) - ulps(y)) gives the difference in ulps between two\n    floats.\n\n    The results from this function will only make sense on platforms\n    where native doubles are represented in IEEE 754 binary64 format.\n\n    Note: 0.0 and -0.0 are converted to 0 and -1, respectively.\n    \"\"\"\n    n = struct.unpack('<q', struct.pack('<d', x))[0]\n    if n < 0:\n        n = ~(n + 2 ** 63)\n    return n\n\ndef ulp_abs_check(expected, got, ulp_tol, abs_tol):\n    \"\"\"Given finite floats `expected` and `got`, check that they're\n    approximately equal to within the given number of ulps or the\n    given absolute tolerance, whichever is bigger.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    ulp_error = abs(to_ulps(expected) - to_ulps(got))\n    abs_error = abs(expected - got)\n    if abs_error <= abs_tol or ulp_error <= ulp_tol:\n        return None\n    else:\n        fmt = 'error = {:.3g} ({:d} ulps); permitted error = {:.3g} or {:d} ulps'\n        return fmt.format(abs_error, ulp_error, abs_tol, ulp_tol)\n\ndef result_check(expected, got, ulp_tol=5, abs_tol=0.0):\n    \"\"\"Compare arguments expected and got, as floats, if either\n    is a float, using a tolerance expressed in multiples of\n    ulp(expected) or absolutely (if given and greater).\n\n    As a convenience, when neither argument is a float, and for\n    non-finite floats, exact equality is demanded. Also, nan==nan\n    as far as this function is concerned.\n\n    Returns None on success and an error message on failure.\n    \"\"\"\n    if got == expected:\n        if not got and (not expected):\n            if math.copysign(1, got) != math.copysign(1, expected):\n                return f'expected {expected}, got {got} (zero has wrong sign)'\n        return None\n    failure = 'not equal'\n    if isinstance(expected, float) and isinstance(got, int):\n        got = float(got)\n    elif isinstance(got, float) and isinstance(expected, int):\n        expected = float(expected)\n    if isinstance(expected, float) and isinstance(got, float):\n        if math.isnan(expected) and math.isnan(got):\n            failure = None\n        elif math.isinf(expected) or math.isinf(got):\n            pass\n        else:\n            failure = ulp_abs_check(expected, got, ulp_tol, abs_tol)\n    if failure is not None:\n        fail_fmt = 'expected {!r}, got {!r}'\n        fail_msg = fail_fmt.format(expected, got)\n        fail_msg += ' ({})'.format(failure)\n        return fail_msg\n    else:\n        return None\n\ndef _t():\n\n    def ftest(name, got, expected, ulp_tol=5, abs_tol=0.0):\n        \"\"\"Compare arguments expected and got, as floats, if either\n        is a float, using a tolerance expressed in multiples of\n        ulp(expected) or absolutely, whichever is greater.\n\n        As a convenience, when neither argument is a float, and for\n        non-finite floats, exact equality is demanded. Also, nan==nan\n        in this function.\n        \"\"\"\n        failure = result_check(expected, got, ulp_tol, abs_tol)\n        if failure is not None:\n            raise AssertionError('{}: {}'.format(name, failure))\n    try:\n        math.exp()\n    except TypeError:\n        pass\n    ftest('exp(-1)', math.exp(-1), 1 / math.e)\n    ftest('exp(0)', math.exp(0), 1)\n    ftest('exp(1)', math.exp(1), math.e)\n    assert math.exp(INF) == INF, ('assertEqual', math.exp(INF), INF)\n    assert math.exp(NINF) == 0.0, ('assertEqual', math.exp(NINF), 0.0)\n    assert math.isnan(math.exp(NAN)), ('assertTrue', math.isnan(math.exp(NAN)))\n    try:\n        math.exp(*(1000000,))\n    except OverflowError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

