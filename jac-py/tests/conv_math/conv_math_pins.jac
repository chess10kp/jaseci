test "IsCloseTests.test_eight_decimal_places" {
    (ok, detail) = p2_libtest_run_snippet("import math\n\ndef _t():\n\n    def assertIsClose(a, b, *args, **kwargs):\n        assert self.isclose(a, b, *args, **kwargs), ('assertTrue', self.isclose(a, b, *args, **kwargs), '%s and %s should be close!' % (a, b))\n\n    def assertAllClose(examples, *args, **kwargs):\n        for a, b in examples:\n            assertIsClose(a, b, *args, **kwargs)\n\n    def assertIsNotClose(a, b, *args, **kwargs):\n        assert not self.isclose(a, b, *args, **kwargs), ('assertFalse', self.isclose(a, b, *args, **kwargs), '%s and %s should not be close!' % (a, b))\n\n    def assertAllNotClose(examples, *args, **kwargs):\n        for a, b in examples:\n            assertIsNotClose(a, b, *args, **kwargs)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.isclose = math.isclose\n    _SelfNS.isclose = math.isclose\n    eight_decimal_places_examples = [(100000000.0, 100000000.0 + 1), (-1e-08, -1.000000009e-08), (1.12345678, 1.12345679)]\n    assertAllClose(eight_decimal_places_examples, rel_tol=1e-08)\n    assertAllNotClose(eight_decimal_places_examples, rel_tol=1e-09)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IsCloseTests.test_near_zero" {
