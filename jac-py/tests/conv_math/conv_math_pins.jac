}

test "MathTests.test_trunc" {
    (ok, detail) = p2_libtest_run_snippet("import math\n\nclass FloatLike:\n\n    def __init__(self, value):\n        self.value = value\n\n    def __float__(self):\n        return self.value\n\nclass BadDescr:\n\n    def __get__(self, obj, objtype=None):\n        raise ValueError\n\ndef _t():\n    assert math.trunc(1) == 1, ('assertEqual', math.trunc(1), 1)\n    assert math.trunc(-1) == -1, ('assertEqual', math.trunc(-1), -1)\n    assert type(math.trunc(1)) == int, ('assertEqual', type(math.trunc(1)), int)\n    assert type(math.trunc(1.5)) == int, ('assertEqual', type(math.trunc(1.5)), int)\n    assert math.trunc(1.5) == 1, ('assertEqual', math.trunc(1.5), 1)\n    assert math.trunc(-1.5) == -1, ('assertEqual', math.trunc(-1.5), -1)\n    assert math.trunc(1.999999) == 1, ('assertEqual', math.trunc(1.999999), 1)\n    assert math.trunc(-1.999999) == -1, ('assertEqual', math.trunc(-1.999999), -1)\n    assert math.trunc(-0.999999) == -0, ('assertEqual', math.trunc(-0.999999), -0)\n    assert math.trunc(-100.999) == -100, ('assertEqual', math.trunc(-100.999), -100)\n\n    class TestTrunc:\n\n        def __trunc__(self):\n            return 23\n\n    class FloatTrunc(float):\n\n        def __trunc__(self):\n            return 23\n\n    class TestNoTrunc:\n        pass\n\n    class TestBadTrunc:\n        __trunc__ = BadDescr()\n    assert math.trunc(TestTrunc()) == 23, ('assertEqual', math.trunc(TestTrunc()), 23)\n    assert math.trunc(FloatTrunc()) == 23, ('assertEqual', math.trunc(FloatTrunc()), 23)\n    try:\n        math.trunc()\n    except TypeError:\n        pass\n    try:\n        math.trunc(*(1, 2))\n    except TypeError:\n        pass\n    try:\n        math.trunc(*(FloatLike(23.5),))\n    except TypeError:\n        pass\n    try:\n        math.trunc(*(TestNoTrunc(),))\n    except TypeError:\n        pass\n    try:\n        math.trunc(*(TestBadTrunc(),))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

