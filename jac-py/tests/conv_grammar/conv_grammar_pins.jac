test "GrammarTests.test_comprehension_specials" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    x = 10\n    g = (i for i in range(x))\n    x = 5\n    assert len(list(g)) == 10, ('assertEqual', len(list(g)), 10)\n    x = 10\n    t = False\n    g = ((i, j) for i in range(x) if t for j in range(x))\n    x = 5\n    t = True\n    assert [(i, j) for i in range(10) for j in range(5)] == list(g), ('assertEqual', [(i, j) for i in range(10) for j in range(5)], list(g))\n    assert [x for x in range(10) if x % 2 if x % 3] == [1, 5, 7], ('assertEqual', [x for x in range(10) if x % 2 if x % 3], [1, 5, 7])\n    assert list((x for x in range(10) if x % 2 if x % 3)) == [1, 5, 7], ('assertEqual', list((x for x in range(10) if x % 2 if x % 3)), [1, 5, 7])\n    assert [x for x, in [(4,), (5,), (6,)]] == [4, 5, 6], ('assertEqual', [x for x, in [(4,), (5,), (6,)]], [4, 5, 6])\n    assert list((x for x, in [(7,), (8,), (9,)])) == [7, 8, 9], ('assertEqual', list((x for x, in [(7,), (8,), (9,)])), [7, 8, 9])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "GrammarTests.test_with_statement" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class manager(object):\n\n        def __enter__(self):\n            return (1, 2)\n\n        def __exit__(self, *args):\n            pass\n    with manager():\n        pass\n    with manager() as x:\n        pass\n    with manager() as (x, y):\n        pass\n    with manager(), manager():\n        pass\n    with manager() as x, manager() as y:\n        pass\n    with manager() as x, manager():\n        pass\n    with manager():\n        pass\n    with manager() as x:\n        pass\n    with manager() as (x, y), manager() as z:\n        pass\n    with manager(), manager():\n        pass\n    with manager() as x, manager() as y:\n        pass\n    with manager() as x, manager():\n        pass\n    with manager() as x, manager() as y, manager() as z:\n        pass\n    with manager() as x, manager() as y, manager():\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "GrammarTests.test_if_else_expr" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    def _checkeval(msg, ret):\n        \"\"\"helper to check that evaluation of expressions is done correctly\"\"\"\n        print(msg)\n        return ret\n    assert [x() for x in (lambda: True, lambda: False) if x()] == [True], ('assertEqual', [x() for x in (lambda: True, lambda: False) if x()], [True])\n    assert [x(False) for x in (lambda x: False if x else True, lambda x: True if x else False) if x(False)] == [True], ('assertEqual', [x(False) for x in (lambda x: False if x else True, lambda x: True if x else False) if x(False)], [True])\n    assert (5 if 1 else _checkeval('check 1', 0)) == 5, ('assertEqual', (5 if 1 else _checkeval('check 1', 0)), 5)\n    assert (_checkeval('check 2', 0) if 0 else 5) == 5, ('assertEqual', (_checkeval('check 2', 0) if 0 else 5), 5)\n    assert (5 and 6 if 0 else 1) == 1, ('assertEqual', (5 and 6 if 0 else 1), 1)\n    assert (5 and 6 if 0 else 1) == 1, ('assertEqual', (5 and 6 if 0 else 1), 1)\n    assert (5 and (6 if 1 else 1)) == 6, ('assertEqual', (5 and (6 if 1 else 1)), 6)\n    assert (0 or _checkeval('check 3', 2) if 0 else 3) == 3, ('assertEqual', (0 or _checkeval('check 3', 2) if 0 else 3), 3)\n    assert (1 or _checkeval('check 4', 2) if 1 else _checkeval('check 5', 3)) == 1, ('assertEqual', (1 or _checkeval('check 4', 2) if 1 else _checkeval('check 5', 3)), 1)\n    assert (0 or 5 if 1 else _checkeval('check 6', 3)) == 5, ('assertEqual', (0 or 5 if 1 else _checkeval('check 6', 3)), 5)\n    assert (not 5 if 1 else 1) == False, ('assertEqual', (not 5 if 1 else 1), False)\n    assert (not 5 if 0 else 1) == 1, ('assertEqual', (not 5 if 0 else 1), 1)\n    assert (6 + 1 if 1 else 2) == 7, ('assertEqual', (6 + 1 if 1 else 2), 7)\n    assert (6 - 1 if 1 else 2) == 5, ('assertEqual', (6 - 1 if 1 else 2), 5)\n    assert (6 * 2 if 1 else 4) == 12, ('assertEqual', (6 * 2 if 1 else 4), 12)\n    assert (6 / 2 if 1 else 3) == 3, ('assertEqual', (6 / 2 if 1 else 3), 3)\n    assert (6 < 4 if 0 else 2) == 2, ('assertEqual', (6 < 4 if 0 else 2), 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

