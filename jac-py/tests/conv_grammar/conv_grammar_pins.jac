test "GrammarTests.test_classdef" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class B:\n        pass\n\n    class B2:\n        pass\n\n    class C1(B):\n        pass\n\n    class C2(B):\n        pass\n\n    class D(C1, C2, B):\n        pass\n\n    class C:\n\n        def meth1(self):\n            pass\n\n        def meth2(self, arg):\n            pass\n\n        def meth3(self, a1, a2):\n            pass\n\n    def class_decorator(x):\n        return x\n\n    @class_decorator\n    class G:\n        pass\n\n    @False or class_decorator\n    class H:\n        pass\n\n    @(d := class_decorator)\n    class I:\n        pass\n\n    @lambda c: class_decorator(c)\n    class J:\n        pass\n\n    @[..., class_decorator, ...][1]\n    class K:\n        pass\n\n    @class_decorator(class_decorator)(class_decorator)\n    class L:\n        pass\n\n    @[class_decorator][0].__call__.__call__\n    class M:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

