test "GrammarTests.test_selectors" {
    (ok, detail) = p2_libtest_run_snippet("import sys\n\ndef _t():\n    import sys, time\n    c = sys.path[0]\n    x = time.time()\n    x = sys.modules['time'].time()\n    a = '01234'\n    c = a[0]\n    c = a[-1]\n    s = a[0:5]\n    s = a[:5]\n    s = a[0:]\n    s = a[:]\n    s = a[-5:]\n    s = a[:-1]\n    s = a[-4:-3]\n    d = {}\n    d[1] = 1\n    d[1,] = 2\n    d[1, 2] = 3\n    d[1, 2, 3] = 4\n    L = list(d)\n    L.sort(key=lambda x: (type(x).__name__, x))\n    assert str(L) == '[1, (1,), (1, 2), (1, 2, 3)]', ('assertEqual', str(L), '[1, (1,), (1, 2), (1, 2, 3)]')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

