    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n\n    def _check_content(source, ast_node, content):\n        assert ast.get_source_segment(source, ast_node) == content, ('assertEqual', ast.get_source_segment(source, ast_node), content)\n    tests = (('( ( ( a ) ) ) ( )', 'Call'), ('( ( ( a ) ) ) ( b )', 'Call'), ('( ( ( a ) ) ) [ b ]', 'Subscript'), ('( ( ( a ) ) ) . b', 'Attribute'))\n    for s, t in tests:\n        v = ast.parse(s).body[0].value\n        assert type(v).__name__ == t, ('assertEqual', type(v).__name__, t)\n        _check_content(s, v, s)\n        s2 = 'await ' + s\n        v = ast.parse(s2).body[0].value.value\n        assert type(v).__name__ == t, ('assertEqual', type(v).__name__, t)\n        _check_content(s2, v, s)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
