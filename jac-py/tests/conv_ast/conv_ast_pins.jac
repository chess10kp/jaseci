test "ASTHelpers_Test.test_literal_eval" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n    assert ast.literal_eval('[1, 2, 3]') == [1, 2, 3], ('assertEqual', ast.literal_eval('[1, 2, 3]'), [1, 2, 3])\n    assert ast.literal_eval('{\"foo\": 42}') == {'foo': 42}, ('assertEqual', ast.literal_eval('{\"foo\": 42}'), {'foo': 42})\n    assert ast.literal_eval('(True, False, None)') == (True, False, None), ('assertEqual', ast.literal_eval('(True, False, None)'), (True, False, None))\n    assert ast.literal_eval('{1, 2, 3}') == {1, 2, 3}, ('assertEqual', ast.literal_eval('{1, 2, 3}'), {1, 2, 3})\n    assert ast.literal_eval('b\"hi\"') == b'hi', ('assertEqual', ast.literal_eval('b\"hi\"'), b'hi')\n    assert ast.literal_eval('set()') == set(), ('assertEqual', ast.literal_eval('set()'), set())\n    try:\n        ast.literal_eval(*('foo()',))\n    except ValueError:\n        pass\n    assert ast.literal_eval('6') == 6, ('assertEqual', ast.literal_eval('6'), 6)\n    assert ast.literal_eval('+6') == 6, ('assertEqual', ast.literal_eval('+6'), 6)\n    assert ast.literal_eval('-6') == -6, ('assertEqual', ast.literal_eval('-6'), -6)\n    assert ast.literal_eval('3.25') == 3.25, ('assertEqual', ast.literal_eval('3.25'), 3.25)\n    assert ast.literal_eval('+3.25') == 3.25, ('assertEqual', ast.literal_eval('+3.25'), 3.25)\n    assert ast.literal_eval('-3.25') == -3.25, ('assertEqual', ast.literal_eval('-3.25'), -3.25)\n    assert repr(ast.literal_eval('-0.0')) == '-0.0', ('assertEqual', repr(ast.literal_eval('-0.0')), '-0.0')\n    try:\n        ast.literal_eval(*('++6',))\n    except ValueError:\n        pass\n    try:\n        ast.literal_eval(*('+True',))\n    except ValueError:\n        pass\n    try:\n        ast.literal_eval(*('2+3',))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ASTHelpers_Test.test_literal_eval_complex" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n    assert ast.literal_eval('6j') == 6j, ('assertEqual', ast.literal_eval('6j'), 6j)\n    assert ast.literal_eval('-6j') == -6j, ('assertEqual', ast.literal_eval('-6j'), -6j)\n    assert ast.literal_eval('6.75j') == 6.75j, ('assertEqual', ast.literal_eval('6.75j'), 6.75j)\n    assert ast.literal_eval('-6.75j') == -6.75j, ('assertEqual', ast.literal_eval('-6.75j'), -6.75j)\n    assert ast.literal_eval('3+6j') == 3 + 6j, ('assertEqual', ast.literal_eval('3+6j'), 3 + 6j)\n    assert ast.literal_eval('-3+6j') == -3 + 6j, ('assertEqual', ast.literal_eval('-3+6j'), -3 + 6j)\n    assert ast.literal_eval('3-6j') == 3 - 6j, ('assertEqual', ast.literal_eval('3-6j'), 3 - 6j)\n    assert ast.literal_eval('-3-6j') == -3 - 6j, ('assertEqual', ast.literal_eval('-3-6j'), -3 - 6j)\n    assert ast.literal_eval('3.25+6.75j') == 3.25 + 6.75j, ('assertEqual', ast.literal_eval('3.25+6.75j'), 3.25 + 6.75j)\n    assert ast.literal_eval('-3.25+6.75j') == -3.25 + 6.75j, ('assertEqual', ast.literal_eval('-3.25+6.75j'), -3.25 + 6.75j)\n    assert ast.literal_eval('3.25-6.75j') == 3.25 - 6.75j, ('assertEqual', ast.literal_eval('3.25-6.75j'), 3.25 - 6.75j)\n    assert ast.literal_eval('-3.25-6.75j') == -3.25 - 6.75j, ('assertEqual', ast.literal_eval('-3.25-6.75j'), -3.25 - 6.75j)\n    assert ast.literal_eval('(3+6j)') == 3 + 6j, ('assertEqual', ast.literal_eval('(3+6j)'), 3 + 6j)\n    try:\n        ast.literal_eval(*('-6j+3',))\n    except ValueError:\n        pass\n    try:\n        ast.literal_eval(*('-6j+3j',))\n    except ValueError:\n        pass\n    try:\n        ast.literal_eval(*('3+-6j',))\n    except ValueError:\n        pass\n    try:\n        ast.literal_eval(*('3+(0+6j)',))\n    except ValueError:\n        pass\n    try:\n        ast.literal_eval(*('-(3+6j)',))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
