test "EndPositionTests.test_source_segment_endings" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n\n    def _check_content(source, ast_node, content):\n        assert ast.get_source_segment(source, ast_node) == content, ('assertEqual', ast.get_source_segment(source, ast_node), content)\n    s = 'v = 1\\r\\nw = 1\\nx = 1\\n\\ry = 1\\rz = 1\\r\\n'\n    v, w, x, y, z = ast.parse(s).body\n    _check_content(s, v, 'v = 1')\n    _check_content(s, w, 'w = 1')\n    _check_content(s, x, 'x = 1')\n    _check_content(s, y, 'y = 1')\n    _check_content(s, z, 'z = 1')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "EndPositionTests.test_source_segment_tabs" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\nfrom textwrap import dedent\n\ndef _t():\n    s = dedent('\\n            class C:\\n              \\t\\x0c  def fun(self) -> None:\\n              \\t\\x0c      pass\\n        ').strip()\n    s_method = '  \\t\\x0c  def fun(self) -> None:\\n  \\t\\x0c      pass'\n    cdef = ast.parse(s).body[0]\n    assert ast.get_source_segment(s, cdef.body[0], padded=True) == s_method, ('assertEqual', ast.get_source_segment(s, cdef.body[0], padded=True), s_method)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "EndPositionTests.test_source_segment_newlines" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n\n    def _check_content(source, ast_node, content):\n        assert ast.get_source_segment(source, ast_node) == content, ('assertEqual', ast.get_source_segment(source, ast_node), content)\n    s = 'def f():\\n  pass\\ndef g():\\r  pass\\r\\ndef h():\\r\\n  pass\\r\\n'\n    f, g, h = ast.parse(s).body\n    _check_content(s, f, 'def f():\\n  pass')\n    _check_content(s, g, 'def g():\\r  pass')\n    _check_content(s, h, 'def h():\\r\\n  pass')\n    s = 'def f():\\n  a = 1\\r  b = 2\\r\\n  c = 3\\n'\n    f = ast.parse(s).body[0]\n    _check_content(s, f, s.rstrip())\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "EndPositionTests.test_source_segment_missing_info" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n    s = 'v = 1\\r\\nw = 1\\nx = 1\\n\\ry = 1\\r\\n'\n    v, w, x, y = ast.parse(s).body\n    del v.lineno\n    del w.end_lineno\n    del x.col_offset\n    del y.end_col_offset\n    assert ast.get_source_segment(s, v) is None, ('assertIsNone', ast.get_source_segment(s, v))\n    assert ast.get_source_segment(s, w) is None, ('assertIsNone', ast.get_source_segment(s, w))\n    assert ast.get_source_segment(s, x) is None, ('assertIsNone', ast.get_source_segment(s, x))\n    assert ast.get_source_segment(s, y) is None, ('assertIsNone', ast.get_source_segment(s, y))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ASTConstructorTests.test_custom_subclass_with_no_fields" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n\n    class NoInit(ast.AST):\n        pass\n    obj = NoInit()\n    assert isinstance(obj, NoInit), ('assertIsInstance', obj, NoInit)\n    assert obj.__dict__ == {}, ('assertEqual', obj.__dict__, {})\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ASTConstructorTests.test_fields_and_types" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n\n    class FieldsAndTypes(ast.AST):\n        _fields = ('a',)\n        _field_types = {'a': int | None}\n        a: int | None = None\n    obj = FieldsAndTypes()\n    assert obj.a is None, ('assertIs', obj.a, None)\n    obj = FieldsAndTypes(a=1)\n    assert obj.a == 1, ('assertEqual', obj.a, 1)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
