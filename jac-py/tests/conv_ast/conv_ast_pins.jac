test "AST_Tests.test_issue18374_binop_col_offset" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n    tree = ast.parse('4+5+6+7')\n    parent_binop = tree.body[0].value\n    child_binop = parent_binop.left\n    grandchild_binop = child_binop.left\n    assert parent_binop.col_offset == 0, ('assertEqual', parent_binop.col_offset, 0)\n    assert parent_binop.end_col_offset == 7, ('assertEqual', parent_binop.end_col_offset, 7)\n    assert child_binop.col_offset == 0, ('assertEqual', child_binop.col_offset, 0)\n    assert child_binop.end_col_offset == 5, ('assertEqual', child_binop.end_col_offset, 5)\n    assert grandchild_binop.col_offset == 0, ('assertEqual', grandchild_binop.col_offset, 0)\n    assert grandchild_binop.end_col_offset == 3, ('assertEqual', grandchild_binop.end_col_offset, 3)\n    tree = ast.parse('4+5-\\\\\\n 6-7')\n    parent_binop = tree.body[0].value\n    child_binop = parent_binop.left\n    grandchild_binop = child_binop.left\n    assert parent_binop.col_offset == 0, ('assertEqual', parent_binop.col_offset, 0)\n    assert parent_binop.lineno == 1, ('assertEqual', parent_binop.lineno, 1)\n    assert parent_binop.end_col_offset == 4, ('assertEqual', parent_binop.end_col_offset, 4)\n    assert parent_binop.end_lineno == 2, ('assertEqual', parent_binop.end_lineno, 2)\n    assert child_binop.col_offset == 0, ('assertEqual', child_binop.col_offset, 0)\n    assert child_binop.lineno == 1, ('assertEqual', child_binop.lineno, 1)\n    assert child_binop.end_col_offset == 2, ('assertEqual', child_binop.end_col_offset, 2)\n    assert child_binop.end_lineno == 2, ('assertEqual', child_binop.end_lineno, 2)\n    assert grandchild_binop.col_offset == 0, ('assertEqual', grandchild_binop.col_offset, 0)\n    assert grandchild_binop.lineno == 1, ('assertEqual', grandchild_binop.lineno, 1)\n    assert grandchild_binop.end_col_offset == 3, ('assertEqual', grandchild_binop.end_col_offset, 3)\n    assert grandchild_binop.end_lineno == 1, ('assertEqual', grandchild_binop.end_lineno, 1)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
