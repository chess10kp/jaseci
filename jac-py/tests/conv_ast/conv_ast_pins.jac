test "ASTHelpers_Test.test_iter_child_nodes" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n    node = ast.parse(\"spam(23, 42, eggs='leek')\", mode='eval')\n    assert len(list(ast.iter_child_nodes(node.body))) == 4, ('assertEqual', len(list(ast.iter_child_nodes(node.body))), 4)\n    iterator = ast.iter_child_nodes(node.body)\n    assert next(iterator).id == 'spam', ('assertEqual', next(iterator).id, 'spam')\n    assert next(iterator).value == 23, ('assertEqual', next(iterator).value, 23)\n    assert next(iterator).value == 42, ('assertEqual', next(iterator).value, 42)\n    assert ast.dump(next(iterator)) == \"keyword(arg='eggs', value=Constant(value='leek'))\", ('assertEqual', ast.dump(next(iterator)), \"keyword(arg='eggs', value=Constant(value='leek'))\")\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
