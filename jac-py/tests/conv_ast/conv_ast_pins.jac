test "ASTValidatorTests.test_module" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n\n    def mod(mod, msg=None, mode='exec', *, exc=ValueError):\n        mod.lineno = mod.col_offset = 0\n        ast.fix_missing_locations(mod)\n        if msg is None:\n            compile(mod, '<test>', mode)\n        else:\n            try:\n                compile(mod, '<test>', mode)\n            except exc as _exc:\n                cm = _exc\n            else:\n                raise AssertionError('assertRaises: did not raise')\n            assert msg in str(cm), ('assertIn', msg, str(cm))\n    m = ast.Interactive([ast.Expr(ast.Name('x', ast.Store()))])\n    mod(m, 'must have Load context', 'single')\n    m = ast.Expression(ast.Name('x', ast.Store()))\n    mod(m, 'must have Load context', 'eval')\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ASTValidatorTests.test_funcdef_pattern_matching" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\nimport textwrap\n\ndef _t():\n\n    def matcher(node):\n        match node:\n            case ast.FunctionDef('foo', ast.arguments(args=[ast.arg('bar')]), [ast.Pass()], [ast.Name('capybara', ast.Load())], ast.Name('pacarana', ast.Load())):\n                return True\n            case _:\n                return False\n    code = '\\n            @capybara\\n            def foo(bar) -> pacarana:\\n                pass\\n        '\n    source = ast.parse(textwrap.dedent(code))\n    funcdef = source.body[0]\n    assert isinstance(funcdef, ast.FunctionDef), ('assertIsInstance', funcdef, ast.FunctionDef)\n    assert matcher(funcdef), ('assertTrue', matcher(funcdef))\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ConstantTests.test_validation" {
