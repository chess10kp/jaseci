test "ConstantTests.test_load_const" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\nimport dis\n\ndef _t():\n\n    def get_load_const(tree):\n        co = compile(tree, '<string>', 'exec')\n        consts = []\n        for instr in dis.get_instructions(co):\n            if instr.opcode in dis.hasconst:\n                consts.append(instr.argval)\n        return consts\n    consts = [None, True, False, 1000, 2.0, 3j, 'unicode', b'bytes', (1, 2, 3)]\n    code = '\\n'.join(['x={!r}'.format(const) for const in consts])\n    code += '\\nx = ...'\n    consts.extend((Ellipsis, None))\n    tree = ast.parse(code)\n    assert get_load_const(tree) == consts, ('assertEqual', get_load_const(tree), consts)\n    for assign, const in zip(tree.body, consts):\n        assert isinstance(assign, ast.Assign), ast.dump(assign)\n        new_node = ast.Constant(value=const)\n        ast.copy_location(new_node, assign.value)\n        assign.value = new_node\n    assert get_load_const(tree) == consts, ('assertEqual', get_load_const(tree), consts)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

