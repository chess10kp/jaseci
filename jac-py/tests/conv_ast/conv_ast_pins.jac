sert alias.end_lineno == 1, ('assertEqual', alias.end_lineno, 1)\n    assert alias.col_offset == 7, ('assertEqual', alias.col_offset, 7)\n    assert alias.end_col_offset == 17, ('assertEqual', alias.end_col_offset, 17)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
