test "AST_Tests.test_constant_subclasses" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.maxDiff = None\n    _SelfNS.maxDiff = None\n\n    class N(ast.Constant):\n\n        def __init__(self, *args, **kwargs):\n            super().__init__(*args, **kwargs)\n            self.z = 'spam'\n\n    class N2(ast.Constant):\n        pass\n    n = N(42)\n    assert n.value == 42, ('assertEqual', n.value, 42)\n    assert n.z == 'spam', ('assertEqual', n.z, 'spam')\n    assert type(n) == N, ('assertEqual', type(n), N)\n    assert isinstance(n, N), ('assertTrue', isinstance(n, N))\n    assert isinstance(n, ast.Constant), ('assertTrue', isinstance(n, ast.Constant))\n    assert not isinstance(n, N2), ('assertFalse', isinstance(n, N2))\n    assert not isinstance(ast.Constant(42), N), ('assertFalse', isinstance(ast.Constant(42), N))\n    n = N(value=42)\n    assert n.value == 42, ('assertEqual', n.value, 42)\n    assert type(n) == N, ('assertEqual', type(n), N)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

