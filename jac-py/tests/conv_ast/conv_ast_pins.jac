test "ASTHelpers_Test.test_copy_location" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n    src = ast.parse('1 + 1', mode='eval')\n    src.body.right = ast.copy_location(ast.Constant(2), src.body.right)\n    assert ast.dump(src, include_attributes=True) == 'Expression(body=BinOp(left=Constant(value=1, lineno=1, col_offset=0, end_lineno=1, end_col_offset=1), op=Add(), right=Constant(value=2, lineno=1, col_offset=4, end_lineno=1, end_col_offset=5), lineno=1, col_offset=0, end_lineno=1, end_col_offset=5))', ('assertEqual', ast.dump(src, include_attributes=True), 'Expression(body=BinOp(left=Constant(value=1, lineno=1, col_offset=0, end_lineno=1, end_col_offset=1), op=Add(), right=Constant(value=2, lineno=1, col_offset=4, end_lineno=1, end_col_offset=5), lineno=1, col_offset=0, end_lineno=1, end_col_offset=5))')\n    func = ast.Name('spam', ast.Load())\n    src = ast.Call(col_offset=1, lineno=1, end_lineno=1, end_col_offset=1, func=func)\n    new = ast.copy_location(src, ast.Call(col_offset=None, lineno=None, func=func))\n    assert new.end_lineno is None, ('assertIsNone', new.end_lineno)\n    assert new.end_col_offset is None, ('assertIsNone', new.end_col_offset)\n    assert new.lineno == 1, ('assertEqual', new.lineno, 1)\n    assert new.col_offset == 1, ('assertEqual', new.col_offset, 1)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ASTHelpers_Test.test_increment_lineno" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport ast\n\ndef _t():\n    src = ast.parse('1 + 1', mode='eval')\n    assert ast.increment_lineno(src, n=3) == src, ('assertEqual', ast.increment_lineno(src, n=3), src)\n    assert ast.dump(src, include_attributes=True) == 'Expression(body=BinOp(left=Constant(value=1, lineno=4, col_offset=0, end_lineno=4, end_col_offset=1), op=Add(), right=Constant(value=1, lineno=4, col_offset=4, end_lineno=4, end_col_offset=5), lineno=4, col_offset=0, end_lineno=4, end_col_offset=5))', ('assertEqual', ast.dump(src, include_attributes=True), 'Expression(body=BinOp(left=Constant(value=1, lineno=4, col_offset=0, end_lineno=4, end_col_offset=1), op=Add(), right=Constant(value=1, lineno=4, col_offset=4, end_lineno=4, end_col_offset=5), lineno=4, col_offset=0, end_lineno=4, end_col_offset=5))')\n    src = ast.parse('1 + 1', mode='eval')\n    assert ast.increment_lineno(src.body, n=3) == src.body, ('assertEqual', ast.increment_lineno(src.body, n=3), src.body)\n    assert ast.dump(src, include_attributes=True) == 'Expression(body=BinOp(left=Constant(value=1, lineno=4, col_offset=0, end_lineno=4, end_col_offset=1), op=Add(), right=Constant(value=1, lineno=4, col_offset=4, end_lineno=4, end_col_offset=5), lineno=4, col_offset=0, end_lineno=4, end_col_offset=5))', ('assertEqual', ast.dump(src, include_attributes=True), 'Expression(body=BinOp(left=Constant(value=1, lineno=4, col_offset=0, end_lineno=4, end_col_offset=1), op=Add(), right=Constant(value=1, lineno=4, col_offset=4, end_lineno=4, end_col_offset=5), lineno=4, col_offset=0, end_lineno=4, end_col_offset=5))')\n    src = ast.Call(func=ast.Name('test', ast.Load()), args=[], keywords=[], lineno=1)\n    assert ast.increment_lineno(src).lineno == 2, ('assertEqual', ast.increment_lineno(src).lineno, 2)\n    assert ast.increment_lineno(src).end_lineno is None, ('assertIsNone', ast.increment_lineno(src).end_lineno)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ASTHelpers_Test.test_increment_lineno_on_module" {
