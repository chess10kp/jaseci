d remember well\\n       What I have said to you.\\n\\nOPHELIA\\n\\n       'Tis in my memory lock'd,\\n       And you yourself shall keep the key of it.\\n\\nLAERTES\\n\\n       Farewell.\\n\"\n\nclass CustomInt:\n\n    def __index__(self):\n        return 100\n\ndef _t():\n    data = HAMLET_SCENE * 10\n    compressed = zlib.compress(data, 1)\n    dco = zlib.decompressobj()\n    assert dco.decompress(compressed, CustomInt()) == data[:100], ('assertEqual', dco.decompress(compressed, CustomInt()), data[:100])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
