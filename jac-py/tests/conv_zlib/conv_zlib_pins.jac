d remember well\\n       What I have said to you.\\n\\nOPHELIA\\n\\n       'Tis in my memory lock'd,\\n       And you yourself shall keep the key of it.\\n\\nLAERTES\\n\\n       Farewell.\\n\"\n\ndef _t():\n    x = zlib.compress(HAMLET_SCENE, level=3)\n    assert zlib.decompress(x) == HAMLET_SCENE, ('assertEqual', zlib.decompress(x), HAMLET_SCENE)\n    try:\n        zlib.compress(data=HAMLET_SCENE, level=3)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert zlib.decompress(x, wbits=zlib.MAX_WBITS, bufsize=zlib.DEF_BUF_SIZE) == HAMLET_SCENE, ('assertEqual', zlib.decompress(x, wbits=zlib.MAX_WBITS, bufsize=zlib.DEF_BUF_SIZE), HAMLET_SCENE)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
