, Ophelia; and remember well\\n       What I have said to you.\\n\\nOPHELIA\\n\\n       'Tis in my memory lock'd,\\n       And you yourself shall keep the key of it.\\n\\nLAERTES\\n\\n       Farewell.\\n\"\n\ndef _t():\n    data = HAMLET_SCENE\n    comp = zlib.compress(data)\n    assert isinstance(comp, bytes), ('assertIsInstance', comp, bytes)\n    for func in (lambda c: c.copy(), copy.copy, copy.deepcopy):\n        d0 = zlib.decompressobj()\n        bufs0 = []\n        bufs0.append(d0.decompress(comp[:32]))\n        d1 = func(d0)\n        bufs1 = bufs0[:]\n        bufs0.append(d0.decompress(comp[32:]))\n        s0 = b''.join(bufs0)\n        bufs1.append(d1.decompress(comp[32:]))\n        s1 = b''.join(bufs1)\n        assert s0 == s1, ('assertEqual', s0, s1)\n        assert s0 == data, ('assertEqual', s0, data)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
