d remember well\\n       What I have said to you.\\n\\nOPHELIA\\n\\n       'Tis in my memory lock'd,\\n       And you yourself shall keep the key of it.\\n\\nLAERTES\\n\\n       Farewell.\\n\"\n\nclass CustomInt:\n\n    def __index__(self):\n        return 100\n\ndef _t():\n    input = HAMLET_SCENE * 10\n    data = zlib.compress(input, 1)\n    dco = zlib.decompressobj()\n    dco.decompress(data, 1)\n    assert dco.flush(CustomInt()) == input[1:], ('assertEqual', dco.flush(CustomInt()), input[1:])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
