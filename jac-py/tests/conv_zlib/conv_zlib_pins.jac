}

test "CompressObjectTestCase.test_baddecompresscopy" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\nimport copy\nzlib = import_helper.import_module('zlib')\nHAMLET_SCENE = b\"\\nLAERTES\\n\\n       O, fear me not.\\n       I stay too long: but here my father comes.\\n\\n       Enter POLONIUS\\n\\n       A double blessing is a double grace,\\n       Occasion smiles upon a second leave.\\n\\nLORD POLONIUS\\n\\n       Yet here, Laertes! aboard, aboard, for shame!\\n       The wind sits in the shoulder of your sail,\\n       And you are stay'd for. There; my blessing with thee!\\n       And these few precepts in thy memory\\n       See thou character. Give thy thoughts no tongue,\\n       Nor any unproportioned thought his act.\\n       Be thou familiar, but by no means vulgar.\\n       Those friends thou hast, and their adoption tried,\\n       Grapple them to thy soul with hoops of steel;\\n       But do not dull thy palm with entertainment\\n       Of each new-hatch'd, unfledged comrade. Beware\\n       Of entrance to a quarrel, but being in,\\n       Bear't that the opposed may beware of thee.\\n       Give every man thy ear, but few thy voice;\\n       Take each man's censure, but reserve thy judgment.\\n       Costly thy habit as thy purse can buy,\\n       But not express'd in fancy; rich, not gaudy;\\n       For the apparel oft proclaims the man,\\n       And they in France of the best rank and station\\n       Are of a most select and generous chief in that.\\n       Neither a borrower nor a lender be;\\n       For loan oft loses both itself and friend,\\n       And borrowing dulls the edge of husbandry.\\n       This above all: to thine ownself be true,\\n       And it must follow, as the night the day,\\n       Thou canst not then be false to any man.\\n       Farewell: my blessing season this in thee!\\n\\nLAERTES\\n\\n       Most humbly do I take my leave, my lord.\\n\\nLORD POLONIUS\\n\\n       The time invites you; go; your servants tend.\\n\\nLAERTES\\n\\n       Farewell, Ophelia; and remember well\\n       What I have said to you.\\n\\nOPHELIA\\n\\n       'Tis in my memory lock'd,\\n       And you yourself shall keep the key of it.\\n\\nLAERTES\\n\\n       Farewell.\\n\"\n\ndef _t():\n    data = zlib.compress(HAMLET_SCENE)\n    d = zlib.decompressobj()\n    d.decompress(data)\n    d.flush()\n    try:\n        d.copy()\n    except ValueError:\n        pass\n    try:\n        copy.copy(*(d,))\n    except ValueError:\n        pass\n    try:\n        copy.deepcopy(*(d,))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CompressObjectTestCase.test_compresspickle" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\nimport pickle\nzlib = import_helper.import_module('zlib')\n\ndef _t():\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        try:\n            pickle.dumps(zlib.compressobj(zlib.Z_BEST_COMPRESSION), proto)\n        except (TypeError, pickle.PicklingError) as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CompressObjectTestCase.test_decompresspickle" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\nimport pickle\nzlib = import_helper.import_module('zlib')\n\ndef _t():\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        try:\n            pickle.dumps(zlib.decompressobj(), proto)\n        except (TypeError, pickle.PicklingError) as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CompressObjectTestCase.test_wbits" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom test.support import import_helper\nzlib = import_helper.import_module('zlib')\n\ndef _zlib_runtime_version_tuple(zlib_version=zlib.ZLIB_RUNTIME_VERSION):\n    v = zlib_version.split('-', 1)[0].split('.')\n    if len(v) < 4:\n        v.append('0')\n    elif not v[-1].isnumeric():\n        v[-1] = '0'\n    return tuple(map(int, v))\nZLIB_RUNTIME_VERSION_TUPLE = _zlib_runtime_version_tuple()\nHAMLET_SCENE = b\"\\nLAERTES\\n\\n       O, fear me not.\\n       I stay too long: but here my father comes.\\n\\n       Enter POLONIUS\\n\\n       A double blessing is a double grace,\\n       Occasion smiles upon a second leave.\\n\\nLORD POLONIUS\\n\\n       Yet here, Laertes! aboard, aboard, for shame!\\n       The wind sits in the shoulder of your sail,\\n       And you are stay'd for. There; my blessing with thee!\\n       And these few precepts in thy memory\\n       See thou character. Give thy thoughts no tongue,\\n       Nor any unproportioned thought his act.\\n       Be thou familiar, but by no means vulgar.\\n       Those friends thou hast, and their adoption tried,\\n       Grapple them to thy soul with hoops of steel;\\n       But do not dull thy palm with entertainment\\n       Of each new-hatch'd, unfledged comrade. Beware\\n       Of entrance to a quarrel, but being in,\\n       Bear't that the opposed may beware of thee.\\n       Give every man thy ear, but few thy voice;\\n       Take each man's censure, but reserve thy judgment.\\n       Costly thy habit as thy purse can buy,\\n       But not express'd in fancy; rich, not gaudy;\\n       For the apparel oft proclaims the man,\\n       And they in France of the best rank and station\\n       Are of a most select and generous chief in that.\\n       Neither a borrower nor a lender be;\\n       For loan oft loses both itself and friend,\\n       And borrowing dulls the edge of husbandry.\\n       This above all: to thine ownself be true,\\n       And it must follow, as the night the day,\\n       Thou canst not then be false to any man.\\n       Farewell: my blessing season this in thee!\\n\\nLAERTES\\n\\n       Most humbly do I take my leave, my lord.\\n\\nLORD POLONIUS\\n\\n       The time invites you; go; your servants tend.\\n\\nLAERTES\\n\\n       Farewell, Ophelia; and remember well\\n       What I have said to you.\\n\\nOPHELIA\\n\\n       'Tis in my memory lock'd,\\n       And you yourself shall keep the key of it.\\n\\nLAERTES\\n\\n       Farewell.\\n\"\n\ndef _t():\n    supports_wbits_0 = ZLIB_RUNTIME_VERSION_TUPLE >= (1, 2, 3, 5)\n    co = zlib.compressobj(level=1, wbits=15)\n    zlib15 = co.compress(HAMLET_SCENE) + co.flush()\n    assert zlib.decompress(zlib15, 15) == HAMLET_SCENE, ('assertEqual', zlib.decompress(zlib15, 15), HAMLET_SCENE)\n    if supports_wbits_0:\n        assert zlib.decompress(zlib15, 0) == HAMLET_SCENE, ('assertEqual', zlib.decompress(zlib15, 0), HAMLET_SCENE)\n    assert zlib.decompress(zlib15, 32 + 15) == HAMLET_SCENE, ('assertEqual', zlib.decompress(zlib15, 32 + 15), HAMLET_SCENE)\n    try:\n        zlib.decompress(zlib15, 14)\n    except zlib.error as _exc:\n        assert _re.search('invalid window size', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    dco = zlib.decompressobj(wbits=32 + 15)\n    assert dco.decompress(zlib15) == HAMLET_SCENE, ('assertEqual', dco.decompress(zlib15), HAMLET_SCENE)\n    dco = zlib.decompressobj(wbits=14)\n    try:\n        dco.decompress(zlib15)\n    except zlib.error as _exc:\n        assert _re.search('invalid window size', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    co = zlib.compressobj(level=1, wbits=9)\n    zlib9 = co.compress(HAMLET_SCENE) + co.flush()\n    assert zlib.decompress(zlib9, 9) == HAMLET_SCENE, ('assertEqual', zlib.decompress(zlib9, 9), HAMLET_SCENE)\n    assert zlib.decompress(zlib9, 15) == HAMLET_SCENE, ('assertEqual', zlib.decompress(zlib9, 15), HAMLET_SCENE)\n    if supports_wbits_0:\n        assert zlib.decompress(zlib9, 0) == HAMLET_SCENE, ('assertEqual', zlib.decompress(zlib9, 0), HAMLET_SCENE)\n    assert zlib.decompress(zlib9, 32 + 9) == HAMLET_SCENE, ('assertEqual', zlib.decompress(zlib9, 32 + 9), HAMLET_SCENE)\n    dco = zlib.decompressobj(wbits=32 + 9)\n    assert dco.decompress(zlib9) == HAMLET_SCENE, ('assertEqual', dco.decompress(zlib9), HAMLET_SCENE)\n    co = zlib.compressobj(level=1, wbits=-15)\n    deflate15 = co.compress(HAMLET_SCENE) + co.flush()\n    assert zlib.decompress(deflate15, -15) == HAMLET_SCENE, ('assertEqual', zlib.decompress(deflate15, -15), HAMLET_SCENE)\n    dco = zlib.decompressobj(wbits=-15)\n    assert dco.decompress(deflate15) == HAMLET_SCENE, ('assertEqual', dco.decompress(deflate15), HAMLET_SCENE)\n    co = zlib.compressobj(level=1, wbits=-9)\n    deflate9 = co.compress(HAMLET_SCENE) + co.flush()\n    assert zlib.decompress(deflate9, -9) == HAMLET_SCENE, ('assertEqual', zlib.decompress(deflate9, -9), HAMLET_SCENE)\n    assert zlib.decompress(deflate9, -15) == HAMLET_SCENE, ('assertEqual', zlib.decompress(deflate9, -15), HAMLET_SCENE)\n    dco = zlib.decompressobj(wbits=-9)\n    assert dco.decompress(deflate9) == HAMLET_SCENE, ('assertEqual', dco.decompress(deflate9), HAMLET_SCENE)\n    co = zlib.compressobj(level=1, wbits=16 + 15)\n    gzip = co.compress(HAMLET_SCENE) + co.flush()\n    assert zlib.decompress(gzip, 16 + 15) == HAMLET_SCENE, ('assertEqual', zlib.decompress(gzip, 16 + 15), HAMLET_SCENE)\n    assert zlib.decompress(gzip, 32 + 15) == HAMLET_SCENE, ('assertEqual', zlib.decompress(gzip, 32 + 15), HAMLET_SCENE)\n    dco = zlib.decompressobj(32 + 15)\n    assert dco.decompress(gzip) == HAMLET_SCENE, ('assertEqual', dco.decompress(gzip), HAMLET_SCENE)\n    for wbits in (-15, 15, 31):\n        expected = HAMLET_SCENE\n        actual = zlib.decompress(zlib.compress(HAMLET_SCENE, wbits=wbits), wbits=wbits)\n        assert expected == actual, ('assertEqual', expected, actual)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ZlibDecompressorTest.test_Constructor" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\nzlib = import_helper.import_module('zlib')\n\ndef _t():\n    try:\n        zlib._ZlibDecompressor(*('ASDA',))\n    except TypeError:\n        pass\n    try:\n        zlib._ZlibDecompressor(*(-15, 'notbytes'))\n    except TypeError:\n        pass\n    try:\n        zlib._ZlibDecompressor(*(-15, b'bytes', 5))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ZlibDecompressorTest.testPickle" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\nimport pickle\nzlib = import_helper.import_module('zlib')\n\ndef _t():\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        try:\n            pickle.dumps(zlib._ZlibDecompressor(), proto)\n        except TypeError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
