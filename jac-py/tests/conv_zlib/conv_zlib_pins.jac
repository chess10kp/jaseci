 invites you; go; your servants tend.\\n\\nLAERTES\\n\\n       Farewell, Ophelia; and remember well\\n       What I have said to you.\\n\\nOPHELIA\\n\\n       'Tis in my memory lock'd,\\n       And you yourself shall keep the key of it.\\n\\nLAERTES\\n\\n       Farewell.\\n\"\n\ndef _t():\n    data = HAMLET_SCENE * 128\n    x = zlib.compress(data)\n    if not HW_ACCELERATED:\n        assert zlib.compress(bytearray(data)) == x, ('assertEqual', zlib.compress(bytearray(data)), x)\n    for ob in (x, bytearray(x)):\n        assert zlib.decompress(ob) == data, ('assertEqual', zlib.decompress(ob), data)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

