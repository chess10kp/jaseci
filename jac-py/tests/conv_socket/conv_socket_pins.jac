test "TestExceptions.testExceptionTree" {
    (ok, detail) = p2_libtest_run_snippet("import socket\n\ndef _t():\n    assert issubclass(OSError, Exception), ('assertIsSubclass', OSError, Exception)\n    assert issubclass(socket.herror, OSError), ('assertIsSubclass', socket.herror, OSError)\n    assert issubclass(socket.gaierror, OSError), ('assertIsSubclass', socket.gaierror, OSError)\n    assert issubclass(socket.timeout, OSError), ('assertIsSubclass', socket.timeout, OSError)\n    assert socket.error is OSError, ('assertIs', socket.error, OSError)\n    assert socket.timeout is TimeoutError, ('assertIs', socket.timeout, TimeoutError)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestExceptions.test_setblocking_invalidfd" {
