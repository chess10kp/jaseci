test "CreateServerTest.test_reuse_port" {
    (ok, detail) = p2_libtest_run_snippet("import socket\n\ndef _t():\n    if not hasattr(socket, 'SO_REUSEPORT'):\n        try:\n            socket.create_server(('localhost', 0), reuse_port=True)\n        except ValueError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n    else:\n        with socket.create_server(('localhost', 0)) as sock:\n            opt = sock.getsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT)\n            assert opt == 0, ('assertEqual', opt, 0)\n        with socket.create_server(('localhost', 0), reuse_port=True) as sock:\n            opt = sock.getsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT)\n            assert opt != 0, ('assertNotEqual', opt, 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SendRecvFdsTests.testSendAndRecvFds" {
    (ok, detail) = p2_libtest_run_snippet("_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nimport os\nimport socket\nMSG = 'Michael Gilfix was here\u1234\\r\\n'.encode('utf-8')\n\ndef _t():\n\n    def close_pipes(pipes):\n        for fd1, fd2 in pipes:\n            os.close(fd1)\n            os.close(fd2)\n\n    def close_fds(fds):\n        for fd in fds:\n            os.close(fd)\n    pipes = [os.pipe() for _ in range(10)]\n    _add_cleanup(close_pipes, *(pipes,))\n    fds = [rfd for rfd, wfd in pipes]\n    sock1, sock2 = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)\n    with sock1, sock2:\n        socket.send_fds(sock1, [MSG], fds)\n        msg, fds2, flags, addr = socket.recv_fds(sock2, len(MSG) * 2, len(fds) * 2)\n        _add_cleanup(close_fds, *(fds2,))\n    assert msg == MSG, ('assertEqual', msg, MSG)\n    assert len(fds2) == len(fds), ('assertEqual', len(fds2), len(fds))\n    assert flags == 0, ('assertEqual', flags, 0)\n    for index, fds in enumerate(pipes):\n        rfd, wfd = fds\n        os.write(wfd, str(index).encode())\n    for index, rfd in enumerate(fds2):\n        data = os.read(rfd, 100)\n        assert data == str(index).encode(), ('assertEqual', data, str(index).encode())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _run_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
