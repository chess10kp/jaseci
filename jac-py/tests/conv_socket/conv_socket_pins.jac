test "GeneralModuleTests.testNtoH" {
    (ok, detail) = p2_libtest_run_snippet("import socket\n\ndef _t():\n    sizes = {socket.htonl: 32, socket.ntohl: 32, socket.htons: 16, socket.ntohs: 16}\n    for func, size in sizes.items():\n        mask = (1 << size) - 1\n        for i in (0, 1, 65535, ~65535, 2, 19088743, 1985229328):\n            assert i & mask == func(func(i & mask)) & mask, ('assertEqual', i & mask, func(func(i & mask)) & mask)\n        swapped = func(mask)\n        assert swapped & mask == mask, ('assertEqual', swapped & mask, mask)\n        try:\n            func(*(1 << 34,))\n        except OverflowError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
