test "GeneralModuleTests.test_socket_consistent_sock_type" {
    (ok, detail) = p2_libtest_run_snippet("import socket\n\ndef _t():\n    SOCK_NONBLOCK = getattr(socket, 'SOCK_NONBLOCK', 0)\n    SOCK_CLOEXEC = getattr(socket, 'SOCK_CLOEXEC', 0)\n    sock_type = socket.SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC\n    with socket.socket(socket.AF_INET, sock_type) as s:\n        assert s.type == socket.SOCK_STREAM, ('assertEqual', s.type, socket.SOCK_STREAM)\n        s.settimeout(1)\n        assert s.type == socket.SOCK_STREAM, ('assertEqual', s.type, socket.SOCK_STREAM)\n        s.settimeout(0)\n        assert s.type == socket.SOCK_STREAM, ('assertEqual', s.type, socket.SOCK_STREAM)\n        s.setblocking(True)\n        assert s.type == socket.SOCK_STREAM, ('assertEqual', s.type, socket.SOCK_STREAM)\n        s.setblocking(False)\n        assert s.type == socket.SOCK_STREAM, ('assertEqual', s.type, socket.SOCK_STREAM)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
