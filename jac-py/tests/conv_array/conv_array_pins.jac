test "ByteTest.test_index" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-1, 0, 1, 43, 127]\n    self.example = [-1, 0, 1, 42, 127]\n    self.minitemsize = 1\n    self.outside = 23\n    self.smallerexample = [-1, 0, 1, 42, 126]\n    self.typecode = 'b'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    example = 2 * self.example\n    a = array.array(self.typecode, example)\n    try:\n        a.index()\n    except TypeError:\n        pass\n    for x in example:\n        assert a.index(x) == example.index(x), ('assertEqual', a.index(x), example.index(x))\n    try:\n        a.index(*(None,))\n    except ValueError:\n        pass\n    try:\n        a.index(*(self.outside,))\n    except ValueError:\n        pass\n    a = array.array('i', [-2, -1, 0, 0, 1, 2])\n    assert a.index(0) == 2, ('assertEqual', a.index(0), 2)\n    assert a.index(0, 2) == 2, ('assertEqual', a.index(0, 2), 2)\n    assert a.index(0, -4) == 2, ('assertEqual', a.index(0, -4), 2)\n    assert a.index(-2, -10) == 0, ('assertEqual', a.index(-2, -10), 0)\n    assert a.index(0, 3) == 3, ('assertEqual', a.index(0, 3), 3)\n    assert a.index(0, -3) == 3, ('assertEqual', a.index(0, -3), 3)\n    assert a.index(0, 3, 4) == 3, ('assertEqual', a.index(0, 3, 4), 3)\n    assert a.index(0, -3, -2) == 3, ('assertEqual', a.index(0, -3, -2), 3)\n    try:\n        a.index(*(2, 0, -10))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

