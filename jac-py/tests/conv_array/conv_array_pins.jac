test "ByteTest.test_cmp" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-1, 0, 1, 43, 127]\n    self.example = [-1, 0, 1, 42, 127]\n    self.minitemsize = 1\n    self.outside = 23\n    self.smallerexample = [-1, 0, 1, 42, 126]\n    self.typecode = 'b'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = array.array(self.typecode, self.example)\n    assert (a == 42) is False, ('assertIs', (a == 42), False)\n    assert (a != 42) is True, ('assertIs', (a != 42), True)\n    assert (a == a) is True, ('assertIs', (a == a), True)\n    assert (a != a) is False, ('assertIs', (a != a), False)\n    assert (a < a) is False, ('assertIs', (a < a), False)\n    assert (a <= a) is True, ('assertIs', (a <= a), True)\n    assert (a > a) is False, ('assertIs', (a > a), False)\n    assert (a >= a) is True, ('assertIs', (a >= a), True)\n    al = array.array(self.typecode, self.smallerexample)\n    ab = array.array(self.typecode, self.biggerexample)\n    assert (a == 2 * a) is False, ('assertIs', (a == 2 * a), False)\n    assert (a != 2 * a) is True, ('assertIs', (a != 2 * a), True)\n    assert (a < 2 * a) is True, ('assertIs', (a < 2 * a), True)\n    assert (a <= 2 * a) is True, ('assertIs', (a <= 2 * a), True)\n    assert (a > 2 * a) is False, ('assertIs', (a > 2 * a), False)\n    assert (a >= 2 * a) is False, ('assertIs', (a >= 2 * a), False)\n    assert (a == al) is False, ('assertIs', (a == al), False)\n    assert (a != al) is True, ('assertIs', (a != al), True)\n    assert (a < al) is False, ('assertIs', (a < al), False)\n    assert (a <= al) is False, ('assertIs', (a <= al), False)\n    assert (a > al) is True, ('assertIs', (a > al), True)\n    assert (a >= al) is True, ('assertIs', (a >= al), True)\n    assert (a == ab) is False, ('assertIs', (a == ab), False)\n    assert (a != ab) is True, ('assertIs', (a != ab), True)\n    assert (a < ab) is True, ('assertIs', (a < ab), True)\n    assert (a <= ab) is True, ('assertIs', (a <= ab), True)\n    assert (a > ab) is False, ('assertIs', (a > ab), False)\n    assert (a >= ab) is False, ('assertIs', (a >= ab), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

