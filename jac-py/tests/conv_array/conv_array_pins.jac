\n    assert (a < al) is False, ('assertIs', (a < al), False)\n    assert (a <= al) is False, ('assertIs', (a <= al), False)\n    assert (a > al) is True, ('assertIs', (a > al), True)\n    assert (a >= al) is True, ('assertIs', (a >= al), True)\n    assert (a == ab) is False, ('assertIs', (a == ab), False)\n    assert (a != ab) is True, ('assertIs', (a != ab), True)\n    assert (a < ab) is True, ('assertIs', (a < ab), True)\n    assert (a <= ab) is True, ('assertIs', (a <= ab), True)\n    assert (a > ab) is False, ('assertIs', (a > ab), False)\n    assert (a >= ab) is False, ('assertIs', (a >= ab), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
