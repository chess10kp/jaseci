test "LargeArrayTest.test_setitem_use_after_shrink_with_int_data" {
    (ok, detail) = p2_libtest_run_snippet("import array\n\ndef _t():\n    victim = array.array('b', [1, 2, 3])\n\n    class Index:\n\n        def __index__(self):\n            victim.pop()\n            victim.pop()\n            return 0\n    try:\n        victim.__setitem__(*(1, Index()))\n    except IndexError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
