test "ByteTest.test_mul" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-1, 0, 1, 43, 127]\n    self.example = [-1, 0, 1, 42, 127]\n    self.minitemsize = 1\n    self.outside = 23\n    self.smallerexample = [-1, 0, 1, 42, 126]\n    self.typecode = 'b'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = 5 * array.array(self.typecode, self.example)\n    assert a == array.array(self.typecode, 5 * self.example), ('assertEqual', a, array.array(self.typecode, 5 * self.example))\n    a = array.array(self.typecode, self.example) * 5\n    assert a == array.array(self.typecode, self.example * 5), ('assertEqual', a, array.array(self.typecode, self.example * 5))\n    a = 0 * array.array(self.typecode, self.example)\n    assert a == array.array(self.typecode), ('assertEqual', a, array.array(self.typecode))\n    a = -1 * array.array(self.typecode, self.example)\n    assert a == array.array(self.typecode), ('assertEqual', a, array.array(self.typecode))\n    a = 5 * array.array(self.typecode, self.example[:1])\n    assert a == array.array(self.typecode, [a[0]] * 5), ('assertEqual', a, array.array(self.typecode, [a[0]] * 5))\n    try:\n        a.__mul__(*('bad',))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
