test "ByteTest.test_iterator_pickle" {
    (ok, detail) = p2_libtest_run_snippet("import pickle\nimport warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-1, 0, 1, 43, 127]\n    self.example = [-1, 0, 1, 42, 127]\n    self.minitemsize = 1\n    self.outside = 23\n    self.smallerexample = [-1, 0, 1, 42, 126]\n    self.typecode = 'b'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    orig = array.array(self.typecode, self.example)\n    data = list(orig)\n    data2 = data[::-1]\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        itorig = iter(orig)\n        d = pickle.dumps((itorig, orig), proto)\n        it, a = pickle.loads(d)\n        a.fromlist(data2)\n        assert type(it) == type(itorig), ('assertEqual', type(it), type(itorig))\n        assert list(it) == data + data2, ('assertEqual', list(it), data + data2)\n        next(itorig)\n        d = pickle.dumps((itorig, orig), proto)\n        it, a = pickle.loads(d)\n        a.fromlist(data2)\n        assert type(it) == type(itorig), ('assertEqual', type(it), type(itorig))\n        assert list(it) == data[1:] + data2, ('assertEqual', list(it), data[1:] + data2)\n        for i in range(1, len(data)):\n            next(itorig)\n        d = pickle.dumps((itorig, orig), proto)\n        it, a = pickle.loads(d)\n        a.fromlist(data2)\n        assert type(it) == type(itorig), ('assertEqual', type(it), type(itorig))\n        assert list(it) == data2, ('assertEqual', list(it), data2)\n        try:\n            next(*(itorig,))\n        except StopIteration:\n            pass\n        d = pickle.dumps((itorig, orig), proto)\n        it, a = pickle.loads(d)\n        a.fromlist(data2)\n        assert list(it) == [], ('assertEqual', list(it), [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

