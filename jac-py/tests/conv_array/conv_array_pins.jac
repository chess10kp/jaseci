test "ByteTest.test_exhausted_reverse_iterator" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-1, 0, 1, 43, 127]\n    self.example = [-1, 0, 1, 42, 127]\n    self.minitemsize = 1\n    self.outside = 23\n    self.smallerexample = [-1, 0, 1, 42, 126]\n    self.typecode = 'b'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = array.array(self.typecode, self.example)\n    assert list(a) == list(self.example), ('assertEqual', list(a), list(self.example))\n    exhit = reversed(a)\n    empit = reversed(a)\n    for x in exhit:\n        next(empit)\n    a.insert(0, self.outside)\n    assert list(exhit) == [], ('assertEqual', list(exhit), [])\n    assert list(empit) == [], ('assertEqual', list(empit), [])\n    assert list(a) == [self.outside] + list(self.example), ('assertEqual', list(a), [self.outside] + list(self.example))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
