test "FloatTest.test_nan" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-42.0, 0, 42, 100000.0, 10000000000.0]\n    self.example = [-42.0, 0, 42, 100000.0, -10000000000.0]\n    self.minitemsize = 4\n    self.outside = 23\n    self.smallerexample = [-42.0, 0, 42, 100000.0, -20000000000.0]\n    self.typecode = 'f'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = array.array(self.typecode, [float('nan')])\n    b = array.array(self.typecode, [float('nan')])\n    assert (a != b) is True, ('assertIs', (a != b), True)\n    assert (a == b) is False, ('assertIs', (a == b), False)\n    assert (a > b) is False, ('assertIs', (a > b), False)\n    assert (a >= b) is False, ('assertIs', (a >= b), False)\n    assert (a < b) is False, ('assertIs', (a < b), False)\n    assert (a <= b) is False, ('assertIs', (a <= b), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "DoubleTest.test_nan" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-42.0, 0, 42, 100000.0, 10000000000.0]\n    self.example = [-42.0, 0, 42, 100000.0, -10000000000.0]\n    self.minitemsize = 8\n    self.outside = 23\n    self.smallerexample = [-42.0, 0, 42, 100000.0, -20000000000.0]\n    self.typecode = 'd'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = array.array(self.typecode, [float('nan')])\n    b = array.array(self.typecode, [float('nan')])\n    assert (a != b) is True, ('assertIs', (a != b), True)\n    assert (a == b) is False, ('assertIs', (a == b), False)\n    assert (a > b) is False, ('assertIs', (a > b), False)\n    assert (a >= b) is False, ('assertIs', (a >= b), False)\n    assert (a < b) is False, ('assertIs', (a < b), False)\n    assert (a <= b) is False, ('assertIs', (a <= b), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FloatTest.test_byteswap" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-42.0, 0, 42, 100000.0, 10000000000.0]\n    self.example = [-42.0, 0, 42, 100000.0, -10000000000.0]\n    self.minitemsize = 4\n    self.outside = 23\n    self.smallerexample = [-42.0, 0, 42, 100000.0, -20000000000.0]\n    self.typecode = 'f'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = array.array(self.typecode, self.example)\n    try:\n        a.byteswap(*(42,))\n    except TypeError:\n        pass\n    if a.itemsize in (1, 2, 4, 8):\n        b = array.array(self.typecode, self.example)\n        b.byteswap()\n        if a.itemsize == 1:\n            assert a == b, ('assertEqual', a, b)\n        else:\n            assert a.tobytes() != b.tobytes(), ('assertNotEqual', a.tobytes(), b.tobytes())\n        b.byteswap()\n        assert a == b, ('assertEqual', a, b)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

