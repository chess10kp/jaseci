test "ByteTest.test_extslice" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-1, 0, 1, 43, 127]\n    self.example = [-1, 0, 1, 42, 127]\n    self.minitemsize = 1\n    self.outside = 23\n    self.smallerexample = [-1, 0, 1, 42, 126]\n    self.typecode = 'b'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = array.array(self.typecode, range(5))\n    assert a[:] == a, ('assertEqual', a[:], a)\n    assert a[::2] == array.array(self.typecode, [0, 2, 4]), ('assertEqual', a[::2], array.array(self.typecode, [0, 2, 4]))\n    assert a[1::2] == array.array(self.typecode, [1, 3]), ('assertEqual', a[1::2], array.array(self.typecode, [1, 3]))\n    assert a[::-1] == array.array(self.typecode, [4, 3, 2, 1, 0]), ('assertEqual', a[::-1], array.array(self.typecode, [4, 3, 2, 1, 0]))\n    assert a[::-2] == array.array(self.typecode, [4, 2, 0]), ('assertEqual', a[::-2], array.array(self.typecode, [4, 2, 0]))\n    assert a[3::-2] == array.array(self.typecode, [3, 1]), ('assertEqual', a[3::-2], array.array(self.typecode, [3, 1]))\n    assert a[-100:100] == a, ('assertEqual', a[-100:100], a)\n    assert a[100:-100:-1] == a[::-1], ('assertEqual', a[100:-100:-1], a[::-1])\n    assert a[-100:100:2] == array.array(self.typecode, [0, 2, 4]), ('assertEqual', a[-100:100:2], array.array(self.typecode, [0, 2, 4]))\n    assert a[1000:2000:2] == array.array(self.typecode, []), ('assertEqual', a[1000:2000:2], array.array(self.typecode, []))\n    assert a[-1000:-2000:-2] == array.array(self.typecode, []), ('assertEqual', a[-1000:-2000:-2], array.array(self.typecode, []))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

