\n    assert a[-1000:1000] == a, ('assertEqual', a[-1000:1000], a)\n    assert a[2000:1000] == array.array(self.typecode), ('assertEqual', a[2000:1000], array.array(self.typecode))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
