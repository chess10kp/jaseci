    (ok, detail) = p2_libtest_run_snippet("import operator\nimport warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [0, 1, 17, 23, 43, 255]\n    self.example = [0, 1, 17, 23, 42, 255]\n    self.minitemsize = 4\n    self.outside = 170\n    self.smallerexample = [0, 1, 17, 23, 42, 254]\n    self.typecode = 'L'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = array.array(self.typecode, self.example)\n    m = memoryview(a)\n    expected = m.tobytes()\n    assert a.tobytes() == expected, ('assertEqual', a.tobytes(), expected)\n    assert a.tobytes()[0] == expected[0], ('assertEqual', a.tobytes()[0], expected[0])\n    try:\n        a.append(*(a[0],))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        a.extend(*(a[0:1],))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        a.remove(*(a[0],))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        a.pop(*(0,))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        a.fromlist(*(a.tolist(),))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        a.frombytes(*(a.tobytes(),))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    if self.typecode in ('u', 'w'):\n        try:\n            a.fromunicode(*(a.tounicode(),))\n        except BufferError:\n            pass\n        assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        operator.imul(*(a, 2))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        operator.imul(*(a, 0))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        operator.setitem(*(a, slice(0, 0), a))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        operator.delitem(*(a, 0))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\n    try:\n        operator.delitem(*(a, slice(0, 1)))\n    except BufferError:\n        pass\n    assert m.tobytes() == expected, ('assertEqual', m.tobytes(), expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

