test "ByteTest.test_buffer_info" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\nimport array\n\ndef setUp():\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.biggerexample = [-1, 0, 1, 43, 127]\n    self.example = [-1, 0, 1, 42, 127]\n    self.minitemsize = 1\n    self.outside = 23\n    self.smallerexample = [-1, 0, 1, 42, 126]\n    self.typecode = 'b'\n    _enterctx_cm = warnings.catch_warnings()\n    _enterctx_cm.__enter__()\n    warnings.filterwarnings('ignore', message=\"The 'u' type code is deprecated and will be removed in Python 3.16\", category=DeprecationWarning)\n    a = array.array(self.typecode, self.example)\n    try:\n        a.buffer_info(*(42,))\n    except TypeError:\n        pass\n    bi = a.buffer_info()\n    assert isinstance(bi, tuple), ('assertIsInstance', bi, tuple)\n    assert len(bi) == 2, ('assertEqual', len(bi), 2)\n    assert isinstance(bi[0], int), ('assertIsInstance', bi[0], int)\n    assert isinstance(bi[1], int), ('assertIsInstance', bi[1], int)\n    assert bi[1] == len(a), ('assertEqual', bi[1], len(a))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
