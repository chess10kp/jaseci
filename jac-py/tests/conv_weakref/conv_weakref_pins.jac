test "ReferencesTestCase.test_callback_in_cycle_resurrection" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\n\nclass C:\n\n    def method(self):\n        pass\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cbcalled = 0\n    import gc\n    alist = []\n\n    class C(object):\n\n        def __init__(self, value):\n            self.attribute = value\n\n        def acallback(self, ignore):\n            alist.append(self.c)\n    c1, c2 = (C(1), C(2))\n    c1.c = c2\n    c2.c = c1\n    c1.wr = weakref.ref(c2, c1.acallback)\n    c2.wr = weakref.ref(c1, c2.acallback)\n\n    def C_went_away(ignore):\n        alist.append('C went away')\n    wr = weakref.ref(C, C_went_away)\n    del c1, c2, C\n    assert alist == [], ('assertEqual', alist, [])\n    gc.collect()\n    assert alist == ['C went away'], ('assertEqual', alist, ['C went away'])\n    assert wr() == None, ('assertEqual', wr(), None)\n    del alist[:]\n    gc.collect()\n    assert alist == [], ('assertEqual', alist, [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ReferencesTestCase.test_callbacks_on_callback" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\n\nclass C:\n\n    def method(self):\n        pass\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cbcalled = 0\n    import gc\n    alist = []\n\n    def safe_callback(ignore):\n        alist.append('safe_callback called')\n\n    class C(object):\n\n        def cb(self, ignore):\n            alist.append('cb called')\n    c, d = (C(), C())\n    c.other = d\n    d.other = c\n    callback = c.cb\n    c.wr = weakref.ref(d, callback)\n    d.wr = weakref.ref(callback, d.cb)\n    external_wr = weakref.ref(callback, safe_callback)\n    assert external_wr() is callback, ('assertIs', external_wr(), callback)\n    del callback, c, d, C\n    assert alist == [], ('assertEqual', alist, [])\n    gc.collect()\n    assert alist == ['safe_callback called'], ('assertEqual', alist, ['safe_callback called'])\n    assert external_wr() == None, ('assertEqual', external_wr(), None)\n    del alist[:]\n    gc.collect()\n    assert alist == [], ('assertEqual', alist, [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

