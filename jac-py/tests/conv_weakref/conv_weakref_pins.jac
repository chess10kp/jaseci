test "SubclassableWeakrefTestCase.test_subclass_refs_with_slots" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cbcalled = 0\n\n    class MyRef(weakref.ref):\n        __slots__ = ('slot1', 'slot2')\n\n        def __new__(type, ob, callback, slot1, slot2):\n            return weakref.ref.__new__(type, ob, callback)\n\n        def __init__(self, ob, callback, slot1, slot2):\n            self.slot1 = slot1\n            self.slot2 = slot2\n\n        def meth(self):\n            return self.slot1 + self.slot2\n    o = Object(42)\n    r = MyRef(o, None, 'abc', 'def')\n    assert r.slot1 == 'abc', ('assertEqual', r.slot1, 'abc')\n    assert r.slot2 == 'def', ('assertEqual', r.slot2, 'def')\n    assert r.meth() == 'abcdef', ('assertEqual', r.meth(), 'abcdef')\n    assert not hasattr(r, '__dict__'), ('assertNotHasAttr', r, '__dict__')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SubclassableWeakrefTestCase.test_subclass_refs_with_cycle" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\nclass C:\n\n    def method(self):\n        pass\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cbcalled = 0\n    'Confirm https://bugs.python.org/issue3100 is fixed.'\n\n    class MyRef(weakref.ref):\n        pass\n\n    def callback(w):\n        self.cbcalled += 1\n    o = C()\n    r1 = MyRef(o, callback)\n    r1.o = o\n    del o\n    del r1\n    assert self.cbcalled == 0, ('assertEqual', self.cbcalled, 0)\n    o = C()\n    r1 = MyRef(o, callback)\n    r2 = MyRef(o, callback)\n    r1.r = r2\n    r2.o = o\n    del o\n    del r2\n    del r1\n    assert self.cbcalled == 0, ('assertEqual', self.cbcalled, 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "WeakMethodTestCase.test_alive" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n    o = Object(1)\n    r = weakref.WeakMethod(o.some_method)\n    assert isinstance(r, weakref.ReferenceType), ('assertIsInstance', r, weakref.ReferenceType)\n    assert isinstance(r(), type(o.some_method)), ('assertIsInstance', r(), type(o.some_method))\n    assert r().__self__ is o, ('assertIs', r().__self__, o)\n    assert r().__func__ is o.some_method.__func__, ('assertIs', r().__func__, o.some_method.__func__)\n    assert r()() == 4, ('assertEqual', r()(), 4)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "WeakMethodTestCase.test_object_dead" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n    o = Object(1)\n    r = weakref.WeakMethod(o.some_method)\n    del o\n    gc.collect()\n    assert r() is None, ('assertIs', r(), None)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "WeakMethodTestCase.test_method_dead" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\n\nclass C:\n\n    def method(self):\n        pass\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _subclass():\n    \"\"\"Return an Object subclass overriding `some_method`.\"\"\"\n\n    class C(Object):\n\n        def some_method(self):\n            return 6\n    return C\n\nclass C:\n\n    def method(self):\n        pass\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n    C = _subclass()\n    o = C(1)\n    r = weakref.WeakMethod(o.some_method)\n    del C.some_method\n    gc.collect()\n    assert r() is None, ('assertIs', r(), None)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

