test "SubclassableWeakrefTestCase.test_subclass_refs" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\nfrom test.support import gc_collect\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cbcalled = 0\n\n    class MyRef(weakref.ref):\n\n        def __init__(self, ob, callback=None, value=42):\n            self.value = value\n            super().__init__(ob, callback)\n\n        def __call__(self):\n            self.called = True\n            return super().__call__()\n    o = Object('foo')\n    mr = MyRef(o, value=24)\n    assert mr() is o, ('assertIs', mr(), o)\n    assert mr.called, ('assertTrue', mr.called)\n    assert mr.value == 24, ('assertEqual', mr.value, 24)\n    del o\n    gc_collect()\n    assert mr() is None, ('assertIsNone', mr())\n    assert mr.called, ('assertTrue', mr.called)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SubclassableWeakrefTestCase.test_subclass_refs_dont_replace_standard_refs" {
