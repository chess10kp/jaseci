test "ReferencesTestCase.test_equality" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\nfrom test.support import script_helper, ALWAYS_EQ\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cbcalled = 0\n    x = Object(1)\n    y = Object(1)\n    z = Object(2)\n    a = weakref.ref(x)\n    b = weakref.ref(y)\n    c = weakref.ref(z)\n    d = weakref.ref(x)\n    assert a == b, ('assertTrue', a == b)\n    assert not a != b, ('assertFalse', a != b)\n    assert not a == c, ('assertFalse', a == c)\n    assert a != c, ('assertTrue', a != c)\n    assert a == d, ('assertTrue', a == d)\n    assert not a != d, ('assertFalse', a != d)\n    assert not a == x, ('assertFalse', a == x)\n    assert a != x, ('assertTrue', a != x)\n    assert a == ALWAYS_EQ, ('assertTrue', a == ALWAYS_EQ)\n    assert not a != ALWAYS_EQ, ('assertFalse', a != ALWAYS_EQ)\n    del x, y, z\n    gc.collect()\n    for r in (a, b, c):\n        assert r() is None, ('assertIs', r(), None)\n    assert not a == b, ('assertFalse', a == b)\n    assert a != b, ('assertTrue', a != b)\n    assert not a == c, ('assertFalse', a == c)\n    assert a != c, ('assertTrue', a != c)\n    assert (a == d) == (a is d), ('assertEqual', (a == d), (a is d))\n    assert (a != d) == (a is not d), ('assertEqual', (a != d), (a is not d))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ReferencesTestCase.test_ordering" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\nimport operator\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cbcalled = 0\n    ops = [operator.lt, operator.gt, operator.le, operator.ge]\n    x = Object(1)\n    y = Object(1)\n    a = weakref.ref(x)\n    b = weakref.ref(y)\n    for op in ops:\n        try:\n            op(*(a, b))\n        except TypeError:\n            pass\n    del x, y\n    gc.collect()\n    for op in ops:\n        try:\n            op(*(a, b))\n        except TypeError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

