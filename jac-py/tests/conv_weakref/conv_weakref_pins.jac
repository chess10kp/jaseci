test "WeakMethodTestCase.test_equality" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\nfrom test.support import script_helper, ALWAYS_EQ\n\ndef create_function():\n\n    def f():\n        pass\n    return f\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n\n    def _eq(a, b):\n        assert a == b, ('assertTrue', a == b)\n        assert not a != b, ('assertFalse', a != b)\n\n    def _ne(a, b):\n        assert a != b, ('assertTrue', a != b)\n        assert not a == b, ('assertFalse', a == b)\n    x = Object(1)\n    y = Object(1)\n    a = weakref.WeakMethod(x.some_method)\n    b = weakref.WeakMethod(y.some_method)\n    c = weakref.WeakMethod(x.other_method)\n    d = weakref.WeakMethod(y.other_method)\n    _eq(a, b)\n    _eq(c, d)\n    _ne(a, c)\n    _ne(a, d)\n    _ne(b, c)\n    _ne(b, d)\n    z = Object(2)\n    e = weakref.WeakMethod(z.some_method)\n    f = weakref.WeakMethod(z.other_method)\n    _ne(a, e)\n    _ne(a, f)\n    _ne(b, e)\n    _ne(b, f)\n    _ne(a, x.some_method)\n    _eq(a, ALWAYS_EQ)\n    del x, y, z\n    gc.collect()\n    refs = (a, b, c, d, e, f)\n    for q in refs:\n        for r in refs:\n            assert (q == r) == (q is r), ('assertEqual', (q == r), (q is r))\n            assert (q != r) == (q is not r), ('assertEqual', (q != r), (q is not r))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "WeakMethodTestCase.test_hashing" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n    x = Object(1)\n    y = Object(1)\n    a = weakref.WeakMethod(x.some_method)\n    b = weakref.WeakMethod(y.some_method)\n    c = weakref.WeakMethod(y.other_method)\n    assert hash(a) == hash(b), ('assertEqual', hash(a), hash(b))\n    ha = hash(a)\n    del x, y\n    gc.collect()\n    assert hash(a) == ha, ('assertEqual', hash(a), ha)\n    assert hash(b) == ha, ('assertEqual', hash(b), ha)\n    try:\n        hash(*(c,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MappingTestCase.test_weak_keyed_len_cycles" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\n\nclass RefCycle:\n\n    def __init__(self):\n        self.cycle = self\n\ndef check_len_cycles(dict_type, cons):\n    N = 20\n    items = [RefCycle() for i in range(N)]\n    dct = dict_type((cons(o) for o in items))\n    it = dct.items()\n    try:\n        next(it)\n    except StopIteration:\n        pass\n    del items\n    gc.collect()\n    n1 = len(dct)\n    del it\n    gc.collect()\n    n2 = len(dct)\n    assert n1 in (0, 1), ('assertIn', n1, (0, 1))\n    assert n2 == 0, ('assertEqual', n2, 0)\n\nclass RefCycle:\n\n    def __init__(self):\n        self.cycle = self\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.COUNT = 10\n    self.cbcalled = 0\n    check_len_cycles(weakref.WeakKeyDictionary, lambda k: (k, 1))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

