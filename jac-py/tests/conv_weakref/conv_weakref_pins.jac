    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\n\nclass C:\n\n    def method(self):\n        pass\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _subclass():\n    \"\"\"Return an Object subclass overriding `some_method`.\"\"\"\n\n    class C(Object):\n\n        def some_method(self):\n            return 6\n    return C\n\nclass C:\n\n    def method(self):\n        pass\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n    C = _subclass()\n    calls = []\n\n    def cb(arg):\n        calls.append(arg)\n    o = C(1)\n    r = weakref.WeakMethod(o.some_method, cb)\n    del o\n    gc.collect()\n    assert calls == [r], ('assertEqual', calls, [r])\n    C.some_method = Object.some_method\n    gc.collect()\n    assert calls == [r], ('assertEqual', calls, [r])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
