    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MappingTestCase.test_weak_keyed_cascading_deletes" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\nfrom test.support import gc_collect\n\nclass C:\n\n    def method(self):\n        pass\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.COUNT = 10\n    self.cbcalled = 0\n    d = weakref.WeakKeyDictionary()\n    mutate = False\n\n    class C(object):\n\n        def __init__(self, i):\n            self.value = i\n\n        def __hash__(self):\n            return hash(self.value)\n\n        def __eq__(self, other):\n            if mutate:\n                del objs[-1]\n            return self.value == other.value\n    objs = [C(i) for i in range(4)]\n    for o in objs:\n        d[o] = o.value\n    del o\n    objs = list(d.keys())\n    objs.reverse()\n    mutate = True\n    count = 0\n    for o in objs:\n        count += 1\n        del d[o]\n    gc_collect()\n    assert len(d) == 0, ('assertEqual', len(d), 0)\n    assert count == 2, ('assertEqual', count, 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MappingTestCase.test_make_weak_valued_dict_repr" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport weakref\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.COUNT = 10\n    self.cbcalled = 0\n    dict = weakref.WeakValueDictionary()\n    assert _re.search('<WeakValueDictionary at 0x.*>', repr(dict)), ('assertRegex', repr(dict), '<WeakValueDictionary at 0x.*>')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

