test "MappingTestCase.test_weak_valued_dict_update" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\nclass C:\n\n    def method(self):\n        pass\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef check_update(klass, dict):\n    weakdict = klass()\n    weakdict.update(dict)\n    assert len(weakdict) == len(dict), ('assertEqual', len(weakdict), len(dict))\n    for k in weakdict.keys():\n        assert k in dict, ('assertIn', k, dict)\n        v = dict.get(k)\n        assert v is weakdict[k], ('assertIs', v, weakdict[k])\n        assert v is weakdict.get(k), ('assertIs', v, weakdict.get(k))\n    for k in dict.keys():\n        assert k in weakdict, ('assertIn', k, weakdict)\n        v = dict[k]\n        assert v is weakdict[k], ('assertIs', v, weakdict[k])\n        assert v is weakdict.get(k), ('assertIs', v, weakdict.get(k))\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.COUNT = 10\n    self.cbcalled = 0\n    check_update(weakref.WeakValueDictionary, {1: C(), 'a': C(), C(): C()})\n    try:\n        weakref.WeakValueDictionary.update()\n    except TypeError:\n        pass\n    d = weakref.WeakValueDictionary()\n    try:\n        d.update(*({}, {}))\n    except TypeError:\n        pass\n    try:\n        d.update(*((), ()))\n    except TypeError:\n        pass\n    assert list(d.keys()) == [], ('assertEqual', list(d.keys()), [])\n    o = Object(3)\n    for kw in ('self', 'dict', 'other', 'iterable'):\n        d = weakref.WeakValueDictionary()\n        d.update(**{kw: o})\n        assert list(d.keys()) == [kw], ('assertEqual', list(d.keys()), [kw])\n        assert d[kw] == o, ('assertEqual', d[kw], o)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MappingTestCase.test_weak_valued_union_operators" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\nclass C:\n\n    def method(self):\n        pass\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.COUNT = 10\n    self.cbcalled = 0\n    a = C()\n    b = C()\n    c = C()\n    wvd1 = weakref.WeakValueDictionary({1: a})\n    wvd2 = weakref.WeakValueDictionary({1: b, 2: a})\n    wvd3 = wvd1.copy()\n    d1 = {1: c, 3: b}\n    pairs = [(5, c), (6, b)]\n    tmp1 = wvd1 | wvd2\n    assert dict(tmp1) == dict(wvd1) | dict(wvd2), ('assertEqual', dict(tmp1), dict(wvd1) | dict(wvd2))\n    assert type(tmp1) is weakref.WeakValueDictionary, ('assertIs', type(tmp1), weakref.WeakValueDictionary)\n    wvd1 |= wvd2\n    assert wvd1 == tmp1, ('assertEqual', wvd1, tmp1)\n    tmp2 = wvd2 | d1\n    assert dict(tmp2) == dict(wvd2) | d1, ('assertEqual', dict(tmp2), dict(wvd2) | d1)\n    assert type(tmp2) is weakref.WeakValueDictionary, ('assertIs', type(tmp2), weakref.WeakValueDictionary)\n    wvd2 |= d1\n    assert wvd2 == tmp2, ('assertEqual', wvd2, tmp2)\n    tmp3 = wvd3.copy()\n    tmp3 |= pairs\n    assert dict(tmp3) == dict(wvd3) | dict(pairs), ('assertEqual', dict(tmp3), dict(wvd3) | dict(pairs))\n    assert type(tmp3) is weakref.WeakValueDictionary, ('assertIs', type(tmp3), weakref.WeakValueDictionary)\n    tmp4 = d1 | wvd3\n    assert dict(tmp4) == d1 | dict(wvd3), ('assertEqual', dict(tmp4), d1 | dict(wvd3))\n    assert type(tmp4) is weakref.WeakValueDictionary, ('assertIs', type(tmp4), weakref.WeakValueDictionary)\n    del a\n    assert 2 not in tmp1, ('assertNotIn', 2, tmp1)\n    assert 2 not in tmp2, ('assertNotIn', 2, tmp2)\n    assert 1 not in tmp3, ('assertNotIn', 1, tmp3)\n    assert 1 not in tmp4, ('assertNotIn', 1, tmp4)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

