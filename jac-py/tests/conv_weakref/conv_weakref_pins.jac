test "ModuleTestCase.test_names" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\ndef _t():\n    for name in ('ReferenceType', 'ProxyType', 'CallableProxyType', 'WeakMethod', 'WeakSet', 'WeakKeyDictionary', 'WeakValueDictionary'):\n        obj = getattr(weakref, name)\n        if name != 'WeakSet':\n            assert obj.__module__ == 'weakref', ('assertEqual', obj.__module__, 'weakref')\n        assert obj.__name__ == name, ('assertEqual', obj.__name__, name)\n        assert obj.__qualname__ == name, ('assertEqual', obj.__qualname__, name)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "weakref.doctests:libreftest" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\nfrom test.support import gc_collect\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n_d_buf = []\n\ndef _d_print(*args, sep=' '):\n    _d_buf.append(sep.join((str(a) for a in args)))\n\ndef _d_clear():\n    _d_buf.clear()\n\ndef _d_ell_match(want, got):\n    parts = want.split('...')\n    if len(parts) == 1:\n        return want == got\n    if not got.startswith(parts[0]) or not got.endswith(parts[-1]):\n        return False\n    pos = len(parts[0])\n    end = len(got) - len(parts[-1])\n    for seg in parts[1:-1]:\n        idx = got.find(seg, pos)\n        if idx < 0 or idx > end:\n            return False\n        pos = idx + len(seg)\n    return True\n\ndef _d_check(idx, want, ell=False):\n    got = chr(10).join(_d_buf)\n    ok = _d_ell_match(want, got) if ell else got == want\n    if not ok and want in ('0', '1'):\n        ok = got == ('False' if want == '0' else 'True')\n    assert ok, ('doctest', idx, got, want)\n_d_clear()\nfrom test.support import gc_collect\n_d_clear()\nimport weakref\n_d_clear()\n\nclass Dict(dict):\n    pass\n_d_clear()\nobj = Dict(red=1, green=2, blue=3)\n_d_clear()\nr = weakref.ref(obj)\n_d_clear()\n_d_r = _d_print(r() is obj)\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(5, 'True')\n_d_clear()\nimport weakref\n_d_clear()\n\nclass Object:\n    pass\n_d_clear()\no = Object()\n_d_clear()\nr = weakref.ref(o)\n_d_clear()\no2 = r()\n_d_clear()\n_d_r = o is o2\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(11, 'True')\n_d_clear()\ndel o, o2\n_d_clear()\n_d_r = gc_collect()\n_d_clear()\n_d_r = _d_print(r())\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(14, 'None')\n_d_clear()\nimport weakref\n_d_clear()\n\nclass ExtendedRef(weakref.ref):\n\n    def __init__(self, ob, callback=None, **annotations):\n        super().__init__(ob, callback)\n        self.__counter = 0\n        for k, v in annotations.items():\n            setattr(self, k, v)\n\n    def __call__(self):\n        \"\"\"Return a pair containing the referent and the number of\n        times the reference has been called.\n        \"\"\"\n        ob = super().__call__()\n        if ob is not None:\n            self.__counter += 1\n            ob = (ob, self.__counter)\n        return ob\n_d_clear()\n\nclass A:\n    pass\n_d_clear()\na = A()\n_d_clear()\nr = ExtendedRef(a, foo=1, bar='baz')\n_d_clear()\n_d_r = r.foo\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(20, '1')\n_d_clear()\n_d_r = r.bar\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(21, \"'baz'\")\n_d_clear()\n_d_r = r()[1]\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(22, '1')\n_d_clear()\n_d_r = r()[1]\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(23, '2')\n_d_clear()\n_d_r = r()[0] is a\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(24, 'True')\n_d_clear()\nimport weakref\n_d_clear()\n_id2obj_dict = weakref.WeakValueDictionary()\n_d_clear()\n\ndef remember(obj):\n    oid = id(obj)\n    _id2obj_dict[oid] = obj\n    return oid\n_d_clear()\n\ndef id2obj(oid):\n    return _id2obj_dict[oid]\n_d_clear()\na = A()\n_d_clear()\na_id = remember(a)\n_d_clear()\n_d_r = id2obj(a_id) is a\nif _d_r is not None:\n    _d_buf.append(repr(_d_r))\n_d_check(31, 'True')\n_d_clear()\ndel a\n_d_clear()\n_d_r = gc_collect()\n_d_clear()\ntry:\n    id2obj(a_id)\nexcept KeyError:\n    _d_print('OK')\nelse:\n    _d_print('WeakValueDictionary error')\n_d_check(34, 'OK')\nprint('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
