test "MappingTestCase.test_weak_valued_dict_popitem" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\nclass C:\n\n    def method(self):\n        pass\n\ndef check_popitem(klass, key1, value1, key2, value2):\n    weakdict = klass()\n    weakdict[key1] = value1\n    weakdict[key2] = value2\n    assert len(weakdict) == 2, ('assertEqual', len(weakdict), 2)\n    k, v = weakdict.popitem()\n    assert len(weakdict) == 1, ('assertEqual', len(weakdict), 1)\n    if k is key1:\n        assert v is value1, ('assertIs', v, value1)\n    else:\n        assert v is value2, ('assertIs', v, value2)\n    k, v = weakdict.popitem()\n    assert len(weakdict) == 0, ('assertEqual', len(weakdict), 0)\n    if k is key1:\n        assert v is value1, ('assertIs', v, value1)\n    else:\n        assert v is value2, ('assertIs', v, value2)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.COUNT = 10\n    self.cbcalled = 0\n    check_popitem(weakref.WeakValueDictionary, 'key1', C(), 'key2', C())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

