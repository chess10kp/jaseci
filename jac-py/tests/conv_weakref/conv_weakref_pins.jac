test "MappingTestCase.test_weak_keyed_delitem" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\nclass Object:\n\n    def __init__(self, arg):\n        self.arg = arg\n\n    def __repr__(self):\n        return '<Object %r>' % self.arg\n\n    def __eq__(self, other):\n        if isinstance(other, Object):\n            return self.arg == other.arg\n        return NotImplemented\n\n    def __lt__(self, other):\n        if isinstance(other, Object):\n            return self.arg < other.arg\n        return NotImplemented\n\n    def __hash__(self):\n        return hash(self.arg)\n\n    def some_method(self):\n        return 4\n\n    def other_method(self):\n        return 5\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.COUNT = 10\n    self.cbcalled = 0\n    d = weakref.WeakKeyDictionary()\n    o1 = Object('1')\n    o2 = Object('2')\n    d[o1] = 'something'\n    d[o2] = 'something'\n    assert len(d) == 2, ('assertEqual', len(d), 2)\n    del d[o1]\n    assert len(d) == 1, ('assertEqual', len(d), 1)\n    assert list(d.keys()) == [o2], ('assertEqual', list(d.keys()), [o2])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
