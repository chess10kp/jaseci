test "MappingTestCase.test_weak_valued_dict_setdefault" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\n\nclass C:\n\n    def method(self):\n        pass\n\ndef check_setdefault(klass, key, value1, value2):\n    assert value1 is not value2, ('assertIsNot', value1, value2)\n    weakdict = klass()\n    o = weakdict.setdefault(key, value1)\n    assert o is value1, ('assertIs', o, value1)\n    assert key in weakdict, ('assertIn', key, weakdict)\n    assert weakdict.get(key) is value1, ('assertIs', weakdict.get(key), value1)\n    assert weakdict[key] is value1, ('assertIs', weakdict[key], value1)\n    o = weakdict.setdefault(key, value2)\n    assert o is value1, ('assertIs', o, value1)\n    assert key in weakdict, ('assertIn', key, weakdict)\n    assert weakdict.get(key) is value1, ('assertIs', weakdict.get(key), value1)\n    assert weakdict[key] is value1, ('assertIs', weakdict[key], value1)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.COUNT = 10\n    self.cbcalled = 0\n    check_setdefault(weakref.WeakValueDictionary, 'key', C(), C())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

