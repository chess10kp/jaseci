test "TestPosixSpawn.test_open_file" {
    (ok, detail) = p2_libtest_run_snippet("_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nfrom test import support\nfrom test.support import os_helper\nimport sys\nimport os\nimport stat\ntry:\n    import posix\nexcept ImportError:\n    import nt as posix\n\ndef _t():\n\n    def python_args(*args):\n        return (sys.executable, '-I', '-S', *args)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.NOOP_PROGRAM = (sys.executable, '-I', '-S', '-c', 'pass')\n    _SelfNS.NOOP_PROGRAM = (sys.executable, '-I', '-S', '-c', 'pass')\n    self.spawn_func = getattr(posix, 'posix_spawn', None)\n    _SelfNS.spawn_func = getattr(posix, 'posix_spawn', None)\n    outfile = os_helper.TESTFN\n    _add_cleanup(os_helper.unlink, *(outfile,))\n    script = 'if 1:\\n            import sys\\n            sys.stdout.write(\"hello\")\\n            '\n    file_actions = [(os.POSIX_SPAWN_OPEN, 1, outfile, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, stat.S_IRUSR | stat.S_IWUSR)]\n    args = python_args('-c', script)\n    pid = self.spawn_func(args[0], args, os.environ, file_actions=file_actions)\n    support.wait_process(pid, exitcode=0)\n    with open(outfile, encoding='utf-8') as f:\n        assert f.read() == 'hello', ('assertEqual', f.read(), 'hello')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _run_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestPosixSpawn.test_close_file" {
    (ok, detail) = p2_libtest_run_snippet("_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nfrom test import support\nfrom test.support import os_helper\nimport errno\nimport sys\nimport os\ntry:\n    import posix\nexcept ImportError:\n    import nt as posix\n\ndef _t():\n\n    def python_args(*args):\n        return (sys.executable, '-I', '-S', *args)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.NOOP_PROGRAM = (sys.executable, '-I', '-S', '-c', 'pass')\n    _SelfNS.NOOP_PROGRAM = (sys.executable, '-I', '-S', '-c', 'pass')\n    self.spawn_func = getattr(posix, 'posix_spawn', None)\n    _SelfNS.spawn_func = getattr(posix, 'posix_spawn', None)\n    closefile = os_helper.TESTFN\n    _add_cleanup(os_helper.unlink, *(closefile,))\n    script = f\"if 1:\\n            import os\\n            try:\\n                os.fstat(0)\\n            except OSError as e:\\n                with open({closefile!r}, 'w', encoding='utf-8') as closefile:\\n                    closefile.write('is closed %d' % e.errno)\\n            \"\n    args = python_args('-c', script)\n    pid = self.spawn_func(args[0], args, os.environ, file_actions=[(os.POSIX_SPAWN_CLOSE, 0)])\n    support.wait_process(pid, exitcode=0)\n    with open(closefile, encoding='utf-8') as f:\n        assert f.read() == 'is closed %d' % errno.EBADF, ('assertEqual', f.read(), 'is closed %d' % errno.EBADF)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _run_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestPosixSpawn.test_dup2" {
    (ok, detail) = p2_libtest_run_snippet("_cleanups = []\n\ndef _add_cleanup(f, *args, **kwargs):\n    _cleanups.append((f, args, kwargs))\n\ndef _run_cleanups():\n    while _cleanups:\n        f, args, kwargs = _cleanups.pop()\n        f(*args, **kwargs)\nfrom test import support\nfrom test.support import os_helper\nimport sys\nimport os\ntry:\n    import posix\nexcept ImportError:\n    import nt as posix\n\ndef _t():\n\n    def python_args(*args):\n        return (sys.executable, '-I', '-S', *args)\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.NOOP_PROGRAM = (sys.executable, '-I', '-S', '-c', 'pass')\n    _SelfNS.NOOP_PROGRAM = (sys.executable, '-I', '-S', '-c', 'pass')\n    self.spawn_func = getattr(posix, 'posix_spawn', None)\n    _SelfNS.spawn_func = getattr(posix, 'posix_spawn', None)\n    dupfile = os_helper.TESTFN\n    _add_cleanup(os_helper.unlink, *(dupfile,))\n    script = 'if 1:\\n            import sys\\n            sys.stdout.write(\"hello\")\\n            '\n    with open(dupfile, 'wb') as childfile:\n        file_actions = [(os.POSIX_SPAWN_DUP2, childfile.fileno(), 1)]\n        args = python_args('-c', script)\n        pid = self.spawn_func(args[0], args, os.environ, file_actions=file_actions)\n        support.wait_process(pid, exitcode=0)\n    with open(dupfile, encoding='utf-8') as f:\n        assert f.read() == 'hello', ('assertEqual', f.read(), 'hello')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _run_cleanups()\n");
