test "TestPosixSpawnP.test_no_such_executable" {
    (ok, detail) = p2_libtest_run_snippet("import sys\nimport os\ntry:\n    import posix\nexcept ImportError:\n    import nt as posix\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.NOOP_PROGRAM = (sys.executable, '-I', '-S', '-c', 'pass')\n    _SelfNS.NOOP_PROGRAM = (sys.executable, '-I', '-S', '-c', 'pass')\n    self.spawn_func = getattr(posix, 'posix_spawnp', None)\n    _SelfNS.spawn_func = getattr(posix, 'posix_spawnp', None)\n    no_such_executable = 'no_such_executable'\n    try:\n        pid = self.spawn_func(no_such_executable, [no_such_executable], os.environ)\n    except (FileNotFoundError, PermissionError) as exc:\n        assert exc.filename == no_such_executable, ('assertEqual', exc.filename, no_such_executable)\n    else:\n        pid2, status = os.waitpid(pid, 0)\n        assert pid2 == pid, ('assertEqual', pid2, pid)\n        assert status != 0, ('assertNotEqual', status, 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
