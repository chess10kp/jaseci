test "QuopriTestCase.test_decodestring_double_equals" {
    (ok, detail) = p2_libtest_run_snippet("import os as _os\n\ndef _oracle_write(text):\n    _os.write(1, (text + '\\n').encode())\nimport quopri\n\ndef _t():\n    decoded_value, encoded_value = (b'123=four', b'123==four')\n    assert quopri.decodestring(encoded_value) == decoded_value, ('assertEqual', quopri.decodestring(encoded_value), decoded_value)\ntry:\n    _t()\nexcept BaseException as _e:\n    _oracle_write('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    _oracle_write('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

