test "TestNumbersDefaultMethods.test_complex" {
    (ok, detail) = p2_libtest_run_snippet("import abc\nfrom numbers import Complex, Real, Rational, Integral, Number\n\ndef concretize(cls):\n\n    def not_implemented(*args, **kwargs):\n        raise NotImplementedError()\n    for name in dir(cls):\n        try:\n            value = getattr(cls, name)\n            if value.__isabstractmethod__:\n                setattr(cls, name, not_implemented)\n        except AttributeError:\n            pass\n    abc.update_abstractmethods(cls)\n    return cls\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    @concretize\n    class MyComplex(Complex):\n\n        def __init__(self, real, imag):\n            self.r = real\n            self.i = imag\n\n        @property\n        def real(self):\n            return self.r\n\n        @property\n        def imag(self):\n            return self.i\n\n        def __add__(self, other):\n            if isinstance(other, Complex):\n                return MyComplex(self.imag + other.imag, self.real + other.real)\n            raise NotImplementedError\n\n        def __neg__(self):\n            return MyComplex(-self.real, -self.imag)\n\n        def __eq__(self, other):\n            if isinstance(other, Complex):\n                return self.imag == other.imag and self.real == other.real\n            if isinstance(other, Number):\n                return self.imag == 0 and self.real == other.real\n    assert bool(MyComplex(1, 1)), ('assertTrue', bool(MyComplex(1, 1)))\n    assert bool(MyComplex(0, 1)), ('assertTrue', bool(MyComplex(0, 1)))\n    assert bool(MyComplex(1, 0)), ('assertTrue', bool(MyComplex(1, 0)))\n    assert not bool(MyComplex(0, 0)), ('assertFalse', bool(MyComplex(0, 0)))\n    assert MyComplex(2, 3) - complex(1, 2) == MyComplex(1, 1), ('assertEqual', MyComplex(2, 3) - complex(1, 2), MyComplex(1, 1))\n    assert complex(2, 3) - MyComplex(1, 2) == MyComplex(1, 1), ('assertEqual', complex(2, 3) - MyComplex(1, 2), MyComplex(1, 1))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestNumbersDefaultMethods.test_real" {
    (ok, detail) = p2_libtest_run_snippet("import abc\nfrom numbers import Complex, Real, Rational, Integral, Number\n\ndef concretize(cls):\n\n    def not_implemented(*args, **kwargs):\n        raise NotImplementedError()\n    for name in dir(cls):\n        try:\n            value = getattr(cls, name)\n            if value.__isabstractmethod__:\n                setattr(cls, name, not_implemented)\n        except AttributeError:\n            pass\n    abc.update_abstractmethods(cls)\n    return cls\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    @concretize\n    class MyReal(Real):\n\n        def __init__(self, n):\n            self.n = n\n\n        def __pos__(self):\n            return self.n\n\n        def __float__(self):\n            return float(self.n)\n\n        def __floordiv__(self, other):\n            return self.n // other\n\n        def __rfloordiv__(self, other):\n            return other // self.n\n\n        def __mod__(self, other):\n            return self.n % other\n\n        def __rmod__(self, other):\n            return other % self.n\n    assert divmod(MyReal(3), 2) == (1, 1), ('assertEqual', divmod(MyReal(3), 2), (1, 1))\n    assert divmod(3, MyReal(2)) == (1, 1), ('assertEqual', divmod(3, MyReal(2)), (1, 1))\n    assert complex(MyReal(1)) == 1 + 0j, ('assertEqual', complex(MyReal(1)), 1 + 0j)\n    assert MyReal(3).real == 3, ('assertEqual', MyReal(3).real, 3)\n    assert MyReal(3).imag == 0, ('assertEqual', MyReal(3).imag, 0)\n    assert MyReal(123).conjugate() == 123, ('assertEqual', MyReal(123).conjugate(), 123)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

