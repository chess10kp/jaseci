test "SymtableTest.test_bytes" {
    (ok, detail) = p2_libtest_run_snippet("import symtable\nTEST_CODE = '\\nimport sys\\n\\nglob = 42\\nsome_var = 12\\nsome_non_assigned_global_var: int\\nsome_assigned_global_var = 11\\n\\nclass Mine:\\n    instance_var = 24\\n    def a_method(p1, p2):\\n        pass\\n\\ndef spam(a, b, *var, **kw):\\n    global bar\\n    global some_assigned_global_var\\n    some_assigned_global_var = 12\\n    bar = 47\\n    some_var = 10\\n    x = 23\\n    glob\\n    def internal():\\n        return x\\n    def other_internal():\\n        nonlocal some_var\\n        some_var = 3\\n        return some_var\\n    return internal\\n\\ndef foo():\\n    pass\\n\\ndef namespace_test(): pass\\ndef namespace_test(): pass\\n\\ntype Alias = int\\ntype GenericAlias[T] = list[T]\\n\\ndef generic_spam[T](a):\\n    pass\\n\\nclass GenericMine[T: int, U: (int, str) = int]:\\n    pass\\n'\n\ndef find_block(block, name):\n    for ch in block.get_children():\n        if ch.get_name() == name:\n            return ch\n\ndef _t():\n    top = symtable.symtable(TEST_CODE.encode('utf8'), '?', 'exec')\n    assert find_block(top, 'Mine') is not None, ('assertIsNotNone', find_block(top, 'Mine'))\n    code = b'# -*- coding: iso8859-15 -*-\\nclass \\xb4: pass\\n'\n    top = symtable.symtable(code, '?', 'exec')\n    assert find_block(top, '\u017d') is not None, ('assertIsNotNone', find_block(top, '\u017d'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

