test "SymtableTest.test_annotated" {
    (ok, detail) = p2_libtest_run_snippet("import symtable\n\ndef _t():\n    st1 = symtable.symtable('def f():\\n    x: int\\n', 'test', 'exec')\n    st2 = st1.get_children()[1]\n    assert st2.get_type() == 'function', ('assertEqual', st2.get_type(), 'function')\n    assert st2.lookup('x').is_local(), ('assertTrue', st2.lookup('x').is_local())\n    assert st2.lookup('x').is_annotated(), ('assertTrue', st2.lookup('x').is_annotated())\n    assert not st2.lookup('x').is_global(), ('assertFalse', st2.lookup('x').is_global())\n    st3 = symtable.symtable('def f():\\n    x = 1\\n', 'test', 'exec')\n    st4 = st3.get_children()[1]\n    assert st4.get_type() == 'function', ('assertEqual', st4.get_type(), 'function')\n    assert st4.lookup('x').is_local(), ('assertTrue', st4.lookup('x').is_local())\n    assert not st4.lookup('x').is_annotated(), ('assertFalse', st4.lookup('x').is_annotated())\n    st5 = symtable.symtable('global x\\nx: int', 'test', 'exec')\n    assert st5.lookup('x').is_global(), ('assertTrue', st5.lookup('x').is_global())\n    st6 = symtable.symtable('def g():\\n    x = 2\\n    def f():\\n        nonlocal x\\n    x: int', 'test', 'exec')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SymtableTest.test_filename_correct" {
    (ok, detail) = p2_libtest_run_snippet("import symtable\n\ndef _t():\n\n    def checkfilename(brokencode, offset):\n        try:\n            symtable.symtable(brokencode, 'spam', 'exec')\n        except SyntaxError as e:\n            assert e.filename == 'spam', ('assertEqual', e.filename, 'spam')\n            assert e.lineno == 1, ('assertEqual', e.lineno, 1)\n            assert e.offset == offset, ('assertEqual', e.offset, offset)\n        else:\n            raise AssertionError('no SyntaxError for %r' % (brokencode,))\n    checkfilename('def f(x): foo)(', 14)\n    checkfilename('def f(x): global x', 11)\n    symtable.symtable('pass', b'spam', 'exec')\n    try:\n        symtable.symtable('pass', bytearray(b'spam'), 'exec')\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        symtable.symtable('pass', memoryview(b'spam'), 'exec')\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        symtable.symtable('pass', list(b'spam'), 'exec')\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

