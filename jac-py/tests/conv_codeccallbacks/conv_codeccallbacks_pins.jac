test "CodecCallbackTest.test_mutating_decode_handler" {
    (ok, detail) = p2_libtest_run_snippet("import codecs\n\ndef _t():\n    baddata = [('ascii', b'\\xff'), ('utf-7', b'++'), ('utf-8', b'\\xff'), ('utf-16', b'\\xff'), ('utf-32', b'\\xff'), ('unicode-escape', b'\\\\u123g'), ('raw-unicode-escape', b'\\\\u123g')]\n\n    def replacing(exc):\n        if isinstance(exc, UnicodeDecodeError):\n            exc.object = 42\n            return ('\u4242', 0)\n        else:\n            raise TypeError(\"don't know how to handle %r\" % exc)\n    codecs.register_error('test.replacing', replacing)\n    for encoding, data in baddata:\n        try:\n            data.decode(encoding, 'test.replacing')\n        except TypeError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n\n    def mutating(exc):\n        if isinstance(exc, UnicodeDecodeError):\n            exc.object = b''\n            return ('\u4242', 0)\n        else:\n            raise TypeError(\"don't know how to handle %r\" % exc)\n    codecs.register_error('test.mutating', mutating)\n    for encoding, data in baddata:\n        assert data.decode(encoding, 'test.mutating') == '\u4242', ('assertEqual', data.decode(encoding, 'test.mutating'), '\u4242')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CodecCallbackTest.test_crashing_decode_handler" {
    (ok, detail) = p2_libtest_run_snippet("import codecs\n\ndef _t():\n\n    def forward_shorter_than_end(exc):\n        if isinstance(exc, UnicodeDecodeError):\n            return ('\ufffd', exc.start + 1)\n        else:\n            raise TypeError(\"don't know how to handle %r\" % exc)\n    codecs.register_error('test.forward_shorter_than_end', forward_shorter_than_end)\n    assert b'\\xd8\\xd8\\xd8\\xd8\\xd8\\x00\\x00\\x00'.decode('utf-16-le', 'test.forward_shorter_than_end') == '\ufffd\ufffd\ufffd\ufffd\u00d8\\x00', ('assertEqual', b'\\xd8\\xd8\\xd8\\xd8\\xd8\\x00\\x00\\x00'.decode('utf-16-le', 'test.forward_shorter_than_end'), '\ufffd\ufffd\ufffd\ufffd\u00d8\\x00')\n    assert b'\\xd8\\xd8\\xd8\\xd8\\x00\\xd8\\x00\\x00'.decode('utf-16-be', 'test.forward_shorter_than_end') == '\ufffd\ufffd\ufffd\ufffd\u00d8\\x00', ('assertEqual', b'\\xd8\\xd8\\xd8\\xd8\\x00\\xd8\\x00\\x00'.decode('utf-16-be', 'test.forward_shorter_than_end'), '\ufffd\ufffd\ufffd\ufffd\u00d8\\x00')\n    assert b'\\x11\\x11\\x11\\x11\\x11\\x00\\x00\\x00\\x00\\x00\\x00'.decode('utf-32-le', 'test.forward_shorter_than_end') == '\ufffd\ufffd\ufffd\u1111\\x00', ('assertEqual', b'\\x11\\x11\\x11\\x11\\x11\\x00\\x00\\x00\\x00\\x00\\x00'.decode('utf-32-le', 'test.forward_shorter_than_end'), '\ufffd\ufffd\ufffd\u1111\\x00')\n    assert b'\\x11\\x11\\x11\\x00\\x00\\x11\\x11\\x00\\x00\\x00\\x00'.decode('utf-32-be', 'test.forward_shorter_than_end') == '\ufffd\ufffd\ufffd\u1111\\x00', ('assertEqual', b'\\x11\\x11\\x11\\x00\\x00\\x11\\x11\\x00\\x00\\x00\\x00'.decode('utf-32-be', 'test.forward_shorter_than_end'), '\ufffd\ufffd\ufffd\u1111\\x00')\n\n    def replace_with_long(exc):\n        if isinstance(exc, UnicodeDecodeError):\n            exc.object = b'\\x00' * 8\n            return ('\ufffd', exc.start)\n        else:\n            raise TypeError(\"don't know how to handle %r\" % exc)\n    codecs.register_error('test.replace_with_long', replace_with_long)\n    assert b'\\x00'.decode('utf-16', 'test.replace_with_long') == '\ufffd\\x00\\x00\\x00\\x00', ('assertEqual', b'\\x00'.decode('utf-16', 'test.replace_with_long'), '\ufffd\\x00\\x00\\x00\\x00')\n    assert b'\\x00'.decode('utf-32', 'test.replace_with_long') == '\ufffd\\x00\\x00', ('assertEqual', b'\\x00'.decode('utf-32', 'test.replace_with_long'), '\ufffd\\x00\\x00')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CodecCallbackTest.test_fake_error_class" {
    (ok, detail) = p2_libtest_run_snippet("import codecs\n\ndef _t():\n    handlers = [codecs.strict_errors, codecs.ignore_errors, codecs.replace_errors, codecs.backslashreplace_errors, codecs.namereplace_errors, codecs.xmlcharrefreplace_errors, codecs.lookup_error('surrogateescape'), codecs.lookup_error('surrogatepass')]\n    for cls in (UnicodeEncodeError, UnicodeDecodeError, UnicodeTranslateError):\n\n        class FakeUnicodeError(str):\n            __class__ = cls\n        for handler in handlers:\n            try:\n                handler(*(FakeUnicodeError(),))\n            except TypeError:\n                pass\n\n        class FakeUnicodeError(Exception):\n            __class__ = cls\n        for handler in handlers:\n            try:\n                handler(FakeUnicodeError())\n            except (TypeError, FakeUnicodeError) as _exc:\n                pass\n            else:\n                raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CodecCallbackTest.test_reject_unregister_builtin_error_handler" {
    (ok, detail) = p2_libtest_run_snippet("from _codecs import _unregister_error as _codecs_unregister_error\n\ndef _t():\n    for name in ['strict', 'ignore', 'replace', 'backslashreplace', 'namereplace', 'xmlcharrefreplace', 'surrogateescape', 'surrogatepass']:\n        try:\n            _codecs_unregister_error(*(name,))\n        except ValueError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CodecCallbackTest.test_unregister_custom_error_handler" {
    (ok, detail) = p2_libtest_run_snippet("from _codecs import _unregister_error as _codecs_unregister_error\nimport codecs\n\ndef _t():\n\n    def custom_handler(exc):\n        raise exc\n    custom_name = 'test.test_unregister_custom_error_handler'\n    try:\n        codecs.lookup_error(*(custom_name,))\n    except LookupError:\n        pass\n    codecs.register_error(custom_name, custom_handler)\n    assert codecs.lookup_error(custom_name) is custom_handler, ('assertIs', codecs.lookup_error(custom_name), custom_handler)\n    assert _codecs_unregister_error(custom_name), ('assertTrue', _codecs_unregister_error(custom_name))\n    try:\n        codecs.lookup_error(*(custom_name,))\n    except LookupError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

