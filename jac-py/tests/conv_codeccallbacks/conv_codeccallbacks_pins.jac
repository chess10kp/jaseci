test "CodecCallbackTest.test_decodehelper" {
    (ok, detail) = p2_libtest_run_snippet("import codecs\nimport sys\n\nclass PosReturn:\n\n    def __init__(self):\n        self.pos = 0\n\n    def handle(self, exc):\n        oldpos = self.pos\n        realpos = oldpos\n        if realpos < 0:\n            realpos = len(exc.object) + realpos\n        if realpos <= exc.start:\n            self.pos = len(exc.object)\n        return ('<?>', oldpos)\n\ndef _t():\n    try:\n        b'\\xff'.decode(*('ascii', 'test.unknown'))\n    except LookupError:\n        pass\n\n    def baddecodereturn1(exc):\n        return 42\n    codecs.register_error('test.baddecodereturn1', baddecodereturn1)\n    try:\n        b'\\xff'.decode(*('ascii', 'test.baddecodereturn1'))\n    except TypeError:\n        pass\n    try:\n        b'\\\\'.decode(*('unicode-escape', 'test.baddecodereturn1'))\n    except TypeError:\n        pass\n    try:\n        b'\\\\x0'.decode(*('unicode-escape', 'test.baddecodereturn1'))\n    except TypeError:\n        pass\n    try:\n        b'\\\\x0y'.decode(*('unicode-escape', 'test.baddecodereturn1'))\n    except TypeError:\n        pass\n    try:\n        b'\\\\Uffffeeee'.decode(*('unicode-escape', 'test.baddecodereturn1'))\n    except TypeError:\n        pass\n    try:\n        b'\\\\uyyyy'.decode(*('raw-unicode-escape', 'test.baddecodereturn1'))\n    except TypeError:\n        pass\n\n    def baddecodereturn2(exc):\n        return ('?', None)\n    codecs.register_error('test.baddecodereturn2', baddecodereturn2)\n    try:\n        b'\\xff'.decode(*('ascii', 'test.baddecodereturn2'))\n    except TypeError:\n        pass\n    handler = PosReturn()\n    codecs.register_error('test.posreturn', handler.handle)\n    handler.pos = -1\n    assert b'\\xff0'.decode('ascii', 'test.posreturn') == '<?>0', ('assertEqual', b'\\xff0'.decode('ascii', 'test.posreturn'), '<?>0')\n    handler.pos = -2\n    assert b'\\xff0'.decode('ascii', 'test.posreturn') == '<?><?>', ('assertEqual', b'\\xff0'.decode('ascii', 'test.posreturn'), '<?><?>')\n    handler.pos = -3\n    try:\n        b'\\xff0'.decode(*('ascii', 'test.posreturn'))\n    except IndexError:\n        pass\n    handler.pos = 1\n    assert b'\\xff0'.decode('ascii', 'test.posreturn') == '<?>0', ('assertEqual', b'\\xff0'.decode('ascii', 'test.posreturn'), '<?>0')\n    handler.pos = 2\n    assert b'\\xff0'.decode('ascii', 'test.posreturn') == '<?>', ('assertEqual', b'\\xff0'.decode('ascii', 'test.posreturn'), '<?>')\n    handler.pos = 3\n    try:\n        b'\\xff0'.decode(*('ascii', 'test.posreturn'))\n    except IndexError:\n        pass\n    handler.pos = 6\n    assert b'\\\\uyyyy0'.decode('raw-unicode-escape', 'test.posreturn') == '<?>0', ('assertEqual', b'\\\\uyyyy0'.decode('raw-unicode-escape', 'test.posreturn'), '<?>0')\n\n    class D(dict):\n\n        def __getitem__(self, key):\n            raise ValueError\n    try:\n        codecs.charmap_decode(*(b'\\xff', 'strict', {255: None}))\n    except UnicodeError:\n        pass\n    try:\n        codecs.charmap_decode(*(b'\\xff', 'strict', D()))\n    except ValueError:\n        pass\n    try:\n        codecs.charmap_decode(*(b'\\xff', 'strict', {255: sys.maxunicode + 1}))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CodecCallbackTest.test_encodehelper" {
    (ok, detail) = p2_libtest_run_snippet("import codecs\n\nclass PosReturn:\n\n    def __init__(self):\n        self.pos = 0\n\n    def handle(self, exc):\n        oldpos = self.pos\n        realpos = oldpos\n        if realpos < 0:\n            realpos = len(exc.object) + realpos\n        if realpos <= exc.start:\n            self.pos = len(exc.object)\n        return ('<?>', oldpos)\n\ndef _t():\n    try:\n        '\u00ff'.encode(*('ascii', 'test.unknown'))\n    except LookupError:\n        pass\n\n    def badencodereturn1(exc):\n        return 42\n    codecs.register_error('test.badencodereturn1', badencodereturn1)\n    try:\n        '\u00ff'.encode(*('ascii', 'test.badencodereturn1'))\n    except TypeError:\n        pass\n\n    def badencodereturn2(exc):\n        return ('?', None)\n    codecs.register_error('test.badencodereturn2', badencodereturn2)\n    try:\n        '\u00ff'.encode(*('ascii', 'test.badencodereturn2'))\n    except TypeError:\n        pass\n    handler = PosReturn()\n    codecs.register_error('test.posreturn', handler.handle)\n    handler.pos = -1\n    assert '\u00ff0'.encode('ascii', 'test.posreturn') == b'<?>0', ('assertEqual', '\u00ff0'.encode('ascii', 'test.posreturn'), b'<?>0')\n    handler.pos = -2\n    assert '\u00ff0'.encode('ascii', 'test.posreturn') == b'<?><?>', ('assertEqual', '\u00ff0'.encode('ascii', 'test.posreturn'), b'<?><?>')\n    handler.pos = -3\n    try:\n        '\u00ff0'.encode(*('ascii', 'test.posreturn'))\n    except IndexError:\n        pass\n    handler.pos = 1\n    assert '\u00ff0'.encode('ascii', 'test.posreturn') == b'<?>0', ('assertEqual', '\u00ff0'.encode('ascii', 'test.posreturn'), b'<?>0')\n    handler.pos = 2\n    assert '\u00ff0'.encode('ascii', 'test.posreturn') == b'<?>', ('assertEqual', '\u00ff0'.encode('ascii', 'test.posreturn'), b'<?>')\n    handler.pos = 3\n    try:\n        '\u00ff0'.encode(*('ascii', 'test.posreturn'))\n    except IndexError:\n        pass\n    handler.pos = 0\n\n    class D(dict):\n\n        def __getitem__(self, key):\n            raise ValueError\n    for err in ('strict', 'replace', 'xmlcharrefreplace', 'backslashreplace', 'namereplace', 'test.posreturn'):\n        try:\n            codecs.charmap_encode(*('\u00ff', err, {255: None}))\n        except UnicodeError:\n            pass\n        try:\n            codecs.charmap_encode(*('\u00ff', err, D()))\n        except ValueError:\n            pass\n        try:\n            codecs.charmap_encode(*('\u00ff', err, {255: 300}))\n        except TypeError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
