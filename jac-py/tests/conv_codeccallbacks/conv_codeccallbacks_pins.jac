test "CodecCallbackTest.test_unicodeencodeerror" {
    (ok, detail) = p2_libtest_run_snippet("def check_exceptionobjectargs(exctype, args, msg):\n    try:\n        exctype(*(*args[:-1],))\n    except TypeError:\n        pass\n    try:\n        exctype(*(*args + ['too much'],))\n    except TypeError:\n        pass\n    wrongargs = ['spam', b'eggs', b'spam', 42, 1.0, None]\n    for i in range(len(args)):\n        for wrongarg in wrongargs:\n            if type(wrongarg) is type(args[i]):\n                continue\n            callargs = []\n            for j in range(len(args)):\n                if i == j:\n                    callargs.append(wrongarg)\n                else:\n                    callargs.append(args[i])\n            try:\n                exctype(*(*callargs,))\n            except TypeError:\n                pass\n    exc = exctype(*args)\n    assert str(exc) == msg, ('assertEqual', str(exc), msg)\n\ndef _t():\n    check_exceptionobjectargs(UnicodeEncodeError, ['ascii', 'g\u00fcrk', 1, 2, 'ouch'], \"'ascii' codec can't encode character '\\\\xfc' in position 1: ouch\")\n    check_exceptionobjectargs(UnicodeEncodeError, ['ascii', 'g\u00fcrk', 1, 4, 'ouch'], \"'ascii' codec can't encode characters in position 1-3: ouch\")\n    check_exceptionobjectargs(UnicodeEncodeError, ['ascii', '\u00fcx', 0, 1, 'ouch'], \"'ascii' codec can't encode character '\\\\xfc' in position 0: ouch\")\n    check_exceptionobjectargs(UnicodeEncodeError, ['ascii', '\u0100x', 0, 1, 'ouch'], \"'ascii' codec can't encode character '\\\\u0100' in position 0: ouch\")\n    check_exceptionobjectargs(UnicodeEncodeError, ['ascii', '\\uffffx', 0, 1, 'ouch'], \"'ascii' codec can't encode character '\\\\uffff' in position 0: ouch\")\n    check_exceptionobjectargs(UnicodeEncodeError, ['ascii', '\ud800\udc00x', 0, 1, 'ouch'], \"'ascii' codec can't encode character '\\\\U00010000' in position 0: ouch\")\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

