test "CodecCallbackTest.test_xmlcharnamereplace" {
    (ok, detail) = p2_libtest_run_snippet("import codecs\nimport html.entities\n\ndef _t():\n\n    def xmlcharnamereplace(exc):\n        if not isinstance(exc, UnicodeEncodeError):\n            raise TypeError(\"don't know how to handle %r\" % exc)\n        l = []\n        for c in exc.object[exc.start:exc.end]:\n            try:\n                l.append('&%s;' % html.entities.codepoint2name[ord(c)])\n            except KeyError:\n                l.append('&#%d;' % ord(c))\n        return (''.join(l), exc.end)\n    codecs.register_error('test.xmlcharnamereplace', xmlcharnamereplace)\n    sin = '\u00ab\u211c\u00bb = \u2329\u1234\u20ac\u232a'\n    sout = b'&laquo;&real;&raquo; = &lang;&#4660;&euro;&rang;'\n    assert sin.encode('ascii', 'test.xmlcharnamereplace') == sout, ('assertEqual', sin.encode('ascii', 'test.xmlcharnamereplace'), sout)\n    sout = b'\\xab&real;\\xbb = &lang;&#4660;&euro;&rang;'\n    assert sin.encode('latin-1', 'test.xmlcharnamereplace') == sout, ('assertEqual', sin.encode('latin-1', 'test.xmlcharnamereplace'), sout)\n    sout = b'\\xab&real;\\xbb = &lang;&#4660;\\xa4&rang;'\n    assert sin.encode('iso-8859-15', 'test.xmlcharnamereplace') == sout, ('assertEqual', sin.encode('iso-8859-15', 'test.xmlcharnamereplace'), sout)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CodecCallbackTest.test_uninamereplace" {
    (ok, detail) = p2_libtest_run_snippet("import codecs\nimport unicodedata\n\ndef _t():\n\n    def uninamereplace(exc):\n        if not isinstance(exc, UnicodeEncodeError):\n            raise TypeError(\"don't know how to handle %r\" % exc)\n        l = []\n        for c in exc.object[exc.start:exc.end]:\n            l.append(unicodedata.name(c, '0x%x' % ord(c)))\n        return ('\\x1b[1m%s\\x1b[0m' % ', '.join(l), exc.end)\n    codecs.register_error('test.uninamereplace', uninamereplace)\n    sin = '\u00ac\u1234\u20ac\u8000'\n    sout = b'\\x1b[1mNOT SIGN, ETHIOPIC SYLLABLE SEE, EURO SIGN, CJK UNIFIED IDEOGRAPH-8000\\x1b[0m'\n    assert sin.encode('ascii', 'test.uninamereplace') == sout, ('assertEqual', sin.encode('ascii', 'test.uninamereplace'), sout)\n    sout = b'\\xac\\x1b[1mETHIOPIC SYLLABLE SEE, EURO SIGN, CJK UNIFIED IDEOGRAPH-8000\\x1b[0m'\n    assert sin.encode('latin-1', 'test.uninamereplace') == sout, ('assertEqual', sin.encode('latin-1', 'test.uninamereplace'), sout)\n    sout = b'\\xac\\x1b[1mETHIOPIC SYLLABLE SEE\\x1b[0m\\xa4\\x1b[1mCJK UNIFIED IDEOGRAPH-8000\\x1b[0m'\n    assert sin.encode('iso-8859-15', 'test.uninamereplace') == sout, ('assertEqual', sin.encode('iso-8859-15', 'test.uninamereplace'), sout)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

