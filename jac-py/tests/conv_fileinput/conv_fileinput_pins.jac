i.filename() == t2, ('assertEqual', fi.filename(), t2)\n    assert fi.lineno() == 21, ('assertEqual', fi.lineno(), 21)\n    assert fi.filelineno() == 6, ('assertEqual', fi.filelineno(), 6)\n    assert not fi.isfirstline(), ('assertFalse', fi.isfirstline())\n    assert not fi.isstdin(), ('assertFalse', fi.isstdin())\n    if verbose:\n        print('3. Nextfile')\n    fi.nextfile()\n    assert fi.readline() == 'Line 1 of file 3\\n', ('assertEqual', fi.readline(), 'Line 1 of file 3\\n')\n    assert fi.lineno() == 22, ('assertEqual', fi.lineno(), 22)\n    fi.close()\n    if verbose:\n        print('4. Stdin')\n    fi = FileInput(files=(t1, t2, t3, t4, '-'), encoding='utf-8')\n    savestdin = sys.stdin\n    try:\n        sys.stdin = StringIO('Line 1 of stdin\\nLine 2 of stdin\\n')\n        lines = list(fi)\n        assert len(lines) == 33, ('assertEqual', len(lines), 33)\n        assert lines[32] == 'Line 2 of stdin\\n', ('assertEqual', lines[32], 'Line 2 of stdin\\n')\n        assert fi.filename() == '<stdin>', ('assertEqual', fi.filename(), '<stdin>')\n        fi.nextfile()\n    finally:\n        sys.stdin = savestdin\n    if verbose:\n        print('5. Boundary conditions')\n    fi = FileInput(files=(t1, t2, t3, t4), encoding='utf-8')\n    assert fi.lineno() == 0, ('assertEqual', fi.lineno(), 0)\n    assert fi.filename() == None, ('assertEqual', fi.filename(), None)\n    fi.nextfile()\n    assert fi.lineno() == 0, ('assertEqual', fi.lineno(), 0)\n    assert fi.filename() == None, ('assertEqual', fi.filename(), None)\n    if verbose:\n        print('6. Inplace')\n    savestdout = sys.stdout\n    try:\n        fi = FileInput(files=(t1, t2, t3, t4), inplace=True, encoding='utf-8')\n        for line in fi:\n            line = line[:-1].upper()\n            print(line)\n        fi.close()\n    finally:\n        sys.stdout = savestdout\n    fi = FileInput(files=(t1, t2, t3, t4), encoding='utf-8')\n    for line in fi:\n        assert line[-1] == '\\n', ('assertEqual', line[-1], '\\n')\n        m = pat.match(line[:-1])\n        assert m != None, ('assertNotEqual', m, None)\n        assert int(m.group(1)) == fi.filelineno(), ('assertEqual', int(m.group(1)), fi.filelineno())\n    fi.close()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _drain_cleanups()\n");
