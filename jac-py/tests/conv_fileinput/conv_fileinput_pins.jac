test "FileInputTests.test_readline_buffering" {
    (ok, detail) = p2_libtest_run_snippet("from fileinput import FileInput, hook_encoded\n\nclass LineReader:\n\n    def __init__(self):\n        self._linesread = []\n\n    @property\n    def linesread(self):\n        try:\n            return self._linesread[:]\n        finally:\n            self._linesread = []\n\n    def openhook(self, filename, mode):\n        self.it = iter(filename.splitlines(True))\n        return self\n\n    def readline(self, size=None):\n        line = next(self.it, '')\n        self._linesread.append(line)\n        return line\n\n    def readlines(self, hint=-1):\n        lines = []\n        size = 0\n        while True:\n            line = self.readline()\n            if not line:\n                return lines\n            lines.append(line)\n            size += len(line)\n            if size >= hint:\n                return lines\n\n    def close(self):\n        pass\n\ndef _t():\n    src = LineReader()\n    with FileInput(files=['line1\\nline2', 'line3\\n'], openhook=src.openhook) as fi:\n        assert src.linesread == [], ('assertEqual', src.linesread, [])\n        assert fi.readline() == 'line1\\n', ('assertEqual', fi.readline(), 'line1\\n')\n        assert src.linesread == ['line1\\n'], ('assertEqual', src.linesread, ['line1\\n'])\n        assert fi.readline() == 'line2', ('assertEqual', fi.readline(), 'line2')\n        assert src.linesread == ['line2'], ('assertEqual', src.linesread, ['line2'])\n        assert fi.readline() == 'line3\\n', ('assertEqual', fi.readline(), 'line3\\n')\n        assert src.linesread == ['', 'line3\\n'], ('assertEqual', src.linesread, ['', 'line3\\n'])\n        assert fi.readline() == '', ('assertEqual', fi.readline(), '')\n        assert src.linesread == [''], ('assertEqual', src.linesread, [''])\n        assert fi.readline() == '', ('assertEqual', fi.readline(), '')\n        assert src.linesread == [], ('assertEqual', src.linesread, [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FileInputTests.test_iteration_buffering" {
    (ok, detail) = p2_libtest_run_snippet("from fileinput import FileInput, hook_encoded\n\nclass LineReader:\n\n    def __init__(self):\n        self._linesread = []\n\n    @property\n    def linesread(self):\n        try:\n            return self._linesread[:]\n        finally:\n            self._linesread = []\n\n    def openhook(self, filename, mode):\n        self.it = iter(filename.splitlines(True))\n        return self\n\n    def readline(self, size=None):\n        line = next(self.it, '')\n        self._linesread.append(line)\n        return line\n\n    def readlines(self, hint=-1):\n        lines = []\n        size = 0\n        while True:\n            line = self.readline()\n            if not line:\n                return lines\n            lines.append(line)\n            size += len(line)\n            if size >= hint:\n                return lines\n\n    def close(self):\n        pass\n\ndef _t():\n    src = LineReader()\n    with FileInput(files=['line1\\nline2', 'line3\\n'], openhook=src.openhook) as fi:\n        assert src.linesread == [], ('assertEqual', src.linesread, [])\n        assert next(fi) == 'line1\\n', ('assertEqual', next(fi), 'line1\\n')\n        assert src.linesread == ['line1\\n'], ('assertEqual', src.linesread, ['line1\\n'])\n        assert next(fi) == 'line2', ('assertEqual', next(fi), 'line2')\n        assert src.linesread == ['line2'], ('assertEqual', src.linesread, ['line2'])\n        assert next(fi) == 'line3\\n', ('assertEqual', next(fi), 'line3\\n')\n        assert src.linesread == ['', 'line3\\n'], ('assertEqual', src.linesread, ['', 'line3\\n'])\n        try:\n            next(*(fi,))\n        except StopIteration:\n            pass\n        assert src.linesread == [''], ('assertEqual', src.linesread, [''])\n        try:\n            next(*(fi,))\n        except StopIteration:\n            pass\n        assert src.linesread == [], ('assertEqual', src.linesread, [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FileInputTests.test_pathlike_file" {
    (ok, detail) = p2_libtest_run_snippet("_cleanup_stack = []\n\ndef _drain_cleanups():\n    while _cleanup_stack:\n        _fn, _a, _k = _cleanup_stack.pop()\n        try:\n            _fn(*_a, **_k)\n        except BaseException as _ce:\n            print('ORACLE_EXC ' + type(_ce).__name__ + ' ' + repr(str(_ce)))\nimport os\nimport tempfile\nfrom fileinput import FileInput, hook_encoded\nfrom test.support.os_helper import TESTFN, FakePath\nfrom test.support import os_helper\n\ndef writeTmp(content, *, mode='w'):\n    fd, name = tempfile.mkstemp()\n    _cleanup_stack.append((os_helper.unlink, (name,), {}))\n    encoding = None if 'b' in mode else 'utf-8'\n    with open(fd, mode, encoding=encoding) as f:\n        f.write(content)\n    return name\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    t1 = FakePath(writeTmp('Path-like file.'))\n    with FileInput(t1, encoding='utf-8') as fi:\n        line = fi.readline()\n        assert line == 'Path-like file.', ('assertEqual', line, 'Path-like file.')\n        assert fi.lineno() == 1, ('assertEqual', fi.lineno(), 1)\n        assert fi.filelineno() == 1, ('assertEqual', fi.filelineno(), 1)\n        assert fi.filename() == os.fspath(t1), ('assertEqual', fi.filename(), os.fspath(t1))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _drain_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
