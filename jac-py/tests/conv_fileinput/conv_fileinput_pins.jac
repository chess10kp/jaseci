test "Test_hook_encoded.test" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport fileinput\nimport builtins\n\nclass InvocationRecorder:\n\n    def __init__(self):\n        self.invocation_count = 0\n\n    def __call__(self, *args, **kwargs):\n        self.invocation_count += 1\n        self.last_invocation = (args, kwargs)\n        return io.BytesIO(b'some bytes')\n\ndef _t():\n    encoding = object()\n    errors = object()\n    result = fileinput.hook_encoded(encoding, errors=errors)\n    fake_open = InvocationRecorder()\n    original_open = builtins.open\n    builtins.open = fake_open\n    try:\n        filename = object()\n        mode = object()\n        open_result = result(filename, mode)\n    finally:\n        builtins.open = original_open\n    assert fake_open.invocation_count == 1, ('assertEqual', fake_open.invocation_count, 1)\n    args, kwargs = fake_open.last_invocation\n    assert args[0] is filename, ('assertIs', args[0], filename)\n    assert args[1] is mode, ('assertIs', args[1], mode)\n    assert kwargs.pop('encoding') is encoding, ('assertIs', kwargs.pop('encoding'), encoding)\n    assert kwargs.pop('errors') is errors, ('assertIs', kwargs.pop('errors'), errors)\n    assert not kwargs, ('assertFalse', kwargs)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "Test_hook_encoded.test_errors" {
    (ok, detail) = p2_libtest_run_snippet("_cleanup_stack = []\n\ndef _drain_cleanups():\n    while _cleanup_stack:\n        _fn, _a, _k = _cleanup_stack.pop()\n        try:\n            _fn(*_a, **_k)\n        except BaseException as _ce:\n            print('ORACLE_EXC ' + type(_ce).__name__ + ' ' + repr(str(_ce)))\nfrom fileinput import FileInput, hook_encoded\nfrom test.support.os_helper import TESTFN, FakePath\nfrom test.support.os_helper import unlink as safe_unlink\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    with open(TESTFN, 'wb') as f:\n        f.write(b'\\x80abc')\n    _cleanup_stack.append((safe_unlink, (TESTFN,), {}))\n\n    def check(errors, expected_lines):\n        with FileInput(files=TESTFN, mode='r', openhook=hook_encoded('utf-8', errors=errors)) as fi:\n            lines = list(fi)\n        assert lines == expected_lines, ('assertEqual', lines, expected_lines)\n    check('ignore', ['abc'])\n    try:\n        check('strict', ['abc'])\n    except UnicodeDecodeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    check('replace', ['\ufffdabc'])\n    check('backslashreplace', ['\\\\x80abc'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _drain_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "Test_hook_encoded.test_modes" {
    (ok, detail) = p2_libtest_run_snippet("_cleanup_stack = []\n\ndef _drain_cleanups():\n    while _cleanup_stack:\n        _fn, _a, _k = _cleanup_stack.pop()\n        try:\n            _fn(*_a, **_k)\n        except BaseException as _ce:\n            print('ORACLE_EXC ' + type(_ce).__name__ + ' ' + repr(str(_ce)))\nfrom fileinput import FileInput, hook_encoded\nfrom test.support.os_helper import TESTFN, FakePath\nfrom test.support.os_helper import unlink as safe_unlink\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    with open(TESTFN, 'wb') as f:\n        f.write(b'A\\nB\\r\\nC\\rD+IKw-')\n    _cleanup_stack.append((safe_unlink, (TESTFN,), {}))\n\n    def check(mode, expected_lines):\n        with FileInput(files=TESTFN, mode=mode, openhook=hook_encoded('utf-7')) as fi:\n            lines = list(fi)\n        assert lines == expected_lines, ('assertEqual', lines, expected_lines)\n    check('r', ['A\\n', 'B\\n', 'C\\n', 'D\u20ac'])\n    try:\n        check('rb', ['A\\n', 'B\\r\\n', 'C\\r', 'D\u20ac'])\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\nfinally:\n    _drain_cleanups()\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
